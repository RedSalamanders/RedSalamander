<Project>
  <Import Project="$(MSBuildThisFileDirectory)..\.build\dependencies\DxUi\DxUi.resolved.$(Platform).props"
          Condition="'$(RSDxUiSdkRoot)'=='' and Exists('$(MSBuildThisFileDirectory)..\.build\dependencies\DxUi\DxUi.resolved.$(Platform).props')" />
  <Import Project="$(DxUiRoot)\Build\DxUi.Consumer.props" Condition="'$(RSDxUiSdkRoot)'=='' and '$(DxUiRoot)'!=''" />
  <Import Project="$(RSDxUiSdkRoot)\DxUi.Sdk.props" Condition="'$(RSDxUiSdkRoot)'!=''" />
  <!-- The SDK's sample-consumer Windows macros change this application's existing
       header inclusion order. Keep the Source profile's per-translation-unit
       Windows macro policy; all shared SDK ABI/profile checks still apply. -->
  <ItemDefinitionGroup Condition="'$(RSDxUiSdkRoot)'!=''">
    <ClCompile><PreprocessorDefinitions>$([MSBuild]::Unescape($([System.Text.RegularExpressions.Regex]::Replace('%(PreprocessorDefinitions)', '(^|;)(WIN32_LEAN_AND_MEAN|NOMINMAX)(=1)?(?=;|$)', ''))))</PreprocessorDefinitions></ClCompile>
  </ItemDefinitionGroup>
  <Import Project="$(RSCiEngineRoot)\Tools\MSBuild\Ci.SdkConsumer.targets" Condition="'$(RSDxUiSdkRoot)'!=''" />
  <PropertyGroup><RSDxUiConsumer>true</RSDxUiConsumer></PropertyGroup>
  <Target Name="RequireRestoredDxUi" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(DxUiRoot)'=='' and '$(RSDxUiSdkRoot)'==''" Text="Run Tools/Restore-DxUi.ps1 for this platform before building a DxUi consumer." />
    <Error Condition="'$(DxUiRoot)'!='' and '$(RSDxUiSdkRoot)'!=''" Text="Select exactly one pinned DxUi source or SDK recipe." />
    <Error Condition="'$(RSDxUiSdkRoot)'!='' and ('$(CiSdkLeasePath)'=='' or '$(RSCiEngineRoot)'=='')" Text="Use build.ps1 with an active qualified SDK reader." />
  </Target>
</Project>
