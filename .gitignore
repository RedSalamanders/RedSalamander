# Visual Studio user/cache files
.vs/
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb
ipch/
*.aps
*.binlog

# Build outputs. First-party projects write under .build\; keep compiler
# leftovers ignored in case a project is built without Directory.Build.props.
.build/

# Per-platform intermediate/output directories produced when MSBuild or Visual
# Studio runs without the repository defaults (no first-party source lives here).
x64/
ARM64/
ARM/
x86/
Win32/

*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.ilk
*.exp
*.sbr

# Packaging leftovers (Visual Studio Store/MSIX output)
AppPackages/
BundleArtifacts/
Package.StoreAssociation.xml
_pkginfo.txt
*.appx
*.appxbundle
*.appxupload
*.pfx

# vcpkg (canonical install is under .build\; this also covers in-tree mistakes)
**/vcpkg_installed/

# Logs (see Specs/TestRuns/README.md and Specs/Testing/Testing_ValidationEvidence.md)
*.log

# Generated test-run archives. Curated evidence is force-added.
# Do not add per-run exception lists; already-tracked files stay tracked.
Specs/TestRuns/*
!Specs/TestRuns/README.md

# Theme Gallery workbench (see Specs/Mockups/ThemeGalleryWorkbench/.gitignore)
node_modules/

# Local ETW captures from the root helper scripts
/RedSalamanderTrace.csv
/RedSalamanderTrace.etl
/RedSalamanderTrace.txt

# Stray copies of built binaries / dumps at known paths
/RedSalamanderMonitor.exe
/RedSalamander/payload.json

# Editor/agent local state
.claude/settings.local.json
.omc
.gitnexus

# Editor/OS junk
~$*
*~
*.tmp
