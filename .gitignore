# Common block: the same lines in every RedSalamanders repository (RedHome convergence D-03).
# Generated output, Visual Studio state, the shared CI engine checkout and the changelog fold lease.
.build/
.vs/
*.user
*.suo
*.VC.db
*.VC.opendb
*.VC.VC.opendb
/.ci-engine/
/.changelog-fold.lock
/.changelog-*.tmp
# Personal harness state: each person's local agent settings and locks (RedHome convergence A-17).
.claude/settings.local.json
.claude/scheduled_tasks.lock
# End of the common block.

# Visual Studio user/cache files
*.rsuser
*.userosscache
*.sln.docstates
ipch/
*.aps
*.binlog

/x64/**/*
x64/

*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.ilk
*.exp
*.sbr

# Historical installer outputs and private local signing credentials
AppPackages/
BundleArtifacts/
Package.StoreAssociation.xml
_pkginfo.txt
*.appx
*.appxbundle
*.appxupload
*.pfx

# vcpkg (canonical install is under .build\; this also covers in-tree mistakes)
**/vcpkg_installed/

# Logs (see Specs/TestRuns/README.md and Specs/Testing/Testing_ValidationEvidence.md)
*.log

# Generated test-run archives. Curated evidence is force-added.
# Do not add per-run exception lists; already-tracked files stay tracked.
Specs/TestRuns/*
!Specs/TestRuns/README.md

# Theme Gallery workbench (see Specs/Mockups/ThemeGalleryWorkbench/.gitignore)
node_modules/

# Local ETW captures from the root helper scripts
/RedSalamanderTrace.csv
/RedSalamanderTrace.etl
/RedSalamanderTrace.txt

# Stray copies of built binaries / dumps at known paths
/RedSalamanderMonitor.exe
/RedSalamander/payload.json

# Editor and agent local state
.omc
.gitnexus

# Editor/OS junk
~$*
*~
*.tmp
