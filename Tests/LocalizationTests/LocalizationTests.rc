#include "resource.h"
#include <winres.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDR_LOCALIZATION_TEST_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Open", 1
    END
END

IDD_LOCALIZATION_TEST_DIALOG DIALOGEX 0, 0, 140, 48
STYLE DS_SETFONT | WS_CAPTION | WS_SYSMENU
CAPTION "Embedded Dialog"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Embedded content", IDC_STATIC, 8, 8, 100, 10
    CONTROL "", IDC_LOCALIZATION_TEST_CUSTOM, "LocalizationTestCustomControl", WS_CHILD | WS_VISIBLE, 8, 22, 68, 10
    DEFPUSHBUTTON "OK", IDOK, 84, 27, 50, 14
END

STRINGTABLE
BEGIN
    IDS_LOCALIZATION_TEST_PRESENT "Embedded English test string"
    IDS_LOCALIZATION_TEST_EMBEDDED_ONLY "Embedded only fallback string"
END
