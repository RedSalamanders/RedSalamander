		            END
		            MENUITEM SEPARATOR
		            MENUITEM "&Hide overlay [dbg]",               IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_HIDE
		        END
#endif
		    END
		END
	
