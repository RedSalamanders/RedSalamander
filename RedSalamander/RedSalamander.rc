IDD_PREFERENCES DIALOGEX 0, 0, 500, 340
STYLE DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_CLIPCHILDREN | DS_SHELLFONT
CAPTION "Preferences"
FONT 9, "Segoe UI"
BEGIN
    CONTROL         "",IDC_PREFS_CATEGORY_LIST,"Static",WS_CHILD | WS_VISIBLE | WS_TABSTOP | SS_NOTIFY,8,8,120,308
    CONTROL         "",IDC_PREFS_PAGE_HOST,"RedSalamanderPrefsPageHost",WS_CHILD | WS_VISIBLE | WS_TABSTOP,136,8,356,308
    DEFPUSHBUTTON   "OK",IDOK,318,324,54,14
    PUSHBUTTON      "Cancel",IDCANCEL,376,324,54,14
    PUSHBUTTON      "Apply",IDC_PREFS_APPLY,434,324,54,14
END

// IDD_CONNECTION_MANAGER deleted (Phase 12). The Connection Manager runs as a
// single-canvas DxUi top-level window (`ConnectionManagerWindow.{h,cpp}`); see
// `Specs/Plans/Done/UI_ConnectionManagerSingleCanvasPlan.md`. The
// `IDC_CONNECTION_*` ids that survive in `resource.h` (`IDC_CONNECTION_NEW`,
// `IDC_CONNECTION_RENAME`, `IDC_CONNECTION_REMOVE`, `IDC_CONNECTION_CLOSE`)
// are kept because the new `WindowImpl::DebugGetCommandButton` switch maps
// them to logical command buttons in the test surface.

IDD_CONNECTION_CRED_PROMPT DIALOGEX 0, 0, 300, 150
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SHELLFONT
CAPTION ""
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "",IDC_CONNECTION_CRED_PROMPT_MESSAGE,10,10,280,24,SS_NOPREFIX
    LTEXT           "",IDC_CONNECTION_CRED_PROMPT_USER_LABEL,10,40,280,10
    EDITTEXT        IDC_CONNECTION_CRED_PROMPT_USER_EDIT,10,52,280,16,ES_AUTOHSCROLL
    LTEXT           "",IDC_CONNECTION_CRED_PROMPT_SECRET_LABEL,10,74,280,10
    EDITTEXT        IDC_CONNECTION_CRED_PROMPT_SECRET_EDIT,10,86,236,16,ES_AUTOHSCROLL | ES_PASSWORD
    PUSHBUTTON      "",IDC_CONNECTION_CRED_PROMPT_SHOW_SECRET,250,86,40,16
    LTEXT           "",IDC_CONNECTION_CRED_PROMPT_VALIDATION,10,106,280,22,SS_NOPREFIX
    DEFPUSHBUTTON   "",IDOK,190,132,48,14
    PUSHBUTTON      "",IDCANCEL,242,132,48,14
END

IDD_COMPARE_DIRECTORIES_OPTIONS DIALOGEX 0, 0, 360, 276
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,198,255,48,14
    PUSHBUTTON      "Cancel",IDCANCEL,250,255,50,14
END

IDD_SHARED_DIRECTORIES DIALOGEX 0, 0, 520, 240
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | DS_SHELLFONT
CAPTION "Shared Directories"
FONT 9, "Segoe UI"
BEGIN
    CONTROL         "",IDC_SHARED_DIRECTORIES_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP,8,8,504,190
    LTEXT           "No shared directories are available.",IDC_SHARED_DIRECTORIES_EMPTY,14,18,492,24
    PUSHBUTTON      "Open Path",IDC_SHARED_DIRECTORIES_OPEN,266,218,70,14
    PUSHBUTTON      "Manage...",IDC_SHARED_DIRECTORIES_MANAGE,342,218,70,14
    DEFPUSHBUTTON   "Close",IDCANCEL,420,218,92,14
END


