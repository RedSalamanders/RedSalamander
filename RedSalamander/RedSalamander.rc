            MENUITEM "&Time",              IDM_RIGHT_SORT_TIME,MFT_STRING,MFS_ENABLED
            MENUITEM "&Size",              IDM_RIGHT_SORT_SIZE,MFT_STRING,MFS_ENABLED
            MENUITEM "&Attributes",                 IDM_RIGHT_SORT_ATTRIBUTES,MFT_STRING,MFS_ENABLED
        END
        POPUP "&Show",                       65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Hidden Files",        IDM_RIGHT_SHOW_HIDDEN_FILES,MFT_STRING,MFS_ENABLED
            MENUITEM "&System Files",        IDM_RIGHT_SHOW_SYSTEM_FILES,MFT_STRING,MFS_ENABLED
            MENUITEM "File E&xtensions",     IDM_RIGHT_SHOW_FILE_EXTENSIONS,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "Filter &Bar",          IDM_RIGHT_FILTER_BAR,MFT_STRING,MFS_ENABLED
            MENUITEM "&Navigation Bar",      IDM_RIGHT_NAVIGATION_BAR,MFT_STRING,MFS_ENABLED
            MENUITEM "&Status Bar",          IDM_RIGHT_STATUSBAR,MFT_STRING,MFS_ENABLED
        END
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Maximize/Restore Pane", IDM_RIGHT_ZOOM_PANEL,MFT_STRING,MFS_ENABLED
        MENUITEM "&Swap Panes",              IDM_APP_SWAP_PANES,MFT_STRING,MFS_ENABLED
        MENUITEM "Path from &Other Panel",   IDM_RIGHT_GO_TO_PATH_FROM_OTHER_PANE,MFT_STRING,MFS_ENABLED
        MENUITEM "Re&fresh",                IDM_RIGHT_REFRESH,MFT_STRING,MFS_ENABLED
        MENUITEM "&Filter...",             IDM_RIGHT_FILTER,MFT_STRING,MFS_ENABLED
#if defined(_DEBUG) || defined(DEBUG)
	        MENUITEM MFT_SEPARATOR
	        POPUP "Overlay &Sample [dbg]",          65535,MFT_STRING,MFS_ENABLED
	        BEGIN
	            POPUP "&Modal (blocks input) [dbg]",          65535,MFT_STRING,MFS_ENABLED
	            BEGIN
	                MENUITEM "&Error [dbg]",                      IDM_RIGHT_OVERLAY_SAMPLE_ERROR,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Warning [dbg]",                    IDM_RIGHT_OVERLAY_SAMPLE_WARNING,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Information [dbg]",                IDM_RIGHT_OVERLAY_SAMPLE_INFORMATION,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Please wait [dbg]",                IDM_RIGHT_OVERLAY_SAMPLE_BUSY,MFT_STRING,MFS_ENABLED
	                MENUITEM "Please wait (with &Cancel) [dbg]",  IDM_RIGHT_OVERLAY_SAMPLE_BUSY_WITH_CANCEL,MFT_STRING,MFS_ENABLED
	            END
	            POPUP "&Non-modal (doesn't block) [dbg]",      65535,MFT_STRING,MFS_ENABLED
	            BEGIN
	                MENUITEM "&Error [dbg]",                      IDM_RIGHT_OVERLAY_SAMPLE_ERROR_NONMODAL,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Warning [dbg]",                    IDM_RIGHT_OVERLAY_SAMPLE_WARNING_NONMODAL,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Information [dbg]",                IDM_RIGHT_OVERLAY_SAMPLE_INFORMATION_NONMODAL,MFT_STRING,MFS_ENABLED
	                MENUITEM "Loading &canceled (no close) [dbg]", IDM_RIGHT_OVERLAY_SAMPLE_CANCELED,MFT_STRING,MFS_ENABLED
	            END
	            MENUITEM MFT_SEPARATOR
	            MENUITEM "&Hide overlay [dbg]",               IDM_RIGHT_OVERLAY_SAMPLE_HIDE,MFT_STRING,MFS_ENABLED
	        END
#endif
	    END
	    POPUP "&Help",                          65535,MFT_STRING | MFT_RIGHTJUSTIFY,MFS_ENABLED
    BEGIN
        MENUITEM "Display &Shortcuts...", IDM_APP_SHOW_SHORTCUTS,MFT_STRING,MFS_ENABLED
        MENUITEM "External &Help",        IDM_APP_EXTERNAL_HELP,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "&About ...",                  IDM_ABOUT,MFT_STRING,MFS_ENABLED
    END
END

IDR_COMPARE_DIRECTORIES_MENU MENU
BEGIN
    POPUP "&Compare"
    BEGIN
        MENUITEM "&Options...",              IDM_COMPARE_OPTIONS
        MENUITEM "&Rescan",                 IDM_COMPARE_RESCAN
        MENUITEM SEPARATOR
        MENUITEM "Show &Identical Items",   IDM_COMPARE_TOGGLE_IDENTICAL
        MENUITEM SEPARATOR
        MENUITEM "&Restore Differences Selection", IDM_COMPARE_RESTORE_DIFFERENCES_SELECTION
        MENUITEM "&Invert Differences Selection",  IDM_COMPARE_INVERT_DIFFERENCES_SELECTION
        MENUITEM SEPARATOR
        MENUITEM "&Close",                  IDM_COMPARE_CLOSE
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Brief\tAlt+2",           IDM_PANE_DISPLAY_BRIEF
        MENUITEM "&Detailed\tAlt+3",        IDM_PANE_DISPLAY_DETAILED
        MENUITEM "E&xtra Detailed\tAlt+4",  IDM_PANE_DISPLAY_EXTRA_DETAILED
    END
END


