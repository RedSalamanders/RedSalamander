IDR_FOLDERVIEW_CONTEXT MENU
BEGIN
	    POPUP ""
		    BEGIN
		        MENUITEM "&Open",                       IDM_FOLDERVIEW_CONTEXT_OPEN
		        MENUITEM "Open &With...",               IDM_FOLDERVIEW_CONTEXT_OPEN_WITH
		        MENUITEM "View &Space",                 IDM_FOLDERVIEW_CONTEXT_VIEW_SPACE
		        MENUITEM SEPARATOR
		        MENUITEM "&Delete",                     IDM_FOLDERVIEW_CONTEXT_DELETE
		        MENUITEM "&Move...",                    IDM_FOLDERVIEW_CONTEXT_MOVE
		        MENUITEM "Re&name",                     IDM_FOLDERVIEW_CONTEXT_RENAME
	        MENUITEM SEPARATOR
	        MENUITEM "&Copy",                       IDM_FOLDERVIEW_CONTEXT_COPY
		        MENUITEM "&Paste",                      IDM_FOLDERVIEW_CONTEXT_PASTE
		        MENUITEM SEPARATOR
		        MENUITEM "&Properties",                 IDM_FOLDERVIEW_CONTEXT_PROPERTIES
#if defined(_DEBUG) || defined(DEBUG)
		        MENUITEM SEPARATOR
		        POPUP "Overlay &Sample [dbg]"
		        BEGIN
		            POPUP "&Modal (blocks input) [dbg]"
		            BEGIN
		                MENUITEM "&Error [dbg]",                      IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_ERROR
		                MENUITEM "&Warning [dbg]",                    IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_WARNING
		                MENUITEM "&Information [dbg]",                IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_INFORMATION
		                MENUITEM "&Please wait [dbg]",                IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_BUSY
