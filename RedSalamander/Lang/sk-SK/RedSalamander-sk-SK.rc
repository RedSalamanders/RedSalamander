#include "../../Resource.h"
#include <winres.h>

LANGUAGE LANG_SLOVAK, SUBLANG_DEFAULT

IDR_FOLDERVIEW_CONTEXT MENU
BEGIN
	    POPUP ""
		    BEGIN
		        MENUITEM "&Otvoriť",                       IDM_FOLDERVIEW_CONTEXT_OPEN
		        MENUITEM "&Otvoriť pomocou...",               IDM_FOLDERVIEW_CONTEXT_OPEN_WITH
		        MENUITEM "&Zobraziť priestor",                 IDM_FOLDERVIEW_CONTEXT_VIEW_SPACE
		        MENUITEM SEPARATOR
		        MENUITEM "&Odstrániť",                     IDM_FOLDERVIEW_CONTEXT_DELETE
		        MENUITEM "&Presunúť...",                    IDM_FOLDERVIEW_CONTEXT_MOVE
		        MENUITEM "&Premenovať",                     IDM_FOLDERVIEW_CONTEXT_RENAME
	        MENUITEM SEPARATOR
	        MENUITEM "&Kopírovať",                       IDM_FOLDERVIEW_CONTEXT_COPY
		        MENUITEM "&Prilepiť",                      IDM_FOLDERVIEW_CONTEXT_PASTE
		        MENUITEM SEPARATOR
		        MENUITEM "&Vlastnosti",                 IDM_FOLDERVIEW_CONTEXT_PROPERTIES
#if defined(_DEBUG) || defined(DEBUG)
		        MENUITEM SEPARATOR
		        POPUP "&Ukážka prekrytia [dbg]"
		        BEGIN
		            POPUP "&Modálne (blokuje vstup) [dbg]"
		            BEGIN
		                MENUITEM "&Chyba [dbg]",                      IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_ERROR
		                MENUITEM "&Upozornenie [dbg]",                    IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_WARNING
		                MENUITEM "&Informácie [dbg]",                IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_INFORMATION
		                MENUITEM "&Čakajte prosím [dbg]",                IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_BUSY
		                MENUITEM "&Čakajte prosím (so zrušením) [dbg]",  IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_BUSY_WITH_CANCEL
		            END
		            POPUP "&Nemodálne (neblokuje) [dbg]"
		            BEGIN
		                MENUITEM "&Chyba [dbg]",                      IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_ERROR_NONMODAL
		                MENUITEM "&Upozornenie [dbg]",                    IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_WARNING_NONMODAL
		                MENUITEM "&Informácie [dbg]",                IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_INFORMATION_NONMODAL
		                MENUITEM "&Načítanie bolo zrušené (bez zatvorenia) [dbg]", IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_CANCELED
		            END
		            MENUITEM SEPARATOR
		            MENUITEM "&Skryť prekrytie [dbg]",               IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_HIDE
		        END
#endif
		    END
		END

	IDC_REDSALAMANDER MENUEX
BEGIN
    POPUP "&Vľavo",                          65535,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "&Zmeniť Disk",        IDM_LEFT_CHANGE_DRIVE,MFT_STRING,MFS_ENABLED
        POPUP "&Prejsť na",                         65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Späť",                   IDM_LEFT_GO_TO_BACK,MFT_STRING,MFS_ENABLED
            MENUITEM "&Vpred",                IDM_LEFT_GO_TO_FORWARD,MFT_STRING,MFS_ENABLED
            MENUITEM "&Nadradený adresár", IDM_LEFT_GO_TO_PARENT_DIRECTORY,MFT_STRING,MFS_ENABLED
            MENUITEM "&Koreňový adresár",                    IDM_LEFT_GO_TO_ROOT_DIRECTORY,MFT_STRING,MFS_ENABLED
            MENUITEM "&Cesta z iného panelu",       IDM_LEFT_GO_TO_PATH_FROM_OTHER_PANE,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "&Horúce cesty...",      IDM_LEFT_HOT_PATHS,MFT_STRING,MFS_ENABLED
            MENUITEM "(prázdne)",                      0,MFT_STRING,MFS_GRAYED
            MENUITEM MFT_SEPARATOR
            MENUITEM "(prázdne)",                      0,MFT_STRING,MFS_GRAYED
        END
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Stručný",               IDM_LEFT_DISPLAY_BRIEF,MFT_STRING,MFS_ENABLED
        MENUITEM "&Podrobné",            IDM_LEFT_DISPLAY_DETAILED,MFT_STRING,MFS_ENABLED
        MENUITEM "&Extra podrobné",      IDM_LEFT_DISPLAY_EXTRA_DETAILED,MFT_STRING,MFS_ENABLED
        MENUITEM "&Miniatúry",          IDM_LEFT_DISPLAY_THUMBNAILS,MFT_STRING,MFS_ENABLED
        MENUITEM "&Panel ukážky",      IDM_LEFT_PREVIEW_PANE,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        POPUP "&Zoradiť podľa",                       65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Žiadny",              IDM_LEFT_SORT_NONE,MFT_STRING,MFS_ENABLED
            MENUITEM "&Meno",              IDM_LEFT_SORT_NAME,MFT_STRING,MFS_ENABLED
            MENUITEM "&Rozšírenie",         IDM_LEFT_SORT_EXTENSION,MFT_STRING,MFS_ENABLED
            MENUITEM "&Čas",              IDM_LEFT_SORT_TIME,MFT_STRING,MFS_ENABLED
            MENUITEM "&Veľkosť",              IDM_LEFT_SORT_SIZE,MFT_STRING,MFS_ENABLED
            MENUITEM "&Atribúty",                 IDM_LEFT_SORT_ATTRIBUTES,MFT_STRING,MFS_ENABLED
        END
        POPUP "&Zobraziť",                       65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Skryté súbory",        IDM_LEFT_SHOW_HIDDEN_FILES,MFT_STRING,MFS_ENABLED
            MENUITEM "&Systémové súbory",        IDM_LEFT_SHOW_SYSTEM_FILES,MFT_STRING,MFS_ENABLED
            MENUITEM "&Prípony súborov",   IDM_LEFT_SHOW_FILE_EXTENSIONS,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "&Panel filtra",         IDM_LEFT_FILTER_BAR,MFT_STRING,MFS_ENABLED
            MENUITEM "&Navigačný panel",     IDM_LEFT_NAVIGATION_BAR,MFT_STRING,MFS_ENABLED
            MENUITEM "&Stavový riadok",            IDM_LEFT_STATUSBAR,MFT_STRING,MFS_ENABLED
        END
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Tabla maximalizovať/obnoviť", IDM_LEFT_ZOOM_PANEL,MFT_STRING,MFS_ENABLED
        MENUITEM "&Vymeňte tabule",              IDM_APP_SWAP_PANES,MFT_STRING,MFS_ENABLED
        MENUITEM "&Cesta z iného panelu",       IDM_LEFT_GO_TO_PATH_FROM_OTHER_PANE,MFT_STRING,MFS_ENABLED
        MENUITEM "&Obnoviť",                IDM_LEFT_REFRESH,MFT_STRING,MFS_ENABLED
        MENUITEM "&Filtrovať...",             IDM_LEFT_FILTER,MFT_STRING,MFS_ENABLED
#if defined(_DEBUG) || defined(DEBUG)
	        MENUITEM MFT_SEPARATOR
	        POPUP "&Ukážka prekrytia [dbg]",          65535,MFT_STRING,MFS_ENABLED
		        BEGIN
		            POPUP "&Modálne (blokuje vstup) [dbg]",          65535,MFT_STRING,MFS_ENABLED
		            BEGIN
		                MENUITEM "&Chyba [dbg]",                      IDM_LEFT_OVERLAY_SAMPLE_ERROR,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Upozornenie [dbg]",                    IDM_LEFT_OVERLAY_SAMPLE_WARNING,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Informácie [dbg]",                IDM_LEFT_OVERLAY_SAMPLE_INFORMATION,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Čakajte prosím [dbg]",                IDM_LEFT_OVERLAY_SAMPLE_BUSY,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Čakajte prosím (so zrušením) [dbg]",  IDM_LEFT_OVERLAY_SAMPLE_BUSY_WITH_CANCEL,MFT_STRING,MFS_ENABLED
	            END
	            POPUP "&Nemodálne (neblokuje) [dbg]",      65535,MFT_STRING,MFS_ENABLED
	            BEGIN
	                MENUITEM "&Chyba [dbg]",                      IDM_LEFT_OVERLAY_SAMPLE_ERROR_NONMODAL,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Upozornenie [dbg]",                    IDM_LEFT_OVERLAY_SAMPLE_WARNING_NONMODAL,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Informácie [dbg]",                IDM_LEFT_OVERLAY_SAMPLE_INFORMATION_NONMODAL,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Načítanie bolo zrušené (bez zatvorenia) [dbg]", IDM_LEFT_OVERLAY_SAMPLE_CANCELED,MFT_STRING,MFS_ENABLED
	            END
		            MENUITEM MFT_SEPARATOR
		            MENUITEM "&Skryť prekrytie [dbg]",               IDM_LEFT_OVERLAY_SAMPLE_HIDE,MFT_STRING,MFS_ENABLED
		        END
#endif
	    END
    POPUP "&Súbory",                         65535,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "&Premenovať...",               IDM_PANE_RENAME,MFT_STRING,MFS_ENABLED
        MENUITEM "&Otvoriť / Spustiť",       IDM_PANE_EXECUTE_OPEN,MFT_STRING,MFS_ENABLED
        MENUITEM "&Zobrazenie",                    IDM_PANE_VIEW,MFT_STRING,MFS_ENABLED
        MENUITEM "&Zobraziť šírku...", IDM_APP_VIEW_WIDTH,MFT_STRING,MFS_ENABLED
        MENUITEM "&Alternatívny pohľad",      IDM_PANE_ALTERNATE_VIEW,MFT_STRING,MFS_ENABLED
        POPUP "&Zobraziť s",                      65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "(prázdne)",                      0,MFT_STRING,MFS_GRAYED
        END
        MENUITEM "&Úpravy",                    IDM_PANE_EDIT,MFT_STRING,MFS_ENABLED
        MENUITEM "&Alternatívna úprava", IDM_PANE_ALTERNATE_EDIT,MFT_STRING,MFS_ENABLED
        POPUP "&Upraviť pomocou",                      65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "(prázdne)",                      0,MFT_STRING,MFS_GRAYED
        END
        MENUITEM "&Upraviť nový súbor...",   IDM_PANE_EDIT_NEW,MFT_STRING,MFS_ENABLED
        MENUITEM "&Kopírovať...",                  IDM_PANE_COPY_TO_OTHER,MFT_STRING,MFS_ENABLED
        MENUITEM "&Presunúť/premenovať...",           IDM_PANE_MOVE_TO_OTHER,MFT_STRING,MFS_ENABLED
        POPUP "&Odstrániť",                         65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Odstrániť",                   IDM_PANE_DELETE,MFT_STRING,MFS_ENABLED
            MENUITEM "&Presuňte sa do koša",     IDM_PANE_MOVE_TO_RECYCLE_BIN,MFT_STRING,MFS_ENABLED
        END
        MENUITEM "&Trvalé odstránenie",   IDM_PANE_PERMANENT_DELETE,MFT_STRING,MFS_ENABLED
        MENUITEM "&Vlastnosti",        IDM_PANE_OPEN_PROPERTIES,MFT_STRING,MFS_ENABLED
        MENUITEM "&Kontextové menu",      IDM_PANE_CONTEXT_MENU,MFT_STRING,MFS_ENABLED
        MENUITEM "&Kontextová ponuka (aktuálny adresár)", IDM_PANE_CONTEXT_MENU_CURRENT_DIRECTORY,MFT_STRING,MFS_ENABLED
        MENUITEM "&Bezpečnosť...",                       IDM_PANE_OPEN_SECURITY,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Zmeniť atribúty...", IDM_PANE_CHANGE_ATTRIBUTES,MFT_STRING,MFS_ENABLED
        MENUITEM "&Zmeniť prípad...",      IDM_PANE_CHANGE_CASE,MFT_STRING,MFS_ENABLED
        MENUITEM "&Zbaliť...",                     IDM_PANE_PACK,MFT_STRING,MFS_ENABLED
        MENUITEM "&Rozbaliť...",                   IDM_PANE_UNPACK,MFT_STRING,MFS_ENABLED
        POPUP "&Nové",                            65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Priečinok...",                IDM_PANE_CREATE_DIR,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "(prázdne)",                      0,MFT_STRING,MFS_GRAYED
        END
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Koniec",                IDM_EXIT,MFT_STRING,MFS_ENABLED
    END
    POPUP "&Úpravy",                          65535,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "&Vystrihnúť",                                IDM_PANE_CLIPBOARD_CUT,MFT_STRING,MFS_ENABLED
        MENUITEM "&Kopírovať",           IDM_PANE_CLIPBOARD_COPY,MFT_STRING,MFS_ENABLED
        MENUITEM "&Prilepiť",         IDM_PANE_CLIPBOARD_PASTE,MFT_STRING,MFS_ENABLED
        MENUITEM "Prilepiť skratku",                      IDM_PANE_CLIPBOARD_PASTE_SHORTCUT,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "Skopírujte cestu + názov ako text", IDM_PANE_COPY_PATH_AND_NAME_AS_TEXT,MFT_STRING,MFS_ENABLED
        MENUITEM "Skopírovať meno ako text",  IDM_PANE_COPY_NAME_AS_TEXT,MFT_STRING,MFS_ENABLED
        MENUITEM "Kopírovať cestu ako text",   IDM_PANE_COPY_PATH_AS_TEXT,MFT_STRING,MFS_ENABLED
        MENUITEM "Skopírujte cestu UNC + názov ako text", IDM_PANE_COPY_PATH_AND_FILE_NAME,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Vybrať...",                           IDM_PANE_SELECTION_SELECT_DIALOG,MFT_STRING,MFS_ENABLED
        MENUITEM "&Zrušiť výber...",                         IDM_PANE_SELECTION_UNSELECT_DIALOG,MFT_STRING,MFS_ENABLED
        MENUITEM "&Invertovať výber",                    IDM_PANE_SELECTION_INVERT,MFT_STRING,MFS_ENABLED
        MENUITEM "&Vyberte možnosť Všetky",                          IDM_PANE_SELECTION_SELECT_ALL,MFT_STRING,MFS_ENABLED
        MENUITEM "&Zrušte výber všetkých",                        IDM_PANE_SELECTION_UNSELECT_ALL,MFT_STRING,MFS_ENABLED
        MENUITEM "&Obnoviť výber",                   IDM_PANE_SELECTION_RESTORE,MFT_STRING,MFS_ENABLED
        MENUITEM "&Vyberte položku Ďalej",          IDM_PANE_SELECT_NEXT,MFT_STRING,MFS_ENABLED
        MENUITEM "Vyberte + Vypočítať veľkosť adresára + Ďalej", IDM_PANE_SELECT_CALC_DIR_SIZE_NEXT,MFT_STRING,MFS_ENABLED
        POPUP "&Pokročilé",                       65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Uložiť výber", IDM_PANE_SAVE_SELECTION,MFT_STRING,MFS_ENABLED
            MENUITEM "&Načítať výber...", IDM_PANE_SELECTION_RESTORE,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "&Vyberte možnosť Rovnaké rozšírenia",       IDM_PANE_SELECTION_SELECT_SAME_EXTENSION,MFT_STRING,MFS_ENABLED
            MENUITEM "Zrušte výber rovnakých rozšírení",      IDM_PANE_SELECTION_UNSELECT_SAME_EXTENSION,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "&Vyberte možnosť Rovnaké mená",                   IDM_PANE_SELECTION_SELECT_SAME_NAME,MFT_STRING,MFS_ENABLED
            MENUITEM "Zrušte výber rovnakých mien",                  IDM_PANE_SELECTION_UNSELECT_SAME_NAME,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "&Skryť vybrané mená",          IDM_PANE_SELECTION_HIDE_SELECTED_NAMES,MFT_STRING,MFS_ENABLED
            MENUITEM "Skryť nevybrané mená",         IDM_PANE_SELECTION_HIDE_UNSELECTED_NAMES,MFT_STRING,MFS_ENABLED
            MENUITEM "Zobraziť skryté mená",             IDM_PANE_SELECTION_SHOW_HIDDEN_NAMES,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "Prejdite na predchádzajúci vybraný názov",         IDM_PANE_SELECTION_GOTO_PREV_SELECTED_NAME,MFT_STRING,MFS_ENABLED
            MENUITEM "Prejdite na ďalšie vybraté meno",             IDM_PANE_SELECTION_GOTO_NEXT_SELECTED_NAME,MFT_STRING,MFS_ENABLED
        END
    END
    POPUP "&Príkazy",                      65535,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "&Vytvoriť adresár...", IDM_PANE_CREATE_DIR,MFT_STRING,MFS_ENABLED
        MENUITEM "&Zmeniť adresár...", IDM_PANE_CHANGE_DIRECTORY,MFT_STRING,MFS_ENABLED
	        MENUITEM "&Porovnať adresáre...", IDM_APP_COMPARE,MFT_STRING,MFS_ENABLED
	        MENUITEM "&Vypočítajte obsadené miesto", IDM_PANE_VIEW_SPACE,MFT_STRING,MFS_ENABLED
	        MENUITEM "&Nájsť súbory a adresáre...", IDM_PANE_FIND,MFT_STRING,MFS_ENABLED
	        MENUITEM "&Vytvoriť zoznam súborov...", IDM_PANE_MAKE_FILE_LIST,MFT_STRING,MFS_ENABLED
	        MENUITEM "&Prejdite na položku Skratka alebo Cieľ odkazu", IDM_PANE_GO_TO_SHORTCUT_OR_LINK_TARGET,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Zoznam otvorených súborov", IDM_PANE_LIST_OPENED_FILES,MFT_STRING,MFS_ENABLED
        MENUITEM "&Zobraziť históriu priečinkov", IDM_PANE_SHOW_FOLDERS_HISTORY,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Pripojiť sieťový disk...", IDM_PANE_CONNECT,MFT_STRING,MFS_ENABLED
        MENUITEM "&Odpojiť...", IDM_PANE_DISCONNECT,MFT_STRING,MFS_ENABLED
        MENUITEM "&Zdieľané adresáre...", IDM_PANE_SHARES,MFT_STRING,MFS_ENABLED
        MENUITEM "&Správca pripojení...", IDM_PANE_CONNECTION_MANAGER,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Command Shell", IDM_PANE_OPEN_COMMAND_SHELL,MFT_STRING,MFS_ENABLED
        MENUITEM "&Rýchle vyhľadávanie", IDM_PANE_QUICK_SEARCH,MFT_STRING,MFS_ENABLED
        MENUITEM "Preneste aktuálny adresár do príkazového riadka", IDM_PANE_BRING_CURRENT_DIR_TO_COMMAND_LINE,MFT_STRING,MFS_ENABLED
        MENUITEM "Preneste názov súboru na príkazový riadok", IDM_PANE_BRING_FILENAME_TO_COMMAND_LINE,MFT_STRING,MFS_ENABLED
        MENUITEM "&Ponuka panela", IDM_PANE_MENU,MFT_STRING,MFS_ENABLED
        MENUITEM "&Znovu si prečítajte asociácie", IDM_APP_REREAD_ASSOCIATIONS,MFT_STRING,MFS_ENABLED
        POPUP "&Používateľské menu",                          65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "(prázdne)",                     0,MFT_STRING,MFS_GRAYED
        END
        POPUP "&Otvorte Prieskumník súborov",               65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Aktuálny priečinok", IDM_PANE_OPEN_CURRENT_FOLDER,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "Pracovná plocha",                  IDM_APP_OPEN_FILE_EXPLORER_DESKTOP,MFT_STRING,MFS_ENABLED
            MENUITEM "dokumenty",                IDM_APP_OPEN_FILE_EXPLORER_DOCUMENTS,MFT_STRING,MFS_ENABLED
            MENUITEM "sťahovanie",                IDM_APP_OPEN_FILE_EXPLORER_DOWNLOADS,MFT_STRING,MFS_ENABLED
            MENUITEM "Obrázky",                 IDM_APP_OPEN_FILE_EXPLORER_PICTURES,MFT_STRING,MFS_ENABLED
            MENUITEM "Hudba",                    IDM_APP_OPEN_FILE_EXPLORER_MUSIC,MFT_STRING,MFS_ENABLED
            MENUITEM "Videá",                   IDM_APP_OPEN_FILE_EXPLORER_VIDEOS,MFT_STRING,MFS_ENABLED
            MENUITEM "OneDrive",                 IDM_APP_OPEN_FILE_EXPLORER_ONEDRIVE,MFT_STRING,MFS_ENABLED
        END
    END
    POPUP "&Pluginy",                       65535,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "&Správca doplnkov...",           IDM_VIEW_PLUGINS_MANAGE,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "(prázdne)",                     0,MFT_STRING,MFS_GRAYED
    END
    POPUP "&Zobrazenie",                          65535,MFT_STRING,MFS_ENABLED
    BEGIN
        POPUP "&Téma",                         65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Vysoký kontrast (systém)",     IDM_VIEW_THEME_HIGH_CONTRAST,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "&Systém",                     IDM_VIEW_THEME_SYSTEM,MFT_STRING,MFS_ENABLED
            MENUITEM "&Svetlý",                      IDM_VIEW_THEME_LIGHT,MFT_STRING,MFS_ENABLED
            MENUITEM "&Tmavý",                       IDM_VIEW_THEME_DARK,MFT_STRING,MFS_ENABLED
            MENUITEM "&Dúha",                    IDM_VIEW_THEME_RAINBOW,MFT_STRING,MFS_ENABLED
            MENUITEM "&Vysoký kontrast (aplikácia)",        IDM_VIEW_THEME_HIGH_CONTRAST_APP,MFT_STRING,MFS_ENABLED
