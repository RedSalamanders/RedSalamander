        MENUITEM "&Ponuka okna",            IDM_VIEW_WINDOW_MENU,MFT_STRING,MFS_ENABLED
        MENUITEM "&Prepnúť zameranie tably",            IDM_VIEW_SWITCH_PANE_FOCUS,MFT_STRING,MFS_ENABLED
        MENUITEM "&Súborové operácie zlyhali", IDM_VIEW_FILEOPS_FAILED_ITEMS,MFT_STRING,MFS_ENABLED
        MENUITEM "&Panel funkcií",                IDM_VIEW_FUNCTIONBAR,MFT_STRING,MFS_ENABLED
        MENUITEM "&Panel s ponukami",                    IDM_VIEW_MENUBAR,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Predvoľby...",              IDM_FILE_PREFERENCES,MFT_STRING,MFS_ENABLED
