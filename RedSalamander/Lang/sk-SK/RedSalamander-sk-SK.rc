    POPUP "&Správne",                         65535,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "&Zmeniť Disk",        IDM_RIGHT_CHANGE_DRIVE,MFT_STRING,MFS_ENABLED
        POPUP "&Prejsť na",                         65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Späť",                   IDM_RIGHT_GO_TO_BACK,MFT_STRING,MFS_ENABLED
            MENUITEM "&Vpred",                IDM_RIGHT_GO_TO_FORWARD,MFT_STRING,MFS_ENABLED
            MENUITEM "&Nadradený adresár", IDM_RIGHT_GO_TO_PARENT_DIRECTORY,MFT_STRING,MFS_ENABLED
            MENUITEM "&Koreňový adresár",                    IDM_RIGHT_GO_TO_ROOT_DIRECTORY,MFT_STRING,MFS_ENABLED
            MENUITEM "&Cesta z iného panelu",       IDM_RIGHT_GO_TO_PATH_FROM_OTHER_PANE,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "&Horúce cesty...",      IDM_RIGHT_HOT_PATHS,MFT_STRING,MFS_ENABLED
            MENUITEM "(prázdne)",                      0,MFT_STRING,MFS_GRAYED
            MENUITEM MFT_SEPARATOR
            MENUITEM "(prázdne)",                      0,MFT_STRING,MFS_GRAYED
        END
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Stručný",               IDM_RIGHT_DISPLAY_BRIEF,MFT_STRING,MFS_ENABLED
        MENUITEM "&Podrobné",            IDM_RIGHT_DISPLAY_DETAILED,MFT_STRING,MFS_ENABLED
        MENUITEM "&Extra podrobné",      IDM_RIGHT_DISPLAY_EXTRA_DETAILED,MFT_STRING,MFS_ENABLED
        MENUITEM "&Miniatúry",          IDM_RIGHT_DISPLAY_THUMBNAILS,MFT_STRING,MFS_ENABLED
        MENUITEM "&Panel ukážky",      IDM_RIGHT_PREVIEW_PANE,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        POPUP "&Zoradiť podľa",                       65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Žiadny",              IDM_RIGHT_SORT_NONE,MFT_STRING,MFS_ENABLED
            MENUITEM "&Meno",              IDM_RIGHT_SORT_NAME,MFT_STRING,MFS_ENABLED
            MENUITEM "&Rozšírenie",         IDM_RIGHT_SORT_EXTENSION,MFT_STRING,MFS_ENABLED
            MENUITEM "&Čas",              IDM_RIGHT_SORT_TIME,MFT_STRING,MFS_ENABLED
            MENUITEM "&Veľkosť",              IDM_RIGHT_SORT_SIZE,MFT_STRING,MFS_ENABLED
            MENUITEM "&Atribúty",                 IDM_RIGHT_SORT_ATTRIBUTES,MFT_STRING,MFS_ENABLED
        END
        POPUP "&Zobraziť",                       65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Skryté súbory",        IDM_RIGHT_SHOW_HIDDEN_FILES,MFT_STRING,MFS_ENABLED
            MENUITEM "&Systémové súbory",        IDM_RIGHT_SHOW_SYSTEM_FILES,MFT_STRING,MFS_ENABLED
            MENUITEM "&Prípony súborov",   IDM_RIGHT_SHOW_FILE_EXTENSIONS,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "&Panel filtra",         IDM_RIGHT_FILTER_BAR,MFT_STRING,MFS_ENABLED
            MENUITEM "&Navigačný panel",     IDM_RIGHT_NAVIGATION_BAR,MFT_STRING,MFS_ENABLED
            MENUITEM "&Stavový riadok",            IDM_RIGHT_STATUSBAR,MFT_STRING,MFS_ENABLED
        END
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Tabla maximalizovať/obnoviť", IDM_RIGHT_ZOOM_PANEL,MFT_STRING,MFS_ENABLED
        MENUITEM "&Vymeňte tabule",              IDM_APP_SWAP_PANES,MFT_STRING,MFS_ENABLED
        MENUITEM "&Cesta z iného panelu",       IDM_RIGHT_GO_TO_PATH_FROM_OTHER_PANE,MFT_STRING,MFS_ENABLED
        MENUITEM "&Obnoviť",                IDM_RIGHT_REFRESH,MFT_STRING,MFS_ENABLED
        MENUITEM "&Filtrovať...",             IDM_RIGHT_FILTER,MFT_STRING,MFS_ENABLED
#if defined(_DEBUG) || defined(DEBUG)
	        MENUITEM MFT_SEPARATOR
	        POPUP "&Ukážka prekrytia [dbg]",          65535,MFT_STRING,MFS_ENABLED
	        BEGIN
	            POPUP "&Modálne (blokuje vstup) [dbg]",          65535,MFT_STRING,MFS_ENABLED
	            BEGIN
	                MENUITEM "&Chyba [dbg]",                      IDM_RIGHT_OVERLAY_SAMPLE_ERROR,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Upozornenie [dbg]",                    IDM_RIGHT_OVERLAY_SAMPLE_WARNING,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Informácie [dbg]",                IDM_RIGHT_OVERLAY_SAMPLE_INFORMATION,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Čakajte prosím [dbg]",                IDM_RIGHT_OVERLAY_SAMPLE_BUSY,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Čakajte prosím (so zrušením) [dbg]",  IDM_RIGHT_OVERLAY_SAMPLE_BUSY_WITH_CANCEL,MFT_STRING,MFS_ENABLED
	            END
	            POPUP "&Nemodálne (neblokuje) [dbg]",      65535,MFT_STRING,MFS_ENABLED
	            BEGIN
	                MENUITEM "&Chyba [dbg]",                      IDM_RIGHT_OVERLAY_SAMPLE_ERROR_NONMODAL,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Upozornenie [dbg]",                    IDM_RIGHT_OVERLAY_SAMPLE_WARNING_NONMODAL,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Informácie [dbg]",                IDM_RIGHT_OVERLAY_SAMPLE_INFORMATION_NONMODAL,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Načítanie bolo zrušené (bez zatvorenia) [dbg]", IDM_RIGHT_OVERLAY_SAMPLE_CANCELED,MFT_STRING,MFS_ENABLED
	            END
	            MENUITEM MFT_SEPARATOR
	            MENUITEM "&Skryť prekrytie [dbg]",               IDM_RIGHT_OVERLAY_SAMPLE_HIDE,MFT_STRING,MFS_ENABLED
	        END
#endif
	    END
	    POPUP "&Pomocník",                          65535,MFT_STRING | MFT_RIGHTJUSTIFY,MFS_ENABLED
    BEGIN
        MENUITEM "&Zobraziť skratky...", IDM_APP_SHOW_SHORTCUTS,MFT_STRING,MFS_ENABLED
        MENUITEM "&Externá pomoc",        IDM_APP_EXTERNAL_HELP,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "&O...",                  IDM_ABOUT,MFT_STRING,MFS_ENABLED
    END
END

IDR_COMPARE_DIRECTORIES_MENU MENU
BEGIN
    POPUP "&Porovnaj"
    BEGIN
        MENUITEM "&Možnosti...",              IDM_COMPARE_OPTIONS
        MENUITEM "&Znova naskenovať",                 IDM_COMPARE_RESCAN
        MENUITEM SEPARATOR
        MENUITEM "&Zobraziť identické položky",   IDM_COMPARE_TOGGLE_IDENTICAL
        MENUITEM SEPARATOR
        MENUITEM "&Obnoviť výber rozdielov", IDM_COMPARE_RESTORE_DIFFERENCES_SELECTION
        MENUITEM "&Invertovať výber rozdielov",  IDM_COMPARE_INVERT_DIFFERENCES_SELECTION
        MENUITEM SEPARATOR
        MENUITEM "&Zavrieť",                  IDM_COMPARE_CLOSE
    END
    POPUP "&Zobrazenie"
    BEGIN
        MENUITEM "&Stručný\tAlt+2",           IDM_PANE_DISPLAY_BRIEF
        MENUITEM "&Podrobné\tAlt+3",        IDM_PANE_DISPLAY_DETAILED
        MENUITEM "&Extra podrobné\tAlt+4",  IDM_PANE_DISPLAY_EXTRA_DETAILED
    END
END

