    POPUP "&Správně",                         65535,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "&Změnit Disk",        IDM_RIGHT_CHANGE_DRIVE,MFT_STRING,MFS_ENABLED
        POPUP "&Přejít na",                         65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Zpět",                   IDM_RIGHT_GO_TO_BACK,MFT_STRING,MFS_ENABLED
            MENUITEM "&Vpřed",                IDM_RIGHT_GO_TO_FORWARD,MFT_STRING,MFS_ENABLED
            MENUITEM "&Nadřazený adresář", IDM_RIGHT_GO_TO_PARENT_DIRECTORY,MFT_STRING,MFS_ENABLED
            MENUITEM "&Kořenový adresář",                    IDM_RIGHT_GO_TO_ROOT_DIRECTORY,MFT_STRING,MFS_ENABLED
            MENUITEM "&Cesta z jiného panelu",       IDM_RIGHT_GO_TO_PATH_FROM_OTHER_PANE,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "&Horké stezky...",      IDM_RIGHT_HOT_PATHS,MFT_STRING,MFS_ENABLED
            MENUITEM "(Prázdné)",                      0,MFT_STRING,MFS_GRAYED
            MENUITEM MFT_SEPARATOR
            MENUITEM "(Prázdné)",                      0,MFT_STRING,MFS_GRAYED
        END
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Stručně",               IDM_RIGHT_DISPLAY_BRIEF,MFT_STRING,MFS_ENABLED
        MENUITEM "&Podrobné",            IDM_RIGHT_DISPLAY_DETAILED,MFT_STRING,MFS_ENABLED
        MENUITEM "&Extra podrobné",      IDM_RIGHT_DISPLAY_EXTRA_DETAILED,MFT_STRING,MFS_ENABLED
        MENUITEM "&Miniatury",          IDM_RIGHT_DISPLAY_THUMBNAILS,MFT_STRING,MFS_ENABLED
        MENUITEM "&Podokno náhledu",      IDM_RIGHT_PREVIEW_PANE,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        POPUP "&Seřadit podle",                       65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Žádný",              IDM_RIGHT_SORT_NONE,MFT_STRING,MFS_ENABLED
            MENUITEM "&Jméno",              IDM_RIGHT_SORT_NAME,MFT_STRING,MFS_ENABLED
            MENUITEM "&Rozšíření",         IDM_RIGHT_SORT_EXTENSION,MFT_STRING,MFS_ENABLED
            MENUITEM "&Čas",              IDM_RIGHT_SORT_TIME,MFT_STRING,MFS_ENABLED
            MENUITEM "&Velikost",              IDM_RIGHT_SORT_SIZE,MFT_STRING,MFS_ENABLED
            MENUITEM "&Atributy",                 IDM_RIGHT_SORT_ATTRIBUTES,MFT_STRING,MFS_ENABLED
        END
        POPUP "&Zobrazit",                       65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Skryté soubory",        IDM_RIGHT_SHOW_HIDDEN_FILES,MFT_STRING,MFS_ENABLED
            MENUITEM "&Systémové soubory",        IDM_RIGHT_SHOW_SYSTEM_FILES,MFT_STRING,MFS_ENABLED
            MENUITEM "&Přípony souborů",   IDM_RIGHT_SHOW_FILE_EXTENSIONS,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "&Filtrační lišta",         IDM_RIGHT_FILTER_BAR,MFT_STRING,MFS_ENABLED
            MENUITEM "&Navigační lišta",     IDM_RIGHT_NAVIGATION_BAR,MFT_STRING,MFS_ENABLED
            MENUITEM "&Stavový řádek",            IDM_RIGHT_STATUSBAR,MFT_STRING,MFS_ENABLED
        END
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Maximalizovat/Obnovit podokno", IDM_RIGHT_ZOOM_PANEL,MFT_STRING,MFS_ENABLED
        MENUITEM "&Vyměňte tabule",              IDM_APP_SWAP_PANES,MFT_STRING,MFS_ENABLED
        MENUITEM "&Cesta z jiného panelu",       IDM_RIGHT_GO_TO_PATH_FROM_OTHER_PANE,MFT_STRING,MFS_ENABLED
        MENUITEM "&Obnovit",                IDM_RIGHT_REFRESH,MFT_STRING,MFS_ENABLED
        MENUITEM "&Filtrovat...",             IDM_RIGHT_FILTER,MFT_STRING,MFS_ENABLED
#if defined(_DEBUG) || defined(DEBUG)
	        MENUITEM MFT_SEPARATOR
	        POPUP "&Překryvná ukázka [dbg]",          65535,MFT_STRING,MFS_ENABLED
	        BEGIN
	            POPUP "&Modální (blokuje vstup) [dbg]",          65535,MFT_STRING,MFS_ENABLED
	            BEGIN
	                MENUITEM "&Chyba [dbg]",                      IDM_RIGHT_OVERLAY_SAMPLE_ERROR,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Upozornění [dbg]",                    IDM_RIGHT_OVERLAY_SAMPLE_WARNING,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Informace [dbg]",                IDM_RIGHT_OVERLAY_SAMPLE_INFORMATION,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Čekejte prosím [dbg]",                IDM_RIGHT_OVERLAY_SAMPLE_BUSY,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Čekejte prosím (se zrušením) [dbg]",  IDM_RIGHT_OVERLAY_SAMPLE_BUSY_WITH_CANCEL,MFT_STRING,MFS_ENABLED
	            END
	            POPUP "&Nemodální (neblokuje) [dbg]",      65535,MFT_STRING,MFS_ENABLED
	            BEGIN
	                MENUITEM "&Chyba [dbg]",                      IDM_RIGHT_OVERLAY_SAMPLE_ERROR_NONMODAL,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Upozornění [dbg]",                    IDM_RIGHT_OVERLAY_SAMPLE_WARNING_NONMODAL,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Informace [dbg]",                IDM_RIGHT_OVERLAY_SAMPLE_INFORMATION_NONMODAL,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Načítání zrušeno (bez uzavření) [dbg]", IDM_RIGHT_OVERLAY_SAMPLE_CANCELED,MFT_STRING,MFS_ENABLED
	            END
	            MENUITEM MFT_SEPARATOR
	            MENUITEM "&Skrýt překryvnou vrstvu [dbg]",               IDM_RIGHT_OVERLAY_SAMPLE_HIDE,MFT_STRING,MFS_ENABLED
	        END
#endif
	    END
	    POPUP "&Nápověda",                          65535,MFT_STRING | MFT_RIGHTJUSTIFY,MFS_ENABLED
    BEGIN
        MENUITEM "&Zobrazit zástupce...", IDM_APP_SHOW_SHORTCUTS,MFT_STRING,MFS_ENABLED
        MENUITEM "&Externí nápověda",        IDM_APP_EXTERNAL_HELP,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "&O...",                  IDM_ABOUT,MFT_STRING,MFS_ENABLED
    END
END

IDR_COMPARE_DIRECTORIES_MENU MENU
BEGIN
    POPUP "&Porovnejte"
    BEGIN
        MENUITEM "&Možnosti...",              IDM_COMPARE_OPTIONS
        MENUITEM "&Znovu naskenovat",                 IDM_COMPARE_RESCAN
        MENUITEM SEPARATOR
        MENUITEM "&Zobrazit identické položky",   IDM_COMPARE_TOGGLE_IDENTICAL
        MENUITEM SEPARATOR
        MENUITEM "&Obnovit výběr rozdílů", IDM_COMPARE_RESTORE_DIFFERENCES_SELECTION
        MENUITEM "&Invertovat výběr rozdílů",  IDM_COMPARE_INVERT_DIFFERENCES_SELECTION
        MENUITEM SEPARATOR
        MENUITEM "&Zavřít",                  IDM_COMPARE_CLOSE
    END
    POPUP "&Zobrazení"
    BEGIN
        MENUITEM "&Stručně\tAlt+2",           IDM_PANE_DISPLAY_BRIEF
        MENUITEM "&Podrobné\tAlt+3",        IDM_PANE_DISPLAY_DETAILED
        MENUITEM "&Extra podrobné\tAlt+4",  IDM_PANE_DISPLAY_EXTRA_DETAILED
    END
END

