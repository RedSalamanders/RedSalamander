#include "../../Resource.h"
#include <winres.h>

LANGUAGE LANG_CZECH, SUBLANG_DEFAULT

IDR_FOLDERVIEW_CONTEXT MENU
BEGIN
	    POPUP ""
		    BEGIN
		        MENUITEM "&Otevřít",                       IDM_FOLDERVIEW_CONTEXT_OPEN
		        MENUITEM "&Otevřít pomocí...",               IDM_FOLDERVIEW_CONTEXT_OPEN_WITH
		        MENUITEM "&Zobrazit prostor",                 IDM_FOLDERVIEW_CONTEXT_VIEW_SPACE
		        MENUITEM SEPARATOR
		        MENUITEM "&Odstranit",                     IDM_FOLDERVIEW_CONTEXT_DELETE
		        MENUITEM "&Přesunout...",                    IDM_FOLDERVIEW_CONTEXT_MOVE
		        MENUITEM "&Přejmenovat",                     IDM_FOLDERVIEW_CONTEXT_RENAME
	        MENUITEM SEPARATOR
	        MENUITEM "&Kopírovat",                       IDM_FOLDERVIEW_CONTEXT_COPY
		        MENUITEM "&Vložit",                      IDM_FOLDERVIEW_CONTEXT_PASTE
		        MENUITEM SEPARATOR
		        MENUITEM "&Vlastnosti",                 IDM_FOLDERVIEW_CONTEXT_PROPERTIES
#if defined(_DEBUG) || defined(DEBUG)
		        MENUITEM SEPARATOR
		        POPUP "&Překryvná ukázka [dbg]"
		        BEGIN
		            POPUP "&Modální (blokuje vstup) [dbg]"
		            BEGIN
		                MENUITEM "&Chyba [dbg]",                      IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_ERROR
		                MENUITEM "&Upozornění [dbg]",                    IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_WARNING
		                MENUITEM "&Informace [dbg]",                IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_INFORMATION
		                MENUITEM "&Čekejte prosím [dbg]",                IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_BUSY
		                MENUITEM "&Čekejte prosím (se zrušením) [dbg]",  IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_BUSY_WITH_CANCEL
		            END
		            POPUP "&Nemodální (neblokuje) [dbg]"
		            BEGIN
		                MENUITEM "&Chyba [dbg]",                      IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_ERROR_NONMODAL
		                MENUITEM "&Upozornění [dbg]",                    IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_WARNING_NONMODAL
		                MENUITEM "&Informace [dbg]",                IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_INFORMATION_NONMODAL
		                MENUITEM "&Načítání zrušeno (bez uzavření) [dbg]", IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_CANCELED
		            END
		            MENUITEM SEPARATOR
		            MENUITEM "&Skrýt překryvnou vrstvu [dbg]",               IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_HIDE
		        END
#endif
		    END
		END

	IDC_REDSALAMANDER MENUEX
BEGIN
    POPUP "&Vlevo",                          65535,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "&Změnit Disk",        IDM_LEFT_CHANGE_DRIVE,MFT_STRING,MFS_ENABLED
        POPUP "&Přejít na",                         65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Zpět",                   IDM_LEFT_GO_TO_BACK,MFT_STRING,MFS_ENABLED
            MENUITEM "&Vpřed",                IDM_LEFT_GO_TO_FORWARD,MFT_STRING,MFS_ENABLED
            MENUITEM "&Nadřazený adresář", IDM_LEFT_GO_TO_PARENT_DIRECTORY,MFT_STRING,MFS_ENABLED
            MENUITEM "&Kořenový adresář",                    IDM_LEFT_GO_TO_ROOT_DIRECTORY,MFT_STRING,MFS_ENABLED
            MENUITEM "&Cesta z jiného panelu",       IDM_LEFT_GO_TO_PATH_FROM_OTHER_PANE,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "&Horké stezky...",      IDM_LEFT_HOT_PATHS,MFT_STRING,MFS_ENABLED
            MENUITEM "(Prázdné)",                      0,MFT_STRING,MFS_GRAYED
            MENUITEM MFT_SEPARATOR
            MENUITEM "(Prázdné)",                      0,MFT_STRING,MFS_GRAYED
        END
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Stručně",               IDM_LEFT_DISPLAY_BRIEF,MFT_STRING,MFS_ENABLED
        MENUITEM "&Podrobné",            IDM_LEFT_DISPLAY_DETAILED,MFT_STRING,MFS_ENABLED
        MENUITEM "&Extra podrobné",      IDM_LEFT_DISPLAY_EXTRA_DETAILED,MFT_STRING,MFS_ENABLED
        MENUITEM "&Miniatury",          IDM_LEFT_DISPLAY_THUMBNAILS,MFT_STRING,MFS_ENABLED
        MENUITEM "&Podokno náhledu",      IDM_LEFT_PREVIEW_PANE,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        POPUP "&Seřadit podle",                       65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Žádný",              IDM_LEFT_SORT_NONE,MFT_STRING,MFS_ENABLED
            MENUITEM "&Jméno",              IDM_LEFT_SORT_NAME,MFT_STRING,MFS_ENABLED
            MENUITEM "&Rozšíření",         IDM_LEFT_SORT_EXTENSION,MFT_STRING,MFS_ENABLED
            MENUITEM "&Čas",              IDM_LEFT_SORT_TIME,MFT_STRING,MFS_ENABLED
            MENUITEM "&Velikost",              IDM_LEFT_SORT_SIZE,MFT_STRING,MFS_ENABLED
            MENUITEM "&Atributy",                 IDM_LEFT_SORT_ATTRIBUTES,MFT_STRING,MFS_ENABLED
        END
        POPUP "&Zobrazit",                       65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Skryté soubory",        IDM_LEFT_SHOW_HIDDEN_FILES,MFT_STRING,MFS_ENABLED
            MENUITEM "&Systémové soubory",        IDM_LEFT_SHOW_SYSTEM_FILES,MFT_STRING,MFS_ENABLED
            MENUITEM "&Přípony souborů",   IDM_LEFT_SHOW_FILE_EXTENSIONS,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "&Filtrační lišta",         IDM_LEFT_FILTER_BAR,MFT_STRING,MFS_ENABLED
            MENUITEM "&Navigační lišta",     IDM_LEFT_NAVIGATION_BAR,MFT_STRING,MFS_ENABLED
            MENUITEM "&Stavový řádek",            IDM_LEFT_STATUSBAR,MFT_STRING,MFS_ENABLED
        END
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Maximalizovat/Obnovit podokno", IDM_LEFT_ZOOM_PANEL,MFT_STRING,MFS_ENABLED
        MENUITEM "&Vyměňte tabule",              IDM_APP_SWAP_PANES,MFT_STRING,MFS_ENABLED
        MENUITEM "&Cesta z jiného panelu",       IDM_LEFT_GO_TO_PATH_FROM_OTHER_PANE,MFT_STRING,MFS_ENABLED
        MENUITEM "&Obnovit",                IDM_LEFT_REFRESH,MFT_STRING,MFS_ENABLED
        MENUITEM "&Filtrovat...",             IDM_LEFT_FILTER,MFT_STRING,MFS_ENABLED
#if defined(_DEBUG) || defined(DEBUG)
	        MENUITEM MFT_SEPARATOR
	        POPUP "&Překryvná ukázka [dbg]",          65535,MFT_STRING,MFS_ENABLED
		        BEGIN
		            POPUP "&Modální (blokuje vstup) [dbg]",          65535,MFT_STRING,MFS_ENABLED
		            BEGIN
		                MENUITEM "&Chyba [dbg]",                      IDM_LEFT_OVERLAY_SAMPLE_ERROR,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Upozornění [dbg]",                    IDM_LEFT_OVERLAY_SAMPLE_WARNING,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Informace [dbg]",                IDM_LEFT_OVERLAY_SAMPLE_INFORMATION,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Čekejte prosím [dbg]",                IDM_LEFT_OVERLAY_SAMPLE_BUSY,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Čekejte prosím (se zrušením) [dbg]",  IDM_LEFT_OVERLAY_SAMPLE_BUSY_WITH_CANCEL,MFT_STRING,MFS_ENABLED
	            END
	            POPUP "&Nemodální (neblokuje) [dbg]",      65535,MFT_STRING,MFS_ENABLED
	            BEGIN
	                MENUITEM "&Chyba [dbg]",                      IDM_LEFT_OVERLAY_SAMPLE_ERROR_NONMODAL,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Upozornění [dbg]",                    IDM_LEFT_OVERLAY_SAMPLE_WARNING_NONMODAL,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Informace [dbg]",                IDM_LEFT_OVERLAY_SAMPLE_INFORMATION_NONMODAL,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Načítání zrušeno (bez uzavření) [dbg]", IDM_LEFT_OVERLAY_SAMPLE_CANCELED,MFT_STRING,MFS_ENABLED
	            END
		            MENUITEM MFT_SEPARATOR
		            MENUITEM "&Skrýt překryvnou vrstvu [dbg]",               IDM_LEFT_OVERLAY_SAMPLE_HIDE,MFT_STRING,MFS_ENABLED
		        END
#endif
	    END
    POPUP "&Soubory",                         65535,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "&Přejmenovat...",               IDM_PANE_RENAME,MFT_STRING,MFS_ENABLED
        MENUITEM "&Otevřít / Provést",       IDM_PANE_EXECUTE_OPEN,MFT_STRING,MFS_ENABLED
        MENUITEM "&Zobrazení",                    IDM_PANE_VIEW,MFT_STRING,MFS_ENABLED
        MENUITEM "&Zobrazit šířku...", IDM_APP_VIEW_WIDTH,MFT_STRING,MFS_ENABLED
        MENUITEM "&Alternativní pohled",      IDM_PANE_ALTERNATE_VIEW,MFT_STRING,MFS_ENABLED
        POPUP "&Zobrazit s",                      65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "(Prázdné)",                      0,MFT_STRING,MFS_GRAYED
        END
        MENUITEM "&Úpravy",                    IDM_PANE_EDIT,MFT_STRING,MFS_ENABLED
        MENUITEM "&Alternativní úprava", IDM_PANE_ALTERNATE_EDIT,MFT_STRING,MFS_ENABLED
        POPUP "&Upravit pomocí",                      65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "(Prázdné)",                      0,MFT_STRING,MFS_GRAYED
        END
        MENUITEM "&Upravit nový soubor...",   IDM_PANE_EDIT_NEW,MFT_STRING,MFS_ENABLED
        MENUITEM "&Kopírovat...",                  IDM_PANE_COPY_TO_OTHER,MFT_STRING,MFS_ENABLED
        MENUITEM "&Přesunout/Přejmenovat...",           IDM_PANE_MOVE_TO_OTHER,MFT_STRING,MFS_ENABLED
        POPUP "&Odstranit",                         65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Odstranit",                   IDM_PANE_DELETE,MFT_STRING,MFS_ENABLED
            MENUITEM "&Přesunout do koše",     IDM_PANE_MOVE_TO_RECYCLE_BIN,MFT_STRING,MFS_ENABLED
        END
        MENUITEM "&Trvalé smazání",   IDM_PANE_PERMANENT_DELETE,MFT_STRING,MFS_ENABLED
        MENUITEM "&Vlastnosti",        IDM_PANE_OPEN_PROPERTIES,MFT_STRING,MFS_ENABLED
        MENUITEM "&Kontextové menu",      IDM_PANE_CONTEXT_MENU,MFT_STRING,MFS_ENABLED
        MENUITEM "&Kontextová nabídka (aktuální adresář)", IDM_PANE_CONTEXT_MENU_CURRENT_DIRECTORY,MFT_STRING,MFS_ENABLED
        MENUITEM "&Zabezpečení...",                       IDM_PANE_OPEN_SECURITY,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Změnit atributy...", IDM_PANE_CHANGE_ATTRIBUTES,MFT_STRING,MFS_ENABLED
        MENUITEM "&Změnit případ...",      IDM_PANE_CHANGE_CASE,MFT_STRING,MFS_ENABLED
        MENUITEM "&Zabalit...",                     IDM_PANE_PACK,MFT_STRING,MFS_ENABLED
        MENUITEM "&Rozbalit...",                   IDM_PANE_UNPACK,MFT_STRING,MFS_ENABLED
        POPUP "&Nové",                            65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Složka...",                IDM_PANE_CREATE_DIR,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "(Prázdné)",                      0,MFT_STRING,MFS_GRAYED
        END
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Konec",                IDM_EXIT,MFT_STRING,MFS_ENABLED
    END
    POPUP "&Úpravy",                          65535,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "&Řez",                                IDM_PANE_CLIPBOARD_CUT,MFT_STRING,MFS_ENABLED
        MENUITEM "&Kopírovat",           IDM_PANE_CLIPBOARD_COPY,MFT_STRING,MFS_ENABLED
        MENUITEM "&Vložit",         IDM_PANE_CLIPBOARD_PASTE,MFT_STRING,MFS_ENABLED
        MENUITEM "Vložit zástupce",                      IDM_PANE_CLIPBOARD_PASTE_SHORTCUT,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "Kopírovat cestu + název jako text", IDM_PANE_COPY_PATH_AND_NAME_AS_TEXT,MFT_STRING,MFS_ENABLED
        MENUITEM "Zkopírovat název jako text",  IDM_PANE_COPY_NAME_AS_TEXT,MFT_STRING,MFS_ENABLED
        MENUITEM "Kopírovat cestu jako text",   IDM_PANE_COPY_PATH_AS_TEXT,MFT_STRING,MFS_ENABLED
        MENUITEM "Zkopírujte cestu UNC + název jako text", IDM_PANE_COPY_PATH_AND_FILE_NAME,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Vyberte...",                           IDM_PANE_SELECTION_SELECT_DIALOG,MFT_STRING,MFS_ENABLED
        MENUITEM "&Zrušit výběr...",                         IDM_PANE_SELECTION_UNSELECT_DIALOG,MFT_STRING,MFS_ENABLED
        MENUITEM "&Invertovat výběr",                    IDM_PANE_SELECTION_INVERT,MFT_STRING,MFS_ENABLED
        MENUITEM "&Vyberte Vše",                          IDM_PANE_SELECTION_SELECT_ALL,MFT_STRING,MFS_ENABLED
        MENUITEM "&Zrušte výběr všech",                        IDM_PANE_SELECTION_UNSELECT_ALL,MFT_STRING,MFS_ENABLED
        MENUITEM "&Obnovit výběr",                   IDM_PANE_SELECTION_RESTORE,MFT_STRING,MFS_ENABLED
        MENUITEM "&Vyberte Další",          IDM_PANE_SELECT_NEXT,MFT_STRING,MFS_ENABLED
        MENUITEM "Vyberte + Vypočítat velikost adresáře + Další", IDM_PANE_SELECT_CALC_DIR_SIZE_NEXT,MFT_STRING,MFS_ENABLED
        POPUP "&Pokročilé",                       65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Uložit výběr", IDM_PANE_SAVE_SELECTION,MFT_STRING,MFS_ENABLED
            MENUITEM "&Načíst výběr...", IDM_PANE_SELECTION_RESTORE,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "&Vyberte možnost Stejná rozšíření",       IDM_PANE_SELECTION_SELECT_SAME_EXTENSION,MFT_STRING,MFS_ENABLED
            MENUITEM "Zrušte výběr stejných rozšíření",      IDM_PANE_SELECTION_UNSELECT_SAME_EXTENSION,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "&Vyberte možnost Stejná jména",                   IDM_PANE_SELECTION_SELECT_SAME_NAME,MFT_STRING,MFS_ENABLED
            MENUITEM "Zrušte výběr Stejná jména",                  IDM_PANE_SELECTION_UNSELECT_SAME_NAME,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "&Skrýt vybraná jména",          IDM_PANE_SELECTION_HIDE_SELECTED_NAMES,MFT_STRING,MFS_ENABLED
            MENUITEM "Skrýt nevybraná jména",         IDM_PANE_SELECTION_HIDE_UNSELECTED_NAMES,MFT_STRING,MFS_ENABLED
            MENUITEM "Zobrazit skrytá jména",             IDM_PANE_SELECTION_SHOW_HIDDEN_NAMES,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "Přejděte na předchozí vybraný název",         IDM_PANE_SELECTION_GOTO_PREV_SELECTED_NAME,MFT_STRING,MFS_ENABLED
            MENUITEM "Přejděte na další vybraný název",             IDM_PANE_SELECTION_GOTO_NEXT_SELECTED_NAME,MFT_STRING,MFS_ENABLED
        END
    END
    POPUP "&Příkazy",                      65535,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "&Vytvořit adresář...", IDM_PANE_CREATE_DIR,MFT_STRING,MFS_ENABLED
        MENUITEM "&Změnit adresář...", IDM_PANE_CHANGE_DIRECTORY,MFT_STRING,MFS_ENABLED
	        MENUITEM "&Porovnat adresáře...", IDM_APP_COMPARE,MFT_STRING,MFS_ENABLED
	        MENUITEM "&Vypočítejte obsazený prostor", IDM_PANE_VIEW_SPACE,MFT_STRING,MFS_ENABLED
	        MENUITEM "&Najít soubory a adresáře...", IDM_PANE_FIND,MFT_STRING,MFS_ENABLED
	        MENUITEM "&Vytvořit seznam souborů...", IDM_PANE_MAKE_FILE_LIST,MFT_STRING,MFS_ENABLED
	        MENUITEM "&Přejděte na zástupce nebo cíl odkazu", IDM_PANE_GO_TO_SHORTCUT_OR_LINK_TARGET,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Seznam otevřených souborů", IDM_PANE_LIST_OPENED_FILES,MFT_STRING,MFS_ENABLED
        MENUITEM "&Zobrazit historii složek", IDM_PANE_SHOW_FOLDERS_HISTORY,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Připojit síťový disk...", IDM_PANE_CONNECT,MFT_STRING,MFS_ENABLED
        MENUITEM "&Odpojit...", IDM_PANE_DISCONNECT,MFT_STRING,MFS_ENABLED
        MENUITEM "&Sdílené adresáře...", IDM_PANE_SHARES,MFT_STRING,MFS_ENABLED
        MENUITEM "&Správce připojení...", IDM_PANE_CONNECTION_MANAGER,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Command Shell", IDM_PANE_OPEN_COMMAND_SHELL,MFT_STRING,MFS_ENABLED
        MENUITEM "&Rychlé vyhledávání", IDM_PANE_QUICK_SEARCH,MFT_STRING,MFS_ENABLED
        MENUITEM "Přeneste aktuální adresář do příkazového řádku", IDM_PANE_BRING_CURRENT_DIR_TO_COMMAND_LINE,MFT_STRING,MFS_ENABLED
        MENUITEM "Přeneste název souboru na příkazový řádek", IDM_PANE_BRING_FILENAME_TO_COMMAND_LINE,MFT_STRING,MFS_ENABLED
        MENUITEM "&Nabídka podokna", IDM_PANE_MENU,MFT_STRING,MFS_ENABLED
        MENUITEM "&Znovu si přečtěte asociace", IDM_APP_REREAD_ASSOCIATIONS,MFT_STRING,MFS_ENABLED
        POPUP "&Uživatelské menu",                          65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "(Prázdné)",                     0,MFT_STRING,MFS_GRAYED
        END
        POPUP "&Otevřete Průzkumník souborů",               65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Aktuální složka", IDM_PANE_OPEN_CURRENT_FOLDER,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "Plocha",                  IDM_APP_OPEN_FILE_EXPLORER_DESKTOP,MFT_STRING,MFS_ENABLED
            MENUITEM "Dokumenty",                IDM_APP_OPEN_FILE_EXPLORER_DOCUMENTS,MFT_STRING,MFS_ENABLED
            MENUITEM "Stahování",                IDM_APP_OPEN_FILE_EXPLORER_DOWNLOADS,MFT_STRING,MFS_ENABLED
            MENUITEM "obrázky",                 IDM_APP_OPEN_FILE_EXPLORER_PICTURES,MFT_STRING,MFS_ENABLED
            MENUITEM "Hudba",                    IDM_APP_OPEN_FILE_EXPLORER_MUSIC,MFT_STRING,MFS_ENABLED
            MENUITEM "videa",                   IDM_APP_OPEN_FILE_EXPLORER_VIDEOS,MFT_STRING,MFS_ENABLED
            MENUITEM "OneDrive",                 IDM_APP_OPEN_FILE_EXPLORER_ONEDRIVE,MFT_STRING,MFS_ENABLED
        END
    END
    POPUP "&Pluginy",                       65535,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "&Správce pluginů...",           IDM_VIEW_PLUGINS_MANAGE,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "(Prázdné)",                     0,MFT_STRING,MFS_GRAYED
    END
    POPUP "&Zobrazení",                          65535,MFT_STRING,MFS_ENABLED
    BEGIN
        POPUP "&téma",                         65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Vysoký kontrast (systém)",     IDM_VIEW_THEME_HIGH_CONTRAST,MFT_STRING,MFS_ENABLED
