        MENUITEM "&Přepnout zaměření podokna",            IDM_VIEW_SWITCH_PANE_FOCUS,MFT_STRING,MFS_ENABLED
        MENUITEM "&Položky operace se soubory se nezdařily", IDM_VIEW_FILEOPS_FAILED_ITEMS,MFT_STRING,MFS_ENABLED
        MENUITEM "&Funkční lišta",                IDM_VIEW_FUNCTIONBAR,MFT_STRING,MFS_ENABLED
        MENUITEM "&Panel nabídek",                    IDM_VIEW_MENUBAR,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Předvolby...",              IDM_FILE_PREFERENCES,MFT_STRING,MFS_ENABLED
