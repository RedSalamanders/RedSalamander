#pragma code_page(65001)
#include "../../Resource.h"
#include <winres.h>

LANGUAGE LANG_FRENCH, SUBLANG_FRENCH

IDR_FOLDERVIEW_CONTEXT MENU
BEGIN
	    POPUP ""
		    BEGIN
		        MENUITEM "&Ouvrir",                       IDM_FOLDERVIEW_CONTEXT_OPEN
		        MENUITEM "Ouvrir &avec...",               IDM_FOLDERVIEW_CONTEXT_OPEN_WITH
		        MENUITEM "Calculer l’&espace",                 IDM_FOLDERVIEW_CONTEXT_VIEW_SPACE
		        MENUITEM SEPARATOR
		        MENUITEM "&Supprimer",                     IDM_FOLDERVIEW_CONTEXT_DELETE
		        MENUITEM "&Déplacer...",                    IDM_FOLDERVIEW_CONTEXT_MOVE
		        MENUITEM "Re&nommer",                     IDM_FOLDERVIEW_CONTEXT_RENAME
	        MENUITEM SEPARATOR
	        MENUITEM "&Copier",                       IDM_FOLDERVIEW_CONTEXT_COPY
		        MENUITEM "&Coller",                      IDM_FOLDERVIEW_CONTEXT_PASTE
		        MENUITEM SEPARATOR
		        MENUITEM "&Propriétés",                 IDM_FOLDERVIEW_CONTEXT_PROPERTIES
#if defined(_DEBUG) || defined(DEBUG)
		        MENUITEM SEPARATOR
		        POPUP "Exemple de &superposition [dbg]"
		        BEGIN
		            POPUP "&Modal (bloque la saisie) [dbg]"
		            BEGIN
		                MENUITEM "&Erreur [dbg]",                      IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_ERROR
		                MENUITEM "&Avertissement [dbg]",                    IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_WARNING
		                MENUITEM "&Information [dbg]",                IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_INFORMATION
		                MENUITEM "&Veuillez patienter [dbg]",                IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_BUSY
		                MENUITEM "Veuillez patienter (avec bouton &Annuler) [dbg]",  IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_BUSY_WITH_CANCEL
		            END
		            POPUP "&Non modal (ne bloque pas) [dbg]"
		            BEGIN
		                MENUITEM "&Erreur [dbg]",                      IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_ERROR_NONMODAL
		                MENUITEM "&Avertissement [dbg]",                    IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_WARNING_NONMODAL
		                MENUITEM "&Information [dbg]",                IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_INFORMATION_NONMODAL
		                MENUITEM "Chargement &annulé (sans fermeture) [dbg]", IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_CANCELED
		            END
		            MENUITEM SEPARATOR
		            MENUITEM "&Masquer la superposition [dbg]",               IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_HIDE
		        END
#endif
		    END
		END

	IDC_REDSALAMANDER MENUEX
BEGIN
    POPUP "&Gauche",                          65535,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "Changer de &lecteur",        IDM_LEFT_CHANGE_DRIVE,MFT_STRING,MFS_ENABLED
        POPUP "&Aller à",                         65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Précédent",                   IDM_LEFT_GO_TO_BACK,MFT_STRING,MFS_ENABLED
            MENUITEM "&Suivant",                IDM_LEFT_GO_TO_FORWARD,MFT_STRING,MFS_ENABLED
            MENUITEM "Dossier &parent", IDM_LEFT_GO_TO_PARENT_DIRECTORY,MFT_STRING,MFS_ENABLED
            MENUITEM "&Dossier racine",                    IDM_LEFT_GO_TO_ROOT_DIRECTORY,MFT_STRING,MFS_ENABLED
            MENUITEM "Chemin depuis l’autre &volet",       IDM_LEFT_GO_TO_PATH_FROM_OTHER_PANE,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "Emplacements &favoris...",      IDM_LEFT_HOT_PATHS,MFT_STRING,MFS_ENABLED
            MENUITEM "(Vide)",                      0,MFT_STRING,MFS_GRAYED
            MENUITEM MFT_SEPARATOR
            MENUITEM "(Vide)",                      0,MFT_STRING,MFS_GRAYED
        END
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Bref",               IDM_LEFT_DISPLAY_BRIEF,MFT_STRING,MFS_ENABLED
        MENUITEM "&Détaillé",            IDM_LEFT_DISPLAY_DETAILED,MFT_STRING,MFS_ENABLED
        MENUITEM "Très &détaillé",      IDM_LEFT_DISPLAY_EXTRA_DETAILED,MFT_STRING,MFS_ENABLED
        MENUITEM "&Miniatures",          IDM_LEFT_DISPLAY_THUMBNAILS,MFT_STRING,MFS_ENABLED
        MENUITEM "Volet d’&aperçu",      IDM_LEFT_PREVIEW_PANE,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        POPUP "Trier &par",                       65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Aucun",              IDM_LEFT_SORT_NONE,MFT_STRING,MFS_ENABLED
            MENUITEM "&Nom",              IDM_LEFT_SORT_NAME,MFT_STRING,MFS_ENABLED
            MENUITEM "&Extension",         IDM_LEFT_SORT_EXTENSION,MFT_STRING,MFS_ENABLED
            MENUITEM "&Date",              IDM_LEFT_SORT_TIME,MFT_STRING,MFS_ENABLED
            MENUITEM "&Taille",              IDM_LEFT_SORT_SIZE,MFT_STRING,MFS_ENABLED
            MENUITEM "&Attributs",                 IDM_LEFT_SORT_ATTRIBUTES,MFT_STRING,MFS_ENABLED
        END
        POPUP "Affic&her",                       65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "Fichiers &masqués",        IDM_LEFT_SHOW_HIDDEN_FILES,MFT_STRING,MFS_ENABLED
            MENUITEM "Fichiers &système",        IDM_LEFT_SHOW_SYSTEM_FILES,MFT_STRING,MFS_ENABLED
            MENUITEM "E&xtensions de fichier",   IDM_LEFT_SHOW_FILE_EXTENSIONS,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "Barre de &filtre",         IDM_LEFT_FILTER_BAR,MFT_STRING,MFS_ENABLED
            MENUITEM "Barre de &navigation",     IDM_LEFT_NAVIGATION_BAR,MFT_STRING,MFS_ENABLED
            MENUITEM "Barre d’&état",            IDM_LEFT_STATUSBAR,MFT_STRING,MFS_ENABLED
        END
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Agrandir/restaurer le volet", IDM_LEFT_ZOOM_PANEL,MFT_STRING,MFS_ENABLED
        MENUITEM "Permuter les &volets",              IDM_APP_SWAP_PANES,MFT_STRING,MFS_ENABLED
        MENUITEM "Chemin depuis l’autre &volet",       IDM_LEFT_GO_TO_PATH_FROM_OTHER_PANE,MFT_STRING,MFS_ENABLED
        MENUITEM "Ac&tualiser",                IDM_LEFT_REFRESH,MFT_STRING,MFS_ENABLED
        MENUITEM "&Filtrer...",             IDM_LEFT_FILTER,MFT_STRING,MFS_ENABLED
#if defined(_DEBUG) || defined(DEBUG)
	        MENUITEM MFT_SEPARATOR
	        POPUP "Exemple de &superposition [dbg]",          65535,MFT_STRING,MFS_ENABLED
		        BEGIN
		            POPUP "&Modal (bloque la saisie) [dbg]",          65535,MFT_STRING,MFS_ENABLED
		            BEGIN
		                MENUITEM "&Erreur [dbg]",                      IDM_LEFT_OVERLAY_SAMPLE_ERROR,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Avertissement [dbg]",                    IDM_LEFT_OVERLAY_SAMPLE_WARNING,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Information [dbg]",                IDM_LEFT_OVERLAY_SAMPLE_INFORMATION,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Veuillez patienter [dbg]",                IDM_LEFT_OVERLAY_SAMPLE_BUSY,MFT_STRING,MFS_ENABLED
	                MENUITEM "Veuillez patienter (avec bouton &Annuler) [dbg]",  IDM_LEFT_OVERLAY_SAMPLE_BUSY_WITH_CANCEL,MFT_STRING,MFS_ENABLED
	            END
	            POPUP "&Non modal (ne bloque pas) [dbg]",      65535,MFT_STRING,MFS_ENABLED
	            BEGIN
	                MENUITEM "&Erreur [dbg]",                      IDM_LEFT_OVERLAY_SAMPLE_ERROR_NONMODAL,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Avertissement [dbg]",                    IDM_LEFT_OVERLAY_SAMPLE_WARNING_NONMODAL,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Information [dbg]",                IDM_LEFT_OVERLAY_SAMPLE_INFORMATION_NONMODAL,MFT_STRING,MFS_ENABLED
	                MENUITEM "Chargement &annulé (sans fermeture) [dbg]", IDM_LEFT_OVERLAY_SAMPLE_CANCELED,MFT_STRING,MFS_ENABLED
	            END
		            MENUITEM MFT_SEPARATOR
		            MENUITEM "&Masquer la superposition [dbg]",               IDM_LEFT_OVERLAY_SAMPLE_HIDE,MFT_STRING,MFS_ENABLED
		        END
#endif
	    END
    POPUP "&Fichiers",                         65535,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "&Renommer...",               IDM_PANE_RENAME,MFT_STRING,MFS_ENABLED
        MENUITEM "&Ouvrir / exécuter",       IDM_PANE_EXECUTE_OPEN,MFT_STRING,MFS_ENABLED
        MENUITEM "&Affichage",                    IDM_PANE_VIEW,MFT_STRING,MFS_ENABLED
        MENUITEM "Largeur d’&affichage...", IDM_APP_VIEW_WIDTH,MFT_STRING,MFS_ENABLED
        MENUITEM "Affichage &alternatif",      IDM_PANE_ALTERNATE_VIEW,MFT_STRING,MFS_ENABLED
        POPUP "Afficher &avec",                      65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "(Vide)",                      0,MFT_STRING,MFS_GRAYED
        END
        MENUITEM "&Modifier",                    IDM_PANE_EDIT,MFT_STRING,MFS_ENABLED
        MENUITEM "Modification &alternative", IDM_PANE_ALTERNATE_EDIT,MFT_STRING,MFS_ENABLED
        POPUP "Modifier &avec",                      65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "(Vide)",                      0,MFT_STRING,MFS_GRAYED
        END
        MENUITEM "Modifier un &nouveau fichier...",   IDM_PANE_EDIT_NEW,MFT_STRING,MFS_ENABLED
        MENUITEM "&Copier...",                  IDM_PANE_COPY_TO_OTHER,MFT_STRING,MFS_ENABLED
        MENUITEM "&Déplacer/Renommer...",           IDM_PANE_MOVE_TO_OTHER,MFT_STRING,MFS_ENABLED
        POPUP "&Supprimer",                         65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Supprimer",                   IDM_PANE_DELETE,MFT_STRING,MFS_ENABLED
            MENUITEM "Déplacer vers la &corbeille",     IDM_PANE_MOVE_TO_RECYCLE_BIN,MFT_STRING,MFS_ENABLED
        END
        MENUITEM "&Supprimer définitivement",   IDM_PANE_PERMANENT_DELETE,MFT_STRING,MFS_ENABLED
        MENUITEM "&Propriétés",        IDM_PANE_OPEN_PROPERTIES,MFT_STRING,MFS_ENABLED
        MENUITEM "Menu con&textuel",      IDM_PANE_CONTEXT_MENU,MFT_STRING,MFS_ENABLED
        MENUITEM "Menu contextuel (&dossier courant)", IDM_PANE_CONTEXT_MENU_CURRENT_DIRECTORY,MFT_STRING,MFS_ENABLED
        MENUITEM "&Sécurité...",                       IDM_PANE_OPEN_SECURITY,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "Modifier les &attributs...", IDM_PANE_CHANGE_ATTRIBUTES,MFT_STRING,MFS_ENABLED
        MENUITEM "Changer la &casse...",      IDM_PANE_CHANGE_CASE,MFT_STRING,MFS_ENABLED
        MENUITEM "&Compresser...",                     IDM_PANE_PACK,MFT_STRING,MFS_ENABLED
        MENUITEM "&Décompresser...",                   IDM_PANE_UNPACK,MFT_STRING,MFS_ENABLED
        POPUP "&Nouveau",                            65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Dossier...",                IDM_PANE_CREATE_DIR,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "(Vide)",                      0,MFT_STRING,MFS_GRAYED
        END
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Quitter",                IDM_EXIT,MFT_STRING,MFS_ENABLED
    END
    POPUP "&Édition",                          65535,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "Cou&per",                                IDM_PANE_CLIPBOARD_CUT,MFT_STRING,MFS_ENABLED
        MENUITEM "&Copier",           IDM_PANE_CLIPBOARD_COPY,MFT_STRING,MFS_ENABLED
        MENUITEM "&Coller",         IDM_PANE_CLIPBOARD_PASTE,MFT_STRING,MFS_ENABLED
        MENUITEM "Coller le raccourci",                      IDM_PANE_CLIPBOARD_PASTE_SHORTCUT,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "Copier le chemin et le nom comme texte", IDM_PANE_COPY_PATH_AND_NAME_AS_TEXT,MFT_STRING,MFS_ENABLED
        MENUITEM "Copier le nom comme texte",  IDM_PANE_COPY_NAME_AS_TEXT,MFT_STRING,MFS_ENABLED
        MENUITEM "Copier le chemin comme texte",   IDM_PANE_COPY_PATH_AS_TEXT,MFT_STRING,MFS_ENABLED
        MENUITEM "Copier le chemin UNC et le nom comme texte", IDM_PANE_COPY_PATH_AND_FILE_NAME,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Sélectionner...",                           IDM_PANE_SELECTION_SELECT_DIALOG,MFT_STRING,MFS_ENABLED
        MENUITEM "&Désélectionner...",                         IDM_PANE_SELECTION_UNSELECT_DIALOG,MFT_STRING,MFS_ENABLED
        MENUITEM "&Inverser la sélection",                    IDM_PANE_SELECTION_INVERT,MFT_STRING,MFS_ENABLED
        MENUITEM "Tout &sélectionner",                          IDM_PANE_SELECTION_SELECT_ALL,MFT_STRING,MFS_ENABLED
        MENUITEM "Tout &désélectionner",                        IDM_PANE_SELECTION_UNSELECT_ALL,MFT_STRING,MFS_ENABLED
        MENUITEM "&Restaurer la sélection",                   IDM_PANE_SELECTION_RESTORE,MFT_STRING,MFS_ENABLED
        MENUITEM "Sélectionner le &suivant",          IDM_PANE_SELECT_NEXT,MFT_STRING,MFS_ENABLED
        MENUITEM "Sélectionner + calculer la taille du dossier + suivant", IDM_PANE_SELECT_CALC_DIR_SIZE_NEXT,MFT_STRING,MFS_ENABLED
        POPUP "&Avancé",                       65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Enregistrer la sélection", IDM_PANE_SAVE_SELECTION,MFT_STRING,MFS_ENABLED
            MENUITEM "&Charger la sélection...", IDM_PANE_SELECTION_RESTORE,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "Sélectionner les mêmes e&xtensions",       IDM_PANE_SELECTION_SELECT_SAME_EXTENSION,MFT_STRING,MFS_ENABLED
            MENUITEM "Désélectionner les mêmes extensions",      IDM_PANE_SELECTION_UNSELECT_SAME_EXTENSION,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "Sélectionner les mêmes &noms",                   IDM_PANE_SELECTION_SELECT_SAME_NAME,MFT_STRING,MFS_ENABLED
            MENUITEM "Désélectionner les mêmes noms",                  IDM_PANE_SELECTION_UNSELECT_SAME_NAME,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "&Masquer les noms sélectionnés",          IDM_PANE_SELECTION_HIDE_SELECTED_NAMES,MFT_STRING,MFS_ENABLED
            MENUITEM "Masquer les noms non sélectionnés",         IDM_PANE_SELECTION_HIDE_UNSELECTED_NAMES,MFT_STRING,MFS_ENABLED
            MENUITEM "Afficher les noms masqués",             IDM_PANE_SELECTION_SHOW_HIDDEN_NAMES,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "Aller au nom sélectionné précédent",         IDM_PANE_SELECTION_GOTO_PREV_SELECTED_NAME,MFT_STRING,MFS_ENABLED
            MENUITEM "Aller au nom sélectionné suivant",             IDM_PANE_SELECTION_GOTO_NEXT_SELECTED_NAME,MFT_STRING,MFS_ENABLED
        END
    END
    POPUP "&Commandes",                      65535,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "Créer &Dossier...", IDM_PANE_CREATE_DIR,MFT_STRING,MFS_ENABLED
        MENUITEM "Changer de &dossier...", IDM_PANE_CHANGE_DIRECTORY,MFT_STRING,MFS_ENABLED
	        MENUITEM "Comparer les &dossiers...", IDM_APP_COMPARE,MFT_STRING,MFS_ENABLED
	        MENUITEM "Calculer l’&espace occupé", IDM_PANE_VIEW_SPACE,MFT_STRING,MFS_ENABLED
	        MENUITEM "Rechercher des &fichiers et dossiers...", IDM_PANE_FIND,MFT_STRING,MFS_ENABLED
	        MENUITEM "Créer une liste de &fichiers...", IDM_PANE_MAKE_FILE_LIST,MFT_STRING,MFS_ENABLED
	        MENUITEM "Aller vers la cible du raccourci ou du &lien", IDM_PANE_GO_TO_SHORTCUT_OR_LINK_TARGET,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "Liste des fichiers &ouverts", IDM_PANE_LIST_OPENED_FILES,MFT_STRING,MFS_ENABLED
        MENUITEM "Afficher l’&historique des dossiers", IDM_PANE_SHOW_FOLDERS_HISTORY,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "Connecter un lecteur &réseau...", IDM_PANE_CONNECT,MFT_STRING,MFS_ENABLED
        MENUITEM "Se dé&connecter...", IDM_PANE_DISCONNECT,MFT_STRING,MFS_ENABLED
        MENUITEM "Dossiers &partagés...", IDM_PANE_SHARES,MFT_STRING,MFS_ENABLED
        MENUITEM "Gestionnaire de &connexions...", IDM_PANE_CONNECTION_MANAGER,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Invite de commandes", IDM_PANE_OPEN_COMMAND_SHELL,MFT_STRING,MFS_ENABLED
        MENUITEM "&Recherche rapide", IDM_PANE_QUICK_SEARCH,MFT_STRING,MFS_ENABLED
        MENUITEM "Envoyer le dossier courant vers la ligne de commande", IDM_PANE_BRING_CURRENT_DIR_TO_COMMAND_LINE,MFT_STRING,MFS_ENABLED
        MENUITEM "Envoyer le nom de fichier vers la ligne de commande", IDM_PANE_BRING_FILENAME_TO_COMMAND_LINE,MFT_STRING,MFS_ENABLED
        MENUITEM "Volet &Menu", IDM_PANE_MENU,MFT_STRING,MFS_ENABLED
        MENUITEM "&Relire les associations", IDM_APP_REREAD_ASSOCIATIONS,MFT_STRING,MFS_ENABLED
        POPUP "Menu &utilisateur",                          65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "(Vide)",                     0,MFT_STRING,MFS_GRAYED
        END
        POPUP "Ouvrir dans l’&Explorateur de fichiers",               65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Dossier courant", IDM_PANE_OPEN_CURRENT_FOLDER,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "Bureau",                  IDM_APP_OPEN_FILE_EXPLORER_DESKTOP,MFT_STRING,MFS_ENABLED
            MENUITEM "Documents",                IDM_APP_OPEN_FILE_EXPLORER_DOCUMENTS,MFT_STRING,MFS_ENABLED
            MENUITEM "Téléchargements",                IDM_APP_OPEN_FILE_EXPLORER_DOWNLOADS,MFT_STRING,MFS_ENABLED
            MENUITEM "Images",                 IDM_APP_OPEN_FILE_EXPLORER_PICTURES,MFT_STRING,MFS_ENABLED
            MENUITEM "Musique",                    IDM_APP_OPEN_FILE_EXPLORER_MUSIC,MFT_STRING,MFS_ENABLED
            MENUITEM "Vidéos",                   IDM_APP_OPEN_FILE_EXPLORER_VIDEOS,MFT_STRING,MFS_ENABLED
            MENUITEM "OneDrive",                 IDM_APP_OPEN_FILE_EXPLORER_ONEDRIVE,MFT_STRING,MFS_ENABLED
        END
    END
    POPUP "&Plug-ins",                       65535,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "&Gestionnaire de plug-ins...",           IDM_VIEW_PLUGINS_MANAGE,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "(Vide)",                     0,MFT_STRING,MFS_GRAYED
    END
    POPUP "&Affichage",                          65535,MFT_STRING,MFS_ENABLED
    BEGIN
        POPUP "&Thème",                         65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Contraste élevé (système)",     IDM_VIEW_THEME_HIGH_CONTRAST,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "&Système",                     IDM_VIEW_THEME_SYSTEM,MFT_STRING,MFS_ENABLED
            MENUITEM "&Clair",                      IDM_VIEW_THEME_LIGHT,MFT_STRING,MFS_ENABLED
            MENUITEM "&Sombre",                       IDM_VIEW_THEME_DARK,MFT_STRING,MFS_ENABLED
            MENUITEM "&Arc-en-ciel",                    IDM_VIEW_THEME_RAINBOW,MFT_STRING,MFS_ENABLED
            MENUITEM "Contraste &élevé (application)",        IDM_VIEW_THEME_HIGH_CONTRAST_APP,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "Thème précédent",              IDM_VIEW_THEME_PREV,MFT_STRING,MFS_ENABLED
            MENUITEM "Thème suivant",                  IDM_VIEW_THEME_NEXT,MFT_STRING,MFS_ENABLED
        END
        MENUITEM MFT_SEPARATOR
        MENUITEM "Basculer en plein &écran", IDM_APP_FULL_SCREEN,MFT_STRING,MFS_ENABLED
        MENUITEM "Menu &fenêtre",            IDM_VIEW_WINDOW_MENU,MFT_STRING,MFS_ENABLED
        MENUITEM "Changer le &volet actif",            IDM_VIEW_SWITCH_PANE_FOCUS,MFT_STRING,MFS_ENABLED
        MENUITEM "Éléments en échec des opérations de &fichiers", IDM_VIEW_FILEOPS_FAILED_ITEMS,MFT_STRING,MFS_ENABLED
        MENUITEM "Barre de &fonctions",                IDM_VIEW_FUNCTIONBAR,MFT_STRING,MFS_ENABLED
        MENUITEM "Barre de &menus",                    IDM_VIEW_MENUBAR,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Préférences...",              IDM_FILE_PREFERENCES,MFT_STRING,MFS_ENABLED
    END
    POPUP "&Droite",                         65535,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "Changer de &lecteur",        IDM_RIGHT_CHANGE_DRIVE,MFT_STRING,MFS_ENABLED
        POPUP "&Aller à",                         65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Précédent",                   IDM_RIGHT_GO_TO_BACK,MFT_STRING,MFS_ENABLED
            MENUITEM "&Suivant",                IDM_RIGHT_GO_TO_FORWARD,MFT_STRING,MFS_ENABLED
            MENUITEM "Dossier &parent", IDM_RIGHT_GO_TO_PARENT_DIRECTORY,MFT_STRING,MFS_ENABLED
            MENUITEM "&Dossier racine",                    IDM_RIGHT_GO_TO_ROOT_DIRECTORY,MFT_STRING,MFS_ENABLED
            MENUITEM "Chemin depuis l’autre &volet",       IDM_RIGHT_GO_TO_PATH_FROM_OTHER_PANE,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "Emplacements &favoris...",      IDM_RIGHT_HOT_PATHS,MFT_STRING,MFS_ENABLED
            MENUITEM "(Vide)",                      0,MFT_STRING,MFS_GRAYED
            MENUITEM MFT_SEPARATOR
            MENUITEM "(Vide)",                      0,MFT_STRING,MFS_GRAYED
        END
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Bref",               IDM_RIGHT_DISPLAY_BRIEF,MFT_STRING,MFS_ENABLED
        MENUITEM "&Détaillé",            IDM_RIGHT_DISPLAY_DETAILED,MFT_STRING,MFS_ENABLED
        MENUITEM "Très &détaillé",      IDM_RIGHT_DISPLAY_EXTRA_DETAILED,MFT_STRING,MFS_ENABLED
        MENUITEM "&Miniatures",          IDM_RIGHT_DISPLAY_THUMBNAILS,MFT_STRING,MFS_ENABLED
        MENUITEM "Volet d’&aperçu",      IDM_RIGHT_PREVIEW_PANE,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        POPUP "Trier &par",                       65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "&Aucun",              IDM_RIGHT_SORT_NONE,MFT_STRING,MFS_ENABLED
            MENUITEM "&Nom",              IDM_RIGHT_SORT_NAME,MFT_STRING,MFS_ENABLED
            MENUITEM "&Extension",         IDM_RIGHT_SORT_EXTENSION,MFT_STRING,MFS_ENABLED
            MENUITEM "&Date",              IDM_RIGHT_SORT_TIME,MFT_STRING,MFS_ENABLED
            MENUITEM "&Taille",              IDM_RIGHT_SORT_SIZE,MFT_STRING,MFS_ENABLED
            MENUITEM "&Attributs",                 IDM_RIGHT_SORT_ATTRIBUTES,MFT_STRING,MFS_ENABLED
        END
        POPUP "Affic&her",                       65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "Fichiers &masqués",        IDM_RIGHT_SHOW_HIDDEN_FILES,MFT_STRING,MFS_ENABLED
            MENUITEM "Fichiers &système",        IDM_RIGHT_SHOW_SYSTEM_FILES,MFT_STRING,MFS_ENABLED
            MENUITEM "E&xtensions de fichier",   IDM_RIGHT_SHOW_FILE_EXTENSIONS,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "Barre de &filtre",         IDM_RIGHT_FILTER_BAR,MFT_STRING,MFS_ENABLED
            MENUITEM "Barre de &navigation",     IDM_RIGHT_NAVIGATION_BAR,MFT_STRING,MFS_ENABLED
            MENUITEM "Barre d’&état",            IDM_RIGHT_STATUSBAR,MFT_STRING,MFS_ENABLED
        END
        MENUITEM MFT_SEPARATOR
        MENUITEM "&Agrandir/restaurer le volet", IDM_RIGHT_ZOOM_PANEL,MFT_STRING,MFS_ENABLED
        MENUITEM "Permuter les &volets",              IDM_APP_SWAP_PANES,MFT_STRING,MFS_ENABLED
        MENUITEM "Chemin depuis l’autre &volet",       IDM_RIGHT_GO_TO_PATH_FROM_OTHER_PANE,MFT_STRING,MFS_ENABLED
        MENUITEM "Ac&tualiser",                IDM_RIGHT_REFRESH,MFT_STRING,MFS_ENABLED
        MENUITEM "&Filtrer...",             IDM_RIGHT_FILTER,MFT_STRING,MFS_ENABLED
#if defined(_DEBUG) || defined(DEBUG)
	        MENUITEM MFT_SEPARATOR
	        POPUP "Exemple de &superposition [dbg]",          65535,MFT_STRING,MFS_ENABLED
	        BEGIN
	            POPUP "&Modal (bloque la saisie) [dbg]",          65535,MFT_STRING,MFS_ENABLED
	            BEGIN
	                MENUITEM "&Erreur [dbg]",                      IDM_RIGHT_OVERLAY_SAMPLE_ERROR,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Avertissement [dbg]",                    IDM_RIGHT_OVERLAY_SAMPLE_WARNING,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Information [dbg]",                IDM_RIGHT_OVERLAY_SAMPLE_INFORMATION,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Veuillez patienter [dbg]",                IDM_RIGHT_OVERLAY_SAMPLE_BUSY,MFT_STRING,MFS_ENABLED
	                MENUITEM "Veuillez patienter (avec bouton &Annuler) [dbg]",  IDM_RIGHT_OVERLAY_SAMPLE_BUSY_WITH_CANCEL,MFT_STRING,MFS_ENABLED
	            END
	            POPUP "&Non modal (ne bloque pas) [dbg]",      65535,MFT_STRING,MFS_ENABLED
	            BEGIN
	                MENUITEM "&Erreur [dbg]",                      IDM_RIGHT_OVERLAY_SAMPLE_ERROR_NONMODAL,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Avertissement [dbg]",                    IDM_RIGHT_OVERLAY_SAMPLE_WARNING_NONMODAL,MFT_STRING,MFS_ENABLED
	                MENUITEM "&Information [dbg]",                IDM_RIGHT_OVERLAY_SAMPLE_INFORMATION_NONMODAL,MFT_STRING,MFS_ENABLED
	                MENUITEM "Chargement &annulé (sans fermeture) [dbg]", IDM_RIGHT_OVERLAY_SAMPLE_CANCELED,MFT_STRING,MFS_ENABLED
	            END
	            MENUITEM MFT_SEPARATOR
	            MENUITEM "&Masquer la superposition [dbg]",               IDM_RIGHT_OVERLAY_SAMPLE_HIDE,MFT_STRING,MFS_ENABLED
	        END
#endif
	    END
	    POPUP "&Aide",                          65535,MFT_STRING | MFT_RIGHTJUSTIFY,MFS_ENABLED
    BEGIN
        MENUITEM "Afficher les &raccourcis...", IDM_APP_SHOW_SHORTCUTS,MFT_STRING,MFS_ENABLED
        MENUITEM "Aide &externe",        IDM_APP_EXTERNAL_HELP,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "À &propos...",                  IDM_ABOUT,MFT_STRING,MFS_ENABLED
    END
END

IDR_COMPARE_DIRECTORIES_MENU MENU
BEGIN
    POPUP "&Comparer"
    BEGIN
        MENUITEM "&Options...",              IDM_COMPARE_OPTIONS
        MENUITEM "&Relancer l’analyse",                 IDM_COMPARE_RESCAN
        MENUITEM SEPARATOR
        MENUITEM "Afficher les éléments &identiques",   IDM_COMPARE_TOGGLE_IDENTICAL
        MENUITEM SEPARATOR
        MENUITEM "&Restaurer la sélection des différences", IDM_COMPARE_RESTORE_DIFFERENCES_SELECTION
        MENUITEM "&Inverser la sélection des différences",  IDM_COMPARE_INVERT_DIFFERENCES_SELECTION
        MENUITEM SEPARATOR
        MENUITEM "&Fermer",                  IDM_COMPARE_CLOSE
    END
    POPUP "&Affichage"
    BEGIN
        MENUITEM "&Bref\tAlt+2",           IDM_PANE_DISPLAY_BRIEF
        MENUITEM "&Détaillé\tAlt+3",        IDM_PANE_DISPLAY_DETAILED
        MENUITEM "Très &détaillé\tAlt+4",  IDM_PANE_DISPLAY_EXTRA_DETAILED
    END
END

