LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

IDR_FOLDERVIEW_CONTEXT MENU
BEGIN
	    POPUP ""
		    BEGIN
		        MENUITEM "開く(&O)",                       IDM_FOLDERVIEW_CONTEXT_OPEN
		        MENUITEM "開く(&W)...",               IDM_FOLDERVIEW_CONTEXT_OPEN_WITH
		        MENUITEM "使用容量を表示(&S)",                 IDM_FOLDERVIEW_CONTEXT_VIEW_SPACE
		        MENUITEM SEPARATOR
		        MENUITEM "削除(&D)",                     IDM_FOLDERVIEW_CONTEXT_DELETE
		        MENUITEM "移動(&M)...",                    IDM_FOLDERVIEW_CONTEXT_MOVE
		        MENUITEM "名前の変更(&N)",                     IDM_FOLDERVIEW_CONTEXT_RENAME
	        MENUITEM SEPARATOR
	        MENUITEM "コピー(&C)",                       IDM_FOLDERVIEW_CONTEXT_COPY
		        MENUITEM "貼り付け(&P)",                      IDM_FOLDERVIEW_CONTEXT_PASTE
		        MENUITEM SEPARATOR
		        MENUITEM "プロパティ(&P)",                 IDM_FOLDERVIEW_CONTEXT_PROPERTIES
#if defined(_DEBUG) || defined(DEBUG)
		        MENUITEM SEPARATOR
		        POPUP "オーバーレイ サンプル [dbg](&S)"
		        BEGIN
		            POPUP "モーダル (入力をブロック) [dbg](&M)"
		            BEGIN
		                MENUITEM "エラー [dbg](&E)",                      IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_ERROR
		                MENUITEM "警告 [dbg](&W)",                    IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_WARNING
		                MENUITEM "情報 [dbg](&I)",                IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_INFORMATION
		                MENUITEM "お待ちください [dbg](&P)",                IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_BUSY
		                MENUITEM "お待ちください（キャンセル） [dbg](&C)",  IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_BUSY_WITH_CANCEL
		            END
		            POPUP "非モーダル (ブロックしない) [dbg](&N)"
		            BEGIN
		                MENUITEM "エラー [dbg](&E)",                      IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_ERROR_NONMODAL
		                MENUITEM "警告 [dbg](&W)",                    IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_WARNING_NONMODAL
		                MENUITEM "情報 [dbg](&I)",                IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_INFORMATION_NONMODAL
		                MENUITEM "ロードがキャンセルされました (クローズなし) [dbg](&C)", IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_CANCELED
		            END
		            MENUITEM SEPARATOR
		            MENUITEM "オーバーレイを非表示 [dbg](&H)",               IDM_FOLDERVIEW_CONTEXT_OVERLAY_SAMPLE_HIDE
		        END
#endif
		    END
		END

	IDC_REDSALAMANDER MENUEX
BEGIN
    POPUP "左(&L)",                          65535,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "ドライブの変更(&D)",        IDM_LEFT_CHANGE_DRIVE,MFT_STRING,MFS_ENABLED
        POPUP "移動(&G)",                         65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "戻る(&B)",                   IDM_LEFT_GO_TO_BACK,MFT_STRING,MFS_ENABLED
            MENUITEM "進む(&F)",                IDM_LEFT_GO_TO_FORWARD,MFT_STRING,MFS_ENABLED
            MENUITEM "親ディレクトリ(&D)", IDM_LEFT_GO_TO_PARENT_DIRECTORY,MFT_STRING,MFS_ENABLED
            MENUITEM "ルートディレクトリ(&R)",                    IDM_LEFT_GO_TO_ROOT_DIRECTORY,MFT_STRING,MFS_ENABLED
            MENUITEM "他のパネルからのパス(&O)",       IDM_LEFT_GO_TO_PATH_FROM_OTHER_PANE,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "お気に入りパス(&P)...",      IDM_LEFT_HOT_PATHS,MFT_STRING,MFS_ENABLED
            MENUITEM "(空)",                      0,MFT_STRING,MFS_GRAYED
            MENUITEM MFT_SEPARATOR
            MENUITEM "(空)",                      0,MFT_STRING,MFS_GRAYED
        END
        MENUITEM MFT_SEPARATOR
        MENUITEM "概要(&B)",               IDM_LEFT_DISPLAY_BRIEF,MFT_STRING,MFS_ENABLED
        MENUITEM "詳細(&D)",            IDM_LEFT_DISPLAY_DETAILED,MFT_STRING,MFS_ENABLED
        MENUITEM "非常に詳細な(&X)",      IDM_LEFT_DISPLAY_EXTRA_DETAILED,MFT_STRING,MFS_ENABLED
