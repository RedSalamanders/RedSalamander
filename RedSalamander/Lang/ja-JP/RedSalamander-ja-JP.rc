        MENUITEM "プレビュー ペイン(&P)",      IDM_LEFT_PREVIEW_PANE,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        POPUP "並べ替え基準(&B)",                       65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "なし(&N)",              IDM_LEFT_SORT_NONE,MFT_STRING,MFS_ENABLED
            MENUITEM "名前(&N)",              IDM_LEFT_SORT_NAME,MFT_STRING,MFS_ENABLED
            MENUITEM "拡張子(&X)",         IDM_LEFT_SORT_EXTENSION,MFT_STRING,MFS_ENABLED
            MENUITEM "時間(&T)",              IDM_LEFT_SORT_TIME,MFT_STRING,MFS_ENABLED
            MENUITEM "サイズ(&S)",              IDM_LEFT_SORT_SIZE,MFT_STRING,MFS_ENABLED
            MENUITEM "属性(&A)",                 IDM_LEFT_SORT_ATTRIBUTES,MFT_STRING,MFS_ENABLED
        END
        POPUP "表示する(&S)",                       65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "隠しファイル(&H)",        IDM_LEFT_SHOW_HIDDEN_FILES,MFT_STRING,MFS_ENABLED
            MENUITEM "システムファイル(&S)",        IDM_LEFT_SHOW_SYSTEM_FILES,MFT_STRING,MFS_ENABLED
            MENUITEM "ファイル拡張子(&X)",   IDM_LEFT_SHOW_FILE_EXTENSIONS,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "フィルター バー(&B)",         IDM_LEFT_FILTER_BAR,MFT_STRING,MFS_ENABLED
            MENUITEM "ナビゲーション バー(&N)",     IDM_LEFT_NAVIGATION_BAR,MFT_STRING,MFS_ENABLED
            MENUITEM "ステータス バー(&S)",            IDM_LEFT_STATUSBAR,MFT_STRING,MFS_ENABLED
        END
        MENUITEM MFT_SEPARATOR
        MENUITEM "ペインの最大化/復元(&M)", IDM_LEFT_ZOOM_PANEL,MFT_STRING,MFS_ENABLED
        MENUITEM "ペインを入れ替える(&S)",              IDM_APP_SWAP_PANES,MFT_STRING,MFS_ENABLED
        MENUITEM "他のパネルからのパス(&O)",       IDM_LEFT_GO_TO_PATH_FROM_OTHER_PANE,MFT_STRING,MFS_ENABLED
        MENUITEM "更新(&F)",                IDM_LEFT_REFRESH,MFT_STRING,MFS_ENABLED
        MENUITEM "フィルター(&F)...",             IDM_LEFT_FILTER,MFT_STRING,MFS_ENABLED
#if defined(_DEBUG) || defined(DEBUG)
	        MENUITEM MFT_SEPARATOR
	        POPUP "オーバーレイ サンプル [dbg](&S)",          65535,MFT_STRING,MFS_ENABLED
		        BEGIN
		            POPUP "モーダル (入力をブロック) [dbg](&M)",          65535,MFT_STRING,MFS_ENABLED
		            BEGIN
		                MENUITEM "エラー [dbg](&E)",                      IDM_LEFT_OVERLAY_SAMPLE_ERROR,MFT_STRING,MFS_ENABLED
	                MENUITEM "警告 [dbg](&W)",                    IDM_LEFT_OVERLAY_SAMPLE_WARNING,MFT_STRING,MFS_ENABLED
	                MENUITEM "情報 [dbg](&I)",                IDM_LEFT_OVERLAY_SAMPLE_INFORMATION,MFT_STRING,MFS_ENABLED
	                MENUITEM "お待ちください [dbg](&P)",                IDM_LEFT_OVERLAY_SAMPLE_BUSY,MFT_STRING,MFS_ENABLED
	                MENUITEM "お待ちください（キャンセル） [dbg](&C)",  IDM_LEFT_OVERLAY_SAMPLE_BUSY_WITH_CANCEL,MFT_STRING,MFS_ENABLED
	            END
	            POPUP "非モーダル (ブロックしない) [dbg](&N)",      65535,MFT_STRING,MFS_ENABLED
	            BEGIN
	                MENUITEM "エラー [dbg](&E)",                      IDM_LEFT_OVERLAY_SAMPLE_ERROR_NONMODAL,MFT_STRING,MFS_ENABLED
	                MENUITEM "警告 [dbg](&W)",                    IDM_LEFT_OVERLAY_SAMPLE_WARNING_NONMODAL,MFT_STRING,MFS_ENABLED
	                MENUITEM "情報 [dbg](&I)",                IDM_LEFT_OVERLAY_SAMPLE_INFORMATION_NONMODAL,MFT_STRING,MFS_ENABLED
	                MENUITEM "ロードがキャンセルされました (クローズなし) [dbg](&C)", IDM_LEFT_OVERLAY_SAMPLE_CANCELED,MFT_STRING,MFS_ENABLED
	            END
		            MENUITEM MFT_SEPARATOR
		            MENUITEM "オーバーレイを非表示 [dbg](&H)",               IDM_LEFT_OVERLAY_SAMPLE_HIDE,MFT_STRING,MFS_ENABLED
		        END
#endif
	    END
    POPUP "ファイル(&F)",                         65535,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "名前の変更(&R)...",               IDM_PANE_RENAME,MFT_STRING,MFS_ENABLED
        MENUITEM "開く/実行(&O)",       IDM_PANE_EXECUTE_OPEN,MFT_STRING,MFS_ENABLED
        MENUITEM "表示(&V)",                    IDM_PANE_VIEW,MFT_STRING,MFS_ENABLED
