        END
        MENUITEM MFT_SEPARATOR
        MENUITEM "終了(&X)",                IDM_EXIT,MFT_STRING,MFS_ENABLED
    END
    POPUP "編集(&E)",                          65535,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "カット(&T)",                                IDM_PANE_CLIPBOARD_CUT,MFT_STRING,MFS_ENABLED
        MENUITEM "コピー(&C)",           IDM_PANE_CLIPBOARD_COPY,MFT_STRING,MFS_ENABLED
        MENUITEM "貼り付け(&P)",         IDM_PANE_CLIPBOARD_PASTE,MFT_STRING,MFS_ENABLED
