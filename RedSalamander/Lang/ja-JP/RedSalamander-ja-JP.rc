        MENUITEM "現在のディレクトリをコマンドラインに表示", IDM_PANE_BRING_CURRENT_DIR_TO_COMMAND_LINE,MFT_STRING,MFS_ENABLED
        MENUITEM "ファイル名をコマンドラインに表示する", IDM_PANE_BRING_FILENAME_TO_COMMAND_LINE,MFT_STRING,MFS_ENABLED
