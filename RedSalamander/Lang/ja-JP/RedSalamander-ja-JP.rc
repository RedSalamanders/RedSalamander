    POPUP "コマンド(&C)",                      65535,MFT_STRING,MFS_ENABLED
    BEGIN
        MENUITEM "フォルダー(&F)...", IDM_PANE_CREATE_DIR,MFT_STRING,MFS_ENABLED
        MENUITEM "ディレクトリを変更する(&D)...", IDM_PANE_CHANGE_DIRECTORY,MFT_STRING,MFS_ENABLED
