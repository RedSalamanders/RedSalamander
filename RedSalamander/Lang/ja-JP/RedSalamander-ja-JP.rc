	        MENUITEM "ショートカットまたはリンク先へ移動(&L)", IDM_PANE_GO_TO_SHORTCUT_OR_LINK_TARGET,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "開いているファイルのリスト(&O)", IDM_PANE_LIST_OPENED_FILES,MFT_STRING,MFS_ENABLED
        MENUITEM "フォルダー履歴を表示(&H)", IDM_PANE_SHOW_FOLDERS_HISTORY,MFT_STRING,MFS_ENABLED
