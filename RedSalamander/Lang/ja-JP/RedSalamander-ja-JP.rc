        MENUITEM "完全に削除(&D)",   IDM_PANE_PERMANENT_DELETE,MFT_STRING,MFS_ENABLED
        MENUITEM "プロパティ(&P)",        IDM_PANE_OPEN_PROPERTIES,MFT_STRING,MFS_ENABLED
        MENUITEM "コンテキスト メニュー(&T)",      IDM_PANE_CONTEXT_MENU,MFT_STRING,MFS_ENABLED
        MENUITEM "コンテキスト メニュー (現在のディレクトリ)(&D)", IDM_PANE_CONTEXT_MENU_CURRENT_DIRECTORY,MFT_STRING,MFS_ENABLED
        MENUITEM "セキュリティ(&S)...",                       IDM_PANE_OPEN_SECURITY,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "属性の変更(&A)...", IDM_PANE_CHANGE_ATTRIBUTES,MFT_STRING,MFS_ENABLED
        MENUITEM "大文字と小文字を変更する(&S)...",      IDM_PANE_CHANGE_CASE,MFT_STRING,MFS_ENABLED
        MENUITEM "パック(&P)...",                     IDM_PANE_PACK,MFT_STRING,MFS_ENABLED
        MENUITEM "開梱(&U)...",                   IDM_PANE_UNPACK,MFT_STRING,MFS_ENABLED
        POPUP "新しい(&N)",                            65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "フォルダー(&F)...",                IDM_PANE_CREATE_DIR,MFT_STRING,MFS_ENABLED
