    BEGIN
        MENUITEM "ドライブの変更(&D)",        IDM_RIGHT_CHANGE_DRIVE,MFT_STRING,MFS_ENABLED
        POPUP "移動(&G)",                         65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "戻る(&B)",                   IDM_RIGHT_GO_TO_BACK,MFT_STRING,MFS_ENABLED
            MENUITEM "進む(&F)",                IDM_RIGHT_GO_TO_FORWARD,MFT_STRING,MFS_ENABLED
            MENUITEM "親ディレクトリ(&D)", IDM_RIGHT_GO_TO_PARENT_DIRECTORY,MFT_STRING,MFS_ENABLED
            MENUITEM "ルートディレクトリ(&R)",                    IDM_RIGHT_GO_TO_ROOT_DIRECTORY,MFT_STRING,MFS_ENABLED
            MENUITEM "他のパネルからのパス(&O)",       IDM_RIGHT_GO_TO_PATH_FROM_OTHER_PANE,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "お気に入りパス(&P)...",      IDM_RIGHT_HOT_PATHS,MFT_STRING,MFS_ENABLED
            MENUITEM "(空)",                      0,MFT_STRING,MFS_GRAYED
            MENUITEM MFT_SEPARATOR
            MENUITEM "(空)",                      0,MFT_STRING,MFS_GRAYED
        END
        MENUITEM MFT_SEPARATOR
        MENUITEM "概要(&B)",               IDM_RIGHT_DISPLAY_BRIEF,MFT_STRING,MFS_ENABLED
        MENUITEM "詳細(&D)",            IDM_RIGHT_DISPLAY_DETAILED,MFT_STRING,MFS_ENABLED
        MENUITEM "非常に詳細な(&X)",      IDM_RIGHT_DISPLAY_EXTRA_DETAILED,MFT_STRING,MFS_ENABLED
        MENUITEM "サムネイル(&T)",          IDM_RIGHT_DISPLAY_THUMBNAILS,MFT_STRING,MFS_ENABLED
        MENUITEM "プレビュー ペイン(&P)",      IDM_RIGHT_PREVIEW_PANE,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        POPUP "並べ替え基準(&B)",                       65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "なし(&N)",              IDM_RIGHT_SORT_NONE,MFT_STRING,MFS_ENABLED
            MENUITEM "名前(&N)",              IDM_RIGHT_SORT_NAME,MFT_STRING,MFS_ENABLED
            MENUITEM "拡張子(&X)",         IDM_RIGHT_SORT_EXTENSION,MFT_STRING,MFS_ENABLED
            MENUITEM "時間(&T)",              IDM_RIGHT_SORT_TIME,MFT_STRING,MFS_ENABLED
            MENUITEM "サイズ(&S)",              IDM_RIGHT_SORT_SIZE,MFT_STRING,MFS_ENABLED
            MENUITEM "属性(&A)",                 IDM_RIGHT_SORT_ATTRIBUTES,MFT_STRING,MFS_ENABLED
        END
        POPUP "表示する(&S)",                       65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "隠しファイル(&H)",        IDM_RIGHT_SHOW_HIDDEN_FILES,MFT_STRING,MFS_ENABLED
            MENUITEM "システムファイル(&S)",        IDM_RIGHT_SHOW_SYSTEM_FILES,MFT_STRING,MFS_ENABLED
            MENUITEM "ファイル拡張子(&X)",   IDM_RIGHT_SHOW_FILE_EXTENSIONS,MFT_STRING,MFS_ENABLED
            MENUITEM MFT_SEPARATOR
            MENUITEM "フィルター バー(&B)",         IDM_RIGHT_FILTER_BAR,MFT_STRING,MFS_ENABLED
            MENUITEM "ナビゲーション バー(&N)",     IDM_RIGHT_NAVIGATION_BAR,MFT_STRING,MFS_ENABLED
            MENUITEM "ステータス バー(&S)",            IDM_RIGHT_STATUSBAR,MFT_STRING,MFS_ENABLED
        END
        MENUITEM MFT_SEPARATOR
        MENUITEM "ペインの最大化/復元(&M)", IDM_RIGHT_ZOOM_PANEL,MFT_STRING,MFS_ENABLED
        MENUITEM "ペインを入れ替える(&S)",              IDM_APP_SWAP_PANES,MFT_STRING,MFS_ENABLED
        MENUITEM "他のパネルからのパス(&O)",       IDM_RIGHT_GO_TO_PATH_FROM_OTHER_PANE,MFT_STRING,MFS_ENABLED
        MENUITEM "更新(&F)",                IDM_RIGHT_REFRESH,MFT_STRING,MFS_ENABLED
        MENUITEM "フィルター(&F)...",             IDM_RIGHT_FILTER,MFT_STRING,MFS_ENABLED
#if defined(_DEBUG) || defined(DEBUG)
	        MENUITEM MFT_SEPARATOR
	        POPUP "オーバーレイ サンプル [dbg](&S)",          65535,MFT_STRING,MFS_ENABLED
	        BEGIN
	            POPUP "モーダル (入力をブロック) [dbg](&M)",          65535,MFT_STRING,MFS_ENABLED
	            BEGIN
	                MENUITEM "エラー [dbg](&E)",                      IDM_RIGHT_OVERLAY_SAMPLE_ERROR,MFT_STRING,MFS_ENABLED
	                MENUITEM "警告 [dbg](&W)",                    IDM_RIGHT_OVERLAY_SAMPLE_WARNING,MFT_STRING,MFS_ENABLED
	                MENUITEM "情報 [dbg](&I)",                IDM_RIGHT_OVERLAY_SAMPLE_INFORMATION,MFT_STRING,MFS_ENABLED
	                MENUITEM "お待ちください [dbg](&P)",                IDM_RIGHT_OVERLAY_SAMPLE_BUSY,MFT_STRING,MFS_ENABLED
	                MENUITEM "お待ちください（キャンセル） [dbg](&C)",  IDM_RIGHT_OVERLAY_SAMPLE_BUSY_WITH_CANCEL,MFT_STRING,MFS_ENABLED
	            END
	            POPUP "非モーダル (ブロックしない) [dbg](&N)",      65535,MFT_STRING,MFS_ENABLED
	            BEGIN
	                MENUITEM "エラー [dbg](&E)",                      IDM_RIGHT_OVERLAY_SAMPLE_ERROR_NONMODAL,MFT_STRING,MFS_ENABLED
	                MENUITEM "警告 [dbg](&W)",                    IDM_RIGHT_OVERLAY_SAMPLE_WARNING_NONMODAL,MFT_STRING,MFS_ENABLED
	                MENUITEM "情報 [dbg](&I)",                IDM_RIGHT_OVERLAY_SAMPLE_INFORMATION_NONMODAL,MFT_STRING,MFS_ENABLED
	                MENUITEM "ロードがキャンセルされました (クローズなし) [dbg](&C)", IDM_RIGHT_OVERLAY_SAMPLE_CANCELED,MFT_STRING,MFS_ENABLED
	            END
	            MENUITEM MFT_SEPARATOR
	            MENUITEM "オーバーレイを非表示 [dbg](&H)",               IDM_RIGHT_OVERLAY_SAMPLE_HIDE,MFT_STRING,MFS_ENABLED
	        END
#endif
	    END
	    POPUP "ヘルプ(&H)",                          65535,MFT_STRING | MFT_RIGHTJUSTIFY,MFS_ENABLED
    BEGIN
        MENUITEM "ショートカットを表示する(&S)...", IDM_APP_SHOW_SHORTCUTS,MFT_STRING,MFS_ENABLED
        MENUITEM "外部ヘルプ(&H)",        IDM_APP_EXTERNAL_HELP,MFT_STRING,MFS_ENABLED
        MENUITEM MFT_SEPARATOR
        MENUITEM "について(&A)...",                  IDM_ABOUT,MFT_STRING,MFS_ENABLED
    END
END

IDR_COMPARE_DIRECTORIES_MENU MENU
BEGIN
    POPUP "比較する(&C)"
    BEGIN
        MENUITEM "オプション(&O)...",              IDM_COMPARE_OPTIONS
        MENUITEM "再スキャン(&R)",                 IDM_COMPARE_RESCAN
        MENUITEM SEPARATOR
        MENUITEM "同一のアイテムを表示(&I)",   IDM_COMPARE_TOGGLE_IDENTICAL
        MENUITEM SEPARATOR
        MENUITEM "差分の復元の選択(&R)", IDM_COMPARE_RESTORE_DIFFERENCES_SELECTION
        MENUITEM "差分の選択を反転(&I)",  IDM_COMPARE_INVERT_DIFFERENCES_SELECTION
        MENUITEM SEPARATOR
        MENUITEM "閉じる(&C)",                  IDM_COMPARE_CLOSE
    END
    POPUP "表示(&V)"
    BEGIN
        MENUITEM "概要(&B)\tAlt+2",           IDM_PANE_DISPLAY_BRIEF
        MENUITEM "詳細(&D)\tAlt+3",        IDM_PANE_DISPLAY_DETAILED
        MENUITEM "非常に詳細な(&X)\tAlt+4",  IDM_PANE_DISPLAY_EXTRA_DETAILED
    END
END

