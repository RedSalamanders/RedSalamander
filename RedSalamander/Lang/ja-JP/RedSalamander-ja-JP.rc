        POPUP "編集に使用(&W)",                      65535,MFT_STRING,MFS_ENABLED
        BEGIN
            MENUITEM "(空)",                      0,MFT_STRING,MFS_GRAYED
        END
        MENUITEM "新しいファイルを編集する(&N)...",   IDM_PANE_EDIT_NEW,MFT_STRING,MFS_ENABLED
        MENUITEM "コピー(&C)...",                  IDM_PANE_COPY_TO_OTHER,MFT_STRING,MFS_ENABLED
        MENUITEM "移動/名前変更(&M)...",           IDM_PANE_MOVE_TO_OTHER,MFT_STRING,MFS_ENABLED
