#pragma code_page(65001)
#include "../../resource.h"
#include <winres.h>

LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

IDR_VIEWERTEXT_MENU MENU
BEGIN
    POPUP "ファイル(&F)"
    BEGIN
        MENUITEM "開く(&O)...\tCtrl+O", IDM_VIEWER_FILE_OPEN
        MENUITEM "名前を付けて保存(&A)...\tCtrl+S", IDM_VIEWER_FILE_SAVE_AS
        MENUITEM "更新(&R)\tF5", IDM_VIEWER_FILE_REFRESH
        POPUP "その他のファイル(&F)"
        BEGIN
            MENUITEM "次へ(&N)\tSpace, Ctrl+Down", IDM_VIEWER_OTHER_NEXT
            MENUITEM "前へ(&P)\tBackspace, Ctrl+Up", IDM_VIEWER_OTHER_PREVIOUS
            MENUITEM "最初(&F)\tCtrl+Home", IDM_VIEWER_OTHER_FIRST
            MENUITEM "最後(&L)\tCtrl+End", IDM_VIEWER_OTHER_LAST
        END
        MENUITEM SEPARATOR
        MENUITEM "終了(&X)\tEsc", IDM_VIEWER_FILE_EXIT
    END
    POPUP "検索(&S)"
    BEGIN
        MENUITEM "探す(&F)...\tCtrl+F", IDM_VIEWER_SEARCH_FIND
        MENUITEM "次を探す(&N)\tF3", IDM_VIEWER_SEARCH_FIND_NEXT
        MENUITEM "前を検索(&P)\tShift+F3", IDM_VIEWER_SEARCH_FIND_PREVIOUS
    END
    POPUP "表示(&V)"
    BEGIN
        MENUITEM "テキスト(&T)", IDM_VIEWER_VIEW_TEXT
        MENUITEM "差分 / 並べて表示(&S)", IDM_VIEWER_VIEW_DIFF_SIDE_BY_SIDE
        MENUITEM "差分/インライン(&I)", IDM_VIEWER_VIEW_DIFF_INLINE
        MENUITEM "差分 / 変更されていないテキストを表示(&U)", IDM_VIEWER_VIEW_DIFF_SHOW_UNCHANGED
        MENUITEM "差分/次のハンク(&N)\tF7", IDM_VIEWER_VIEW_DIFF_NEXT_HUNK
        MENUITEM "差分/前のハンク(&P)\tShift+F7", IDM_VIEWER_VIEW_DIFF_PREVIOUS_HUNK
        MENUITEM "16進数(&H)", IDM_VIEWER_VIEW_HEX
        POPUP "16 進数のバイト色(&C)"
        BEGIN
            MENUITEM "先頭ニブル (00/FF 強調)(&L)", IDM_VIEWER_VIEW_HEX_BYTE_COLORS_LEADING_NIBBLE
            MENUITEM "オフ(&O)", IDM_VIEWER_VIEW_HEX_BYTE_COLORS_OFF
        END
        MENUITEM SEPARATOR
        MENUITEM "先頭へ移動(&T)\tHome", IDM_VIEWER_VIEW_GOTO_TOP
        MENUITEM "末尾へ移動(&B)\tEnd", IDM_VIEWER_VIEW_GOTO_BOTTOM
        MENUITEM "オフセットに移動(&G)...\tCtrl+G", IDM_VIEWER_VIEW_GOTO_OFFSET
        MENUITEM "行番号(&L)", IDM_VIEWER_VIEW_LINE_NUMBERS
        MENUITEM "ラップ(&W)", IDM_VIEWER_VIEW_WRAP
    END
    POPUP "エンコーディング(&E)"
    BEGIN
        MENUITEM "次のエンコーディング(&N)\tF8", IDM_VIEWER_ENCODING_NEXT
        MENUITEM "以前のエンコーディング(&P)\tShift+F8", IDM_VIEWER_ENCODING_PREVIOUS
        MENUITEM SEPARATOR
        MENUITEM "ANSI(&A)", IDM_VIEWER_ENCODING_DISPLAY_ANSI
        MENUITEM "UTF-7(&7)", IDM_VIEWER_ENCODING_DISPLAY_UTF7
        MENUITEM "UTF-8(&8)", IDM_VIEWER_ENCODING_DISPLAY_UTF8
        MENUITEM "UTF-8 BOM(&B)", IDM_VIEWER_ENCODING_DISPLAY_UTF8_BOM
        MENUITEM "UTF-16 BE BOM(&B)", IDM_VIEWER_ENCODING_DISPLAY_UTF16BE_BOM
        MENUITEM "UTF-16 LE BOM(&L)", IDM_VIEWER_ENCODING_DISPLAY_UTF16LE_BOM
        MENUITEM "UTF-32 BE BOM(&B)", IDM_VIEWER_ENCODING_DISPLAY_UTF32BE_BOM
        MENUITEM "UTF-32 LE BOM(&L)", IDM_VIEWER_ENCODING_DISPLAY_UTF32LE_BOM
        MENUITEM SEPARATOR
        POPUP "文字セット(&S)"
        BEGIN
            POPUP "アラビア語(&A)"
            BEGIN
                MENUITEM "iso-8859-6: ISO 8859-6 アラビア語", 28596
                MENUITEM SEPARATOR
                MENUITEM "windows-1256: アラビア語 (Windows)", 1256
                MENUITEM SEPARATOR
                MENUITEM "x-mac-arabic: アラビア語 (Mac)", 10004
                MENUITEM SEPARATOR
                MENUITEM "ASMO-708: アラビア語 (ASMO 708)", 708
                MENUITEM "アラビア語 (ASMO-449+、BCON V4)", 709
                MENUITEM "アラビア語 - 透明アラビア語", 710
                MENUITEM "DOS-720: アラビア語 (DOS)", 720
                MENUITEM "IBM864: アラビア語 (864)", 864
                MENUITEM SEPARATOR
                MENUITEM "IBM420: EBCDIC アラビア語", 20420
            END
            POPUP "バルト言語(&B)"
            BEGIN
                MENUITEM "iso-8859-4: ISO 8859-4 バルト言語", 28594
                MENUITEM "iso-8859-13: ISO 8859-13 エストニア語", 28603
                MENUITEM SEPARATOR
