#pragma code_page(65001)
#include "../../resource.h"
#include <winres.h>

LANGUAGE LANG_CZECH, SUBLANG_DEFAULT

IDR_VIEWERSPACE_MENU MENU
BEGIN
    POPUP "&Soubor"
    BEGIN
        MENUITEM "&Obnovit\tF5", IDM_VIEWERSPACE_FILE_REFRESH
        MENUITEM "&Nahoru\tBackspace", IDM_VIEWERSPACE_NAV_UP
        MENUITEM SEPARATOR
        MENUITEM "&Konec\tEsc", IDM_VIEWERSPACE_FILE_EXIT
    END
END

STRINGTABLE
BEGIN
    IDS_VIEWERSPACE_NAME "Prostor"
    IDS_VIEWERSPACE_DESCRIPTION "Prohlížeč využití disku stromové mapy"
    IDS_VIEWERSPACE_TITLE_FORMAT "{0} - Vesmír"
    IDS_VIEWERSPACE_STATUS_SCANNING "Skenování..."
    IDS_VIEWERSPACE_STATUS_QUEUED "Ve frontě…"
    IDS_VIEWERSPACE_STATUS_DONE "Hotovo"
    IDS_VIEWERSPACE_OTHER_BUCKET_FORMAT "Další položky ({0:L} položek)"
    IDS_VIEWERSPACE_STATUS_NOT_STARTED "Nezahájeno"
    IDS_VIEWERSPACE_STATUS_ERROR "Chyba"
    IDS_VIEWERSPACE_STATUS_CANCELED "Zrušeno"
    IDS_VIEWERSPACE_TOOLTIP_PERCENT_FORMAT "{0:.1Lf} %"
    IDS_VIEWERSPACE_TOOLTIP_FORMAT_WITH_PATH "{0}\r\n{1}\r\nVelikost: {2}\r\nSdílet: {3}\r\nStav: {4}"
    IDS_VIEWERSPACE_TOOLTIP_FORMAT_NO_PATH "{0}\r\nVelikost: {1}\r\nSdílet: {2}\r\nStav: {3}"
    IDS_VIEWERSPACE_TOOLTIP_FORMAT_WITH_PATH_NO_STATE "{0}\r\n{1}\r\nVelikost: {2}\r\nSdílet: {3}"
    IDS_VIEWERSPACE_TOOLTIP_FORMAT_NO_PATH_NO_STATE "{0}\r\nVelikost: {1}\r\nSdílet: {2}"
    IDS_VIEWERSPACE_HEADER_SCANNING_FORMAT "Skenování {0} - {1}"
    IDS_VIEWERSPACE_HEADER_PROCESSING_FORMAT "Zpracování: {0}"
    IDS_VIEWERSPACE_HEADER_COUNTS_FORMAT "Položky {0:L} (složky {1:L}, soubory {2:L})"
    IDS_VIEWERSPACE_HEADER_SIZE_FORMAT "{0} ({1:L} bajtů)"
    IDS_VIEWERSPACE_AGGREGATE_FOLDERS_FILES_FORMAT "Složky {0:L}, soubory {1:L}"
    IDS_VIEWERSPACE_AGGREGATE_FOLDERS_FORMAT "{0:L} složky"
    IDS_VIEWERSPACE_AGGREGATE_FILES_FORMAT "Soubory {0:L}"
    IDS_VIEWERSPACE_WATERMARK_SCAN_INCOMPLETE "Skenování nebylo dokončeno"
    IDS_VIEWERSPACE_WATERMARK_IN_PROGRESS "Probíhá"
    IDS_VIEWERSPACE_CONTEXT_FOCUS_IN_PANE "Zaměřte se v panelu"
    IDS_VIEWERSPACE_CONTEXT_ZOOM_IN "Přiblížit"
    IDS_VIEWERSPACE_CONTEXT_ZOOM_OUT "Oddálit"
    IDS_VIEWERSPACE_OVERLAY_SCAN_COMPLETED "Skenování dokončeno"
END
