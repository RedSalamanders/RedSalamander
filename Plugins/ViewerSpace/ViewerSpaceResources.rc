#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_VIEWERSPACE_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Refresh\tF5", IDM_VIEWERSPACE_FILE_REFRESH
        MENUITEM "Re&build (discard previous view)", IDM_VIEWERSPACE_FILE_REBUILD
        MENUITEM "Copy &path\tAlt+Insert", IDM_VIEWERSPACE_COPY_PATH
        MENUITEM "&Export current view…", IDM_VIEWERSPACE_EXPORT
        MENUITEM "&Mark for cleanup", IDM_VIEWERSPACE_MARK_CLEANUP
        MENUITEM "Mark ma&tching items", IDM_VIEWERSPACE_MARK_MATCHING
        MENUITEM "Review &cleanup…", IDM_VIEWERSPACE_REVIEW_CLEANUP
        MENUITEM "Mo&ve reviewed targets to Recycle Bin", IDM_VIEWERSPACE_SEND_RECYCLE
        MENUITEM "&Delete reviewed targets permanently", IDM_VIEWERSPACE_SEND_DELETE
        MENUITEM "C&lear cleanup marks", IDM_VIEWERSPACE_CLEAR_MARKS
        MENUITEM "Open folder in ot&her pane", IDM_VIEWERSPACE_OPEN_OTHER_PANE
        MENUITEM SEPARATOR
        MENUITEM "E&xit\tEsc", IDM_VIEWERSPACE_FILE_EXIT
    END

    POPUP "&Navigate"
    BEGIN
        MENUITEM "&Back\tAlt+Left", IDM_VIEWERSPACE_NAV_BACK
        MENUITEM "&Forward\tAlt+Right", IDM_VIEWERSPACE_NAV_FORWARD
        MENUITEM "&Up\tBackspace", IDM_VIEWERSPACE_NAV_UP
    END

    POPUP "&View"
    BEGIN
        MENUITEM "Panel &right\tCtrl+1", IDM_VIEWERSPACE_VIEW_EXPLORER
        MENUITEM "Panel &bottom\tCtrl+2", IDM_VIEWERSPACE_VIEW_ANALYST
        MENUITEM SEPARATOR
        MENUITEM "&Map only", IDM_VIEWERSPACE_VIEW_SHOW_ANALYSIS
        MENUITEM "E&xclude selected item", IDM_VIEWERSPACE_EXCLUDE
        MENUITEM "Restore all &excluded items", IDM_VIEWERSPACE_RESTORE_ALL
        MENUITEM "Scan &problems…", IDM_VIEWERSPACE_PROBLEMS
        MENUITEM "Type and age &filters…", IDM_VIEWERSPACE_FILTERS
        MENUITEM "File type break&down…", IDM_VIEWERSPACE_TYPE_BREAKDOWN
        MENUITEM SEPARATOR
        POPUP "Map &area"
        BEGIN
            MENUITEM "&Size", IDM_VIEWERSPACE_WEIGHT_SIZE
            MENUITEM "File &count", IDM_VIEWERSPACE_WEIGHT_COUNT
            MENUITEM "Size on &disk", IDM_VIEWERSPACE_WEIGHT_DISK
        END
        POPUP "&Color by"
        BEGIN
            MENUITEM "Folder &groups", IDM_VIEWERSPACE_COLOR_FOLDER
            MENUITEM "File &type", IDM_VIEWERSPACE_COLOR_TYPE
            MENUITEM "Age · &Modified date", IDM_VIEWERSPACE_COLOR_AGE
            MENUITEM "Age · &newest file inside", IDM_VIEWERSPACE_COLOR_NEWEST
        END
    END
END

