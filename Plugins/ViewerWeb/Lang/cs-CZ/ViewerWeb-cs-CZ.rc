#pragma code_page(65001)
#include "../../resource.h"
#include <winres.h>

LANGUAGE LANG_CZECH, SUBLANG_DEFAULT

IDR_VIEWERWEB_MENU MENU
BEGIN
    POPUP "&Soubor"
    BEGIN
        MENUITEM "&Uložit jako...\tCtrl+S", IDM_VIEWERWEB_FILE_SAVE_AS
        MENUITEM "&Obnovit\tF5", IDM_VIEWERWEB_FILE_REFRESH
        POPUP "&Jiné soubory"
        BEGIN
            MENUITEM "&Další\tSpace, Ctrl+Down", IDM_VIEWERWEB_OTHER_NEXT
            MENUITEM "&Předchozí\tBackspace, Ctrl+Up", IDM_VIEWERWEB_OTHER_PREVIOUS
            MENUITEM "&Za prvé\tCtrl+Home", IDM_VIEWERWEB_OTHER_FIRST
            MENUITEM "&Poslední\tCtrl+End", IDM_VIEWERWEB_OTHER_LAST
        END
        MENUITEM SEPARATOR
        MENUITEM "&Konec\tEsc", IDM_VIEWERWEB_FILE_EXIT
    END
    POPUP "&Hledat"
    BEGIN
        MENUITEM "&Najít...\tCtrl+F", IDM_VIEWERWEB_SEARCH_FIND
        MENUITEM "&Najít další\tF3", IDM_VIEWERWEB_SEARCH_FIND_NEXT
        MENUITEM "&Najít předchozí\tShift+F3", IDM_VIEWERWEB_SEARCH_FIND_PREVIOUS
    END
    POPUP "&Zobrazení"
    BEGIN
        MENUITEM "&Přiblížit\tCtrl++", IDM_VIEWERWEB_VIEW_ZOOM_IN
        MENUITEM "&Oddálit\tCtrl+-", IDM_VIEWERWEB_VIEW_ZOOM_OUT
        MENUITEM "&Resetování zoomu\tCtrl+0", IDM_VIEWERWEB_VIEW_ZOOM_RESET
        MENUITEM SEPARATOR
        MENUITEM "&Přepnout DevTools\tF12", IDM_VIEWERWEB_VIEW_DEVTOOLS
    END
    POPUP "&Nástroje"
    BEGIN
        MENUITEM "&Kopírovat URL\tCtrl+L", IDM_VIEWERWEB_TOOLS_COPY_URL
        MENUITEM "&Otevřít v prohlížeči\tCtrl+Enter", IDM_VIEWERWEB_TOOLS_OPEN_EXTERNAL
        MENUITEM SEPARATOR
        MENUITEM "&Rozbalit vše (JSON/JSONL)", IDM_VIEWERWEB_TOOLS_JSON_EXPAND_ALL
        MENUITEM "&Sbalit vše (JSON/JSONL)", IDM_VIEWERWEB_TOOLS_JSON_COLLAPSE_ALL
        MENUITEM SEPARATOR
        MENUITEM "&Přepnout zdroj Markdown\tCtrl+`", IDM_VIEWERWEB_TOOLS_MARKDOWN_TOGGLE_SOURCE
    END
END

