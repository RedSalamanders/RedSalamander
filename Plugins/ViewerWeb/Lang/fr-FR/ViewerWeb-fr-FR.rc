#pragma code_page(65001)
#include "../../resource.h"
#include <winres.h>

LANGUAGE LANG_FRENCH, SUBLANG_FRENCH

IDR_VIEWERWEB_MENU MENU
BEGIN
    POPUP "&Fichier"
    BEGIN
        MENUITEM "Enregistrer &sous...\tCtrl+S", IDM_VIEWERWEB_FILE_SAVE_AS
        MENUITEM "&Actualiser\tF5", IDM_VIEWERWEB_FILE_REFRESH
        POPUP "Autres &fichiers"
        BEGIN
            MENUITEM "&Suivant\tSpace, Ctrl+Down", IDM_VIEWERWEB_OTHER_NEXT
            MENUITEM "&Précédent\tBackspace, Ctrl+Up", IDM_VIEWERWEB_OTHER_PREVIOUS
            MENUITEM "&Premier\tCtrl+Home", IDM_VIEWERWEB_OTHER_FIRST
            MENUITEM "&Dernier\tCtrl+End", IDM_VIEWERWEB_OTHER_LAST
        END
        MENUITEM SEPARATOR
        MENUITEM "&Quitter\tEsc", IDM_VIEWERWEB_FILE_EXIT
    END
    POPUP "&Recherche"
    BEGIN
        MENUITEM "&Rechercher...\tCtrl+F", IDM_VIEWERWEB_SEARCH_FIND
        MENUITEM "Rechercher &suivant\tF3", IDM_VIEWERWEB_SEARCH_FIND_NEXT
        MENUITEM "Rechercher &précédent\tShift+F3", IDM_VIEWERWEB_SEARCH_FIND_PREVIOUS
    END
    POPUP "&Affichage"
    BEGIN
        MENUITEM "Zoom &avant\tCtrl++", IDM_VIEWERWEB_VIEW_ZOOM_IN
        MENUITEM "Zoom a&rrière\tCtrl+-", IDM_VIEWERWEB_VIEW_ZOOM_OUT
        MENUITEM "&Réinitialiser le zoom\tCtrl+0", IDM_VIEWERWEB_VIEW_ZOOM_RESET
        MENUITEM SEPARATOR
        MENUITEM "Afficher/masquer les &outils de développement\tF12", IDM_VIEWERWEB_VIEW_DEVTOOLS
    END
    POPUP "&Outils"
    BEGIN
        MENUITEM "Copier &URL\tCtrl+L", IDM_VIEWERWEB_TOOLS_COPY_URL
        MENUITEM "Ouvrir dans le &navigateur\tCtrl+Enter", IDM_VIEWERWEB_TOOLS_OPEN_EXTERNAL
        MENUITEM SEPARATOR
        MENUITEM "Tout &développer (JSON/JSONL)", IDM_VIEWERWEB_TOOLS_JSON_EXPAND_ALL
        MENUITEM "Tout &réduire (JSON/JSONL)", IDM_VIEWERWEB_TOOLS_JSON_COLLAPSE_ALL
        MENUITEM SEPARATOR
        MENUITEM "Afficher/masquer la &source Markdown\tCtrl+`", IDM_VIEWERWEB_TOOLS_MARKDOWN_TOGGLE_SOURCE
    END
END

