LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

STRINGTABLE
BEGIN
    IDS_VIEWERSQLITE_NAME "SQLite ビューアー"
    IDS_VIEWERSQLITE_DESCRIPTION "ページングされたテーブルの参照を備えた読み取り専用の SQLite データベース ビューアー。"
    IDS_VIEWERSQLITE_LABEL_FILE "ファイル:"
    IDS_VIEWERSQLITE_LABEL_TABLE "表:"
    IDS_VIEWERSQLITE_LABEL_QUERY "クエリ:"
    IDS_VIEWERSQLITE_BUTTON_RELOAD "再読み込み"
    IDS_VIEWERSQLITE_BUTTON_PREVIOUS "前へ"
    IDS_VIEWERSQLITE_BUTTON_NEXT "次へ"
    IDS_VIEWERSQLITE_BUTTON_RUN_QUERY "クエリの実行"
    IDS_VIEWERSQLITE_BUTTON_TABLE_PREVIEW "テーブルのプレビュー"
    IDS_VIEWERSQLITE_COLUMN_RESULT "結果"
    IDS_VIEWERSQLITE_STATUS_READY "準備完了。"
    IDS_VIEWERSQLITE_STATUS_LOADING "データベースを開く..."
    IDS_VIEWERSQLITE_STATUS_LOADING_ROWS "行をロードしています..."
    IDS_VIEWERSQLITE_STATUS_RUNNING_QUERY "クエリの実行..."
    IDS_VIEWERSQLITE_STATUS_ENTER_QUERY "読み取り専用の SQL クエリを入力します。"
    IDS_VIEWERSQLITE_STATUS_SELECT_TABLE "プレビューするテーブルを選択します。"
    IDS_VIEWERSQLITE_STATUS_NO_TABLES "テーブルまたはビューが見つかりませんでした。"
    IDS_VIEWERSQLITE_STATUS_TABLE_PAGE_FMT "テーブル {0}: 行 {1:L} ～ {2:L}"
    IDS_VIEWERSQLITE_STATUS_TABLE_PAGE_MORE_FMT "テーブル {0}: 行 {1:L}-{2:L}+"
    IDS_VIEWERSQLITE_STATUS_QUERY_FMT "クエリは {0:L} 行を返しました。"
    IDS_VIEWERSQLITE_STATUS_QUERY_TRUNCATED_FMT "クエリは {0:L}+ 行 (切り捨てられました) を返しました。"
    IDS_VIEWERSQLITE_ERROR_OPEN_FAILED "SQLite データベースを開けませんでした。"
    IDS_VIEWERSQLITE_ERROR_QUERY_FAILED "SQLite クエリの実行に失敗しました。"
    IDS_VIEWERSQLITE_ERROR_QUEUE_FAILED "バックグラウンド SQLite 作業をキューに入れることができませんでした。"
    IDS_VIEWERSQLITE_ERROR_OUT_OF_MEMORY "SQLite ビューアーがメモリ不足になりました。"
