#pragma code_page(65001)
#include "../../resource.h"
#include <winres.h>

LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

STRINGTABLE
BEGIN
    IDS_VIEWERSQLITE_NAME "SQLite ビューアー"
    IDS_VIEWERSQLITE_DESCRIPTION "ページングされたテーブルの参照を備えた読み取り専用の SQLite データベース ビューアー。"
    IDS_VIEWERSQLITE_LABEL_FILE "ファイル:"
    IDS_VIEWERSQLITE_LABEL_TABLE "表:"
    IDS_VIEWERSQLITE_LABEL_QUERY "クエリ:"
    IDS_VIEWERSQLITE_BUTTON_RELOAD "再読み込み"
    IDS_VIEWERSQLITE_BUTTON_PREVIOUS "前へ"
    IDS_VIEWERSQLITE_BUTTON_NEXT "次へ"
    IDS_VIEWERSQLITE_BUTTON_RUN_QUERY "クエリの実行"
    IDS_VIEWERSQLITE_BUTTON_TABLE_PREVIEW "テーブルのプレビュー"
    IDS_VIEWERSQLITE_COLUMN_RESULT "結果"
    IDS_VIEWERSQLITE_STATUS_READY "準備完了。"
    IDS_VIEWERSQLITE_STATUS_LOADING "データベースを開く..."
    IDS_VIEWERSQLITE_STATUS_LOADING_ROWS "行をロードしています..."
    IDS_VIEWERSQLITE_STATUS_RUNNING_QUERY "クエリの実行..."
    IDS_VIEWERSQLITE_STATUS_ENTER_QUERY "読み取り専用の SQL クエリを入力します。"
    IDS_VIEWERSQLITE_STATUS_SELECT_TABLE "プレビューするテーブルを選択します。"
    IDS_VIEWERSQLITE_STATUS_NO_TABLES "テーブルまたはビューが見つかりませんでした。"
    IDS_VIEWERSQLITE_STATUS_TABLE_PAGE_FMT "テーブル {0}: 行 {1:L} ～ {2:L}"
    IDS_VIEWERSQLITE_STATUS_TABLE_PAGE_MORE_FMT "テーブル {0}: 行 {1:L}-{2:L}+"
    IDS_VIEWERSQLITE_STATUS_QUERY_FMT "クエリは {0:L} 行を返しました。"
    IDS_VIEWERSQLITE_STATUS_QUERY_TRUNCATED_FMT "クエリは {0:L}+ 行 (切り捨てられました) を返しました。"
    IDS_VIEWERSQLITE_ERROR_OPEN_FAILED "SQLite データベースを開けませんでした。"
    IDS_VIEWERSQLITE_ERROR_QUERY_FAILED "SQLite クエリの実行に失敗しました。"
    IDS_VIEWERSQLITE_ERROR_QUEUE_FAILED "バックグラウンド SQLite 作業をキューに入れることができませんでした。"
    IDS_VIEWERSQLITE_ERROR_OUT_OF_MEMORY "SQLite ビューアーがメモリ不足になりました。"
    IDS_VIEWERSQLITE_COLUMN_FORMAT "列 {0:L}"
    IDS_VIEWERSQLITE_ERROR_SQLITE_CODE_FMT "SQLite エラー {0}"
    IDS_VIEWERSQLITE_ERROR_CONTEXT_FMT "{0}: {1}"
    IDS_VIEWERSQLITE_ERROR_DATABASE_PATH_UTF8 "データベース パスを UTF-8 に変換できませんでした。"
    IDS_VIEWERSQLITE_ERROR_OPEN_DATABASE_CONTEXT "データベースを開けませんでした"
    IDS_VIEWERSQLITE_ERROR_READ_QUERY_ROWS_CONTEXT "クエリ行の読み取り中にエラーが発生しました"
    IDS_VIEWERSQLITE_ERROR_SQL_UTF8 "SQL クエリを UTF-8 に変換できませんでした。"
    IDS_VIEWERSQLITE_ERROR_PREPARE_QUERY_CONTEXT "クエリを準備できませんでした"
    IDS_VIEWERSQLITE_ERROR_SINGLE_STATEMENT "SQL ステートメントは 1 つだけ指定できます。"
    IDS_VIEWERSQLITE_ERROR_READ_ONLY_STATEMENT "読み取り専用の SQL ステートメントだけが許可されています。"
    IDS_VIEWERSQLITE_ERROR_TEMP_DIRECTORY "一時ディレクトリが見つかりませんでした。"
    IDS_VIEWERSQLITE_ERROR_TEMP_FILE "プライベート一時スナップショットを作成できませんでした。"
    IDS_VIEWERSQLITE_ERROR_READER_UNAVAILABLE "ファイル リーダーを利用できません。"
    IDS_VIEWERSQLITE_ERROR_SNAPSHOT_CREATE "ローカル データベース スナップショットを初期化できませんでした。"
    IDS_VIEWERSQLITE_ERROR_SOURCE_SEEK "ソース データベースの先頭に移動できませんでした。"
    IDS_VIEWERSQLITE_ERROR_SNAPSHOT_OOM "ローカル データベース スナップショットの作成中にメモリ不足になりました。"
    IDS_VIEWERSQLITE_ERROR_SOURCE_READ "ソース データベースを読み取れませんでした。"
    IDS_VIEWERSQLITE_ERROR_SNAPSHOT_WRITE "ローカル データベース スナップショットを書き込めませんでした。"
    IDS_VIEWERSQLITE_ERROR_ENUMERATE_TABLES_CONTEXT "テーブルを列挙できませんでした"
    IDS_VIEWERSQLITE_ERROR_PREVIEW_SQL "テーブル プレビュー クエリを作成できませんでした。"
    IDS_VIEWERSQLITE_ERROR_PREPARE_PREVIEW_FMT "{0} のプレビューを準備できませんでした"
    IDS_VIEWERSQLITE_ERROR_SOURCE_ALLOCATE "SQLite データベース ソースを割り当てられませんでした。"
    IDS_VIEWERSQLITE_ERROR_CONTEXT_MISSING "ビューアー コンテキストにファイル システムまたはパスがありません。"
    IDS_VIEWERSQLITE_ERROR_FILESYSTEM_READ_UNSUPPORTED "このファイル システムでは SQLite ビューアーによるファイル読み取りがサポートされていません。"
    IDS_VIEWERSQLITE_ERROR_FILESYSTEM_OPEN "アクティブなファイル システム経由でデータベースを開けませんでした。"
    IDS_VIEWERSQLITE_ERROR_SOURCE_SIZE "ソース データベースのサイズを取得できませんでした。"
    IDS_VIEWERSQLITE_ERROR_SOURCE_CHANGED "仮想ファイルのスナップショットをコピー中にソース データベースが変更されました。書き込み完了後に開き直してください。"
    IDS_VIEWERSQLITE_ERROR_SOURCE_TOO_LARGE "仮想ファイルのデータベースが大きすぎるため、安全にスナップショットを作成できません。"
    IDS_VIEWERSQLITE_ERROR_SNAPSHOT_FLUSH "ローカル データベース スナップショットをディスクへフラッシュできませんでした。"
    IDS_VIEWERSQLITE_ERROR_BACKUP_DESTINATION_CONTEXT "ローカル スナップショットの保存先を開けませんでした"
    IDS_VIEWERSQLITE_ERROR_BACKUP_INITIALIZE_CONTEXT "SQLite バックアップを初期化できませんでした"
    IDS_VIEWERSQLITE_ERROR_BACKUP_STEP_CONTEXT "SQLite バックアップのコピー中にエラーが発生しました"
    IDS_VIEWERSQLITE_ERROR_CANCELLED "SQLite 操作はキャンセルされました。"
    IDS_VIEWERSQLITE_ERROR_WORK_LIMIT "SQLite 操作が作業上限を超えました。"
    IDS_VIEWERSQLITE_ERROR_SORT_COLUMN "指定された並べ替え列はこのテーブルにありません。"
    IDS_VIEWERSQLITE_ERROR_RESULT_LIMIT "SQLite の結果が大きすぎるため、安全に表示できません。"
    IDS_VIEWERSQLITE_ERROR_CONNECTION_UNAVAILABLE "プライベート SQLite スナップショットへの接続を利用できません。"
    IDS_VIEWERSQLITE_ERROR_TABLE_METADATA_FMT "テーブル {0} のメタデータを読み取れませんでした"
    IDS_VIEWERSQLITE_VALUE_NULL "NULL"
    IDS_VIEWERSQLITE_VALUE_BLOB_FMT "BLOB ({0:L} バイト)"
    IDS_VIEWERSQLITE_ERROR_LOCAL_SNAPSHOT_TOO_LARGE "ローカル データベースが大きすぎるため、安全にスナップショットを作成できません。"
    IDS_VIEWERSQLITE_ERROR_VIRTUAL_WAL_UNSUPPORTED "WAL モードの仮想ファイル データベースは、サイドカー ファイルのアトミック スナップショットなしでは安全に開けません。チェックポイントを実行するか書き込み側を閉じてから、開き直してください。"
    IDS_VIEWERSQLITE_ERROR_IDENTIFIER_TOO_LONG "データベースに、安全に表示できる長さを超えたテーブル名またはビュー名があります。"
    IDS_VIEWERSQLITE_ERROR_ROW_OFFSET "指定されたページ オフセットはサポート範囲外です。"
END
