#include "resource.h"

#include <windows.h>

STRINGTABLE
BEGIN
    IDS_VIEWERSQLITE_NAME "SQLite Viewer"
    IDS_VIEWERSQLITE_DESCRIPTION "Read-only SQLite database viewer with paged table browsing."
    IDS_VIEWERSQLITE_LABEL_FILE "File:"
    IDS_VIEWERSQLITE_LABEL_TABLE "Table:"
    IDS_VIEWERSQLITE_LABEL_QUERY "Query:"
    IDS_VIEWERSQLITE_BUTTON_RELOAD "Reload"
    IDS_VIEWERSQLITE_BUTTON_PREVIOUS "Previous"
    IDS_VIEWERSQLITE_BUTTON_NEXT "Next"
    IDS_VIEWERSQLITE_BUTTON_RUN_QUERY "Run Query"
    IDS_VIEWERSQLITE_BUTTON_TABLE_PREVIEW "Table Preview"
    IDS_VIEWERSQLITE_COLUMN_RESULT "Result"
    IDS_VIEWERSQLITE_STATUS_READY "Ready."
    IDS_VIEWERSQLITE_STATUS_LOADING "Opening database..."
    IDS_VIEWERSQLITE_STATUS_LOADING_ROWS "Loading rows..."
    IDS_VIEWERSQLITE_STATUS_RUNNING_QUERY "Running query..."
    IDS_VIEWERSQLITE_STATUS_ENTER_QUERY "Enter a read-only SQL query."
    IDS_VIEWERSQLITE_STATUS_SELECT_TABLE "Choose a table to preview."
    IDS_VIEWERSQLITE_STATUS_NO_TABLES "No tables or views were found."
    IDS_VIEWERSQLITE_STATUS_TABLE_PAGE_FMT "Table {0}: rows {1:L}-{2:L}"
    IDS_VIEWERSQLITE_STATUS_TABLE_PAGE_MORE_FMT "Table {0}: rows {1:L}-{2:L}+"
    IDS_VIEWERSQLITE_STATUS_QUERY_FMT "Query returned {0:L} rows."
    IDS_VIEWERSQLITE_STATUS_QUERY_TRUNCATED_FMT "Query returned {0:L}+ rows (truncated)."
    IDS_VIEWERSQLITE_ERROR_OPEN_FAILED "Failed to open the SQLite database."
    IDS_VIEWERSQLITE_ERROR_QUERY_FAILED "Failed to run the SQLite query."
    IDS_VIEWERSQLITE_ERROR_QUEUE_FAILED "Failed to queue background SQLite work."
    IDS_VIEWERSQLITE_ERROR_OUT_OF_MEMORY "The SQLite viewer ran out of memory."
    IDS_VIEWERSQLITE_TITLE_FORMAT "{0} - {1}"
    IDS_VIEWERSQLITE_COLUMN_FORMAT "Column {0:L}"
    IDS_VIEWERSQLITE_ERROR_SQLITE_CODE_FMT "SQLite error {0}"
    IDS_VIEWERSQLITE_ERROR_CONTEXT_FMT "{0}: {1}"
    IDS_VIEWERSQLITE_ERROR_DATABASE_PATH_UTF8 "Failed to convert the database path to UTF-8."
    IDS_VIEWERSQLITE_ERROR_OPEN_DATABASE_CONTEXT "Failed to open the database"
    IDS_VIEWERSQLITE_ERROR_READ_QUERY_ROWS_CONTEXT "Failed while reading query rows"
    IDS_VIEWERSQLITE_ERROR_SQL_UTF8 "Failed to convert the SQL query to UTF-8."
    IDS_VIEWERSQLITE_ERROR_PREPARE_QUERY_CONTEXT "Failed to prepare the query"
    IDS_VIEWERSQLITE_ERROR_SINGLE_STATEMENT "Only one SQL statement is allowed."
    IDS_VIEWERSQLITE_ERROR_READ_ONLY_STATEMENT "Only read-only SQL statements are allowed."
    IDS_VIEWERSQLITE_ERROR_TEMP_DIRECTORY "Failed to find the temporary directory."
    IDS_VIEWERSQLITE_ERROR_TEMP_FILE "Failed to create the private temporary snapshot."
    IDS_VIEWERSQLITE_ERROR_READER_UNAVAILABLE "The file reader is not available."
    IDS_VIEWERSQLITE_ERROR_SNAPSHOT_CREATE "Failed to initialize the local database snapshot."
    IDS_VIEWERSQLITE_ERROR_SOURCE_SEEK "Failed to seek to the beginning of the source database."
    IDS_VIEWERSQLITE_ERROR_SNAPSHOT_OOM "Out of memory while creating the local database snapshot."
    IDS_VIEWERSQLITE_ERROR_SOURCE_READ "Failed to read the source database."
    IDS_VIEWERSQLITE_ERROR_SNAPSHOT_WRITE "Failed to write the local database snapshot."
    IDS_VIEWERSQLITE_ERROR_ENUMERATE_TABLES_CONTEXT "Failed to enumerate tables"
    IDS_VIEWERSQLITE_ERROR_PREVIEW_SQL "Failed to build the table preview query."
    IDS_VIEWERSQLITE_ERROR_PREPARE_PREVIEW_FMT "Failed to prepare a preview for {0}"
    IDS_VIEWERSQLITE_ERROR_SOURCE_ALLOCATE "Failed to allocate the SQLite database source."
    IDS_VIEWERSQLITE_ERROR_CONTEXT_MISSING "The viewer context is missing the file system or path."
    IDS_VIEWERSQLITE_ERROR_FILESYSTEM_READ_UNSUPPORTED "This file system does not support reading files for the SQLite viewer."
    IDS_VIEWERSQLITE_ERROR_FILESYSTEM_OPEN "Failed to open the database through the active file system."
    IDS_VIEWERSQLITE_ERROR_SOURCE_SIZE "Failed to read the source database size."
    IDS_VIEWERSQLITE_ERROR_SOURCE_CHANGED "The source database changed while its virtual-file snapshot was being copied. Reopen it after writes finish."
    IDS_VIEWERSQLITE_ERROR_SOURCE_TOO_LARGE "The virtual-file database is too large to snapshot safely."
    IDS_VIEWERSQLITE_ERROR_SNAPSHOT_FLUSH "Failed to flush the local database snapshot."
    IDS_VIEWERSQLITE_ERROR_BACKUP_DESTINATION_CONTEXT "Failed to open the local snapshot destination"
    IDS_VIEWERSQLITE_ERROR_BACKUP_INITIALIZE_CONTEXT "Failed to initialize the SQLite backup"
    IDS_VIEWERSQLITE_ERROR_BACKUP_STEP_CONTEXT "Failed while copying the SQLite backup"
    IDS_VIEWERSQLITE_ERROR_CANCELLED "The SQLite operation was canceled."
    IDS_VIEWERSQLITE_ERROR_WORK_LIMIT "The SQLite operation exceeded its bounded work limit."
    IDS_VIEWERSQLITE_ERROR_SORT_COLUMN "The requested sort column is not available in this table."
    IDS_VIEWERSQLITE_ERROR_RESULT_LIMIT "The SQLite result is too large to display safely."
    IDS_VIEWERSQLITE_ERROR_CONNECTION_UNAVAILABLE "The private SQLite snapshot connection is not available."
    IDS_VIEWERSQLITE_ERROR_TABLE_METADATA_FMT "Failed to read metadata for table {0}"
    IDS_VIEWERSQLITE_VALUE_NULL "NULL"
    IDS_VIEWERSQLITE_VALUE_BLOB_FMT "BLOB ({0:L} bytes)"
    IDS_VIEWERSQLITE_ERROR_LOCAL_SNAPSHOT_TOO_LARGE "The local database is too large to snapshot safely."
    IDS_VIEWERSQLITE_ERROR_VIRTUAL_WAL_UNSUPPORTED "A virtual-file database in WAL mode cannot be opened safely without an atomic sidecar snapshot. Checkpoint or close the writer, then reopen it."
    IDS_VIEWERSQLITE_ERROR_IDENTIFIER_TOO_LONG "The database contains a table or view name that is too long to display safely."
    IDS_VIEWERSQLITE_ERROR_ROW_OFFSET "The requested page offset is outside the supported range."
END
