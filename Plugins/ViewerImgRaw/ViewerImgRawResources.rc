#include <windows.h>
#include "resource.h"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_VIEWERRAW_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Refresh\tF5", IDM_VIEWERRAW_FILE_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "&Export...\tCtrl+S", IDM_VIEWERRAW_FILE_EXPORT
        MENUITEM SEPARATOR
        MENUITEM "E&xit\tEsc", IDM_VIEWERRAW_FILE_EXIT
    END
    POPUP "&Other Files"
    BEGIN
        MENUITEM "&Next\tRight, PgDn, Space", IDM_VIEWERRAW_OTHER_NEXT
        MENUITEM "&Previous\tLeft, PgUp, Backspace", IDM_VIEWERRAW_OTHER_PREVIOUS
        MENUITEM "&First\tHome", IDM_VIEWERRAW_OTHER_FIRST
        MENUITEM "&Last\tEnd", IDM_VIEWERRAW_OTHER_LAST
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Fit to Window\tCtrl+F, Double Click", IDM_VIEWERRAW_VIEW_FIT
        MENUITEM "&Actual Size (100%)\t1, Ctrl+Double Click", IDM_VIEWERRAW_VIEW_ACTUAL_SIZE
        MENUITEM "Toggle Fit/100%\tF", IDM_VIEWERRAW_VIEW_TOGGLE_FIT_100
        MENUITEM SEPARATOR
        MENUITEM "Zoom &In\t+", IDM_VIEWERRAW_VIEW_ZOOM_IN
        MENUITEM "Zoom &Out\t-", IDM_VIEWERRAW_VIEW_ZOOM_OUT
        MENUITEM "Zoom &Reset\t0", IDM_VIEWERRAW_VIEW_ZOOM_RESET
        MENUITEM SEPARATOR
        POPUP "&Transform"
        BEGIN
            MENUITEM "Rotate &Clockwise\tR", IDM_VIEWERRAW_VIEW_ROTATE_CW
            MENUITEM "Rotate &Counterclockwise\tCtrl+R, Shift+R", IDM_VIEWERRAW_VIEW_ROTATE_CCW
            MENUITEM SEPARATOR
            MENUITEM "Flip &Horizontal\tH", IDM_VIEWERRAW_VIEW_FLIP_HORIZONTAL
            MENUITEM "Flip &Vertical\tV", IDM_VIEWERRAW_VIEW_FLIP_VERTICAL
            MENUITEM SEPARATOR
            MENUITEM "&Reset Orientation\tO", IDM_VIEWERRAW_VIEW_RESET_ORIENTATION
        END
        POPUP "&Adjust"
        BEGIN
            MENUITEM "Brightness +\tCtrl+Alt+Up", IDM_VIEWERRAW_VIEW_BRIGHTNESS_INCREASE
            MENUITEM "Brightness -\tCtrl+Alt+Down", IDM_VIEWERRAW_VIEW_BRIGHTNESS_DECREASE
            MENUITEM "Contrast +\tCtrl+Alt+Right", IDM_VIEWERRAW_VIEW_CONTRAST_INCREASE
            MENUITEM "Contrast -\tCtrl+Alt+Left", IDM_VIEWERRAW_VIEW_CONTRAST_DECREASE
            MENUITEM "Gamma +\tCtrl+Alt+PgUp", IDM_VIEWERRAW_VIEW_GAMMA_INCREASE
            MENUITEM "Gamma -\tCtrl+Alt+PgDn", IDM_VIEWERRAW_VIEW_GAMMA_DECREASE
            MENUITEM SEPARATOR
            MENUITEM "&Grayscale\tG", IDM_VIEWERRAW_VIEW_TOGGLE_GRAYSCALE
            MENUITEM "&Negative\tN", IDM_VIEWERRAW_VIEW_TOGGLE_NEGATIVE
        END
        MENUITEM SEPARATOR
        POPUP "Image &Source"
        BEGIN
            MENUITEM "&RAW (decoded)", IDM_VIEWERRAW_VIEW_SOURCE_RAW
            MENUITEM "&Thumbnail", IDM_VIEWERRAW_VIEW_SOURCE_THUMBNAIL
        END
        MENUITEM SEPARATOR
        MENUITEM "Show &Exif Overlay\tI", IDM_VIEWERRAW_VIEW_SHOW_EXIF_OVERLAY
    END
END

/////////////////////////////////////////////////////////////////////////////
//
// String Table
//

STRINGTABLE
BEGIN
    IDS_VIEWERRAW_NAME "Image"
    IDS_VIEWERRAW_DESCRIPTION "Image viewer (WIC + LibRaw)"
    IDS_VIEWERRAW_TITLE_FORMAT "{0} - Image"
    IDS_VIEWERRAW_STATUS_LOADING "Loading..."
    IDS_VIEWERRAW_STATUS_ERROR "Failed to load image."
    IDS_VIEWERRAW_STATUS_NO_IMAGE "No image."
    IDS_VIEWERRAW_DIALOG_EXPORT_TITLE "Export image"
    IDS_VIEWERRAW_DIALOG_FILTER_JPEG "JPEG image (*.jpg;*.jpeg)"
    IDS_VIEWERRAW_DIALOG_FILTER_PNG "PNG image (*.png)"
    IDS_VIEWERRAW_DIALOG_FILTER_TIFF "TIFF image (*.tif;*.tiff)"
    IDS_VIEWERRAW_DIALOG_FILTER_BMP "Bitmap image (*.bmp;*.dib)"
    IDS_VIEWERRAW_DIALOG_FILTER_GIF "GIF image (*.gif)"
    IDS_VIEWERRAW_DIALOG_FILTER_JXR "JPEG XR image (*.jxr;*.wdp;*.hdp)"
    IDS_VIEWERRAW_EXPORT_NO_IMAGE "No image to export."
    IDS_VIEWERRAW_EXPORT_UNSUPPORTED_EXTENSION "Unsupported export extension. Use .png, .jpg/.jpeg, .tif/.tiff, .bmp/.dib, .gif, or .jxr/.wdp/.hdp."
    IDS_VIEWERRAW_STATUS_FILESYSTEM_MISSING "Active filesystem is missing."
    IDS_VIEWERRAW_STATUS_UNSUPPORTED_FORMAT "Unsupported file format."
    IDS_VIEWERRAW_STATUS_STORE_OOM "Out of memory while storing decoded image."
    IDS_VIEWERRAW_STATUS_CANCELED "Canceled."
    IDS_VIEWERRAW_EXPORT_IMAGE_TOO_LARGE "The image is too large to export."
    IDS_VIEWERRAW_EXPORT_BUFFER_TRUNCATED "The decoded image buffer is truncated."
    IDS_VIEWERRAW_EXPORT_TEMP_CREATE_FAILED_FMT "Failed to create the temporary export file (HRESULT 0x{0:08X})."
    IDS_VIEWERRAW_EXPORT_WIC_FACTORY_FAILED_FMT "Failed to create the WIC factory (HRESULT 0x{0:08X})."
    IDS_VIEWERRAW_EXPORT_WIC_STREAM_FAILED_FMT "Failed to create the WIC stream (HRESULT 0x{0:08X})."
    IDS_VIEWERRAW_EXPORT_FILE_OPEN_FAILED_FMT "Failed to open the export file (HRESULT 0x{0:08X})."
    IDS_VIEWERRAW_EXPORT_FORMAT_UNSUPPORTED "The selected export format is not supported."
    IDS_VIEWERRAW_EXPORT_ENCODER_CREATE_FAILED_FMT "Failed to create the image encoder (HRESULT 0x{0:08X})."
    IDS_VIEWERRAW_EXPORT_ENCODER_INIT_FAILED_FMT "Failed to initialize the image encoder (HRESULT 0x{0:08X})."
    IDS_VIEWERRAW_EXPORT_FRAME_CREATE_FAILED_FMT "Failed to create the image frame (HRESULT 0x{0:08X})."
    IDS_VIEWERRAW_EXPORT_FRAME_INIT_FAILED_FMT "Failed to initialize the image frame (HRESULT 0x{0:08X})."
    IDS_VIEWERRAW_EXPORT_SIZE_FAILED_FMT "Failed to set the export dimensions (HRESULT 0x{0:08X})."
    IDS_VIEWERRAW_EXPORT_PIXEL_FORMAT_FAILED_FMT "Failed to set the export pixel format (HRESULT 0x{0:08X})."
    IDS_VIEWERRAW_EXPORT_BITMAP_CREATE_FAILED_FMT "Failed to create the source bitmap (HRESULT 0x{0:08X})."
    IDS_VIEWERRAW_EXPORT_PALETTE_CREATE_FAILED_FMT "Failed to create the image palette (HRESULT 0x{0:08X})."
    IDS_VIEWERRAW_EXPORT_PALETTE_INIT_FAILED_FMT "Failed to initialize the image palette (HRESULT 0x{0:08X})."
    IDS_VIEWERRAW_EXPORT_CONVERTER_CREATE_FAILED_FMT "Failed to create the image converter (HRESULT 0x{0:08X})."
    IDS_VIEWERRAW_EXPORT_INDEXED_CONVERT_FAILED_FMT "Failed to convert the image to indexed color (HRESULT 0x{0:08X})."
    IDS_VIEWERRAW_EXPORT_TARGET_CONVERT_FAILED_FMT "Failed to convert the image to the target format (HRESULT 0x{0:08X})."
    IDS_VIEWERRAW_EXPORT_FRAME_WRITE_FAILED_FMT "Failed to write the image frame (HRESULT 0x{0:08X})."
    IDS_VIEWERRAW_EXPORT_FRAME_COMMIT_FAILED_FMT "Failed to commit the image frame (HRESULT 0x{0:08X})."
    IDS_VIEWERRAW_EXPORT_ENCODER_COMMIT_FAILED_FMT "Failed to commit the image encoder (HRESULT 0x{0:08X})."
    IDS_VIEWERRAW_EXPORT_FINALIZE_FAILED_FMT "Failed to finalize the export (HRESULT 0x{0:08X})."
    IDS_VIEWERRAW_EXPORT_COM_INIT_FAILED_FMT "Failed to initialize COM for export (HRESULT 0x{0:08X})."
    IDS_VIEWERRAW_EXPORT_SUCCESS_FMT "Exported: {0}"
    IDS_VIEWERRAW_EXPORT_FAILED "The image export failed."
    IDS_VIEWERRAW_STATUS_ASYNC_RESULT_FAILED "The decoded image result could not be delivered. Try opening the file again."
    IDS_VIEWERRAW_READ_FILESYSTEM_IO_UNSUPPORTED_FMT "The active filesystem cannot open file data (HRESULT 0x{0:08X})."
    IDS_VIEWERRAW_READ_READER_CREATE_FAILED_FMT "The file reader could not be created (HRESULT 0x{0:08X})."
    IDS_VIEWERRAW_READ_GET_SIZE_FAILED_FMT "The file size could not be read (HRESULT 0x{0:08X})."
    IDS_VIEWERRAW_READ_FILE_EMPTY "The file is empty."
    IDS_VIEWERRAW_READ_FILE_TOO_LARGE_FMT "The file is too large to decode ({0:L} bytes)."
    IDS_VIEWERRAW_READ_ADDRESS_SPACE_LIMIT "The file is too large for this address space."
    IDS_VIEWERRAW_READ_SEEK_FAILED_FMT "The file reader could not seek to the beginning (HRESULT 0x{0:08X})."
    IDS_VIEWERRAW_READ_FAILED_FMT "The file data could not be read (HRESULT 0x{0:08X})."
    IDS_VIEWERRAW_READ_PROVIDER_COUNT_INVALID "The filesystem returned an invalid byte count."
    IDS_VIEWERRAW_READ_UNEXPECTED_EOF "The file ended before its declared size."
    IDS_VIEWERRAW_READ_SIZE_CHANGED "The file size changed while it was being read."
    IDS_VIEWERRAW_RAW_OPEN_FAILED_FMT "The RAW decoder could not open the image: {0} (code {1})."
    IDS_VIEWERRAW_RAW_UNPACK_FAILED_FMT "The RAW decoder could not unpack the image: {0} (code {1})."
    IDS_VIEWERRAW_RAW_DIMENSIONS_LIMIT_FMT "The RAW dimensions exceed the image policy ({0} × {1})."
    IDS_VIEWERRAW_RAW_PREFETCH_BUDGET "The RAW preview exceeds the decoded-image memory budget."
    IDS_VIEWERRAW_RAW_PROCESS_FAILED_FMT "The RAW decoder could not process the image: {0} (code {1})."
    IDS_VIEWERRAW_RAW_MEMORY_IMAGE_FAILED_FMT "The RAW decoder could not create the output image: {0} (code {1})."
    IDS_VIEWERRAW_RAW_PIXEL_FORMAT_INVALID "The decoded RAW pixel format is invalid."
    IDS_VIEWERRAW_RAW_DECODED_DIMENSIONS_LIMIT_FMT "The decoded RAW dimensions exceed the image policy ({0} × {1})."
    IDS_VIEWERRAW_RAW_BYTE_COUNT_OVERFLOW "The decoded RAW byte count exceeds this platform."
    IDS_VIEWERRAW_RAW_SOURCE_BYTE_COUNT_OVERFLOW "The decoded RAW source byte count exceeds this platform."
    IDS_VIEWERRAW_RAW_BUFFER_TRUNCATED "The decoded RAW image buffer is truncated."
    IDS_VIEWERRAW_RAW_OUTPUT_BUDGET "The RAW output exceeds the decoded-image memory budget."
END
