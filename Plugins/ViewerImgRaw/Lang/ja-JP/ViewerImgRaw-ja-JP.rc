#pragma code_page(65001)
#include "../../resource.h"
#include <winres.h>

LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

IDR_VIEWERRAW_MENU MENU
BEGIN
    POPUP "ファイル(&F)"
    BEGIN
        MENUITEM "更新(&R)\tF5", IDM_VIEWERRAW_FILE_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "エクスポート(&E)...\tCtrl+S", IDM_VIEWERRAW_FILE_EXPORT
        MENUITEM SEPARATOR
        MENUITEM "終了(&X)\tEsc", IDM_VIEWERRAW_FILE_EXIT
    END
    POPUP "その他のファイル(&O)"
    BEGIN
        MENUITEM "次へ(&N)\tRight, PgDn, Space", IDM_VIEWERRAW_OTHER_NEXT
        MENUITEM "前へ(&P)\tLeft, PgUp, Backspace", IDM_VIEWERRAW_OTHER_PREVIOUS
        MENUITEM "最初(&F)\tHome", IDM_VIEWERRAW_OTHER_FIRST
        MENUITEM "最後(&L)\tEnd", IDM_VIEWERRAW_OTHER_LAST
    END
    POPUP "表示(&V)"
    BEGIN
        MENUITEM "窓に合わせる(&F)\tCtrl+F, Double Click", IDM_VIEWERRAW_VIEW_FIT
        MENUITEM "実際のサイズ (100%)(&A)\t1, Ctrl+Double Click", IDM_VIEWERRAW_VIEW_ACTUAL_SIZE
        MENUITEM "フィットを切り替え/100%\tF", IDM_VIEWERRAW_VIEW_TOGGLE_FIT_100
        MENUITEM SEPARATOR
        MENUITEM "ズームイン(&I)\t+", IDM_VIEWERRAW_VIEW_ZOOM_IN
        MENUITEM "ズームアウト(&O)\t-", IDM_VIEWERRAW_VIEW_ZOOM_OUT
        MENUITEM "ズームリセット(&R)\t0", IDM_VIEWERRAW_VIEW_ZOOM_RESET
        MENUITEM SEPARATOR
        POPUP "トランスフォーム(&T)"
        BEGIN
            MENUITEM "時計回りに回転(&C)\tR", IDM_VIEWERRAW_VIEW_ROTATE_CW
            MENUITEM "反時計回りに回転(&C)\tCtrl+R, Shift+R", IDM_VIEWERRAW_VIEW_ROTATE_CCW
            MENUITEM SEPARATOR
            MENUITEM "水平方向に反転(&H)\tH", IDM_VIEWERRAW_VIEW_FLIP_HORIZONTAL
            MENUITEM "垂直方向に反転(&V)\tV", IDM_VIEWERRAW_VIEW_FLIP_VERTICAL
            MENUITEM SEPARATOR
            MENUITEM "向きをリセット(&R)\tO", IDM_VIEWERRAW_VIEW_RESET_ORIENTATION
        END
        POPUP "調整する(&A)"
        BEGIN
            MENUITEM "明るさ+\tCtrl+Alt+Up", IDM_VIEWERRAW_VIEW_BRIGHTNESS_INCREASE
            MENUITEM "明るさ -\tCtrl+Alt+Down", IDM_VIEWERRAW_VIEW_BRIGHTNESS_DECREASE
            MENUITEM "コントラスト+\tCtrl+Alt+Right", IDM_VIEWERRAW_VIEW_CONTRAST_INCREASE
            MENUITEM "コントラスト -\tCtrl+Alt+Left", IDM_VIEWERRAW_VIEW_CONTRAST_DECREASE
            MENUITEM "ガンマ+\tCtrl+Alt+PgUp", IDM_VIEWERRAW_VIEW_GAMMA_INCREASE
            MENUITEM "ガンマ -\tCtrl+Alt+PgDn", IDM_VIEWERRAW_VIEW_GAMMA_DECREASE
            MENUITEM SEPARATOR
            MENUITEM "グレースケール(&G)\tG", IDM_VIEWERRAW_VIEW_TOGGLE_GRAYSCALE
            MENUITEM "ネガティブ(&N)\tN", IDM_VIEWERRAW_VIEW_TOGGLE_NEGATIVE
        END
        MENUITEM SEPARATOR
        POPUP "画像ソース(&S)"
        BEGIN
            MENUITEM "RAW (デコードされた)(&R)", IDM_VIEWERRAW_VIEW_SOURCE_RAW
            MENUITEM "サムネイル(&T)", IDM_VIEWERRAW_VIEW_SOURCE_THUMBNAIL
        END
        MENUITEM SEPARATOR
        MENUITEM "Exif オーバーレイを表示(&E)\tI", IDM_VIEWERRAW_VIEW_SHOW_EXIF_OVERLAY
    END
END

STRINGTABLE
BEGIN
    IDS_VIEWERRAW_NAME "画像"
    IDS_VIEWERRAW_DESCRIPTION "画像ビューアー (WIC + LibRaw)"
    IDS_VIEWERRAW_TITLE_FORMAT "{0} - 画像"
    IDS_VIEWERRAW_STATUS_LOADING "読み込み中..."
    IDS_VIEWERRAW_STATUS_ERROR "画像の読み込みに失敗しました。"
    IDS_VIEWERRAW_STATUS_NO_IMAGE "画像がありません。"
    IDS_VIEWERRAW_DIALOG_EXPORT_TITLE "画像のエクスポート"
    IDS_VIEWERRAW_DIALOG_FILTER_JPEG "JPEG画像(*.jpg;*.jpeg)"
    IDS_VIEWERRAW_DIALOG_FILTER_PNG "PNG 画像 (*.png)"
    IDS_VIEWERRAW_DIALOG_FILTER_TIFF "TIFF画像(*.tif;*.tiff)"
    IDS_VIEWERRAW_DIALOG_FILTER_BMP "ビットマップ画像 (*.bmp;*.dib)"
    IDS_VIEWERRAW_DIALOG_FILTER_GIF "GIF画像(*.gif)"
    IDS_VIEWERRAW_DIALOG_FILTER_JXR "JPEG XR 画像 (*.jxr;*.wdp;*.hdp)"
    IDS_VIEWERRAW_EXPORT_NO_IMAGE "エクスポートする画像がありません。"
    IDS_VIEWERRAW_EXPORT_UNSUPPORTED_EXTENSION "サポートされていないエクスポート拡張子です。 .png、.jpg/.jpeg、.tif/.tiff、.bmp/.dib、.gif、または .jxr/.wdp/.hdp. を使用します。"
    IDS_VIEWERRAW_STATUS_FILESYSTEM_MISSING "アクティブなファイル システムが見つかりません。"
    IDS_VIEWERRAW_STATUS_UNSUPPORTED_FORMAT "サポートされていないファイル形式です。"
    IDS_VIEWERRAW_STATUS_STORE_OOM "デコードされたイメージを保存中にメモリ不足が発生しました。"
    IDS_VIEWERRAW_STATUS_CANCELED "キャンセルされました。"
    IDS_VIEWERRAW_EXPORT_IMAGE_TOO_LARGE "画像が大きすぎるためエクスポートできません。"
    IDS_VIEWERRAW_EXPORT_BUFFER_TRUNCATED "デコードされた画像バッファが途中で切れています。"
    IDS_VIEWERRAW_EXPORT_TEMP_CREATE_FAILED_FMT "一時エクスポート ファイルを作成できませんでした (HRESULT 0x{0:08X})。"
    IDS_VIEWERRAW_EXPORT_WIC_FACTORY_FAILED_FMT "WIC ファクトリを作成できませんでした (HRESULT 0x{0:08X})。"
    IDS_VIEWERRAW_EXPORT_WIC_STREAM_FAILED_FMT "WIC ストリームを作成できませんでした (HRESULT 0x{0:08X})。"
    IDS_VIEWERRAW_EXPORT_FILE_OPEN_FAILED_FMT "エクスポート ファイルを開けませんでした (HRESULT 0x{0:08X})。"
    IDS_VIEWERRAW_EXPORT_FORMAT_UNSUPPORTED "選択されたエクスポート形式はサポートされていません。"
    IDS_VIEWERRAW_EXPORT_ENCODER_CREATE_FAILED_FMT "画像エンコーダーを作成できませんでした (HRESULT 0x{0:08X})。"
    IDS_VIEWERRAW_EXPORT_ENCODER_INIT_FAILED_FMT "画像エンコーダーを初期化できませんでした (HRESULT 0x{0:08X})。"
    IDS_VIEWERRAW_EXPORT_FRAME_CREATE_FAILED_FMT "画像フレームを作成できませんでした (HRESULT 0x{0:08X})。"
    IDS_VIEWERRAW_EXPORT_FRAME_INIT_FAILED_FMT "画像フレームを初期化できませんでした (HRESULT 0x{0:08X})。"
    IDS_VIEWERRAW_EXPORT_SIZE_FAILED_FMT "エクスポート サイズを設定できませんでした (HRESULT 0x{0:08X})。"
    IDS_VIEWERRAW_EXPORT_PIXEL_FORMAT_FAILED_FMT "エクスポートのピクセル形式を設定できませんでした (HRESULT 0x{0:08X})。"
    IDS_VIEWERRAW_EXPORT_BITMAP_CREATE_FAILED_FMT "ソース ビットマップを作成できませんでした (HRESULT 0x{0:08X})。"
    IDS_VIEWERRAW_EXPORT_PALETTE_CREATE_FAILED_FMT "画像パレットを作成できませんでした (HRESULT 0x{0:08X})。"
    IDS_VIEWERRAW_EXPORT_PALETTE_INIT_FAILED_FMT "画像パレットを初期化できませんでした (HRESULT 0x{0:08X})。"
    IDS_VIEWERRAW_EXPORT_CONVERTER_CREATE_FAILED_FMT "画像コンバーターを作成できませんでした (HRESULT 0x{0:08X})。"
    IDS_VIEWERRAW_EXPORT_INDEXED_CONVERT_FAILED_FMT "画像をインデックス カラーへ変換できませんでした (HRESULT 0x{0:08X})。"
    IDS_VIEWERRAW_EXPORT_TARGET_CONVERT_FAILED_FMT "画像をターゲット形式へ変換できませんでした (HRESULT 0x{0:08X})。"
    IDS_VIEWERRAW_EXPORT_FRAME_WRITE_FAILED_FMT "画像フレームを書き込めませんでした (HRESULT 0x{0:08X})。"
    IDS_VIEWERRAW_EXPORT_FRAME_COMMIT_FAILED_FMT "画像フレームをコミットできませんでした (HRESULT 0x{0:08X})。"
    IDS_VIEWERRAW_EXPORT_ENCODER_COMMIT_FAILED_FMT "画像エンコーダーをコミットできませんでした (HRESULT 0x{0:08X})。"
    IDS_VIEWERRAW_EXPORT_FINALIZE_FAILED_FMT "エクスポートを完了できませんでした (HRESULT 0x{0:08X})。"
    IDS_VIEWERRAW_EXPORT_COM_INIT_FAILED_FMT "エクスポート用の COM を初期化できませんでした (HRESULT 0x{0:08X})。"
    IDS_VIEWERRAW_EXPORT_SUCCESS_FMT "エクスポートしました: {0}"
    IDS_VIEWERRAW_EXPORT_FAILED "画像のエクスポートに失敗しました。"
    IDS_VIEWERRAW_STATUS_ASYNC_RESULT_FAILED "デコードした画像の結果を表示処理へ渡せませんでした。ファイルを開き直してください。"
    IDS_VIEWERRAW_READ_FILESYSTEM_IO_UNSUPPORTED_FMT "現在のファイルシステムではファイル データを開けません (HRESULT 0x{0:08X})。"
    IDS_VIEWERRAW_READ_READER_CREATE_FAILED_FMT "ファイル リーダーを作成できませんでした (HRESULT 0x{0:08X})。"
    IDS_VIEWERRAW_READ_GET_SIZE_FAILED_FMT "ファイル サイズを取得できませんでした (HRESULT 0x{0:08X})。"
    IDS_VIEWERRAW_READ_FILE_EMPTY "ファイルが空です。"
    IDS_VIEWERRAW_READ_FILE_TOO_LARGE_FMT "ファイルが大きすぎるためデコードできません ({0:L} バイト)。"
    IDS_VIEWERRAW_READ_ADDRESS_SPACE_LIMIT "このアドレス空間ではファイルが大きすぎます。"
    IDS_VIEWERRAW_READ_SEEK_FAILED_FMT "ファイル リーダーを先頭へ移動できませんでした (HRESULT 0x{0:08X})。"
    IDS_VIEWERRAW_READ_FAILED_FMT "ファイル データを読み取れませんでした (HRESULT 0x{0:08X})。"
    IDS_VIEWERRAW_READ_PROVIDER_COUNT_INVALID "ファイルシステムから無効なバイト数が返されました。"
    IDS_VIEWERRAW_READ_UNEXPECTED_EOF "宣言されたサイズより前にファイルの終端へ達しました。"
    IDS_VIEWERRAW_READ_SIZE_CHANGED "読み取り中にファイル サイズが変わりました。"
    IDS_VIEWERRAW_RAW_OPEN_FAILED_FMT "RAW デコーダーで画像を開けませんでした: {0} (コード {1})。"
    IDS_VIEWERRAW_RAW_UNPACK_FAILED_FMT "RAW デコーダーで画像を展開できませんでした: {0} (コード {1})。"
    IDS_VIEWERRAW_RAW_DIMENSIONS_LIMIT_FMT "RAW の寸法が画像ポリシーを超えています ({0} × {1})。"
    IDS_VIEWERRAW_RAW_PREFETCH_BUDGET "RAW プレビューがデコード画像のメモリ上限を超えています。"
    IDS_VIEWERRAW_RAW_PROCESS_FAILED_FMT "RAW デコーダーで画像を処理できませんでした: {0} (コード {1})。"
    IDS_VIEWERRAW_RAW_MEMORY_IMAGE_FAILED_FMT "RAW デコーダーで出力画像を作成できませんでした: {0} (コード {1})。"
    IDS_VIEWERRAW_RAW_PIXEL_FORMAT_INVALID "デコードされた RAW のピクセル形式が無効です。"
    IDS_VIEWERRAW_RAW_DECODED_DIMENSIONS_LIMIT_FMT "デコードされた RAW の寸法が画像ポリシーを超えています ({0} × {1})。"
    IDS_VIEWERRAW_RAW_BYTE_COUNT_OVERFLOW "デコードされた RAW のバイト数がこのプラットフォームの上限を超えています。"
    IDS_VIEWERRAW_RAW_SOURCE_BYTE_COUNT_OVERFLOW "デコードされた RAW のソース バイト数がこのプラットフォームの上限を超えています。"
    IDS_VIEWERRAW_RAW_BUFFER_TRUNCATED "デコードされた RAW 画像バッファが途中で切れています。"
    IDS_VIEWERRAW_RAW_OUTPUT_BUDGET "RAW 出力がデコード画像のメモリ上限を超えています。"
END
