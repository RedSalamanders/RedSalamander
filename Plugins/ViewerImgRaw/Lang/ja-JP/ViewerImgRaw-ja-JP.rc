#pragma code_page(65001)
#include "../../resource.h"
#include <winres.h>

LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

IDR_VIEWERRAW_MENU MENU
BEGIN
    POPUP "ファイル(&F)"
    BEGIN
        MENUITEM "更新(&R)\tF5", IDM_VIEWERRAW_FILE_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "エクスポート(&E)...\tCtrl+S", IDM_VIEWERRAW_FILE_EXPORT
        MENUITEM SEPARATOR
        MENUITEM "終了(&X)\tEsc", IDM_VIEWERRAW_FILE_EXIT
    END
    POPUP "その他のファイル(&O)"
    BEGIN
        MENUITEM "次へ(&N)\tRight, PgDn, Space", IDM_VIEWERRAW_OTHER_NEXT
        MENUITEM "前へ(&P)\tLeft, PgUp, Backspace", IDM_VIEWERRAW_OTHER_PREVIOUS
        MENUITEM "最初(&F)\tHome", IDM_VIEWERRAW_OTHER_FIRST
        MENUITEM "最後(&L)\tEnd", IDM_VIEWERRAW_OTHER_LAST
    END
    POPUP "表示(&V)"
    BEGIN
        MENUITEM "窓に合わせる(&F)\tCtrl+F, Double Click", IDM_VIEWERRAW_VIEW_FIT
        MENUITEM "実際のサイズ (100%)(&A)\t1, Ctrl+Double Click", IDM_VIEWERRAW_VIEW_ACTUAL_SIZE
        MENUITEM "フィットを切り替え/100%\tF", IDM_VIEWERRAW_VIEW_TOGGLE_FIT_100
        MENUITEM SEPARATOR
        MENUITEM "ズームイン(&I)\t+", IDM_VIEWERRAW_VIEW_ZOOM_IN
        MENUITEM "ズームアウト(&O)\t-", IDM_VIEWERRAW_VIEW_ZOOM_OUT
        MENUITEM "ズームリセット(&R)\t0", IDM_VIEWERRAW_VIEW_ZOOM_RESET
        MENUITEM SEPARATOR
        POPUP "トランスフォーム(&T)"
        BEGIN
            MENUITEM "時計回りに回転(&C)\tR", IDM_VIEWERRAW_VIEW_ROTATE_CW
            MENUITEM "反時計回りに回転(&C)\tCtrl+R, Shift+R", IDM_VIEWERRAW_VIEW_ROTATE_CCW
            MENUITEM SEPARATOR
            MENUITEM "水平方向に反転(&H)\tH", IDM_VIEWERRAW_VIEW_FLIP_HORIZONTAL
            MENUITEM "垂直方向に反転(&V)\tV", IDM_VIEWERRAW_VIEW_FLIP_VERTICAL
            MENUITEM SEPARATOR
            MENUITEM "向きをリセット(&R)\tO", IDM_VIEWERRAW_VIEW_RESET_ORIENTATION
        END
        POPUP "調整する(&A)"
        BEGIN
            MENUITEM "明るさ+\tCtrl+Alt+Up", IDM_VIEWERRAW_VIEW_BRIGHTNESS_INCREASE
            MENUITEM "明るさ -\tCtrl+Alt+Down", IDM_VIEWERRAW_VIEW_BRIGHTNESS_DECREASE
            MENUITEM "コントラスト+\tCtrl+Alt+Right", IDM_VIEWERRAW_VIEW_CONTRAST_INCREASE
            MENUITEM "コントラスト -\tCtrl+Alt+Left", IDM_VIEWERRAW_VIEW_CONTRAST_DECREASE
            MENUITEM "ガンマ+\tCtrl+Alt+PgUp", IDM_VIEWERRAW_VIEW_GAMMA_INCREASE
            MENUITEM "ガンマ -\tCtrl+Alt+PgDn", IDM_VIEWERRAW_VIEW_GAMMA_DECREASE
            MENUITEM SEPARATOR
            MENUITEM "グレースケール(&G)\tG", IDM_VIEWERRAW_VIEW_TOGGLE_GRAYSCALE
            MENUITEM "ネガティブ(&N)\tN", IDM_VIEWERRAW_VIEW_TOGGLE_NEGATIVE
        END
        MENUITEM SEPARATOR
        POPUP "画像ソース(&S)"
        BEGIN
            MENUITEM "RAW (デコードされた)(&R)", IDM_VIEWERRAW_VIEW_SOURCE_RAW
            MENUITEM "サムネイル(&T)", IDM_VIEWERRAW_VIEW_SOURCE_THUMBNAIL
        END
        MENUITEM SEPARATOR
        MENUITEM "Exif オーバーレイを表示(&E)\tI", IDM_VIEWERRAW_VIEW_SHOW_EXIF_OVERLAY
    END
END

STRINGTABLE
BEGIN
    IDS_VIEWERRAW_NAME "画像"
    IDS_VIEWERRAW_DESCRIPTION "画像ビューアー (WIC + LibRaw)"
    IDS_VIEWERRAW_TITLE_FORMAT "{0} - 画像"
    IDS_VIEWERRAW_STATUS_LOADING "読み込み中..."
    IDS_VIEWERRAW_STATUS_ERROR "画像の読み込みに失敗しました。"
    IDS_VIEWERRAW_STATUS_NO_IMAGE "画像がありません。"
    IDS_VIEWERRAW_DIALOG_EXPORT_TITLE "画像のエクスポート"
    IDS_VIEWERRAW_DIALOG_FILTER_JPEG "JPEG画像(*.jpg;*.jpeg)"
    IDS_VIEWERRAW_DIALOG_FILTER_PNG "PNG 画像 (*.png)"
    IDS_VIEWERRAW_DIALOG_FILTER_TIFF "TIFF画像(*.tif;*.tiff)"
    IDS_VIEWERRAW_DIALOG_FILTER_BMP "ビットマップ画像 (*.bmp;*.dib)"
    IDS_VIEWERRAW_DIALOG_FILTER_GIF "GIF画像(*.gif)"
    IDS_VIEWERRAW_DIALOG_FILTER_JXR "JPEG XR 画像 (*.jxr;*.wdp;*.hdp)"
    IDS_VIEWERRAW_EXPORT_NO_IMAGE "エクスポートする画像がありません。"
    IDS_VIEWERRAW_EXPORT_UNSUPPORTED_EXTENSION "サポートされていないエクスポート拡張子です。 .png、.jpg/.jpeg、.tif/.tiff、.bmp/.dib、.gif、または .jxr/.wdp/.hdp. を使用します。"
    IDS_VIEWERRAW_STATUS_FILESYSTEM_MISSING "アクティブなファイル システムが見つかりません。"
    IDS_VIEWERRAW_STATUS_UNSUPPORTED_FORMAT "サポートされていないファイル形式です。"
    IDS_VIEWERRAW_STATUS_STORE_OOM "デコードされたイメージを保存中にメモリ不足が発生しました。"
END
