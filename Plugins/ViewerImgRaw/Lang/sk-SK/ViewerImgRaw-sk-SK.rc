#pragma code_page(65001)
#include "../../resource.h"
#include <winres.h>

LANGUAGE LANG_SLOVAK, SUBLANG_DEFAULT

IDR_VIEWERRAW_MENU MENU
BEGIN
    POPUP "&Súbor"
    BEGIN
        MENUITEM "&Obnoviť\tF5", IDM_VIEWERRAW_FILE_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "&Exportovať...\tCtrl+S", IDM_VIEWERRAW_FILE_EXPORT
        MENUITEM SEPARATOR
        MENUITEM "&Koniec\tEsc", IDM_VIEWERRAW_FILE_EXIT
    END
    POPUP "&Iné súbory"
    BEGIN
        MENUITEM "&Ďalej\tRight, PgDn, Space", IDM_VIEWERRAW_OTHER_NEXT
        MENUITEM "&Predchádzajúce\tLeft, PgUp, Backspace", IDM_VIEWERRAW_OTHER_PREVIOUS
        MENUITEM "&Po prvé\tHome", IDM_VIEWERRAW_OTHER_FIRST
        MENUITEM "&Posledný\tEnd", IDM_VIEWERRAW_OTHER_LAST
    END
    POPUP "&Zobrazenie"
    BEGIN
        MENUITEM "&Prispôsobiť oknu\tCtrl+F, Double Click", IDM_VIEWERRAW_VIEW_FIT
        MENUITEM "&Skutočná veľkosť (100 %)\t1, Ctrl+Double Click", IDM_VIEWERRAW_VIEW_ACTUAL_SIZE
        MENUITEM "Prepnúť prispôsobenie/100 %\tF", IDM_VIEWERRAW_VIEW_TOGGLE_FIT_100
        MENUITEM SEPARATOR
        MENUITEM "&Priblížiť\t+", IDM_VIEWERRAW_VIEW_ZOOM_IN
        MENUITEM "&Oddialiť\t-", IDM_VIEWERRAW_VIEW_ZOOM_OUT
        MENUITEM "&Resetovať priblíženie\t0", IDM_VIEWERRAW_VIEW_ZOOM_RESET
        MENUITEM SEPARATOR
        POPUP "&Transformovať"
        BEGIN
            MENUITEM "&Otočte v smere hodinových ručičiek\tR", IDM_VIEWERRAW_VIEW_ROTATE_CW
            MENUITEM "&Otočte proti smeru hodinových ručičiek\tCtrl+R, Shift+R", IDM_VIEWERRAW_VIEW_ROTATE_CCW
            MENUITEM SEPARATOR
            MENUITEM "&Prevrátiť horizontálne\tH", IDM_VIEWERRAW_VIEW_FLIP_HORIZONTAL
            MENUITEM "&Prevrátiť vertikálne\tV", IDM_VIEWERRAW_VIEW_FLIP_VERTICAL
            MENUITEM SEPARATOR
            MENUITEM "&Obnoviť orientáciu\tO", IDM_VIEWERRAW_VIEW_RESET_ORIENTATION
        END
        POPUP "&Upraviť"
        BEGIN
            MENUITEM "Jas +\tCtrl+Alt+Up", IDM_VIEWERRAW_VIEW_BRIGHTNESS_INCREASE
            MENUITEM "Jas -\tCtrl+Alt+Down", IDM_VIEWERRAW_VIEW_BRIGHTNESS_DECREASE
            MENUITEM "Kontrast +\tCtrl+Alt+Right", IDM_VIEWERRAW_VIEW_CONTRAST_INCREASE
            MENUITEM "kontrast -\tCtrl+Alt+Left", IDM_VIEWERRAW_VIEW_CONTRAST_DECREASE
            MENUITEM "Gamma +\tCtrl+Alt+PgUp", IDM_VIEWERRAW_VIEW_GAMMA_INCREASE
            MENUITEM "gama -\tCtrl+Alt+PgDn", IDM_VIEWERRAW_VIEW_GAMMA_DECREASE
            MENUITEM SEPARATOR
            MENUITEM "&Odtiene šedej\tG", IDM_VIEWERRAW_VIEW_TOGGLE_GRAYSCALE
            MENUITEM "&Negatívne\tN", IDM_VIEWERRAW_VIEW_TOGGLE_NEGATIVE
        END
        MENUITEM SEPARATOR
        POPUP "&Zdroj obrázka"
        BEGIN
            MENUITEM "&RAW (dekódované)", IDM_VIEWERRAW_VIEW_SOURCE_RAW
            MENUITEM "&Miniatúra", IDM_VIEWERRAW_VIEW_SOURCE_THUMBNAIL
        END
        MENUITEM SEPARATOR
        MENUITEM "&Zobraziť prekrytie Exif\tI", IDM_VIEWERRAW_VIEW_SHOW_EXIF_OVERLAY
    END
END

