#pragma code_page(65001)
#include "../../resource.h"
#include <winres.h>

LANGUAGE LANG_CZECH, SUBLANG_DEFAULT

IDR_VIEWERRAW_MENU MENU
BEGIN
    POPUP "&Soubor"
    BEGIN
        MENUITEM "&Obnovit\tF5", IDM_VIEWERRAW_FILE_REFRESH
        MENUITEM SEPARATOR
        MENUITEM "&Exportovat...\tCtrl+S", IDM_VIEWERRAW_FILE_EXPORT
        MENUITEM SEPARATOR
        MENUITEM "&Konec\tEsc", IDM_VIEWERRAW_FILE_EXIT
    END
    POPUP "&Jiné soubory"
    BEGIN
        MENUITEM "&Další\tRight, PgDn, Space", IDM_VIEWERRAW_OTHER_NEXT
        MENUITEM "&Předchozí\tLeft, PgUp, Backspace", IDM_VIEWERRAW_OTHER_PREVIOUS
        MENUITEM "&Za prvé\tHome", IDM_VIEWERRAW_OTHER_FIRST
        MENUITEM "&Poslední\tEnd", IDM_VIEWERRAW_OTHER_LAST
    END
    POPUP "&Zobrazení"
    BEGIN
        MENUITEM "&Přizpůsobit oknu\tCtrl+F, Double Click", IDM_VIEWERRAW_VIEW_FIT
        MENUITEM "&Skutečná velikost (100 %)\t1, Ctrl+Double Click", IDM_VIEWERRAW_VIEW_ACTUAL_SIZE
        MENUITEM "Přepnout přizpůsobení/100 %\tF", IDM_VIEWERRAW_VIEW_TOGGLE_FIT_100
        MENUITEM SEPARATOR
        MENUITEM "&Přiblížit\t+", IDM_VIEWERRAW_VIEW_ZOOM_IN
        MENUITEM "&Oddálit\t-", IDM_VIEWERRAW_VIEW_ZOOM_OUT
        MENUITEM "&Resetování zoomu\t0", IDM_VIEWERRAW_VIEW_ZOOM_RESET
        MENUITEM SEPARATOR
        POPUP "&Transformace"
        BEGIN
            MENUITEM "&Otočit ve směru hodinových ručiček\tR", IDM_VIEWERRAW_VIEW_ROTATE_CW
            MENUITEM "&Otočte proti směru hodinových ručiček\tCtrl+R, Shift+R", IDM_VIEWERRAW_VIEW_ROTATE_CCW
            MENUITEM SEPARATOR
            MENUITEM "&Překlopit vodorovně\tH", IDM_VIEWERRAW_VIEW_FLIP_HORIZONTAL
            MENUITEM "&Převrátit svisle\tV", IDM_VIEWERRAW_VIEW_FLIP_VERTICAL
            MENUITEM SEPARATOR
            MENUITEM "&Obnovit orientaci\tO", IDM_VIEWERRAW_VIEW_RESET_ORIENTATION
        END
        POPUP "&Upravte"
        BEGIN
            MENUITEM "Jas +\tCtrl+Alt+Up", IDM_VIEWERRAW_VIEW_BRIGHTNESS_INCREASE
            MENUITEM "Jas -\tCtrl+Alt+Down", IDM_VIEWERRAW_VIEW_BRIGHTNESS_DECREASE
            MENUITEM "Kontrast +\tCtrl+Alt+Right", IDM_VIEWERRAW_VIEW_CONTRAST_INCREASE
            MENUITEM "Kontrast -\tCtrl+Alt+Left", IDM_VIEWERRAW_VIEW_CONTRAST_DECREASE
            MENUITEM "Gama +\tCtrl+Alt+PgUp", IDM_VIEWERRAW_VIEW_GAMMA_INCREASE
            MENUITEM "gama -\tCtrl+Alt+PgDn", IDM_VIEWERRAW_VIEW_GAMMA_DECREASE
            MENUITEM SEPARATOR
            MENUITEM "&Stupně šedi\tG", IDM_VIEWERRAW_VIEW_TOGGLE_GRAYSCALE
            MENUITEM "&Negativní\tN", IDM_VIEWERRAW_VIEW_TOGGLE_NEGATIVE
        END
        MENUITEM SEPARATOR
        POPUP "&Zdroj obrázku"
        BEGIN
            MENUITEM "&RAW (dekódované)", IDM_VIEWERRAW_VIEW_SOURCE_RAW
            MENUITEM "&Náhled", IDM_VIEWERRAW_VIEW_SOURCE_THUMBNAIL
        END
        MENUITEM SEPARATOR
        MENUITEM "&Zobrazit překrytí Exif\tI", IDM_VIEWERRAW_VIEW_SHOW_EXIF_OVERLAY
    END
END

