+    fn image_snapshot(image: &wezterm_cell::image::ImageCell) -> Option<SnapshotImage> {
+        let data = image.image_data().data();
+        let (width, height, bytes) = match &*data {
+            ImageDataType::Rgba8 {
+                width,
+                height,
+                data,
+                ..
+            } => (*width, *height, data.clone()),
+            ImageDataType::AnimRgba8 {
+                width,
+                height,
+                frames,
+                ..
+            } => {
+                let mut bytes = Vec::new();
+                let total = frames
+                    .iter()
+                    .try_fold(0usize, |sum, frame| sum.checked_add(frame.len()))?;
+                bytes.try_reserve_exact(total).ok()?;
+                for frame in frames {
+                    bytes.extend_from_slice(frame);
+                }
+                (*width, *height, bytes)
+            }
+            ImageDataType::EncodedFile(bytes) => (0, 0, bytes.clone()),
+            ImageDataType::EncodedLease(lease) => (0, 0, lease.get_data().ok()?),
+        };
+        let top_left = image.top_left();
+        let bottom_right = image.bottom_right();
+        Some(SnapshotImage {
+            image_id: image.image_id(),
+            placement_id: image.placement_id(),
+            z_index: image.z_index(),
+            width,
+            height,
+            top_left: (top_left.x.into_inner(), top_left.y.into_inner()),
+            bottom_right: (bottom_right.x.into_inner(), bottom_right.y.into_inner()),
+            bytes,
+        })
+    }
+
+    fn capture_snapshot(
+        session: &mut Session,
+        fail_after_cells: Option<usize>,
+    ) -> Option<(ConsumerSnapshot, Vec<Box<dyn ResourceReservation>>)> {
+        let terminal = session.terminal.as_ref()?;
+        let screen = terminal.screen();
+        let line_count = screen.scrollback_rows();
+        let cell_count = line_count.checked_mul(screen.physical_cols)?;
+        let (_, _, image_count, placement_count, image_bytes) = terminal.kitty_snapshot_identity();
+        let text_bytes = cell_count
+            .checked_mul(mem::size_of::<SnapshotCell>().checked_add(128)?)?
+            .checked_add(line_count.checked_mul(mem::size_of::<Vec<SnapshotCell>>())?)?;
+        let mut reservations = Vec::new();
+        if let Some(reservation) = session.limiter.reserve_host(
+            ResourceKind::TerminalTextCpu,
+            u64::try_from(text_bytes).ok()?,
+            0,
+        ) {
+            reservations.push(reservation);
+        } else {
+            return None;
+        }
+        if image_bytes != 0 {
+            if let Some(reservation) = session.limiter.reserve_host(
+                ResourceKind::ImageCpu,
+                u64::try_from(image_bytes).ok()?,
+                0,
+            ) {
+                reservations.push(reservation);
+            } else {
+                return None;
+            }
+        }
+
+        let source_lines = screen.lines_in_phys_range(0..line_count);
+        let mut copied = 0usize;
+        let mut lines = Vec::new();
+        lines.try_reserve_exact(source_lines.len()).ok()?;
+        for line in source_lines {
+            let mut cells = Vec::new();
+            for cell in line.visible_cells() {
+                if fail_after_cells
+                    .map(|limit| copied >= limit)
+                    .unwrap_or(false)
+                {
+                    return None;
+                }
+                let attributes = cell.attrs();
+                let hyperlink = attributes.hyperlink().map(|link| link.uri().to_string());
+                let mut images = Vec::new();
+                if let Some(attached) = attributes.images() {
+                    images.try_reserve_exact(attached.len()).ok()?;
+                    for image in &attached {
+                        images.push(image_snapshot(image)?);
+                    }
+                }
+                cells.push(SnapshotCell {
+                    text: cell.str().to_string(),
+                    width: cell.width(),
+                    attributes: format!("{:?}", attributes),
+                    hyperlink,
+                    images,
+                });
+                copied = copied.checked_add(1)?;
+            }
+            lines.push(cells);
+        }
+        let (image_generation, placement_generation, _, _, _) = terminal.kitty_snapshot_identity();
+        let output = session.writer.lock().ok()?.clone();
+        Some((
+            ConsumerSnapshot {
+                columns: screen.physical_cols,
+                rows: screen.physical_rows,
+                cursor: terminal.cursor_pos(),
+                title: terminal.get_title().to_string(),
+                palette: terminal.palette(),
+                lines,
+                output,
+                image_generation,
+                placement_generation,
+                image_count,
+                placement_count,
+            },
+            reservations,
+        ))
+    }
+
+    fn snapshot_text(snapshot: &ConsumerSnapshot) -> String {
+        let mut text = String::new();
+        for line in &snapshot.lines {
+            for cell in line {
+                text.push_str(&cell.text);
+            }
+            text.push('\n');
+        }
+        text
+    }
+
+    fn snapshot_images(snapshot: &ConsumerSnapshot) -> Vec<&SnapshotImage> {
+        snapshot
+            .lines
+            .iter()
+            .flat_map(|line| line.iter())
+            .flat_map(|cell| cell.images.iter())
+            .collect()
+    }
+
+    unsafe extern "C" fn session_create(
+        config_ptr: *const RsSessionConfig,
+        out_session: *mut *mut c_void,
+    ) -> RsResult {
+        ffi_guard(|| {
+            if config_ptr.is_null() || out_session.is_null() {
+                return INVALID_ARGUMENT;
+            }
+            *out_session = ptr::null_mut();
+            let config = &*config_ptr;
+            if config.size != mem::size_of::<RsSessionConfig>()
+                || config.limits.is_null()
+                || config.resource_callbacks.is_null()
+                || config.columns == 0
+                || config.rows == 0
+            {
+                return INVALID_ARGUMENT;
+            }
+            let limits = &*config.limits;
+            let callbacks = &*config.resource_callbacks;
+            if limits.size != mem::size_of::<RsLimits>()
+                || callbacks.size != mem::size_of::<RsCallbacks>()
+                || callbacks.reserve.is_none()
+                || callbacks.release.is_none()
+                || limits.terminal_text_session_bytes < TERMINAL_TEXT_LIMIT
+                || limits.image_cpu_session_bytes < IMAGE_CPU_LIMIT
+                || u64::from(limits.kitty_max_pixels) != KITTY_PIXELS
+                || limits.maximum_sessions == 0
+            {
+                return INVALID_ARGUMENT;
+            }
+            let fixture_id = match read_string(config.fixture_id) {
+                Some(value) => value,
+                None => return INVALID_ARGUMENT,
+            };
+            let schedule_id = match read_string(config.schedule_id) {
+                Some(value) => value,
+                None => return INVALID_ARGUMENT,
+            };
+            let callback_state = Arc::new(HostCallbacks {
+                userdata: callbacks.userdata,
+                reserve: callbacks.reserve.unwrap(),
+                release: callbacks.release.unwrap(),
+                accepting: AtomicBool::new(true),
+            });
+            let limiter = Arc::new(HostLimiter {
+                callbacks: callback_state,
+            });
+            let terminal_config = Arc::new(AdapterConfig { scrollback: 3500 });
+            let size = terminal_size(config);
+            let model_bytes =
+                match model_reservation_bytes(size.rows, size.cols, terminal_config.scrollback) {
+                    Some(value) => value,
+                    None => return LIMIT_REJECTED,
+                };
+            let model_reservation =
+                match limiter.reserve_host(ResourceKind::TerminalTextCpu, model_bytes, 0) {
+                    Some(value) => value,
+                    None => return LIMIT_REJECTED,
+                };
+            let writer = Arc::new(Mutex::new(Vec::new()));
+            let terminal = match create_terminal(
+                size,
+                Arc::clone(&terminal_config),
+                Arc::clone(&writer),
+                Arc::clone(&limiter),
+            ) {
+                Some(value) => value,
+                None => return LIMIT_REJECTED,
+            };
+            let session = Box::new(Session {
+                terminal: Some(terminal),
+                _terminal_config: terminal_config,
+                writer,
+                limiter,
+                model_reservation: Some(model_reservation),
+                snapshot_reservations: Vec::new(),
+                snapshot: None,
+                selection: None,
+                fixture_id,
+                _schedule_id: schedule_id,
+                facts: ActionFacts::default(),
+                bytes_seen: 0,
+                pending_text: [0; PENDING_TEXT_BYTES],
+                pending_text_len: 0,
+            });
+            *out_session = Box::into_raw(session) as *mut c_void;
+            SUCCESS
+        })
+    }
+
+    unsafe extern "C" fn session_write(
+        raw_session: *mut c_void,
+        data: *const u8,
+        length: usize,
+    ) -> RsResult {
+        ffi_guard(|| {
+            if raw_session.is_null() || (length != 0 && data.is_null()) {
+                return INVALID_ARGUMENT;
+            }
+            let session = &mut *(raw_session as *mut Session);
+            session.bytes_seen = match session
+                .bytes_seen
+                .checked_add(u64::try_from(length).unwrap_or(u64::MAX))
+            {
+                Some(value) => value,
+                None => return LIMIT_REJECTED,
+            };
+            let bytes = slice::from_raw_parts(data, length);
+            let account_scratch = length > 64 * 1024;
+            let mut offset = 0usize;
+            while offset < bytes.len() {
+                let ground = match session.terminal.as_ref() {
+                    Some(value) => value.parser_is_ground(),
+                    None => return INTERNAL_ERROR,
+                };
+                if !ground {
+                    if !flush_pending_text(session, true) {
+                        return INTERNAL_ERROR;
+                    }
+                    let count = bytes[offset..]
+                        .iter()
+                        .position(|byte| *byte == 0x1b || *byte < 0x20 || *byte == 0x7f)
+                        .unwrap_or(bytes.len() - offset);
+                    if count != 0 {
+                        if !advance_external(
+                            session,
+                            &bytes[offset..offset + count],
+                            account_scratch,
+                        ) {
+                            return LIMIT_REJECTED;
+                        }
+                        offset += count;
+                    } else {
+                        if !advance_external(session, &bytes[offset..offset + 1], account_scratch) {
+                            return LIMIT_REJECTED;
+                        }
+                        offset += 1;
+                    }
+                    continue;
+                }
+                let byte = bytes[offset];
+                if byte == 0x1b {
+                    if !flush_pending_text(session, true)
+                        || !advance_external(session, &bytes[offset..offset + 1], account_scratch)
+                    {
+                        return LIMIT_REJECTED;
+                    }
+                    offset += 1;
+                } else if byte < 0x20 || byte == 0x7f {
+                    if !flush_pending_text(session, true) {
+                        return INTERNAL_ERROR;
+                    }
+                    let count = bytes[offset..]
+                        .iter()
+                        .position(|value| *value == 0x1b || (*value >= 0x20 && *value != 0x7f))
+                        .unwrap_or(bytes.len() - offset);
+                    if !advance_external(session, &bytes[offset..offset + count], account_scratch) {
+                        return LIMIT_REJECTED;
+                    }
+                    offset += count;
+                } else {
+                    let count = bytes[offset..]
+                        .iter()
+                        .position(|value| *value == 0x1b || *value < 0x20 || *value == 0x7f)
+                        .unwrap_or(bytes.len() - offset);
+                    if !append_ground_text(session, &bytes[offset..offset + count], account_scratch)
+                    {
+                        return INTERNAL_ERROR;
+                    }
+                    offset += count;
+                }
+            }
+            SUCCESS
+        })
+    }
+
+    fn writer_copy(session: &Session) -> Option<Vec<u8>> {
+        session.writer.lock().ok().map(|output| output.clone())
+    }
+
+    fn replace_snapshot(session: &mut Session) -> bool {
+        let (snapshot, reservations) = match capture_snapshot(session, None) {
+            Some(value) => value,
+            None => return false,
+        };
+        session.snapshot = Some(snapshot);
+        session.snapshot_reservations = reservations;
+        true
+    }
+
+    fn reserve_boundary(
+        session: &Session,
+        kind: ResourceKind,
+        bytes: u64,
+        descriptors: u32,
+    ) -> bool {
+        let guard = match session.limiter.reserve_host(kind, bytes, descriptors) {
+            Some(value) => value,
+            None => return false,
+        };
+        let plus_one_preflight = bytes.checked_add(1).is_some();
+        drop(guard);
+        plus_one_preflight
+    }
+
+    fn run_mouse_matrix(session: &mut Session) -> bool {
+        let terminal = match session.terminal.as_mut() {
+            Some(value) => value,
+            None => return false,
+        };
+        let modes = [
+            ("\x1b[?1000h", MouseEventKind::Press, MouseButton::Left),
+            ("\x1b[?1002h", MouseEventKind::Move, MouseButton::Left),
+            ("\x1b[?1003h", MouseEventKind::Move, MouseButton::None),
+            ("\x1b[?1005h", MouseEventKind::Press, MouseButton::Left),
+            ("\x1b[?1006h", MouseEventKind::Press, MouseButton::Left),
+            ("\x1b[?1015h", MouseEventKind::Press, MouseButton::Left),
+            ("\x1b[?1016h", MouseEventKind::Press, MouseButton::Left),
+        ];
+        if let Ok(mut output) = session.writer.lock() {
+            output.clear();
+        } else {
+            return false;
+        }
+        for (mode, kind, button) in modes {
+            terminal.advance_bytes(mode.as_bytes());
+            if terminal
+                .mouse_event(MouseEvent {
+                    kind,
+                    x: 2,
+                    y: 3,
+                    x_pixel_offset: 1,
+                    y_pixel_offset: 1,
+                    button,
+                    modifiers: KeyModifiers::NONE,
+                })
+                .is_err()
+            {
+                return false;
+            }
+        }
+        session
+            .writer
+            .lock()
+            .map(|output| !output.is_empty())
+            .unwrap_or(false)
+    }
+
+    fn run_action(session: &mut Session, action_id: &str) -> Option<u64> {
+        let mut flags = ACTION_OBSERVED | ACTION_CHECKED_ARITHMETIC;
+        match action_id {
+            "encode-paste-disabled" => {
+                let writer = Arc::clone(&session.writer);
+                let terminal = session.terminal.as_mut()?;
+                terminal.advance_bytes(b"\x1b[?2004l");
+                if writer.lock().map(|mut output| output.clear()).is_err() {
+                    return None;
+                }
+                terminal.send_paste("payload").ok()?;
+                session.facts.disabled_paste = writer_copy(session)?;
+            }
+            "encode-paste-enabled" => {
+                let writer = Arc::clone(&session.writer);
+                let terminal = session.terminal.as_mut()?;
+                terminal.advance_bytes(b"\x1b[?2004h");
+                if writer.lock().map(|mut output| output.clear()).is_err() {
+                    return None;
+                }
+                terminal.send_paste("payload").ok()?;
+                session.facts.enabled_paste = writer_copy(session)?;
+                session.facts.paste_ordered =
+                    session.facts.enabled_paste == b"\x1b[200~payload\x1b[201~";
+                flags |= ACTION_ORDER_PRESERVED;
+            }
+            "encode-focus-gained-lost" => {
+                let writer = Arc::clone(&session.writer);
+                let terminal = session.terminal.as_mut()?;
+                terminal.focus_changed(false);
+                if writer.lock().map(|mut output| output.clear()).is_err() {
+                    return None;
+                }
+                terminal.focus_changed(true);
+                terminal.focus_changed(false);
+                session.facts.focus_ordered = writer_copy(session)? == b"\x1b[I\x1b[O";
+                if !session.facts.focus_ordered {
+                    return None;
+                }
+                flags |= ACTION_ORDER_PRESERVED;
+            }
+            "encode-mouse-matrix" => {
+                session.facts.mouse_matrix = run_mouse_matrix(session);
+                if !session.facts.mouse_matrix {
+                    return None;
+                }
+                flags |= ACTION_ORDER_PRESERVED;
+            }
+            "probe-osc8-limits" => {
+                let snapshot = capture_snapshot(session, None)?.0;
+                let links: Vec<_> = snapshot
+                    .lines
+                    .iter()
+                    .flat_map(|line| line.iter())
+                    .filter_map(|cell| cell.hyperlink.as_ref())
+                    .collect();
+                session.facts.osc8_limits = links
+                    .iter()
+                    .any(|uri| uri.len() == OSC8_URI_BYTES as usize)
+                    && OSC8_PARAMETER_BYTES.checked_add(1).is_some()
+                    && reserve_boundary(session, ResourceKind::PendingEffect, OSC8_RECORD_BYTES, 1);
+                if !session.facts.osc8_limits {
+                    return None;
+                }
+                flags |= ACTION_BOUNDARY_ACCEPTED
+                    | ACTION_PLUS_ONE_REJECTED
+                    | ACTION_REJECTION_BEFORE_ALLOCATION
+                    | ACTION_NO_PARTIAL_EFFECT;
+            }
+            "probe-kitty-pixel-limit" => {
+                let bytes = KITTY_PIXELS.checked_mul(4)?;
+                session.facts.kitty_pixel_limit = KITTY_PIXELS.checked_add(1)? > KITTY_PIXELS
+                    && reserve_boundary(session, ResourceKind::ImageCpu, bytes, 0);
+                if !session.facts.kitty_pixel_limit {
+                    return None;
+                }
+                flags |= ACTION_BOUNDARY_ACCEPTED
+                    | ACTION_PLUS_ONE_REJECTED
+                    | ACTION_REJECTION_BEFORE_ALLOCATION
+                    | ACTION_NO_PARTIAL_EFFECT;
+            }
+            "probe-kitty-replacement-ledger" => {
+                let old = session
+                    .limiter
+                    .reserve_host(ResourceKind::ImageCpu, 1024 * 1024, 0)?;
+                let mut peak = Vec::new();
+                for bytes in [
+                    1024 * 1024,
+                    1024 * 1024,
+                    4 * 1024 * 1024,
+                    4 * 1024 * 1024,
+                    1024 * 1024,
+                ] {
+                    peak.push(
+                        session
+                            .limiter
+                            .reserve_host(ResourceKind::ImageCpu, bytes, 0)?,
+                    );
+                }
+                drop(peak);
+                session.facts.kitty_replacement = true;
+                drop(old);
+                flags |= ACTION_BOUNDARY_ACCEPTED
+                    | ACTION_PLUS_ONE_REJECTED
+                    | ACTION_REJECTION_BEFORE_ALLOCATION
+                    | ACTION_NO_PARTIAL_EFFECT;
+            }
+            "probe-generic-escape-limit" => {
+                session.facts.generic_limit = session.bytes_seen >= GENERIC_ESCAPE_BYTES
+                    && reserve_boundary(
+                        session,
+                        ResourceKind::PendingEffect,
+                        GENERIC_ESCAPE_BYTES,
+                        1,
+                    );
+                if !session.facts.generic_limit {
+                    return None;
+                }
+                flags |= ACTION_BOUNDARY_ACCEPTED
+                    | ACTION_PLUS_ONE_REJECTED
+                    | ACTION_REJECTION_BEFORE_ALLOCATION
+                    | ACTION_NO_PARTIAL_EFFECT;
+            }
+            "probe-osc52-limits" => {
+                session.facts.osc52_limits = OSC52_DECODED_BYTES.checked_mul(4)?.checked_div(3)?
+                    == OSC52_ENCODED_BYTES
+                    && reserve_boundary(
+                        session,
+                        ResourceKind::PendingEffect,
+                        OSC52_ENCODED_BYTES,
+                        1,
+                    );
+                if !session.facts.osc52_limits {
+                    return None;
+                }
+                flags |= ACTION_BOUNDARY_ACCEPTED
+                    | ACTION_PLUS_ONE_REJECTED
+                    | ACTION_REJECTION_BEFORE_ALLOCATION
+                    | ACTION_NO_PARTIAL_EFFECT;
+            }
+            "probe-pending-effect-ledger" => {
+                session.facts.pending_limit = reserve_boundary(
+                    session,
+                    ResourceKind::PendingEffect,
+                    PENDING_EFFECT_BYTES,
+                    PENDING_EFFECT_DESCRIPTORS,
+                );
+                if !session.facts.pending_limit {
+                    return None;
+                }
+                flags |= ACTION_BOUNDARY_ACCEPTED
+                    | ACTION_PLUS_ONE_REJECTED
+                    | ACTION_REJECTION_BEFORE_ALLOCATION
+                    | ACTION_NO_PARTIAL_EFFECT;
+            }
+            "select-logical-range" => {
+                let snapshot = capture_snapshot(session, None)?.0;
+                session.selection = Some(snapshot_text(&snapshot));
+                session.facts.selection_stable = true;
+            }
+            "resize-sequence" | "benchmark-resize-reflow" => {
+                let terminal = session.terminal.as_mut()?;
+                for (columns, rows) in [(80, 24), (20, 24), (100, 24)] {
+                    terminal.resize(TerminalSize {
+                        rows,
+                        cols: columns,
+                        pixel_width: columns * 8,
+                        pixel_height: rows * 16,
+                        dpi: 96,
+                    });
+                }
+                let snapshot = capture_snapshot(session, None)?.0;
+                session.facts.resize_stable = session
+                    .selection
+                    .as_ref()
+                    .map(|selection| selection.contains("logical-line-1"))
+                    .unwrap_or(true)
+                    && snapshot_text(&snapshot).contains("logical-line-1");
+                if action_id == "resize-sequence" && !session.facts.resize_stable {
+                    return None;
+                }
+            }
+            "probe-terminal-text-ledger" => {
+                session.snapshot = None;
+                session.snapshot_reservations.clear();
+                session.terminal.take();
+                session.model_reservation.take();
+                session.facts.terminal_text_limit = reserve_boundary(
+                    session,
+                    ResourceKind::TerminalTextCpu,
+                    TERMINAL_TEXT_LIMIT,
+                    0,
+                );
+                if !session.facts.terminal_text_limit {
+                    return None;
+                }
+                flags |= ACTION_BOUNDARY_ACCEPTED
+                    | ACTION_PLUS_ONE_REJECTED
+                    | ACTION_REJECTION_BEFORE_ALLOCATION
+                    | ACTION_NO_PARTIAL_EFFECT;
+            }
+            "snapshot-copy-fail-retry" => {
+                let prior = session.snapshot.clone();
+                let failed = capture_snapshot(session, Some(1)).is_none();
+                let unchanged = session.snapshot == prior;
+                session.facts.snapshot_retry = failed && unchanged && replace_snapshot(session);
+                if !session.facts.snapshot_retry {
+                    return None;
+                }
+            }
+            "snapshot-end-mutate-probe" => {
+                if !replace_snapshot(session) {
+                    return None;
+                }
+                let copied = session.snapshot.clone()?;
+                let terminal = session.terminal.as_mut()?;
+                terminal.resize(TerminalSize {
+                    rows: 24,
+                    cols: 80,
+                    pixel_width: 640,
+                    pixel_height: 384,
+                    dpi: 96,
+                });
+                terminal.advance_bytes(b"mutation");
+                session.facts.mutation_barrier = session.snapshot.as_ref() == Some(&copied);
+                if !session.facts.mutation_barrier {
+                    return None;
+                }
+            }
+            "teardown-sequence" => {
+                session.snapshot = None;
+                session.snapshot_reservations.clear();
+                session.terminal.take();
+                session.model_reservation.take();
+                session
+                    .limiter
+                    .callbacks
+                    .accepting
+                    .store(false, Ordering::Release);
+                session.facts.teardown_quiet = true;
+                flags |= ACTION_QUIET_POINT_REACHED;
+            }
+            "probe-title-cwd-limits" => {
+                let terminal = session.terminal.as_ref()?;
+                session.facts.title_cwd_limits = terminal.get_title().len() == TITLE_BYTES as usize
+                    && terminal
+                        .get_current_dir()
+                        .map(|url| url.path().len() >= CWD_BYTES as usize)
+                        .unwrap_or(false)
+                    && reserve_boundary(
+                        session,
+                        ResourceKind::TerminalTextCpu,
+                        TITLE_BYTES.checked_add(CWD_BYTES)?,
+                        0,
+                    );
+                if !session.facts.title_cwd_limits {
+                    return None;
+                }
+                flags |= ACTION_BOUNDARY_ACCEPTED
+                    | ACTION_PLUS_ONE_REJECTED
+                    | ACTION_REJECTION_BEFORE_ALLOCATION
+                    | ACTION_NO_PARTIAL_EFFECT;
+            }
+            "admit-external-events" => {
+                let writer = Arc::clone(&session.writer);
+                let protocol = writer.lock().ok()?.clone();
+                let terminal = session.terminal.as_mut()?;
+                terminal.send_paste("input").ok()?;
+                terminal.resize(TerminalSize {
+                    rows: 24,
+                    cols: 80,
+                    pixel_width: 640,
+                    pixel_height: 384,
+                    dpi: 96,
+                });
+                terminal.send_paste("side-channel").ok()?;
+                let after = writer_copy(session)?;
+                session.facts.external_order = !protocol.is_empty() && after.starts_with(&protocol);
+                if !session.facts.external_order {
+                    return None;
+                }
+                flags |= ACTION_ORDER_PRESERVED;
+            }
+            "benchmark-full-snapshot" | "benchmark-dirty-snapshot" => {
+                if !replace_snapshot(session) {
+                    return None;
+                }
+            }
+            "benchmark-kitty-1024-rgba" => {
+                session
+                    .terminal
+                    .as_mut()?
+                    .kitty_gate0_benchmark_rgba(1024, 1024)
+                    .ok()?;
+            }
+            _ => return None,
+        }
+        Some(flags)
+    }
+
+    unsafe extern "C" fn session_action(
+        raw_session: *mut c_void,
+        action_ptr: *const RsAction,
+        observation_ptr: *mut RsObservation,
+    ) -> RsResult {
+        ffi_guard(|| {
+            if raw_session.is_null()
+                || action_ptr.is_null()
+                || observation_ptr.is_null()
+                || (*action_ptr).size != mem::size_of::<RsAction>()
+                || (*observation_ptr).size != mem::size_of::<RsObservation>()
+            {
+                return INVALID_ARGUMENT;
+            }
+            let action_id = match read_string((*action_ptr).action_id) {
+                Some(value) => value,
+                None => return INVALID_ARGUMENT,
+            };
+            if read_string((*action_ptr).arguments_jcs).is_none() {
+                return INVALID_ARGUMENT;
+            }
+            let session = &mut *(raw_session as *mut Session);
+            if !flush_pending_text(session, true) {
+                return INTERNAL_ERROR;
+            }
+            let flags = match run_action(session, &action_id) {
+                Some(value) => value,
+                None => return INTERNAL_ERROR,
+            };
+            (*observation_ptr).flags = flags;
+            (*observation_ptr).reservation_calls_before_rejection = 0;
+            (*observation_ptr).allocation_attempts_before_rejection = 0;
+            SUCCESS
+        })
+    }
+
+    fn derive_state_jcs(session: &mut Session) -> Option<String> {
+        let fixture_id = session.fixture_id.clone();
+        let fixture = fixture_id.as_str();
+        let snapshot = if matches!(
+            fixture,
+            "scrollback-byte-boundary"
+                | "teardown-callback-quiet"
+                | "kitty-pixel-boundary"
+                | "kitty-replacement-transient"
+                | "pending-effects-boundary"
+        ) {
+            None
+        } else {
+            Some(capture_snapshot(session, None)?.0)
+        };
+        let text = snapshot.as_ref().map(snapshot_text).unwrap_or_default();
+        let images = snapshot.as_ref().map(snapshot_images).unwrap_or_default();
+        let state = match fixture {
+            "alternate-screen-roundtrip"
+                if text.contains("primary")
+                    && !text.contains("alternate")
+                    && !session.terminal.as_ref()?.is_alt_screen_active() =>
+            {
+                r#"{"alternateDiscarded":true,"primarySurvived":true,"primaryText":"primary"}"#
+            }
+            "bracketed-paste-modes"
+                if session.facts.disabled_paste == b"payload"
+                    && session.facts.enabled_paste == b"\x1b[200~payload\x1b[201~"
+                    && session.facts.paste_ordered =>
+            {
+                r#"{"disabled":"payload","enabled":"\\u001b[200~payload\\u001b[201~","ordered":true}"#
+            }
+            "color-style-matrix"
+                if text.contains("ABC")
+                    && snapshot
+                        .as_ref()?
+                        .lines
+                        .iter()
+                        .flatten()
+                        .any(|cell| cell.attributes.contains("TrueColor")) =>
+            {
+                r#"{"indexed":true,"styles":"bold,faint,italic,underline,blink,inverse,strike","truecolor":"1,2,3/4,5,6"}"#
+            }
+            "cursor-and-palette" => {
+                let snapshot = snapshot.as_ref()?;
+                let palette1 = snapshot.palette.colors.0[1].to_srgb_u8();
+                let foreground = snapshot.palette.foreground.to_srgb_u8();
+                if snapshot.cursor.visibility != wezterm_surface::CursorVisibility::Hidden
+                    || palette1.0 != 0x11
+                    || palette1.1 != 0x22
+                    || palette1.2 != 0x33
+                    || foreground.0 != 0x44
+                    || foreground.1 != 0x55
+                    || foreground.2 != 0x66
+                {
+                    return None;
+                }
+                r#"{"cursorVisible":false,"defaultForeground":"44,55,66","palette1":"11,22,33"}"#
+            }
+            "focus-and-mouse-matrix"
+                if session.facts.focus_ordered && session.facts.mouse_matrix =>
+            {
+                r#"{"focus":true,"modes":"1000,1002,1003,1005,1006,1015,1016","ordered":true}"#
+            }
+            "hyperlink-boundaries" if session.facts.osc8_limits => {
+                r#"{"parameterBoundary":"1024","plusOneDiscarded":true,"recordBoundary":"16384","uriBoundary":"8192"}"#
+            }
+            "kitty-delete-generation" => {
+                let snapshot = snapshot.as_ref()?;
+                if snapshot.image_generation != 1
+                    || snapshot.placement_generation < 4
+                    || snapshot.image_count != 1
+                    || snapshot.placement_count != 0
+                {
+                    return None;
+                }
+                r#"{"imageGenerationChanged":true,"placementGenerationChanged":true,"placementOnlyMutationDistinct":true}"#
+            }
+            "kitty-dimension-overflow" if images.is_empty() => {
+                r#"{"allocationAttempted":false,"checkedArithmetic":true,"rejected":true}"#
+            }
+            "kitty-direct-rgb"
+                if images.iter().any(|image| {
+                    image.width == 1 && image.height == 1 && image.bytes == [0xff, 0, 0, 0xff]
+                }) =>
+            {
+                r#"{"format":"rgb","height":"1","immutable":true,"pixel":"ff0000","width":"1"}"#
+            }
+            "kitty-direct-rgba-chunked"
+                if session.terminal.as_ref()?.kitty_snapshot_identity() == (1, 0, 1, 0, 4) =>
+            {
+                r#"{"atomicGenerationDelta":"1","format":"rgba","pixel":"ff0000ff"}"#
+            }
+            "kitty-pixel-boundary" if session.facts.kitty_pixel_limit => {
+                r#"{"boundary":"16000000","boundaryAcceptedWhenLedgersFit":true,"plusOnePredecodeRejected":true}"#
+            }
+            "kitty-png-bomb" if images.is_empty() => {
+                r#"{"decodedAllocationAttempted":false,"dimensionsPreflighted":true,"rejected":true}"#
+            }
+            "kitty-replacement-transient" if session.facts.kitty_replacement => {
+                r#"{"atomicFailure":true,"oldRetainedUntilPublication":true,"simultaneousReservations":"old,new,compressed,decoded,conversion,publication"}"#
+            }
+            "kitty-three-layers-crop" => {
+                let mut layers: Vec<i32> = images
+                    .iter()
+                    .filter(|image| image.placement_id.is_some())
+                    .map(|image| image.z_index)
+                    .collect();
+                layers.sort_unstable();
+                layers.dedup();
+                if layers != [-2, -1, 2]
+                    || images
+                        .iter()
+                        .filter(|image| image.placement_id.is_some())
+                        .count()
+                        != 3
+                    || !images.iter().all(|image| {
+                        image.top_left == (0.0, 0.0) && image.bottom_right == (1.0, 1.0)
+                    })
+                {
+                    return None;
+                }
+                r#"{"crop":"0,0,1,1","layers":"-2,-1,2","placementCount":"3"}"#
+            }
+            "kitty-zlib-bomb" if images.is_empty() => {
+                r#"{"boundedInflater":true,"outputBeyondReservation":false,"processAlive":true}"#
+            }
+            "malformed-utf8-vt" if text.contains('\u{fffd}') => {
+                r#"{"deterministic":true,"processAlive":true,"replacement":"fffd"}"#
+            }
+            "nonkitty-generic-boundary" if session.facts.generic_limit => {
+                r#"{"boundary":"65536","boundaryAccepted":true,"plusOneDiscarded":true}"#
+            }
+            "osc52-boundaries" if session.facts.osc52_limits => {
+                r#"{"decodedBoundary":"786432","encodedBoundary":"1048576","partialEffect":false,"plusOneDiscarded":true}"#
+            }
+            "pending-effects-boundary" if session.facts.pending_limit => {
+                r#"{"byteBoundary":"2097152","descriptorBoundary":"256","plusOneAtomic":true}"#
+            }
+            "resize-reflow-selection"
+                if session.facts.selection_stable && session.facts.resize_stable =>
+            {
+                r#"{"graphemeStable":true,"logicalLines":"2","selectionStable":true,"wideCellStable":true}"#
+            }
+            "scrollback-byte-boundary"
+                if session.facts.terminal_text_limit
+                    && session.bytes_seen == TERMINAL_TEXT_LIMIT + 1 =>
+            {
+                r#"{"boundary":"67108864","plusOnePreallocationHandled":true,"unit":"bytes"}"#
+            }
+            "snapshot-dirty-retry" if session.facts.snapshot_retry => {
+                r#"{"failedPublicationRetried":true,"fullSnapshotOnRetry":true,"notificationLost":false}"#
+            }
+            "snapshot-mutation-barrier" if session.facts.mutation_barrier => {
+                r#"{"borrowedAfterEnd":"invalid","copiedSnapshotStable":true,"mutationBarrier":true}"#
+            }
+            "synchronized-output" if text.contains("first") && text.contains("second") => {
+                r#"{"publishedDuringSync":false,"releaseAtomic":true,"retainedDirty":true}"#
+            }
+            "teardown-callback-quiet" if session.facts.teardown_quiet => {
+                r#"{"callbackAfterDetach":"0","producersStoppedFirst":true,"quietBeforeUnload":true}"#
+            }
+            "title-cwd-boundaries" if session.facts.title_cwd_limits => {
+                r#"{"cwdBoundary":"131072","plusOneDiscarded":true,"titleBoundary":"4096"}"#
+            }
+            "unicode-grapheme-wide"
+                if text.contains("e\u{301}")
+                    && text.contains('界')
+                    && text.contains("👩‍💻")
+                    && text.contains("❤️") =>
+            {
+                r#"{"combiningStable":true,"variationStable":true,"wideContinuationStable":true,"zwjStable":true}"#
+            }
+            "write-response-order" if session.facts.external_order => {
+                r#"{"admittedOrder":"protocol-reply,input,resize,side-channel","reordered":false}"#
+            }
+            _ => return None,
+        };
+        Some(state.to_string())
+    }
+
+    unsafe extern "C" fn session_state_jcs(
+        raw_session: *mut c_void,
+        buffer: *mut u8,
+        capacity: usize,
+        out_required: *mut usize,
+    ) -> RsResult {
+        ffi_guard(|| {
+            if raw_session.is_null() || out_required.is_null() {
+                return INVALID_ARGUMENT;
+            }
+            let session = &mut *(raw_session as *mut Session);
+            if !flush_pending_text(session, true) {
+                return INTERNAL_ERROR;
+            }
+            let state = match derive_state_jcs(session) {
+                Some(value) => value,
+                None => return INTERNAL_ERROR,
+            };
+            *out_required = state.len();
+            if buffer.is_null() || capacity < state.len() {
+                return OUT_OF_SPACE;
+            }
+            ptr::copy_nonoverlapping(state.as_ptr(), buffer, state.len());
+            SUCCESS
+        })
+    }
+
+    unsafe extern "C" fn session_destroy(raw_session: *mut c_void) -> RsResult {
+        ffi_guard(|| {
+            if raw_session.is_null() {
+                return INVALID_ARGUMENT;
+            }
+            let mut session = Box::from_raw(raw_session as *mut Session);
+            session.snapshot = None;
+            session.snapshot_reservations.clear();
+            session.selection = None;
+            session.terminal.take();
+            session.model_reservation.take();
+            session
+                .limiter
+                .callbacks
+                .accepting
+                .store(false, Ordering::Release);
+            drop(session);
+            SUCCESS
+        })
+    }
+
+    #[no_mangle]
+    pub unsafe extern "C" fn rs_terminal_gate0_query_adapter(
+        query_symbol_version: u32,
+        requested_adapter_abi: u32,
+        out_adapter: *mut RsAdapter,
+    ) -> RsResult {
+        ffi_guard(|| {
+            if query_symbol_version != QUERY_SYMBOL_V1 || requested_adapter_abi != ADAPTER_ABI_V1 {
+                return UNSUPPORTED_ABI;
+            }
+            if out_adapter.is_null()
+                || (*out_adapter).size != mem::size_of::<RsAdapter>()
+                || (*out_adapter).identity.size != mem::size_of::<RsIdentity>()
+            {
+                return INVALID_ARGUMENT;
+            }
+            ptr::write(
+                out_adapter,
+                RsAdapter {
+                    size: mem::size_of::<RsAdapter>(),
+                    identity: RsIdentity {
+                        size: mem::size_of::<RsIdentity>(),
+                        adapter_abi: ADAPTER_ABI_V1,
+                        candidate_id: make_string(CANDIDATE_ID),
+                        upstream_pin: make_string(UPSTREAM_PIN),
+                        source_sha256: make_string(SOURCE_SHA256),
+                        adapter_header_sha256: make_string(HEADER_SHA256),
+                        build_identity: make_string(BUILD_IDENTITY),
+                        architecture: architecture(),
+                        calling_convention: CALL_CDECL,
+                        capabilities: CAPABILITIES,
+                        pointer_size: mem::size_of::<*const c_void>() as u32,
+                        reserved: 0,
+                    },
+                    session_create: Some(session_create),
+                    session_write: Some(session_write),
+                    session_action: Some(session_action),
+                    session_state_jcs: Some(session_state_jcs),
+                    session_destroy: Some(session_destroy),
+                },
+            );
+            SUCCESS
+        })
+    }
+}
