+    impl ResourceLimiter for HostLimiter {
+        fn reserve(
+            &self,
+            kind: ResourceKind,
+            bytes: u64,
+            descriptors: u32,
+        ) -> Option<Box<dyn ResourceReservation>> {
+            let kind = match kind {
+                ResourceKind::TerminalTextCpu => TERMINAL_TEXT,
+                ResourceKind::ImageCpu => IMAGE_CPU,
+                ResourceKind::ImageGpu => IMAGE_GPU,
+                ResourceKind::PendingEffect => PENDING_EFFECT,
+            };
+            if !self.callbacks.accepting.load(Ordering::Acquire)
+                || !unsafe {
+                    (self.callbacks.reserve)(self.callbacks.userdata, kind, bytes, descriptors)
+                }
+            {
+                return None;
+            }
+            Some(Box::new(HostReservation {
+                callbacks: Arc::clone(&self.callbacks),
+                kind,
+                bytes,
+                descriptors,
+            }))
+        }
+    }
