+    fn ffi_guard<F>(operation: F) -> RsResult
+    where
+        F: FnOnce() -> RsResult,
+    {
+        // A Rust panic is the single language-level unwind category.  It must
+        // never cross this C ABI boundary; allocation panic maps to OOM and all
+        // other panics map to a deterministic adapter failure.
+        match catch_unwind(AssertUnwindSafe(operation)) {
+            Ok(result) => result,
+            Err(payload) => {
+                if payload.is::<std::collections::TryReserveError>() {
+                    OUT_OF_MEMORY
+                } else {
+                    INTERNAL_ERROR
+                }
+            }
+        }
+    }
+
+    fn model_reservation_bytes(rows: usize, columns: usize, scrollback: usize) -> Option<u64> {
+        let line_count = scrollback.checked_add(rows.checked_mul(2)?)?;
+        let cells = line_count.checked_mul(columns)?;
+        let cell_bytes = cells.checked_mul(mem::size_of::<Cell>())?;
+        let line_bytes = line_count.checked_mul(mem::size_of::<Line>())?;
+        u64::try_from(cell_bytes.checked_add(line_bytes)?).ok()
+    }
