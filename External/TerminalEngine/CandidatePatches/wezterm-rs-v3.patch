+
+    fn consume_pending_prefix(session: &mut Session, count: usize) -> bool {
+        if count == 0 {
+            return true;
+        }
+        let terminal = match session.terminal.as_mut() {
+            Some(value) => value,
+            None => return false,
+        };
+        terminal.advance_bytes(&session.pending_text[..count]);
+        session
+            .pending_text
+            .copy_within(count..session.pending_text_len, 0);
+        session.pending_text_len -= count;
+        true
+    }
+
+    fn last_grapheme_start(text: &str) -> usize {
+        let mut offset = 0usize;
+        let mut last = 0usize;
+        for grapheme in Graphemes::new(text) {
+            last = offset;
+            offset += grapheme.len();
+        }
+        last
+    }
+
+    fn flush_pending_text(session: &mut Session, force: bool) -> bool {
+        loop {
+            if session.pending_text_len == 0 {
+                return true;
+            }
+            if force {
+                return consume_pending_prefix(session, session.pending_text_len);
+            }
+            let pending = &session.pending_text[..session.pending_text_len];
+            match str::from_utf8(pending) {
+                Ok(text) => {
+                    return consume_pending_prefix(session, last_grapheme_start(text));
+                }
+                Err(error) => {
+                    if let Some(error_len) = error.error_len() {
+                        let count = error.valid_up_to().saturating_add(error_len);
+                        if !consume_pending_prefix(session, count) {
+                            return false;
+                        }
+                    } else {
+                        let valid = error.valid_up_to();
+                        if valid == 0 {
+                            return true;
+                        }
+                        let text = match str::from_utf8(&pending[..valid]) {
+                            Ok(value) => value,
+                            Err(_) => return false,
+                        };
+                        return consume_pending_prefix(session, last_grapheme_start(text));
+                    }
+                }
+            }
+        }
+    }
+
+    fn advance_external(session: &mut Session, bytes: &[u8], account_scratch: bool) -> bool {
+        for chunk in bytes.chunks(64 * 1024) {
+            let scratch = if account_scratch {
+                match session.limiter.reserve_host(
+                    ResourceKind::TerminalTextCpu,
+                    u64::try_from(chunk.len()).unwrap_or(u64::MAX),
+                    0,
+                ) {
+                    Some(value) => Some(value),
+                    None => return false,
+                }
+            } else {
+                None
+            };
+            match session.terminal.as_mut() {
+                Some(value) => value.advance_bytes(chunk),
+                None => return false,
+            }
+            drop(scratch);
+        }
+        true
+    }
+
+    fn append_ground_text(session: &mut Session, bytes: &[u8], account_scratch: bool) -> bool {
+        if bytes.is_empty() {
+            return true;
+        }
+        if bytes.is_ascii() {
+            if session.pending_text_len == PENDING_TEXT_BYTES && !flush_pending_text(session, true)
+            {
+                return false;
+            }
+            session.pending_text[session.pending_text_len] = bytes[0];
+            session.pending_text_len += 1;
+            if !flush_pending_text(session, false) {
+                return false;
+            }
+            if bytes.len() == 1 {
+                return true;
+            }
+            if !flush_pending_text(session, true)
+                || !advance_external(
+                    session,
+                    &bytes[1..bytes.len().saturating_sub(1)],
+                    account_scratch,
+                )
+            {
+                return false;
+            }
+            session.pending_text[0] = bytes[bytes.len() - 1];
+            session.pending_text_len = 1;
+            return true;
+        }
+        let mut offset = 0usize;
+        while offset < bytes.len() {
+            if session.pending_text_len == PENDING_TEXT_BYTES && !flush_pending_text(session, true)
+            {
+                return false;
+            }
+            let count = (PENDING_TEXT_BYTES - session.pending_text_len).min(bytes.len() - offset);
+            session.pending_text[session.pending_text_len..session.pending_text_len + count]
+                .copy_from_slice(&bytes[offset..offset + count]);
+            session.pending_text_len += count;
+            offset += count;
+            if !flush_pending_text(session, false) {
+                return false;
+            }
+        }
+        true
+    }
