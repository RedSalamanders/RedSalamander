+ * `public_header_sha256` is the lowercase SHA-256 of the public libghostty-vt
+ * header set shipped with the patch: lexicographically sorted slash-normalized
+ * paths relative to `include`, each followed by a NUL byte and then its raw
+ * file bytes. `enum_identity` deterministically covers the patch ABI's
+ * resource, terminal-option, architecture, calling-convention, and capability
+ * assignments. `type_layout_identity` covers GhosttyTerminalResourceLimits
+ * and GhosttyRuntimeIdentity sizes, alignments, fields, and offsets. The full
+ * header digest remains the identity for every other public declaration.
+ */
+typedef struct {
+  size_t size;
+  GhosttyString upstream_commit;
+  uint32_t red_salamander_patch_abi;
+  GhosttyString public_header_sha256;
+  GhosttyString build_identity;
+  GhosttyRuntimeArchitecture architecture;
+  GhosttyRuntimeCallingConvention calling_convention;
+  uint64_t capabilities;
+  uint64_t enum_identity;
+  uint64_t type_layout_identity;
+  uint32_t pointer_size;
+  uint32_t terminal_resource_limits_size;
+} GhosttyRuntimeIdentity;
+
+/**
+ * Query the complete runtime identity.
+ *
+ * @return GHOSTTY_SUCCESS only when `out` is non-NULL and `out->size` exactly
+ *         matches the loaded ABI; otherwise GHOSTTY_INVALID_VALUE.
+ */
+GHOSTTY_API GhosttyResult ghostty_runtime_identity(
+    GhosttyRuntimeIdentity *out);
+
 #ifdef __cplusplus
 }
 #endif
