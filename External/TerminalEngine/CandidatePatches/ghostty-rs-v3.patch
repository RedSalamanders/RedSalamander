+#define GHOSTTY_RUNTIME_CAP_VT_PARSER UINT64_C(1)
+#define GHOSTTY_RUNTIME_CAP_TERMINAL_MODEL UINT64_C(2)
+#define GHOSTTY_RUNTIME_CAP_RENDER_STATE UINT64_C(4)
+#define GHOSTTY_RUNTIME_CAP_KITTY_GRAPHICS UINT64_C(8)
+#define GHOSTTY_RUNTIME_CAP_SCROLLBACK_COMPRESSION UINT64_C(16)
+#define GHOSTTY_RUNTIME_CAP_RESOURCE_LIMITS UINT64_C(32)
+#define GHOSTTY_RUNTIME_CAP_SELECTION UINT64_C(64)
+
+/**
+ * Exact identity of the loaded patched runtime.
+ *
+ * Set `size` to `sizeof(GhosttyRuntimeIdentity)`. The query rejects every
+ * other size rather than returning a partial identity. Strings are immutable,
+ * owned by the library, and remain valid for the process lifetime.
