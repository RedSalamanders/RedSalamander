diff --git a/src/terminal/resource_accounting.zig b/src/terminal/resource_accounting.zig
new file mode 100644
index 0000000000000000000000000000000000000000..4e6a484f6241a48e903c4e32a745a67e6dc75beb
--- /dev/null
+++ b/src/terminal/resource_accounting.zig
@@ -0,0 +1,178 @@
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const graphics_image = @import("kitty/graphics_image.zig");
+
+pub const ResourceAccountant = graphics_image.ResourceAccountant;
+pub const ResourceKind = graphics_image.ResourceKind;
+
+/// Allocator adapter used by the C terminal boundary to account every owned
+/// heap extent by subsystem. The reported byte count is the exact payload
+/// extent requested from the child allocator; allocator-private metadata and
+/// platform rounding are intentionally outside the engine-owned ledger.
+///
+/// Growth is deliberately not performed through resize/remap. Returning
+/// failure makes std.mem.Allocator allocate and reserve the complete
+/// replacement before it releases the old extent, preserving the real peak
+/// ownership order and atomic rejection semantics.
+pub const AccountingAllocator = struct {
+    child: Allocator,
+    kind: ResourceKind,
+    accountant: ResourceAccountant = .{},
+    bytes: usize = 0,
+
+    const Self = @This();
+
+    pub fn init(child: Allocator, kind: ResourceKind) Self {
+        return .{
+            .child = child,
+            .kind = kind,
+        };
+    }
+
+    pub fn allocator(self: *Self) Allocator {
+        return .{
+            .ptr = self,
+            .vtable = &vtable,
+        };
+    }
+
+    pub fn sameAccountant(self: *const Self, other: ResourceAccountant) bool {
+        return self.accountant.userdata == other.userdata and
+            self.accountant.reserve_fn == other.reserve_fn and
+            self.accountant.release_fn == other.release_fn;
+    }
+
+    /// Reserve this allocator's complete existing balance with a prospective
+    /// accountant. The caller performs this for every subsystem before
+    /// publishing any accountant change.
+    pub fn reserveExisting(
+        self: *const Self,
+        prospective: ResourceAccountant,
+    ) error{OutOfMemory}!void {
+        try prospective.reserve(self.kind, self.bytes);
+    }
+
+    pub fn releaseExisting(
+        self: *const Self,
+        previous: ResourceAccountant,
+    ) void {
+        previous.release(self.kind, self.bytes);
+    }
+
+    const vtable: Allocator.VTable = .{
+        .alloc = alloc,
+        .resize = resize,
+        .remap = remap,
+        .free = free,
+    };
+
+    fn alloc(
+        ctx: *anyopaque,
+        len: usize,
+        alignment: std.mem.Alignment,
+        ret_addr: usize,
+    ) ?[*]u8 {
+        const self: *Self = @ptrCast(@alignCast(ctx));
+        const new_total = std.math.add(usize, self.bytes, len) catch return null;
+        self.accountant.reserve(self.kind, len) catch return null;
+        const result = self.child.rawAlloc(len, alignment, ret_addr) orelse {
+            self.accountant.release(self.kind, len);
+            return null;
+        };
+        self.bytes = new_total;
+        return result;
+    }
+
+    fn resize(
+        ctx: *anyopaque,
+        old_mem: []u8,
+        alignment: std.mem.Alignment,
+        new_len: usize,
+        ret_addr: usize,
+    ) bool {
+        const self: *Self = @ptrCast(@alignCast(ctx));
+        if (new_len > old_mem.len) return false;
+        if (!self.child.rawResize(old_mem, alignment, new_len, ret_addr))
+            return false;
+
+        const released = old_mem.len - new_len;
+        std.debug.assert(released <= self.bytes);
+        self.bytes -= released;
+        self.accountant.release(self.kind, released);
+        return true;
+    }
+
+    fn remap(
+        _: *anyopaque,
+        _: []u8,
+        _: std.mem.Alignment,
+        _: usize,
+        _: usize,
+    ) ?[*]u8 {
+        // Force the generic realloc path so replacement capacity is reserved
+        // before the old extent is freed.
+        return null;
+    }
+
+    fn free(
+        ctx: *anyopaque,
+        old_mem: []u8,
+        alignment: std.mem.Alignment,
+        ret_addr: usize,
+    ) void {
+        const self: *Self = @ptrCast(@alignCast(ctx));
+        self.child.rawFree(old_mem, alignment, ret_addr);
+        std.debug.assert(old_mem.len <= self.bytes);
+        self.bytes -= old_mem.len;
+        self.accountant.release(self.kind, old_mem.len);
+    }
+};
+
+test "accounting allocator reserves replacement before release" {
+    const testing = std.testing;
+    const State = struct {
+        current: usize = 0,
+        peak: usize = 0,
+
+        fn reserve(
+            userdata: ?*anyopaque,
+            _: ResourceKind,
+            bytes: usize,
+        ) callconv(.c) bool {
+            const self: *@This() = @ptrCast(@alignCast(userdata.?));
+            self.current = std.math.add(usize, self.current, bytes) catch
+                return false;
+            self.peak = @max(self.peak, self.current);
+            return true;
+        }
+
+        fn release(
+            userdata: ?*anyopaque,
+            _: ResourceKind,
+            bytes: usize,
+        ) callconv(.c) void {
+            const self: *@This() = @ptrCast(@alignCast(userdata.?));
+            testing.expect(bytes <= self.current) catch unreachable;
+            self.current -= bytes;
+        }
+    };
+
+    var state: State = .{};
+    var accounting: AccountingAllocator = .init(
+        testing.allocator,
+        .terminal_text_cpu,
+    );
+    accounting.accountant = .{
+        .userdata = &state,
+        .reserve_fn = &State.reserve,
+        .release_fn = &State.release,
+    };
+    const alloc_impl = accounting.allocator();
+    var bytes = try alloc_impl.alloc(u8, 16);
+    bytes = try alloc_impl.realloc(bytes, 32);
+    try testing.expectEqual(@as(usize, 48), state.peak);
+    try testing.expectEqual(@as(usize, 32), state.current);
+    alloc_impl.free(bytes);
+    try testing.expectEqual(@as(usize, 0), state.current);
+    try testing.expectEqual(@as(usize, 0), accounting.bytes);
+}
