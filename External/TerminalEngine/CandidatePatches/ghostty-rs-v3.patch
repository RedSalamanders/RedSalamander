+        assert(kind == .kitty_image_cpu);
+        assert(bytes <= self.reserved);
+        self.reserved -= bytes;
+        self.release_calls += 1;
+    }
+
+    fn callbacks(self: *TestAccountant) ResourceAccountant {
+        return .{
+            .userdata = self,
+            .reserve_fn = &reserve,
+            .release_fn = &release,
+        };
+    }
