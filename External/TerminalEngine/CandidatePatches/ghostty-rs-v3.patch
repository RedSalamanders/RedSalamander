+        self.reserve_calls += 1;
+        self.last_kind = kind;
+        if (self.reject) return false;
+        self.reserved = std.math.add(usize, self.reserved, bytes) catch
+            return false;
+        self.peak = @max(self.peak, self.reserved);
+        return true;
