+  size_t kitty_max_decoded_bytes;
+  uint64_t kitty_max_pixels;
+  uint32_t kitty_max_dimension;
+  size_t osc_generic_max_bytes;
+  size_t osc_title_max_bytes;
+  size_t osc_hyperlink_max_bytes;
+  size_t osc_hyperlink_uri_max_bytes;
+  size_t osc_hyperlink_params_max_bytes;
+  size_t osc_clipboard_encoded_max_bytes;
+  size_t osc_clipboard_decoded_max_bytes;
+  size_t osc_pwd_max_bytes;
+  size_t osc_shell_integration_max_bytes;
+  size_t apc_generic_max_bytes;
+  size_t apc_kitty_max_bytes;
