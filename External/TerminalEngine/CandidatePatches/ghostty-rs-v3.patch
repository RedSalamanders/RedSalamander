+typedef enum GHOSTTY_ENUM_TYPED {
+  GHOSTTY_RUNTIME_CALLING_CONVENTION_UNKNOWN = 0,
+  GHOSTTY_RUNTIME_CALLING_CONVENTION_C = 1,
