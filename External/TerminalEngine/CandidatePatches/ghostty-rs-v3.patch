+
+/// Hash the exact public libghostty-vt header set on every build.
+///
+/// The canonical byte stream is the slash-normalized path relative to
+/// `include`, a NUL byte, and the raw file contents for every matching header
+/// in lexicographic path order.
+fn publicHeaderSha256(b: *std.Build) ![]const u8 {
+    var include_dir = try b.build_root.handle.openDir(
+        b.graph.io,
+        "include",
+        .{ .iterate = true },
+    );
+    defer include_dir.close(b.graph.io);
+
+    var paths: std.ArrayListUnmanaged([]u8) = .empty;
+    defer {
+        for (paths.items) |path| b.allocator.free(path);
+        paths.deinit(b.allocator);
+    }
+
+    var walk = try include_dir.walk(b.allocator);
+    defer walk.deinit();
+    while (try walk.next(b.graph.io)) |entry| {
+        if (entry.kind != .file or
+            !std.mem.endsWith(u8, entry.path, ".h"))
+        {
+            continue;
+        }
+
+        const canonical = try b.allocator.dupe(u8, entry.path);
+        errdefer b.allocator.free(canonical);
+        std.mem.replaceScalar(u8, canonical, '\\', '/');
+        if (!std.mem.eql(u8, canonical, "ghostty/vt.h") and
+            !std.mem.startsWith(u8, canonical, "ghostty/vt/"))
+        {
+            b.allocator.free(canonical);
+            continue;
+        }
+        try paths.append(b.allocator, canonical);
+    }
+
+    std.mem.sort([]u8, paths.items, {}, struct {
+        fn lessThan(_: void, lhs: []u8, rhs: []u8) bool {
+            return std.mem.order(u8, lhs, rhs) == .lt;
+        }
+    }.lessThan);
+
+    var hasher = std.crypto.hash.sha2.Sha256.init(.{});
+    for (paths.items) |path| {
+        hasher.update(path);
+        hasher.update(&.{0});
+
+        const contents = try include_dir.readFileAlloc(
+            b.graph.io,
+            path,
+            b.allocator,
+            .limited(16 * 1024 * 1024),
+        );
+        defer b.allocator.free(contents);
+        hasher.update(contents);
+    }
+
+    var digest: [std.crypto.hash.sha2.Sha256.digest_length]u8 = undefined;
+    hasher.final(&digest);
+    return b.allocator.dupe(
+        u8,
+        &std.fmt.bytesToHex(digest, .lower),
+    );
+}
