+/**
+ * Resource category passed to reservation callbacks.
+ *
+ * New categories may be added only with a RedSalamander patch ABI version
+ * change, allowing embedders to fail closed on an unknown contract.
+ */
+typedef enum GHOSTTY_ENUM_TYPED {
+  /** Kitty parser/storage/map/decoder heap extents, including PNG scratch. */
+  GHOSTTY_TERMINAL_RESOURCE_KITTY_IMAGE_CPU = 0,
+  /** Grid, scrollback, reflow, compression, and retained terminal-state extents. */
+  GHOSTTY_TERMINAL_RESOURCE_TERMINAL_TEXT_CPU = 1,
+  /** OSC/APC/DCS payloads and synchronous effect/response scratch extents. */
+  GHOSTTY_TERMINAL_RESOURCE_PENDING_EFFECT = 2,
+  GHOSTTY_TERMINAL_RESOURCE_MAX_VALUE = GHOSTTY_ENUM_MAX_VALUE,
+} GhosttyTerminalResourceKind;
+
+/**
+ * Reserve bytes before an engine-owned heap extent is allocated. `bytes` is
+ * the exact payload extent requested from the configured child allocator;
+ * allocator-private metadata and platform allocation rounding are outside this
+ * ledger. Returning false rejects the operation before allocation. Every true
+ * result is paired with exactly one release callback for the same category and
+ * byte count, including error and terminal teardown paths.
+ *
+ * A growing extent reserves its complete replacement while the old extent is
+ * still reserved, then releases the old extent only after replacement
+ * succeeds. Checked arithmetic precedes every callback and allocation.
+ *
+ * The callbacks execute synchronously on the thread making the terminal API
+ * call and must not reenter the same terminal. They may atomically aggregate
+ * session and process ledgers in userdata.
+ */
+typedef bool (*GhosttyTerminalResourceReserveFn)(
+    void* userdata,
+    GhosttyTerminalResourceKind kind,
+    size_t bytes);
+
+/** Release a successful resource reservation. */
+typedef void (*GhosttyTerminalResourceReleaseFn)(
+    void* userdata,
+    GhosttyTerminalResourceKind kind,
+    size_t bytes);
+
+/**
+ * Fail-closed limits for allocations derived from untrusted terminal input.
+ *
+ * Set `size` to `sizeof(GhosttyTerminalResourceLimits)`. The library rejects
+ * any other size, a callback pair with only one function, or a value above
+ * the built-in ceiling. Zero is a valid value and disables the corresponding
+ * payload. Installing or replacing a callback identity atomically reserves
+ * every already-live category balance with the prospective callbacks before
+ * releasing any old balance or publishing the new identity. If any prospective
+ * reservation fails, all prospective reservations are rolled back and the old
+ * identity and limits remain unchanged.
+ *
+ * The callbacks and userdata must remain valid until a successful later
+ * identity migration or terminal destruction has emitted every matching
+ * release. Initial grid allocations are adopted during the first successful
+ * callback installation.
+ *
+ * OSC/APC/DCS and effect callback arguments are borrowed. Their
+ * PENDING_EFFECT heap reservations are released before
+ * ghostty_terminal_vt_write() returns unless parser state remains incomplete
+ * across writes. A consumer that queues an effect must copy it into and charge
+ * its own queue ledger; it must not retain or charge the borrowed engine bytes.
