+/** Architecture of the loaded runtime. */
+typedef enum GHOSTTY_ENUM_TYPED {
+  GHOSTTY_RUNTIME_ARCHITECTURE_UNKNOWN = 0,
+  GHOSTTY_RUNTIME_ARCHITECTURE_X86_64 = 1,
+  GHOSTTY_RUNTIME_ARCHITECTURE_AARCH64 = 2,
+  GHOSTTY_RUNTIME_ARCHITECTURE_MAX_VALUE = GHOSTTY_ENUM_MAX_VALUE,
+} GhosttyRuntimeArchitecture;
+
