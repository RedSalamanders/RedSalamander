+            count += 1;
+            return .success;
+        }
+    };
+    S.count = 0;
+
+    var handler: Handler = .init(&t);
+    handler.clipboard_max_decoded_bytes = 4;
+    handler.effects.clipboard_write = &S.clipboardWrite;
+    var s: Stream = .initAlloc(testing.allocator, handler);
+    defer s.deinit();
