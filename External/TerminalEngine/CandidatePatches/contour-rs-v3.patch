diff --git a/src/vtbackend/ResourceAccounting.cpp b/src/vtbackend/ResourceAccounting.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..adfd76f82d87eac75a3120c8c561d6e7d8961401
--- /dev/null
+++ b/src/vtbackend/ResourceAccounting.cpp
@@ -0,0 +1,210 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <Windows.h>
+#include <algorithm>
+#include <bit>
+#include <limits>
+#include <new>
+#include <utility>
+#include <vtbackend/ResourceAccounting.h>
+namespace vtbackend::resource
+{
+namespace
+{
+struct AllocationHeader
+{
+    void *raw;
+    Context *context;
+    uint64_t accountedBytes;
+    Kind kind;
+    std::array<std::byte, 7> reserved{};
+};
+thread_local Context *ActiveContext = nullptr;
+thread_local Kind ActiveKind = Kind::TerminalTextCpu;
+thread_local bool AllocationDenied = false;
+[[nodiscard]] constexpr size_t indexOf(Kind kind) noexcept
+{
+    return static_cast<size_t>(kind);
+}
+template <typename T> [[nodiscard]] bool tryIncrement(std::atomic<T> &value, T limit, T increment) noexcept
+{
+    auto current = value.load(std::memory_order_relaxed);
+    do
+    {
+        if (current > limit || increment > limit - current)
+            return false;
+    } while (!value.compare_exchange_weak(current, current + increment, std::memory_order_relaxed));
+    return true;
+}
+} // namespace
+Context::Context(Callbacks callbacks, Limits limits, uint64_t externallyReservedTerminalBytes) noexcept
+    : _callbacks{callbacks}, _limits{limits},
+      _externallyReservedTerminalBytes{externallyReservedTerminalBytes}
+{}
+Context *Context::create(Callbacks callbacks,
+                         Limits limits,
+                         uint64_t externallyReservedTerminalBytes) noexcept
+{
+    if (!callbacks.reserve || !callbacks.release)
+        return nullptr;
+    auto constexpr Bytes = uint64_t{sizeof(Context)};
+    auto const terminalIndex = indexOf(Kind::TerminalTextCpu);
+    if (externallyReservedTerminalBytes > limits.bytes[terminalIndex] ||
+        Bytes > limits.bytes[terminalIndex] - externallyReservedTerminalBytes)
+        return nullptr;
+    if (!callbacks.reserve(callbacks.userdata, Kind::TerminalTextCpu, Bytes, 0))
+        return nullptr;
+    clearAllocationDenial();
+    auto *const memory = tryAllocate(sizeof(Context), alignof(Context));
+    if (!memory)
+    {
+        callbacks.release(callbacks.userdata, Kind::TerminalTextCpu, Bytes, 0);
+        if (takeAllocationDenial())
+            return nullptr;
+        std::terminate();
+    }
+    auto *const context = new (memory) Context(callbacks, limits, externallyReservedTerminalBytes);
+    context->_states[terminalIndex].balance.store(externallyReservedTerminalBytes + Bytes,
+                                                  std::memory_order_relaxed);
+    context->_states[terminalIndex].reservationCalls.store(1, std::memory_order_relaxed);
+    return context;
+}
+bool Context::destroy() noexcept
+{
+    for (auto const kind : {Kind::TerminalTextCpu, Kind::ImageCpu, Kind::ImageGpu, Kind::PendingEffect})
+    {
+        auto const expected =
+            kind == Kind::TerminalTextCpu ? _externallyReservedTerminalBytes + sizeof(Context) : 0;
+        if (descriptors(kind) != 0 || balance(kind) != expected)
+            return false;
+    }
+    auto const callbacks = _callbacks;
+    this->~Context();
+    callbacks.release(callbacks.userdata, Kind::TerminalTextCpu, sizeof(Context), 0);
+    deallocate(this);
+    return true;
+}
+bool Context::tryReserve(Kind kind, uint64_t bytes, uint32_t descriptorCount) noexcept
+{
+    auto const index = indexOf(kind);
+    auto &value = _states[index];
+    if (!tryIncrement(value.balance, _limits.bytes[index], bytes))
+    {
+        value.rejectedReservations.fetch_add(1, std::memory_order_relaxed);
+        return false;
+    }
+    if (!tryIncrement(value.descriptors, _limits.descriptors[index], descriptorCount))
+    {
+        value.balance.fetch_sub(bytes, std::memory_order_relaxed);
+        value.rejectedReservations.fetch_add(1, std::memory_order_relaxed);
+        return false;
+    }
+    value.reservationCalls.fetch_add(1, std::memory_order_relaxed);
+    if (_callbacks.reserve(_callbacks.userdata, kind, bytes, descriptorCount))
+        return true;
+    value.descriptors.fetch_sub(descriptorCount, std::memory_order_relaxed);
+    value.balance.fetch_sub(bytes, std::memory_order_relaxed);
+    value.rejectedReservations.fetch_add(1, std::memory_order_relaxed);
+    return false;
+}
+void Context::release(Kind kind, uint64_t bytes, uint32_t descriptorCount) noexcept
+{
+    auto &value = state(kind);
+    value.descriptors.fetch_sub(descriptorCount, std::memory_order_relaxed);
+    value.balance.fetch_sub(bytes, std::memory_order_relaxed);
+    _callbacks.release(_callbacks.userdata, kind, bytes, descriptorCount);
+}
+void *Context::tryAllocateOwned(Kind kind, uint64_t bytes, uint32_t descriptorCount) noexcept
+{
+    if (bytes == 0 || bytes > std::numeric_limits<size_t>::max() || !tryReserve(kind, bytes, descriptorCount))
+        return nullptr;
+    state(kind).allocationAttempts.fetch_add(1, std::memory_order_relaxed);
+    auto *const pointer = HeapAlloc(GetProcessHeap(), 0, static_cast<size_t>(bytes));
+    if (!pointer)
+    {
+        release(kind, bytes, descriptorCount);
+        std::terminate();
+    }
+    return pointer;
+}
+void Context::releaseOwned(void *pointer, Kind kind, uint64_t bytes, uint32_t descriptorCount) noexcept
+{
+    if (!pointer)
+        return;
+    (void)HeapFree(GetProcessHeap(), 0, pointer);
+    release(kind, bytes, descriptorCount);
+}
+Scope::Scope(Context &context, Kind kind) noexcept
+    : _previousContext{ActiveContext}, _previousKind{ActiveKind}
+{
+    ActiveContext = &context;
+    ActiveKind = kind;
+}
+Scope::~Scope() { ActiveContext = _previousContext; ActiveKind = _previousKind; }
+Scope::Scope(Kind kind) noexcept : _previousContext{ActiveContext}, _previousKind{ActiveKind}
+{ ActiveKind = kind; }
+void *tryAllocate(size_t bytes, size_t alignment) noexcept
+{
+    bytes = std::max(bytes, size_t{1});
+    alignment = std::max(alignment, alignof(std::max_align_t));
+    if (!std::has_single_bit(alignment))
+        return nullptr;
+    if (bytes > std::numeric_limits<size_t>::max() - sizeof(AllocationHeader) ||
+        alignment - 1 > std::numeric_limits<size_t>::max() - bytes - sizeof(AllocationHeader))
+        return nullptr;
+    auto const physical = static_cast<uint64_t>(bytes + sizeof(AllocationHeader) + alignment - 1);
+    auto *const context = ActiveContext;
+    auto const kind = ActiveKind;
+    if (context && !context->tryReserve(kind, physical))
+    {
+        AllocationDenied = true;
+        return nullptr;
+    }
+    if (context)
+        context->state(kind).allocationAttempts.fetch_add(1, std::memory_order_relaxed);
+    auto *const raw = HeapAlloc(GetProcessHeap(), 0, static_cast<size_t>(physical));
+    if (!raw)
+    {
+        if (context)
+            context->release(kind, physical);
+        std::terminate();
+    }
+    auto const start = reinterpret_cast<uintptr_t>(raw) + sizeof(AllocationHeader);
+    auto const address = (start + alignment - 1) & ~(static_cast<uintptr_t>(alignment) - 1);
+    auto *const header = reinterpret_cast<AllocationHeader *>(address) - 1;
+    *header = AllocationHeader{.raw = raw, .context = context, .accountedBytes = physical, .kind = kind};
+    return reinterpret_cast<void *>(address);
+}
+void *allocate(size_t bytes, size_t alignment)
+{
+    clearAllocationDenial();
+    if (auto *const pointer = tryAllocate(bytes, alignment))
+        return pointer;
+    if (takeAllocationDenial())
+        throw ReservationDenied{};
+    throw std::bad_alloc();
+}
+void clearAllocationDenial() noexcept { AllocationDenied = false; }
+bool takeAllocationDenial() noexcept { return std::exchange(AllocationDenied, false); }
+void deallocate(void *pointer) noexcept
+{
+    if (!pointer)
+        return;
+    auto const *const header = reinterpret_cast<AllocationHeader *>(pointer) - 1;
+    if (auto *const context = header->context)
+        context->release(header->kind, header->accountedBytes);
+    (void)HeapFree(GetProcessHeap(), 0, header->raw);
+}
+} // namespace vtbackend::resource
+constexpr auto RsDefaultNewAlignment = size_t { __STDCPP_DEFAULT_NEW_ALIGNMENT__ };
+void *operator new(size_t bytes) { return vtbackend::resource::allocate(bytes, RsDefaultNewAlignment); }
+void *operator new[](size_t bytes) { return vtbackend::resource::allocate(bytes, RsDefaultNewAlignment); }
+void *operator new(size_t bytes, std::align_val_t alignment) { return vtbackend::resource::allocate(bytes, static_cast<size_t>(alignment)); }
+void *operator new[](size_t bytes, std::align_val_t alignment) { return vtbackend::resource::allocate(bytes, static_cast<size_t>(alignment)); }
+void operator delete(void *pointer) noexcept { vtbackend::resource::deallocate(pointer); }
+void operator delete[](void *pointer) noexcept { vtbackend::resource::deallocate(pointer); }
+void operator delete(void *pointer, size_t) noexcept { vtbackend::resource::deallocate(pointer); }
+void operator delete[](void *pointer, size_t) noexcept { vtbackend::resource::deallocate(pointer); }
+void operator delete(void *pointer, std::align_val_t) noexcept { vtbackend::resource::deallocate(pointer); }
+void operator delete[](void *pointer, std::align_val_t) noexcept { vtbackend::resource::deallocate(pointer); }
+void operator delete(void *pointer, size_t, std::align_val_t) noexcept { vtbackend::resource::deallocate(pointer); }
+void operator delete[](void *pointer, size_t, std::align_val_t) noexcept { vtbackend::resource::deallocate(pointer); }
diff --git a/src/vtbackend/ResourceAccounting.h b/src/vtbackend/ResourceAccounting.h
new file mode 100644
index 0000000000000000000000000000000000000000..72612f64531a41269d1d5f74865d1721692de8de
--- /dev/null
+++ b/src/vtbackend/ResourceAccounting.h
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+namespace vtbackend::resource
+{
+struct ReservationDenied
+{};
+enum class Kind : uint8_t
+{
+    TerminalTextCpu,
+    ImageCpu,
+    ImageGpu,
+    PendingEffect,
+    Count
+};
+using Reserve = bool (*)(void *userdata, Kind kind, uint64_t bytes, uint32_t descriptors);
+using Release = void (*)(void *userdata, Kind kind, uint64_t bytes, uint32_t descriptors);
+struct Callbacks
+{
+    void *userdata = nullptr;
+    Reserve reserve = nullptr;
+    Release release = nullptr;
+};
+struct Limits
+{
+    std::array<uint64_t, static_cast<size_t>(Kind::Count)> bytes{
+        UINT64_MAX, UINT64_MAX, UINT64_MAX, UINT64_MAX};
