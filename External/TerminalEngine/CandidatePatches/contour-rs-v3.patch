+    uint64_t snapshotBorrowEpoch = 0, lastSnapshotBorrowToken = 0;
+    bool snapshotBorrowActive = false, borrowedAfterEndInvalid = false;
+    std::string orderingReplies, orderingAfterInput;
+    bool orderingResizeObserved = false, orderingSideChannelObserved = false;
+    vtbackend::GridDeltaCursor syncCursor{};
+    uint64_t syncPublishedAtEntry = 0;
+    bool syncObserved = false, syncNoPublication = true, syncDirtyRetained = false;
+    bool syncReleased = false, syncReleaseAtomic = false;
+    Lifecycle lifecycle = Lifecycle::Running;
+    std::string c7Cwd, c7Title, c7Hyperlink;
+    std::optional<vtbackend::PromptRegionError> c7AlternateError;
+    uint64_t hostParserCount = 0;
+    std::string stateJcs;
+    bool stateDirty = true;
+};
+[[nodiscard]] bool validConfig(RsTerminalGate0SessionConfigV1 const *config) noexcept
+{
+    return config && config->size == sizeof(*config) && config->columns != 0 && config->rows != 0 &&
+           config->cell_width_px != 0 && config->cell_height_px != 0 && config->limits &&
+           config->limits->size == sizeof(*config->limits) && config->resource_callbacks &&
+           config->resource_callbacks->size == sizeof(*config->resource_callbacks) &&
+           config->resource_callbacks->reserve && config->resource_callbacks->release &&
+           (config->fixture_id.ptr || config->fixture_id.len == 0) &&
+           (config->schedule_id.ptr || config->schedule_id.len == 0) &&
+           config->limits->maximum_sessions != 0 && config->limits->pending_effect_session_descriptors != 0;
+}
+RsTerminalGate0Result RS_TERMINAL_GATE0_CALL sessionCreate(RsTerminalGate0SessionConfigV1 const *config,
+                                                           RsTerminalGate0Session *output) noexcept
+{
+    if (!output || !validConfig(config))
+        return RS_TERMINAL_GATE0_INVALID_ARGUMENT;
+    *output = nullptr;
+    auto active = ActiveSessions.load(std::memory_order_relaxed);
+    do
+    {
+        if (active >= config->limits->maximum_sessions)
+            return RS_TERMINAL_GATE0_LIMIT_REJECTED;
+    } while (!ActiveSessions.compare_exchange_weak(active, active + 1, std::memory_order_acq_rel));
+    auto const host = *config->resource_callbacks;
+    if (!host.reserve(host.userdata, RS_TERMINAL_GATE0_RESOURCE_TERMINAL_TEXT_CPU, sizeof(CallbackBridge), 0))
+    {
+        ActiveSessions.fetch_sub(1, std::memory_order_release);
+        return RS_TERMINAL_GATE0_LIMIT_REJECTED;
+    }
+    auto *const bridgeMemory =
+        vtbackend::resource::tryAllocate(sizeof(CallbackBridge), alignof(CallbackBridge));
+    if (!bridgeMemory)
+        std::terminate();
+    auto *const bridge = new (bridgeMemory) CallbackBridge{host};
+    auto const contextLimits = vtbackend::resource::Limits{
+        .bytes = {config->limits->terminal_text_session_bytes,
+                  config->limits->image_cpu_session_bytes,
+                  config->limits->image_gpu_session_bytes,
+                  config->limits->pending_effect_session_bytes},
+        .descriptors = {0, 0, 0, config->limits->pending_effect_session_descriptors},
+    };
+    auto *const context = vtbackend::resource::Context::create(
+        {.userdata = bridge, .reserve = reserveBridge, .release = releaseBridge},
+        contextLimits,
+        sizeof(CallbackBridge));
+    if (!context)
+    {
+        destroyBridge(bridge);
+        ActiveSessions.fetch_sub(1, std::memory_order_release);
+        return RS_TERMINAL_GATE0_LIMIT_REJECTED;
+    }
+    Session *session = nullptr;
+    {
+        auto const scope = vtbackend::resource::Scope{*context};
+        auto const result = abiBoundary([&] {
+            session = new Session(bridge, context, *config);
+            return RS_TERMINAL_GATE0_SUCCESS;
+        });
+        if (!session)
+        {
+            (void)context->destroy();
+            destroyBridge(bridge);
+            ActiveSessions.fetch_sub(1, std::memory_order_release);
+            return result;
+        }
+    }
+    *output = session;
+    return RS_TERMINAL_GATE0_SUCCESS;
+}
+RsTerminalGate0Result RS_TERMINAL_GATE0_CALL sessionWrite(RsTerminalGate0Session raw,
+                                                          uint8_t const *data,
+                                                          size_t length) noexcept
+{
+    if (!raw || (!data && length != 0))
+        return RS_TERMINAL_GATE0_INVALID_ARGUMENT;
+    auto &session = *static_cast<Session *>(raw);
+    auto const scope = vtbackend::resource::Scope{*session.accounting};
+    return abiBoundary([&] {
+        return session.write({reinterpret_cast<char const *>(data), length})
+                   ? RS_TERMINAL_GATE0_SUCCESS
+                   : RS_TERMINAL_GATE0_LIMIT_REJECTED;
+    });
+}
+RsTerminalGate0Result RS_TERMINAL_GATE0_CALL
+sessionAction(RsTerminalGate0Session raw,
+              RsTerminalGate0ActionV1 const *action,
+              RsTerminalGate0ActionObservationV1 *observation) noexcept
+{
+    if (!raw || !action || action->size != sizeof(*action) || !observation ||
+        observation->size != sizeof(*observation) ||
+        (!action->action_id.ptr && action->action_id.len != 0) ||
+        (!action->arguments_jcs.ptr && action->arguments_jcs.len != 0))
+        return RS_TERMINAL_GATE0_INVALID_ARGUMENT;
+    auto &session = *static_cast<Session *>(raw);
+    auto const id = view(action->action_id);
+    auto const scope = vtbackend::resource::Scope{*session.accounting};
+    return abiBoundary([&] {
+        auto evidence = ActionEvidence{};
+        if (!session.action(id, view(action->arguments_jcs), evidence))
+            return RS_TERMINAL_GATE0_INTERNAL_ERROR;
+        *observation = {
+            .size = sizeof(*observation),
+            .flags = evidence.flags(),
+            .reservation_calls_before_rejection = evidence.reservationCallsBeforeRejection,
+            .allocation_attempts_before_rejection = evidence.allocationAttemptsBeforeRejection,
+        };
+        return RS_TERMINAL_GATE0_SUCCESS;
+    });
+}
+RsTerminalGate0Result RS_TERMINAL_GATE0_CALL sessionStateJcs(RsTerminalGate0Session raw,
+                                                             uint8_t *buffer,
+                                                             size_t capacity,
+                                                             size_t *required) noexcept
+{
+    if (!raw || !required)
+        return RS_TERMINAL_GATE0_INVALID_ARGUMENT;
+    auto &session = *static_cast<Session *>(raw);
+    auto const scope = vtbackend::resource::Scope{*session.accounting};
+    return abiBoundary([&] {
+        auto const state = session.state();
+        *required = state.size();
+        if (capacity < state.size())
+            return RS_TERMINAL_GATE0_OUT_OF_SPACE;
+        if (!buffer)
+            return RS_TERMINAL_GATE0_INVALID_ARGUMENT;
+        std::memcpy(buffer, state.data(), state.size());
+        return RS_TERMINAL_GATE0_SUCCESS;
+    });
+}
+RsTerminalGate0Result RS_TERMINAL_GATE0_CALL sessionDestroy(RsTerminalGate0Session raw) noexcept
+{
+    if (!raw)
+        return RS_TERMINAL_GATE0_INVALID_ARGUMENT;
+    auto *const session = static_cast<Session *>(raw);
+    auto *const context = session->accounting;
+    auto *const bridge = session->bridge;
+    {
+        auto const scope = vtbackend::resource::Scope{*context};
+        delete session;
+    }
+    if (!context->destroy())
+        return RS_TERMINAL_GATE0_INTERNAL_ERROR;
+    destroyBridge(bridge);
+    ActiveSessions.fetch_sub(1, std::memory_order_release);
+    return RS_TERMINAL_GATE0_SUCCESS;
+}
+} // namespace
+extern "C" RS_TERMINAL_GATE0_API RsTerminalGate0Result RS_TERMINAL_GATE0_CALL rs_terminal_gate0_query_adapter(
+    uint32_t querySymbolVersion, uint32_t requestedAdapterAbi, RsTerminalGate0AdapterV1 *output)
+{
+    if (!output || output->size != sizeof(*output) || output->identity.size != sizeof(output->identity))
+        return RS_TERMINAL_GATE0_INVALID_ARGUMENT;
+    if (querySymbolVersion != RS_TERMINAL_GATE0_QUERY_SYMBOL_VERSION ||
+        requestedAdapterAbi != RS_TERMINAL_GATE0_ADAPTER_ABI_V1)
+        return RS_TERMINAL_GATE0_UNSUPPORTED_ABI;
+#if defined(_M_X64)
+    constexpr auto Architecture = RS_TERMINAL_GATE0_ARCH_X64;
+#elif defined(_M_ARM64)
+    constexpr auto Architecture = RS_TERMINAL_GATE0_ARCH_ARM64;
+#else
+    constexpr auto Architecture = RS_TERMINAL_GATE0_ARCH_UNKNOWN;
+#endif
+    *output = {
+        .size = sizeof(*output),
+        .identity = {.size = sizeof(output->identity),
+                     .adapter_abi = RS_TERMINAL_GATE0_ADAPTER_ABI_V1,
+                     .candidate_id = adapterString(CandidateId),
+                     .upstream_pin = adapterString(UpstreamPin),
+                     .source_sha256 = adapterString(SourceSha256),
+                     .adapter_header_sha256 = adapterString(AdapterHeaderSha256),
+                     .build_identity = adapterString(BuildIdentity),
+                     .architecture = Architecture,
+                     .calling_convention = RS_TERMINAL_GATE0_CALL_CDECL,
+                     .capabilities = Capabilities,
+                     .pointer_size = sizeof(void *),
+                     .reserved = 0},
+        .session_create = sessionCreate,
+        .session_write = sessionWrite,
+        .session_action = sessionAction,
+        .session_state_jcs = sessionStateJcs,
+        .session_destroy = sessionDestroy,
+    };
+    return RS_TERMINAL_GATE0_SUCCESS;
+}
+extern "C" RS_TERMINAL_GATE0_API RsTerminalGate0Result RS_TERMINAL_GATE0_CALL
+rs_terminal_gate0_query_layout_jcs(uint32_t requestedVersion,
+                                   uint8_t *buffer,
+                                   uint64_t capacity,
+                                   uint64_t *outRequired) noexcept
+{
+    return RedSalamander::TerminalEngine::Gate0::Layout::QueryLayoutJcs(
+        requestedVersion, buffer, capacity, outRequired);
+}
