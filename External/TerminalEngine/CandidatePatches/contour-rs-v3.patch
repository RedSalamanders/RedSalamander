+    [[nodiscard]] bool terminalTextBoundary(ActionEvidence &evidence)
+    {
+        auto const &grid = terminal.primaryScreen().grid();
+        terminal.writeToScreen("still-usable");
+        auto const historyWorked =
+            fedBytes == 67'108'865 && grid.historyLineCount() == grid.maxHistoryLineCount() &&
+            fedBytes > static_cast<uint64_t>(*grid.maxHistoryLineCount() + *grid.pageSize().lines) &&
+            grid.renderMainPageText().contains("still-usable");
+        auto constexpr kind = vtbackend::resource::Kind::TerminalTextCpu;
+        auto const beforeBalance = accounting->balance(kind);
+        if (!historyWorked || beforeBalance >= limits.terminal_text_session_bytes)
+            return false;
+        auto const boundaryBytes = limits.terminal_text_session_bytes - beforeBalance;
+        auto *const boundary = accounting->tryAllocateOwned(kind, boundaryBytes);
+        evidence.boundaryAccepted =
+            boundary && accounting->balance(kind) == limits.terminal_text_session_bytes;
+        terminalTextBoundaryObserved =
+            evidence.boundaryAccepted ? accounting->balance(kind) : 0;
+        auto const beforeRejection = accounting->counters(kind);
+        auto *const plusOne = accounting->tryAllocateOwned(kind, 1);
+        auto const afterRejection = accounting->counters(kind);
+        evidence.reservationCallsBeforeRejection =
+            afterRejection.reservationCalls - beforeRejection.reservationCalls;
+        evidence.allocationAttemptsBeforeRejection =
+            afterRejection.allocationAttempts - beforeRejection.allocationAttempts;
+        evidence.plusOneRejected =
+            !plusOne && afterRejection.rejectedReservations == beforeRejection.rejectedReservations + 1;
+        evidence.rejectionBeforeAllocation =
+            evidence.reservationCallsBeforeRejection == 0 && evidence.allocationAttemptsBeforeRejection == 0;
+        evidence.noPartialEffect = accounting->balance(kind) == limits.terminal_text_session_bytes;
+        if (plusOne)
+            accounting->releaseOwned(plusOne, kind, 1);
+        if (boundary)
+            accounting->releaseOwned(boundary, kind, boundaryBytes);
+        return evidence.complete() && accounting->balance(kind) == beforeBalance;
+    }
+    [[nodiscard]] bool pendingEffectBoundary(ActionEvidence &evidence)
+    {
+        auto constexpr kind = vtbackend::resource::Kind::PendingEffect;
+        auto const exercise =
+            [&](uint64_t bytes, uint32_t descriptors, uint64_t plusBytes, uint32_t plusDescriptors) {
+                if (!accounting->tryReserve(kind, bytes, descriptors))
+                    return false;
+                auto const before = accounting->counters(kind);
+                auto const rejected = !accounting->tryReserve(kind, plusBytes, plusDescriptors);
+                auto const after = accounting->counters(kind);
+                evidence.reservationCallsBeforeRejection +=
+                    after.reservationCalls - before.reservationCalls;
+                evidence.allocationAttemptsBeforeRejection +=
+                    after.allocationAttempts - before.allocationAttempts;
+                auto const atomic = accounting->balance(kind) == bytes &&
+                                    accounting->descriptors(kind) == descriptors;
+                accounting->release(kind, bytes, descriptors);
+                return rejected && atomic &&
+                       after.rejectedReservations == before.rejectedReservations + 1 &&
+                       accounting->balance(kind) == 0 && accounting->descriptors(kind) == 0;
+            };
+
+        evidence.boundaryAccepted =
+            exercise(limits.pending_effect_session_bytes, limits.pending_effect_session_descriptors, 1, 1);
+        auto const byteRejected = exercise(limits.pending_effect_session_bytes, 0, 1, 0);
+        auto const descriptorRejected = exercise(0, limits.pending_effect_session_descriptors, 0, 1);
+        evidence.plusOneRejected = evidence.boundaryAccepted && byteRejected && descriptorRejected;
+        evidence.rejectionBeforeAllocation =
+            evidence.reservationCallsBeforeRejection == 0 && evidence.allocationAttemptsBeforeRejection == 0;
+        evidence.noPartialEffect = accounting->balance(kind) == 0 && accounting->descriptors(kind) == 0;
+        return evidence.complete();
