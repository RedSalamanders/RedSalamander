+template <typename Function> RsTerminalGate0Result abiBoundary(Function &&function) noexcept
+{
+    // C ABI boundary: allocation failure is fatal; other standard exceptions cannot escape.
+    try
+    {
+        return function();
+    }
+    catch (vtbackend::resource::ReservationDenied const &)
+    {
+        return RS_TERMINAL_GATE0_LIMIT_REJECTED;
+    }
+    catch (std::bad_alloc const &)
+    {
+        std::terminate();
+    }
+    catch (std::exception const &)
+    {
+        return RS_TERMINAL_GATE0_INTERNAL_ERROR;
+    }
