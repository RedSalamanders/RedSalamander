+}
+[[nodiscard]] std::string hex(std::span<uint8_t const> bytes)
+{
+    constexpr auto Digits = "0123456789abcdef"sv;
+    auto result = std::string(bytes.size() * 2, '0');
+    for (size_t i = 0; i < bytes.size(); ++i)
+    {
+        result[i * 2] = Digits[bytes[i] >> 4];
+        result[i * 2 + 1] = Digits[bytes[i] & 0xF];
+    }
+    return result;
+}
+[[nodiscard]] std::string sha256(std::string_view value)
+{
+    wil::unique_bcrypt_algorithm algorithm;
+    if (BCryptOpenAlgorithmProvider(algorithm.put(), BCRYPT_SHA256_ALGORITHM, nullptr, 0) < 0 ||
+        value.size() > std::numeric_limits<ULONG>::max())
+        return {};
+    auto digest = std::array<uint8_t, 32>{};
+    if (BCryptHash(algorithm.get(),
+                   nullptr,
+                   0,
+                   reinterpret_cast<PUCHAR>(const_cast<char *>(value.data())),
+                   static_cast<ULONG>(value.size()),
+                   digest.data(),
+                   static_cast<ULONG>(digest.size())) < 0)
+        return {};
+    return hex(digest);
+}
