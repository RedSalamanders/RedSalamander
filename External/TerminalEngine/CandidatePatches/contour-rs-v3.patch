+                                  placement.imageGeneration, placement.placementGeneration,
+                                  placement.zIndex, *placement.topLeft.line, *placement.topLeft.column,
+                                  *placement.cellSpan.lines, *placement.cellSpan.columns,
+                                  placement.sourceOffset.x.value, placement.sourceOffset.y.value,
