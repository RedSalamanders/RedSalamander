+    [[nodiscard]] std::string c7EventJcs(C7Event const &event, size_t ordinal) const
+    {
+        if (event.kind == C7Kind::OutputStart)
+            return jsonObject("commandSha256", jsonString(sha256(event.command)),
+                              "kind", jsonString(c7Kind(event.kind)), "ordinal", quoted(ordinal));
+        if (event.kind == C7Kind::CommandFinished)
+            return jsonObject("exitCode", quoted(event.exitCode), "kind", jsonString(c7Kind(event.kind)),
+                              "ordinal", quoted(ordinal));
+        return jsonObject("kind", jsonString(c7Kind(event.kind)), "ordinal", quoted(ordinal));
+    }
+    [[nodiscard]] std::string c7SpanJcs(C7Event const &event, std::string_view phase) const
+    {
+        if (event.spanAvailable)
+            return jsonObject("firstLine", quoted(event.firstLine), "inputBegin", quoted(event.inputBegin),
+                              "lastLine", quoted(event.lastLine), "phase", jsonString(phase),
+                              "status", R"("available")");
+        return jsonObject("error", jsonString(promptError(event.error)), "phase", jsonString(phase),
+                          "status", R"("unavailable")");
+    }
+    [[nodiscard]] std::string c7State() const
+    {
+        auto eventTrace = std::string{"["};
+        auto spanTrace = std::string{"["};
+        auto inputOrdinal = 0;
+        if (c7)
+            for (size_t i = 0; i < c7->count; ++i)
+            {
+                if (i)
+                    eventTrace.push_back(',');
+                eventTrace += c7EventJcs(c7->observations[i], i + 1);
+                auto const &event = c7->observations[i];
+                if (event.kind == C7Kind::InputStart || event.kind == C7Kind::OutputStart)
+                {
+                    if (spanTrace.size() > 1)
+                        spanTrace.push_back(',');
+                    auto const phase = event.kind == C7Kind::OutputStart
+                                           ? "after-output-start"sv
+                                           : (++inputOrdinal == 1 ? "after-first-input-start"sv
+                                                                 : "after-second-input-start"sv);
+                    spanTrace += c7SpanJcs(event, phase);
+                }
+            }
+        eventTrace.push_back(']');
+        if (spanTrace.size() > 1)
+            spanTrace.push_back(',');
+        auto alternate = C7Event{};
+        alternate.error = c7AlternateError.value_or(vtbackend::PromptRegionError::OutOfReach);
+        spanTrace += c7SpanJcs(alternate, "alternate-screen");
+        spanTrace.push_back(']');
+        auto const effects = jsonObject("cwdSha256", jsonString(sha256(c7Cwd)), "hyperlinkSha256",
+                                        jsonString(sha256(c7Hyperlink)), "titleSha256",
+                                        jsonString(sha256(c7Title)));
+        return jsonObject("actionId", R"("probe-c7-engine-effects")", "copiedEffects", effects,
+                          "eventTrace", eventTrace, "hostParserCount", quoted(hostParserCount),
+                          "livePromptSpanTrace", spanTrace, "stateVersion", R"("1")");
