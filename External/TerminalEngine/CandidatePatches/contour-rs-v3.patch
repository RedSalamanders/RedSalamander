+optional<Image::Data> Screen::gate0DecodePng(std::span<uint8_t const> encoded,
+                                             ImageSize& size)
+{
+    auto const pngSize = preflightPng(encoded);
+    if (!pngSize || encoded.size() < 33 || encoded[24] != 8 || encoded[26] != 0
+        || encoded[27] != 0 || encoded[28] != 0)
+        return nullopt;
+    auto const width = static_cast<size_t>(*pngSize->width);
+    auto const height = static_cast<size_t>(*pngSize->height);
+    auto const colorType = encoded[25];
+    auto const channels = colorType == 0 ? 1u : colorType == 2 ? 3u : colorType == 4 ? 2u
+                                                                        : colorType == 6 ? 4u : 0u;
+    if (channels == 0 || width > std::numeric_limits<size_t>::max() / channels)
+        return nullopt;
+
+    auto idat = Image::Data {};
+    auto sawEnd = false;
+    for (size_t offset = 8; offset + 12 <= encoded.size();)
+    {
+        auto const length = static_cast<size_t>(readBigEndian32(encoded, offset));
+        if (length > encoded.size() - offset - 12)
+            return nullopt;
+        auto const type = encoded.subspan(offset + 4, 4);
+        auto crc = crc32(0, nullptr, 0);
+        crc = crc32(crc, type.data(), 4);
+        crc = crc32(crc, encoded.data() + offset + 8, static_cast<uInt>(length));
+        if (crc != readBigEndian32(encoded, offset + 8 + length))
+            return nullopt;
+        if (std::ranges::equal(type, std::string_view{"IDAT"}))
+        {
+            if (length > KittyMaxDecodedBytes - idat.size())
+                return nullopt;
+            idat.insert(idat.end(), encoded.begin() + static_cast<ptrdiff_t>(offset + 8),
+                        encoded.begin() + static_cast<ptrdiff_t>(offset + 8 + length));
+        }
+        else if (std::ranges::equal(type, std::string_view{"IEND"}))
+        {
+            sawEnd = true;
+            break;
+        }
+        offset += length + 12;
+    }
+    auto const rowBytes = width * channels;
+    if (!sawEnd || idat.empty() || height > (KittyMaxDecodedBytes - height) / rowBytes)
+        return nullopt;
+    auto observation = KittyInflateObservation {};
+    auto filtered = inflateKittyPayload(idat, (rowBytes + 1) * height, observation);
+    if (!filtered)
+        return nullopt;
+    auto decoded = Image::Data(rowBytes * height);
+    auto const paeth = [](int left, int up, int upperLeft) {
+        auto const predictor = left + up - upperLeft;
+        auto const dl = std::abs(predictor - left);
+        auto const du = std::abs(predictor - up);
+        auto const dul = std::abs(predictor - upperLeft);
+        return dl <= du && dl <= dul ? left : du <= dul ? up : upperLeft;
+    };
+    for (size_t y = 0; y < height; ++y)
+    {
+        auto const filter = (*filtered)[y * (rowBytes + 1)];
+        if (filter > 4)
+            return nullopt;
+        for (size_t x = 0; x < rowBytes; ++x)
+        {
+            auto const source = (*filtered)[y * (rowBytes + 1) + x + 1];
+            auto const left = x >= channels ? decoded[y * rowBytes + x - channels] : 0;
+            auto const up = y ? decoded[(y - 1) * rowBytes + x] : 0;
+            auto const upperLeft = y && x >= channels
+                                       ? decoded[(y - 1) * rowBytes + x - channels]
+                                       : 0;
+            auto const predictor = filter == 1 ? left
+                                   : filter == 2 ? up
+                                   : filter == 3 ? (left + up) / 2
+                                   : filter == 4 ? paeth(left, up, upperLeft)
+                                                 : 0;
+            decoded[y * rowBytes + x] = static_cast<uint8_t>(source + predictor);
+        }
+    }
+    size = *pngSize;
+    if (colorType == 6)
+        return decoded;
+    auto rgba = Image::Data(width * height * 4);
+    for (size_t pixel = 0; pixel < width * height; ++pixel)
+    {
+        auto const source = pixel * channels;
+        auto const target = pixel * 4;
+        if (colorType == 0 || colorType == 4)
+            rgba[target] = rgba[target + 1] = rgba[target + 2] = decoded[source];
+        else
+            std::ranges::copy_n(decoded.begin() + static_cast<ptrdiff_t>(source), 3,
+                                rgba.begin() + static_cast<ptrdiff_t>(target));
+        rgba[target + 3] = colorType == 4 ? decoded[source + 1] : 0xFF;
+    }
+    return rgba;
+}
