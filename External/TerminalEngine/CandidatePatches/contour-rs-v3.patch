+    [[nodiscard]] optional<KittyRawLayout> kittyRawLayout(kitty_graphics::Command const& command) noexcept
+    {
+        auto const bytesPerPixel = kitty_graphics::bytesPerPixel(command.format);
+        if (bytesPerPixel == 0 || command.pixelWidth == 0 || command.pixelHeight == 0)
+            return nullopt;
+        auto const width = uint64_t { command.pixelWidth };
+        auto const height = uint64_t { command.pixelHeight };
+        if (height > KittyMaxPixels / width)
+            return nullopt;
+        auto const pixels = width * height;
+        if (pixels > KittyMaxPixels
+            || pixels > std::numeric_limits<size_t>::max() / bytesPerPixel
+            || pixels > std::numeric_limits<size_t>::max() / 4)
+            return nullopt;
+        return KittyRawLayout { .pixels = static_cast<size_t>(pixels),
+                                .wireBytes = static_cast<size_t>(pixels) * bytesPerPixel,
+                                .rgbaBytes = static_cast<size_t>(pixels) * 4 };
+    }
+
+    [[nodiscard]] uint32_t readBigEndian32(std::span<uint8_t const> data, size_t offset) noexcept
+    {
+        return (uint32_t { data[offset] } << 24) | (uint32_t { data[offset + 1] } << 16)
+               | (uint32_t { data[offset + 2] } << 8) | uint32_t { data[offset + 3] };
+    }
+
+    [[nodiscard]] optional<ImageSize> preflightPng(std::span<uint8_t const> data) noexcept
+    {
+        constexpr auto Signature =
+            std::array<uint8_t, 8> { 0x89, 'P', 'N', 'G', 0x0D, 0x0A, 0x1A, 0x0A };
+        if (data.size() < 24 || !std::ranges::equal(Signature, data.first(Signature.size()))
+            || readBigEndian32(data, 8) != 13
+            || !std::ranges::equal(std::string_view("IHDR"), data.subspan(12, 4)))
+            return nullopt;
+
+        auto const width = readBigEndian32(data, 16);
+        auto const height = readBigEndian32(data, 20);
+        if (width == 0 || height == 0 || uint64_t { height } > KittyMaxPixels / width)
+            return nullopt;
+        return ImageSize { .width = Width::cast_from(width), .height = Height::cast_from(height) };
+    }
+
+    [[nodiscard]] void* zlibAllocate(void*, uInt count, uInt size) noexcept
+    {
+        if (size != 0 && count > std::numeric_limits<size_t>::max() / size)
+            return nullptr;
+        return resource::tryAllocate(static_cast<size_t>(count) * size, alignof(std::max_align_t));
+    }
+
+    void zlibRelease(void*, void* pointer) noexcept
+    {
+        resource::deallocate(pointer);
+    }
+
+    [[nodiscard]] optional<Image::Data> inflateKittyPayload(std::span<uint8_t const> compressed,
+                                                            size_t expectedBytes,
+                                                            KittyInflateObservation& observation)
+    {
+        observation = {.reservationBytes = expectedBytes};
+        if (compressed.empty() || compressed.size() > KittyMaxDecodedBytes
+            || expectedBytes > KittyMaxDecodedBytes)
+            return nullopt;
+
+        auto output = Image::Data(expectedBytes);
+        auto stream = z_stream {};
+        stream.zalloc = zlibAllocate;
+        stream.zfree = zlibRelease;
+        stream.next_in = const_cast<Bytef*>(compressed.data());
+        stream.avail_in = static_cast<uInt>(compressed.size());
+        stream.next_out = output.data();
+        stream.avail_out = static_cast<uInt>(output.size());
+        resource::clearAllocationDenial();
+        if (inflateInit(&stream) != Z_OK)
+        {
+            if (resource::takeAllocationDenial())
+                throw resource::ReservationDenied {};
+            return nullopt;
+        }
+
+        struct EndInflate
+        {
+            z_stream* stream;
+            ~EndInflate() { (void) inflateEnd(stream); }
+        } const endInflate { &stream };
+
+        resource::clearAllocationDenial();
+        auto const status = inflate(&stream, Z_FINISH);
+        observation.outputBytes = stream.total_out;
+        if (resource::takeAllocationDenial())
+            throw resource::ReservationDenied {};
+        if (status != Z_STREAM_END || stream.total_out != expectedBytes || stream.avail_in != 0)
+            return nullopt;
+        return output;
+    }
+
+    [[nodiscard]] optional<Image::Data> decodeKittyBase64(std::string_view encoded)
+    {
+        if (encoded.empty())
+            return Image::Data {};
+        auto const decodedBytes = crispy::base64::decodeLength(encoded);
+        if (decodedBytes > KittyMaxDecodedBytes)
+            return nullopt;
+        auto output = Image::Data(decodedBytes);
+        output.resize(crispy::base64::decode(encoded, reinterpret_cast<char*>(output.data())));
+        return output;
+    }
