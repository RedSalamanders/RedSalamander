+struct C7Event
+{
+    C7Kind kind = C7Kind::PromptStart;
+    bool spanAvailable = false;
+    int firstLine = 0, inputBegin = 0, lastLine = 0, exitCode = 0;
+    vtbackend::PromptRegionError error = vtbackend::PromptRegionError::NoPromptMark;
+    std::string command;
+};
+class C7Recorder final : public vtbackend::ShellIntegration
+{
+  public:
+    explicit C7Recorder(vtbackend::Terminal &owner) noexcept : terminal{owner} {}
+    [[nodiscard]] bool complete() const noexcept { return count == observations.size(); }
+    void promptStart(bool clickEvents) override
+    { record(C7Event{.kind = C7Kind::PromptStart, .spanAvailable = !clickEvents}); }
+    void promptEnd() override { recordSpan(C7Kind::InputStart); }
+    void commandOutputStart(std::optional<std::string> const &command) override
+    {
+        recordSpan(C7Kind::OutputStart, command.value_or(""));
+    }
+    void commandFinished(int exitCode) override
+    { record(C7Event{.kind = C7Kind::CommandFinished, .exitCode = exitCode}); }
+
+    std::array<C7Event, 6> observations{};
+    size_t count = 0;
+
+  private:
+    void record(C7Event value)
+    {
+        if (count < observations.size())
+            observations[count++] = std::move(value);
+    }
+    void recordSpan(C7Kind kind, std::string command = {})
+    {
+        auto value = C7Event{.kind = kind, .command = std::move(command)};
+        auto const span = terminal.livePromptSpan();
+        value.spanAvailable = span.has_value();
+        if (span)
+        {
+            value.firstLine = *span->firstLine;
+            value.inputBegin = *span->inputBegin.value();
+            value.lastLine = *span->lastLine;
+        }
+        else
+            value.error = span.error();
+        record(std::move(value));
+    }
+    vtbackend::Terminal &terminal;
+};
