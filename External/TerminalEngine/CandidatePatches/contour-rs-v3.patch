+[[nodiscard]] std::string jsonString(std::string_view value)
+{
+    auto result = std::string{"\""};
+    constexpr auto Digits = "0123456789abcdef"sv;
+    for (auto const byte : value)
+    {
+        auto const c = static_cast<uint8_t>(byte);
+        if (c == '"' || c == '\\')
+        {
+            result.push_back('\\');
+            result.push_back(byte);
+        }
+        else if (c < 0x20)
+        {
+            result += "\\u00";
+            result.push_back(Digits[c >> 4]);
+            result.push_back(Digits[c & 0xF]);
+        }
+        else
+            result.push_back(byte);
+    }
+    result.push_back('"');
+    return result;
+}
+template <typename... Rest>
+[[nodiscard]] std::string jsonObject(std::string_view key, std::string_view value, Rest &&...rest)
+{
+    static_assert(sizeof...(rest) % 2 == 0);
+    auto const fields =
+        std::array<std::string_view, 2 + sizeof...(rest)>{key, value, std::string_view{rest}...};
+    auto result = std::string{"{"};
+    for (size_t i = 0; i < fields.size(); i += 2)
+    {
+        if (i)
+            result.push_back(',');
+        result.push_back('"');
+        result += fields[i];
+        result += "\":";
+        result += fields[i + 1];
+    }
+    result.push_back('}');
+    return result;
+}
+template <typename Value> [[nodiscard]] std::string quoted(Value value)
