+[[nodiscard]] bool RunDiscoveryScopeMultipleFoldersLiveProgressChecks(SelfTestState& state) noexcept
+{
+    auto* folder = TryGetFolderWindow(state.mainWindow);
+    auto* operations = TryGetFileOps(folder);
+    if (! operations || ! state.fsLocal || ! state.infoLocal || ! CancelOutstandingSelfTestOperations(operations))
+        return false;
+    RedSalamander::TestSupport::ScopedWindowActivationBlocker blocker;
+    if (! blocker.Start())
+        return false;
+    std::string configuration;
+    if (! BackupPluginConfiguration(state.infoLocal.get(), configuration) || ! SetPluginConfiguration(state.infoLocal.get(), configuration) ||
+        ! BackupPluginConfiguration(state.infoLocal.get(), configuration))
+        return false;
+    const auto fixture = state.tempRoot / L"multiple-folder-live-progress";
+    if (! RecreateEmptyDirectory(fixture) || ! RecreateEmptyDirectory(fixture / L"out") || ! SeedClosureFiles(fixture / L"one", 4u, L"one") ||
+        ! SeedClosureFiles(fixture / L"two" / L"nested", 4u, L"two") || ! SetPluginConfiguration(state.infoLocal.get(), kLocalConcurrency4))
+        return false;
+    ClosureCaseScope scope(state, operations);
+    EnsureFileOperationsSettingsForSelfTest().verifyAfterCopy = false;
+    const auto info = scope.Run(FILESYSTEM_COPY, state.fsLocal, {fixture / L"one", fixture / L"two"}, fixture / L"out");
+    bool contents = true;
+    for (unsigned long index = 0u; index < 4u; ++index)
+        contents = FilesEqualBytes(fixture / L"one" / std::format(L"one-{:02}.bin", index), fixture / L"out" / L"one" / std::format(L"one-{:02}.bin", index)) &&
+                   FilesEqualBytes(fixture / L"two" / L"nested" / std::format(L"two-{:02}.bin", index), fixture / L"out" / L"two" / L"nested" / std::format(L"two-{:02}.bin", index)) && contents;
+    const bool quiet = scope.Close();
+    std::string restored;
+    const bool restore = quiet && SetPluginConfiguration(state.infoLocal.get(), configuration) && BackupPluginConfiguration(state.infoLocal.get(), restored) && restored == configuration;
+    if (quiet)
+        static_cast<void>(SelfTest::RemoveAll(fixture));
+    return info.has_value() && SUCCEEDED(info.value().hr) && info.value().discoveredFiles == 8u && info.value().discoveredTotalBytes == 8u * kClosureFileBytes && contents && quiet && restore;
+}
