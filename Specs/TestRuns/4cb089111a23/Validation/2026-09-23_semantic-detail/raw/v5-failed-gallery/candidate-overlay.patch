+void TestFileOperationsCompletedGroupLayoutKeepsWholeRegions()
+{
+    namespace Group = FileOperationsCompletedGroupLayout;
+    using Group::Layout;
+    const auto clear = D2D1::SizeF(200.0f, 28.0f);
+    const std::array<D2D1_SIZE_F, 5u> fiveBadges{
+        {D2D1::SizeF(48.0f, 22.0f), D2D1::SizeF(48.0f, 22.0f), D2D1::SizeF(48.0f, 22.0f), D2D1::SizeF(48.0f, 22.0f), D2D1::SizeF(48.0f, 22.0f)}};
+
+    const auto requireNoOverlap = [](const Layout& layout, float availableWidth, bool expanded)
+    {
+        std::array<D2D1_RECT_F, 7u> visible{};
+        size_t count     = 0u;
+        visible[count++] = layout.clear;
+        visible[count++] = layout.disclosure;
+        if (expanded)
+            visible[count++] = layout.heading;
+        else
+            for (size_t index = 0u; index < layout.badgeCount; ++index)
+                visible[count++] = layout.badges[index];
+
+        Require(layout.disclosure.left == availableWidth - Group::kDisclosureSizeDip && layout.disclosure.top == 0.0f &&
+                    layout.disclosure.right == availableWidth && layout.disclosure.bottom == Group::kDisclosureSizeDip,
+                "completed-group disclosure remains fixed on the first row");
+        for (size_t index = 0u; index < count; ++index)
+        {
+            const D2D1_RECT_F& a = visible[index];
+            Require(a.left >= 0.0f && a.top >= 0.0f && a.right > a.left && a.bottom > a.top && a.right <= availableWidth && a.bottom <= layout.heightDip,
+                    "completed-group regions are positive and contained by their measured card height");
+            for (size_t other = index + 1u; other < count; ++other)
+            {
+                const D2D1_RECT_F& b = visible[other];
+                Require(a.right <= b.left || b.right <= a.left || a.bottom <= b.top || b.bottom <= a.top, "completed-group regions never overlap");
+            }
+        }
+    };
+
+    Layout expanded{};
+    Require(SUCCEEDED(Group::Arrange(444.0f, clear, D2D1::SizeF(100.0f, 20.0f), {}, true, expanded)), "measured heading fits beside clear");
+    Require(expanded.rowCount == 1u && expanded.heightDip == 28.0f && expanded.heading.left == 208.0f && expanded.heading.right == 308.0f,
