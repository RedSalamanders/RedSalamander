+                                                                                    uint64_t languageRevision) noexcept
+{
+    if (slot >= _terminalFacts.size() || ! _dwriteFactory || ! _bodyFormat || ! std::isfinite(widthPx) || widthPx <= 0.0f)
+        return E_INVALIDARG;
+    auto& cached      = _terminalFacts[slot];
+    const auto counts = TerminalFactCounts(task);
