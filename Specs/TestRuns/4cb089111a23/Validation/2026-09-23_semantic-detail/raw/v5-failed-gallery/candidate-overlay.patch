+    RETURN_IF_FAILED(DxUi::ArrangeMeasuredActions(
+        sizes, widthDip, D2D1::SizeF(8.0f, 6.0f), bounds, layout, rightToLeft ? DxUi::FlowDirection::RightToLeft : DxUi::FlowDirection::LeftToRight));
+    cached.labels      = std::move(labels);
