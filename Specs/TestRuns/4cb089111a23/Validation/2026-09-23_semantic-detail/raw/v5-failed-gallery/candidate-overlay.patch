+void TestFileOperationsFooterKeepsAllCommandsReachable()
+{
+    using FileOperationsFooterLayout::Layout;
+    const auto verify = [](float width, float pause, float cancel, size_t expectedRows)
+    {
+        Layout layout{};
+        Require(SUCCEEDED(FileOperationsFooterLayout::Arrange(width, pause, cancel, layout)), "footer arrangement succeeds for measured controls");
+        Require(layout.rowCount == expectedRows, "footer uses the required number of command rows");
+        Require(layout.heightDip >= 88.0f, "footer keeps its baseline chrome height");
+        const std::array bounds{layout.pauseResume, layout.cancel, layout.queue, layout.options, layout.details};
+        Require((bounds[0].right > bounds[0].left) == (pause != 0.0f), "pause control visibility follows eligibility");
+        Require((bounds[1].right > bounds[1].left) == (cancel != 0.0f), "cancel control visibility follows eligibility");
+        Require(layout.queue.right - layout.queue.left >= 112.0f, "Queue never disappears or shrinks below its usable width");
+        Require(layout.queue.right - layout.queue.left <= 168.0f, "Queue retains its bounded ideal width");
+        Require(layout.queue.top == layout.options.top && layout.options.top == layout.details.top, "settings remain one row cluster");
+        Require(layout.details.right == width, "settings remain right aligned");
+        for (size_t i = 0u; i < bounds.size(); ++i)
+        {
+            const auto& current = bounds[i];
+            if (current.right == current.left)
+                continue;
+            Require(current.left >= 0.0f && current.right <= width && current.bottom > current.top, "every visible command has a contained positive target");
+            Require(current.bottom + FileOperationsFooterLayout::kCommandTopDip + FileOperationsFooterLayout::kBottomDip <= layout.heightDip,
+                    "footer height reserves the entire command and bottom inset");
+            for (size_t j = i + 1u; j < bounds.size(); ++j)
+            {
+                const auto& other = bounds[j];
+                Require(other.right == other.left || current.right <= other.left || other.right <= current.left || current.bottom <= other.top ||
+                            other.bottom <= current.top,
+                        "footer targets never overlap");
+            }
+        }
+        if (pause != 0.0f)
+            Require(layout.pauseResume.right - layout.pauseResume.left == pause, "pause label retains its measured width");
+        if (cancel != 0.0f)
+            Require(layout.cancel.right - layout.cancel.left == cancel, "cancel label retains its measured width");
+    };
+    verify(740.0f, 112.0f, 112.0f, 1u);
+    verify(460.0f, 120.0f, 140.0f, 1u); // Exact minimum-width fit.
+    verify(459.5f, 120.0f, 140.0f, 2u); // Fractional-DIP reflow boundary.
+    verify(460.0f, 200.0f, 190.0f, 2u); // Longer localized commands.
+    verify(460.0f, 300.0f, 280.0f, 3u);
+    verify(460.0f, 0.0f, 430.0f, 2u);
+    verify(460.0f, 200.0f, 0.0f, 1u);
+    verify(460.0f, 0.0f, 0.0f, 1u);
+
+    for (const float summaryHeight : {0.0f, 20.0f, 39.5f, 60.0f})
+    {
+        Layout wrapped{};
+        Require(SUCCEEDED(FileOperationsFooterLayout::Arrange(460.0f, 300.0f, 280.0f, wrapped, summaryHeight)),
+                "wrapped summary coexists with three command rows");
+        Require(wrapped.rowCount == 3u &&
+                    wrapped.commandTopDip >= FileOperationsFooterLayout::kSummaryTopDip + summaryHeight + FileOperationsFooterLayout::kSummaryGapDip,
+                "commands preserve the complete measured summary and its spacing");
+        Require(wrapped.heightDip == 160.0f + (std::max)(0.0f, summaryHeight - 20.0f), "footer height includes all summary lines and command rows");
+    }
+
+    Layout unchanged{};
+    unchanged.heightDip = 1234.0f;
+    unchanged.queue     = D2D1::RectF(1.0f, 2.0f, 3.0f, 4.0f);
+    Require(FAILED(FileOperationsFooterLayout::Arrange(100.0f, 0.0f, 0.0f, unchanged)), "a host narrower than its settings cluster is rejected");
+    Require(FAILED(FileOperationsFooterLayout::Arrange(460.0f, -1.0f, 0.0f, unchanged)), "negative action measurements are rejected");
+    Require(FAILED(FileOperationsFooterLayout::Arrange(460.0f, 112.0f, 112.0f, unchanged, -1.0f)), "negative summary height is rejected");
+    Require(FAILED(FileOperationsFooterLayout::Arrange(460.0f, 112.0f, 112.0f, unchanged, std::numeric_limits<float>::infinity())),
+            "nonfinite summary height is rejected");
+    Require(unchanged.heightDip == 1234.0f && unchanged.queue.left == 1.0f && unchanged.queue.bottom == 4.0f,
+            "failed layout does not publish partial geometry");
+}
