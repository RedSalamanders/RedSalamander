+    const auto destinationB         = state.tempRoot / L"cleanup-drain-b";
+    const auto destinationC         = state.tempRoot / L"cleanup-drain-c";
+    constexpr size_t kPayloadBytes  = 1024u * 1024u;
+    constexpr FileSystemFlags flags = static_cast<FileSystemFlags>(0u);
+    if (state.stepState == 0u)
+    {
+        if (state.fileOps->HasActiveOperations() || ! WriteTestFile(source, kPayloadBytes) || ! RecreateEmptyDirectory(destinationA) ||
+            ! RecreateEmptyDirectory(destinationB) || ! RecreateEmptyDirectory(destinationC))
+        {
+            Fail(L"Could not create an isolated family cleanup fixture.");
+            return true;
+        }
+        state.taskA = StartFileOperationAndGetId(state.fileOps,
+                                                 FILESYSTEM_COPY,
+                                                 FolderWindow::Pane::Left,
+                                                 FolderWindow::Pane::Right,
+                                                 state.fsLocal,
+                                                 {source},
+                                                 destinationA,
+                                                 flags,
+                                                 false,
+                                                 8u * 1024u);
+        if (! state.taskA.has_value())
+        {
+            Fail(L"Could not admit throttled work for family cleanup.");
+            return true;
+        }
+        state.stepState = 1u;
+        return false;
+    }
+    if (state.stepState == 1u)
+    {
+        auto* task = state.fileOps->FindTask(state.taskA.value());
+        if (! task || ! task->HasEnteredOperation())
+            return false;
+        task->SetPaused(true);
+        state.taskB = StartFileOperationAndGetId(
+            state.fileOps, FILESYSTEM_COPY, FolderWindow::Pane::Left, FolderWindow::Pane::Right, state.fsLocal, {source}, destinationB, flags, true);
+        if (! state.taskB.has_value())
+        {
+            Fail(L"Could not admit queued work for family cleanup.");
+            return true;
+        }
+        state.stepState = 2u;
+        return false;
+    }
+    if (state.stepState == 2u)
+    {
+        const auto* paused = state.fileOps->FindTask(state.taskA.value());
+        const auto* queued = state.fileOps->FindTask(state.taskB.value());
+        if (! paused || ! paused->IsPaused() || ! queued || ! queued->IsWaitingForOthers() || queued->HasEnteredOperation())
+        {
+            Fail(L"Cleanup regression requires both a paused active task and a queued task.");
+            return true;
+        }
+        // Exercise exactly the drain used by failed-family cleanup, not a second cancellation path.
+        if (! CancelOutstandingSelfTestOperations(state.fileOps))
+        {
+            Fail(L"Family cleanup did not drain paused and queued work.");
+            return true;
+        }
+        for (const uint64_t taskId : {state.taskA.value(), state.taskB.value()})
