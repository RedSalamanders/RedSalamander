+    Require(five.badgeCount == 5u && five.rowCount == 2u && five.heightDip == 58.0f, "fifth badge is not silently dropped and card height includes its row");
+    Require(five.badges[0].left == 208.0f && five.badges[0].right == 256.0f && five.badges[1].left == 262.0f && five.badges[2].left == 316.0f &&
+                five.badges[3].left == 370.0f && five.badges[3].right == 418.0f && five.badges[4].left == 0.0f && five.badges[4].top == 36.0f &&
+                five.badges[4].bottom == 58.0f,
