+// Synchronous in-process SendMessage only: the sender retains both payload and
+// provider until the UI thread finishes. Never post or timeout a stack payload.
+struct AlertUiaCall
+{
+    void* context                     = nullptr;
+    HRESULT (*invoke)(void*) noexcept = nullptr;
+    HRESULT result                    = static_cast<HRESULT>(UIA_E_ELEMENTNOTAVAILABLE);
+};
+
+LRESULT DispatchAlertUiaCall(LPARAM parameter) noexcept
+{
+    auto* call = reinterpret_cast<AlertUiaCall*>(parameter);
+    if (! call || ! call->invoke)
+        return FALSE;
+    call->result = call->invoke(call->context);
+    return TRUE;
+}
 
