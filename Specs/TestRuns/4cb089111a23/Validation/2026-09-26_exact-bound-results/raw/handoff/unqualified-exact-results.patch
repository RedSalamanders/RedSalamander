diff --git a/RedSalamander/SelfTest/FileOperations/FolderWindow.FileOperations.SelfTest.BatchRenameExactResult.cpp b/RedSalamander/SelfTest/FileOperations/FolderWindow.FileOperations.SelfTest.BatchRenameExactResult.cpp
