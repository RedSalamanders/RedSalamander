+
+void TestFileOperationsCompletedGroupLayoutKeepsWholeRegions()
+{
+    namespace Group = FileOperationsCompletedGroupLayout;
+    using Group::Layout;
+    const auto clear = D2D1::SizeF(200.0f, 28.0f);
+    const std::array<D2D1_SIZE_F, 5u> fiveBadges{
+        {D2D1::SizeF(48.0f, 22.0f), D2D1::SizeF(48.0f, 22.0f), D2D1::SizeF(48.0f, 22.0f), D2D1::SizeF(48.0f, 22.0f), D2D1::SizeF(48.0f, 22.0f)}};
+
+    const auto requireNoOverlap = [](const Layout& layout, float availableWidth, bool expanded)
+    {
+        std::array<D2D1_RECT_F, 7u> visible{};
+        size_t count     = 0u;
+        visible[count++] = layout.clear;
+        visible[count++] = layout.disclosure;
+        if (expanded)
+            visible[count++] = layout.heading;
+        else
+            for (size_t index = 0u; index < layout.badgeCount; ++index)
+                visible[count++] = layout.badges[index];
+
+        Require(layout.disclosure.left == availableWidth - Group::kDisclosureSizeDip && layout.disclosure.top == 0.0f &&
+                    layout.disclosure.right == availableWidth && layout.disclosure.bottom == Group::kDisclosureSizeDip,
+                "completed-group disclosure remains fixed on the first row");
+        for (size_t index = 0u; index < count; ++index)
+        {
+            const D2D1_RECT_F& a = visible[index];
+            Require(a.left >= 0.0f && a.top >= 0.0f && a.right > a.left && a.bottom > a.top && a.right <= availableWidth && a.bottom <= layout.heightDip,
+                    "completed-group regions are positive and contained by their measured card height");
+            for (size_t other = index + 1u; other < count; ++other)
+            {
+                const D2D1_RECT_F& b = visible[other];
+                Require(a.right <= b.left || b.right <= a.left || a.bottom <= b.top || b.bottom <= a.top, "completed-group regions never overlap");
+            }
+        }
+    };
+
+    Layout expanded{};
+    Require(SUCCEEDED(Group::Arrange(444.0f, clear, D2D1::SizeF(100.0f, 20.0f), {}, true, expanded)), "measured heading fits beside clear");
+    Require(expanded.rowCount == 1u && expanded.heightDip == 28.0f && expanded.heading.left == 208.0f && expanded.heading.right == 308.0f,
+            "short heading keeps its complete width on the first row");
+    requireNoOverlap(expanded, 444.0f, true);
+
+    Layout longHeading{};
+    Require(SUCCEEDED(Group::Arrange(444.0f, clear, D2D1::SizeF(300.0f, 20.0f), {}, true, longHeading)), "long heading moves intact to the second row");
+    Require(longHeading.rowCount == 2u && longHeading.heading.left == 0.0f && longHeading.heading.top == 36.0f && longHeading.heading.right == 300.0f &&
+                longHeading.heightDip == 56.0f,
+            "long heading reserves its measured width and second-row height");
+    requireNoOverlap(longHeading, 444.0f, true);
+
+    Layout wrappedHeading{};
+    Require(SUCCEEDED(Group::Arrange(444.0f, clear, D2D1::SizeF(444.0f, 42.0f), {}, true, wrappedHeading)),
+            "a measured multiline heading occupies its entire full-width row");
+    Require(wrappedHeading.heading.top == 36.0f && wrappedHeading.heading.bottom == 78.0f && wrappedHeading.heightDip == 78.0f,
+            "the group preserves every line of a wrapped localized heading");
+    requireNoOverlap(wrappedHeading, 444.0f, true);
+
+    Layout five{};
+    Require(SUCCEEDED(Group::Arrange(444.0f, clear, {}, std::span(fiveBadges), false, five)), "five nonzero badges all arrange");
+    Require(five.badgeCount == 5u && five.rowCount == 2u && five.heightDip == 58.0f, "fifth badge is not silently dropped and card height includes its row");
+    Require(five.badges[0].left == 208.0f && five.badges[0].right == 256.0f && five.badges[1].left == 262.0f && five.badges[2].left == 316.0f &&
+                five.badges[3].left == 370.0f && five.badges[3].right == 418.0f && five.badges[4].left == 0.0f && five.badges[4].top == 36.0f &&
+                five.badges[4].bottom == 58.0f,
+            "four measured badges fit before the disclosure lane and the fifth wraps whole");
+    requireNoOverlap(five, 444.0f, false);
+
+    Layout emptyCategories{};
+    Require(SUCCEEDED(Group::Arrange(444.0f, clear, {}, {}, false, emptyCategories)), "zero nonzero categories are a supported defensive collapsed state");
+    Require(emptyCategories.badgeCount == 0u && emptyCategories.rowCount == 1u && emptyCategories.heightDip == 28.0f,
+            "empty category list retains clear and disclosure without phantom badge rows");
+    requireNoOverlap(emptyCategories, 444.0f, false);
+
+    Layout longClear{};
+    Require(SUCCEEDED(Group::Arrange(444.0f, D2D1::SizeF(430.0f, 28.0f), D2D1::SizeF(100.0f, 20.0f), {}, true, longClear)),
+            "whole clear caption fits on a full-width second row");
+    Require(longClear.disclosure.top == 0.0f && longClear.clear.top == 26.0f && longClear.clear.right == 430.0f && longClear.heading.top == 62.0f &&
+                longClear.rowCount == 3u && longClear.heightDip == 82.0f,
+            "top-right disclosure remains fixed as clear and heading each take whole rows");
+    requireNoOverlap(longClear, 444.0f, true);
+
+    Layout unchanged{};
+    unchanged.heightDip             = 1234.0f;
+    unchanged.rowCount              = 9u;
+    unchanged.badgeCount            = 4u;
+    unchanged.clear                 = D2D1::RectF(1.0f, 2.0f, 3.0f, 4.0f);
+    unchanged.disclosure            = D2D1::RectF(5.0f, 6.0f, 7.0f, 8.0f);
+    unchanged.badges[0]             = D2D1::RectF(9.0f, 10.0f, 11.0f, 12.0f);
+    const auto requireAtomicFailure = [&]
+    {
+        Require(unchanged.heightDip == 1234.0f && unchanged.rowCount == 9u && unchanged.badgeCount == 4u && unchanged.clear.left == 1.0f &&
+                    unchanged.clear.bottom == 4.0f && unchanged.disclosure.right == 7.0f && unchanged.badges[0].bottom == 12.0f,
+                "failed completed-group layout leaves caller output unchanged");
+    };
+    Require(FAILED(Group::Arrange(444.0f, D2D1::SizeF(445.0f, 28.0f), {}, {}, false, unchanged)), "oversized clear fails");
+    requireAtomicFailure();
+    Require(FAILED(Group::Arrange(444.0f, clear, D2D1::SizeF(445.0f, 20.0f), {}, true, unchanged)), "oversized heading fails");
+    requireAtomicFailure();
+    const std::array oversizedBadge{D2D1::SizeF(445.0f, 22.0f)};
+    Require(FAILED(Group::Arrange(444.0f, clear, {}, std::span(oversizedBadge), false, unchanged)), "oversized badge fails");
+    requireAtomicFailure();
+    const std::array sixBadges{fiveBadges[0], fiveBadges[1], fiveBadges[2], fiveBadges[3], fiveBadges[4], fiveBadges[0]};
+    Require(FAILED(Group::Arrange(444.0f, clear, {}, std::span(sixBadges), false, unchanged)), "sixth badge is rejected");
+    requireAtomicFailure();
+    const std::array invalidBadge{D2D1::SizeF(std::numeric_limits<float>::quiet_NaN(), 22.0f)};
+    Require(FAILED(Group::Arrange(444.0f, clear, {}, std::span(invalidBadge), false, unchanged)), "nonfinite badge size fails");
+    requireAtomicFailure();
+    Require(FAILED(Group::Arrange(std::numeric_limits<float>::infinity(), clear, {}, {}, false, unchanged)), "nonfinite width fails");
+    requireAtomicFailure();
+    Require(FAILED(Group::Arrange(444.0f, D2D1::SizeF(-1.0f, 28.0f), {}, {}, false, unchanged)), "negative clear size fails");
+    requireAtomicFailure();
+    Require(FAILED(Group::Arrange(444.0f, clear, {}, {}, true, unchanged)), "expanded state requires a measured heading");
+    requireAtomicFailure();
+    Require(FAILED(Group::Arrange(444.0f, D2D1::SizeF(200.0f, (std::numeric_limits<float>::max)()), {}, std::span(fiveBadges), false, unchanged)),
+            "huge finite dimensions cannot publish zero-area wrapped badge bounds");
+    requireAtomicFailure();
 }
 
