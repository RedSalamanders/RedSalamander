+std::string RemoveAsciiWhitespace(const std::string& text)
+{
+    std::string normalized;
+    normalized.reserve(text.size());
+    for (const char ch : text)
+    {
+        if (std::isspace(static_cast<unsigned char>(ch)) == 0)
+        {
+            normalized.push_back(ch);
+        }
+    }
+    return normalized;
+}
