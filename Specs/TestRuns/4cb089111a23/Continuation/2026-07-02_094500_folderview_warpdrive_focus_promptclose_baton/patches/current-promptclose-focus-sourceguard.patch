diff --git a/RedSalamander/SelfTest/Commands/Commands.SelfTest.Settings.cpp b/RedSalamander/SelfTest/Commands/Commands.SelfTest.Settings.cpp
index 326be13cd..5a66da266 100644
--- a/RedSalamander/SelfTest/Commands/Commands.SelfTest.Settings.cpp
+++ b/RedSalamander/SelfTest/Commands/Commands.SelfTest.Settings.cpp
@@ -5633,13 +5633,44 @@ void AutoCloseTransientUi(std::stop_token stopToken, DWORD uiThreadId, DWORD pro
 
 void FocusFolderViewPane(FolderWindow::Pane pane) noexcept
 {
+    using namespace std::chrono_literals;
+
     g_folderWindow.SetActivePane(pane);
 
     const HWND view = g_folderWindow.GetFolderViewHwnd(pane);
-    if (view && IsWindow(view) != FALSE)
+    if (! view || IsWindow(view) == FALSE)
     {
-        SetFocus(view);
+        return;
+    }
+
+    const auto deadline  = std::chrono::steady_clock::now() + SelfTest::Scale(250ms);
+    size_t stableSamples = 0u;
+    while (std::chrono::steady_clock::now() < deadline)
+    {
+        if (GetFocus() != view)
+        {
+            SetFocus(view);
+        }
+
+        PumpPendingMessages();
+        if (GetFocus() == view && g_folderWindow.GetFocusedFolderViewHwnd() == view && g_folderWindow.GetFocusedPane() == pane)
+        {
+            ++stableSamples;
+            if (stableSamples >= 2u)
+            {
+                return;
+            }
+        }
+        else
+        {
+            stableSamples = 0u;
+        }
+
+        std::this_thread::sleep_for(10ms);
     }
+
+    SetFocus(view);
+    PumpPendingMessages();
 }
 
 [[nodiscard]] bool WaitForFolderViewPaneFocus(FolderWindow::Pane pane, HWND expectedFolderView, std::chrono::milliseconds timeout) noexcept
diff --git a/Tests/DxUiTests/DxUiTests.NativeTextInput.cpp b/Tests/DxUiTests/DxUiTests.NativeTextInput.cpp
index ab8182c72..0b3974d0f 100644
--- a/Tests/DxUiTests/DxUiTests.NativeTextInput.cpp
+++ b/Tests/DxUiTests/DxUiTests.NativeTextInput.cpp
@@ -209,6 +209,77 @@ void TestFolderViewDxUiPromptsDeactivateNativeTextInputBeforeDestroyWindow()
         requireMessage(countOccurrences(classBlock, "_hWnd.reset()") == 1u,
                        std::string(promptClasses[index]) + " avoids direct modal HWND reset outside the native-text-input close helper");
     }
+
+    const std::filesystem::path navigationSourcePath =
+        FindRepoRootForDxUiTests() / L"RedSalamander" / L"FolderWindow.FileSystem.Navigation.Part.cpp";
+    std::ifstream navigationSourceInput(navigationSourcePath);
+    Require(navigationSourceInput.good(), "FolderWindow.FileSystem.Navigation.Part source is readable for DxUi prompt debug close guard");
+    const std::string navigationSource((std::istreambuf_iterator<char>(navigationSourceInput)), std::istreambuf_iterator<char>());
+
+    Require(navigationSource.find("PostFolderViewPromptCloseDebugCommand") != std::string::npos,
+            "FolderView prompt debug close actions share an asynchronous post helper");
+
+    const std::array<const char*, 10> closeDebugHelpers{
+        "bool DebugConfirmFolderViewPaneFilterPrompt() noexcept",
+        "bool DebugCancelFolderViewPaneFilterPrompt() noexcept",
+        "bool DebugConfirmFolderViewSelectionMaskPrompt() noexcept",
+        "bool DebugCancelFolderViewSelectionMaskPrompt() noexcept",
+        "bool DebugConfirmFolderViewCreateDirectoryPrompt() noexcept",
+        "bool DebugCancelFolderViewCreateDirectoryPrompt() noexcept",
+        "bool DebugConfirmFolderViewEditNewPrompt() noexcept",
+        "bool DebugCancelFolderViewEditNewPrompt() noexcept",
+        "bool DebugConfirmFolderViewChangeCasePrompt() noexcept",
+        "bool DebugCancelFolderViewChangeCasePrompt() noexcept",
+    };
+
+    for (const char* helper : closeDebugHelpers)
+    {
+        const size_t helperStart = navigationSource.find(helper);
+        requireMessage(helperStart != std::string::npos, std::string(helper) + " source block is found");
+        if (helperStart == std::string::npos)
+        {
+            continue;
+        }
+
+        const size_t helperEnd = navigationSource.find("\n}", helperStart);
+        requireMessage(helperEnd != std::string::npos && helperStart < helperEnd, std::string(helper) + " source block end is found");
+        const std::string_view helperBlock(navigationSource.data() + helperStart, helperEnd - helperStart);
+        requireMessage(helperBlock.find("PostFolderViewPromptCloseDebugCommand") != std::string_view::npos,
+                       std::string(helper) + " posts Confirm/Cancel close actions");
+        requireMessage(helperBlock.find("SendMessageW") == std::string_view::npos,
+                       std::string(helper) + " avoids synchronous cross-thread close SendMessage");
+    }
+
+    const std::filesystem::path fileOpsPopupSourcePath = FindRepoRootForDxUiTests() / L"RedSalamander" / L"FolderWindow.FileOperations.Popup.cpp";
+    std::ifstream fileOpsPopupSourceInput(fileOpsPopupSourcePath);
+    Require(fileOpsPopupSourceInput.good(), "FolderWindow.FileOperations.Popup source is readable for DxUi prompt debug close guard");
+    const std::string fileOpsPopupSource((std::istreambuf_iterator<char>(fileOpsPopupSourceInput)), std::istreambuf_iterator<char>());
+
+    Require(fileOpsPopupSource.find("PostFileOperationsSpeedLimitPromptCloseDebugCommand") != std::string::npos,
+            "FileOperations speed-limit prompt debug close actions share an asynchronous post helper");
+
+    const std::array<const char*, 2> fileOpsCloseDebugHelpers{
+        "bool DebugConfirmFileOperationsSpeedLimitPrompt() noexcept",
+        "bool DebugCancelFileOperationsSpeedLimitPrompt() noexcept",
+    };
+
+    for (const char* helper : fileOpsCloseDebugHelpers)
+    {
+        const size_t helperStart = fileOpsPopupSource.find(helper);
+        requireMessage(helperStart != std::string::npos, std::string(helper) + " source block is found");
+        if (helperStart == std::string::npos)
+        {
+            continue;
+        }
+
+        const size_t helperEnd = fileOpsPopupSource.find("\n}", helperStart);
+        requireMessage(helperEnd != std::string::npos && helperStart < helperEnd, std::string(helper) + " source block end is found");
+        const std::string_view helperBlock(fileOpsPopupSource.data() + helperStart, helperEnd - helperStart);
+        requireMessage(helperBlock.find("PostFileOperationsSpeedLimitPromptCloseDebugCommand") != std::string_view::npos,
+                       std::string(helper) + " posts Confirm/Cancel close actions");
+        requireMessage(helperBlock.find("SendMessageW") == std::string_view::npos,
+                       std::string(helper) + " avoids synchronous cross-thread close SendMessage");
+    }
 }
 
