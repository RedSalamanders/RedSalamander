+                                  reinterpret_cast<uintptr_t>(child),
+                                  className,
+                                  IsWindowVisible(child) != FALSE ? 1 : 0,
+                                  static_cast<uint64_t>(style),
+                                  static_cast<uint64_t>(exStyle),
+                                  reinterpret_cast<uintptr_t>(GetParent(child)),
+                                  points[0].x,
+                                  points[0].y,
+                                  points[1].x,
+                                  points[1].y);
+        return TRUE;
+    },
+                                       reinterpret_cast<LPARAM>(hwnd)));
