+                                              _countof(line),
+                                              L"%02hu:%02hu:%02hu.%03hu tid=%lu step=%s hwnd=0x%p active=%d threadMgr=0x%p doc=0x%p ctx=0x%p store=0x%p hr=0x%08X\r\n",
