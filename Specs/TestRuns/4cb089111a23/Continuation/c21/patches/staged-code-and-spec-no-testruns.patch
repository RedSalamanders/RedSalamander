+{
+    wchar_t path[MAX_PATH + 1]{};
+    const DWORD pathLength = GetEnvironmentVariableW(L"REDSALAMANDER_DXUI_TEXTINPUT_TRACE_FILE", path, static_cast<DWORD>(_countof(path)));
+    if (pathLength == 0u || pathLength >= _countof(path))
+    {
+        return;
+    }
+
+    wil::unique_hfile file(CreateFileW(path,
