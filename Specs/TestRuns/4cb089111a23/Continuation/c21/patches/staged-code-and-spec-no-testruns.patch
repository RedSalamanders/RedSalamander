+void TestFolderViewDxUiPromptsDeactivateNativeTextInputBeforeDestroyWindow()
+{
+    const std::filesystem::path windowHostSourcePath = FindRepoRootForDxUiTests() / L"Common" / L"DxUi" / L"DxUi.WindowHost.cpp";
+    std::ifstream windowHostSourceInput(windowHostSourcePath);
+    Require(windowHostSourceInput.good(), "DxUi WindowHost source is readable for focus-clear text-input teardown guard");
+    const std::string windowHostSource((std::istreambuf_iterator<char>(windowHostSourceInput)), std::istreambuf_iterator<char>());
+
+    const size_t setFocusControl = windowHostSource.find("void WindowHost::SetFocusControl(Control* control) noexcept");
+    const size_t nextMethod      = windowHostSource.find("\nControl* WindowHost::GetFocusControl", setFocusControl);
+    Require(setFocusControl != std::string::npos && nextMethod != std::string::npos && setFocusControl < nextMethod,
+            "WindowHost SetFocusControl source block is found");
+    const std::string_view setFocusBlock(windowHostSource.data() + setFocusControl, nextMethod - setFocusControl);
+    const size_t oldFocusSupportsTextInput = setFocusBlock.find("oldFocusSupportsTextInput");
+    const size_t deactivateTextInput       = setFocusBlock.find("DeactivateTextInput(false)");
+    const size_t clearFocusedControl       = setFocusBlock.find("_focusedControl = nullptr");
+    Require(oldFocusSupportsTextInput != std::string_view::npos && deactivateTextInput != std::string_view::npos,
+            "WindowHost SetFocusControl deactivates the old text-input focus when focus is cleared");
+    Require(clearFocusedControl != std::string_view::npos && deactivateTextInput < clearFocusedControl,
+            "WindowHost SetFocusControl deactivates text input before clearing focused control state");
+
+    const std::filesystem::path sourcePath = FindRepoRootForDxUiTests() / L"RedSalamander" / L"FolderWindow.FileSystem.cpp";
+    std::ifstream sourceInput(sourcePath);
+    Require(sourceInput.good(), "FolderWindow.FileSystem source is readable for DxUi prompt close guard");
+    const std::string source((std::istreambuf_iterator<char>(sourceInput)), std::istreambuf_iterator<char>());
+
+    const std::array<const char*, 5> promptClasses{
+        "class FolderViewPaneFilterPromptWindow",
+        "class FolderViewSelectionMaskPromptWindow",
+        "class FolderViewCreateDirectoryPromptWindow",
+        "class FolderViewEditNewPromptWindow",
+        "class FolderViewChangeCasePromptWindow",
+    };
+
+    const auto countOccurrences = [](std::string_view haystack, std::string_view needle) noexcept
+    {
+        size_t count  = 0u;
+        size_t offset = 0u;
+        while (offset < haystack.size())
+        {
+            const size_t found = haystack.find(needle, offset);
+            if (found == std::string_view::npos)
+            {
+                break;
+            }
+            ++count;
+            offset = found + needle.size();
+        }
+        return count;
+    };
+    const auto requireMessage = [](bool condition, const std::string& message)
+    {
+        Require(condition, message.c_str());
+    };
+
+    for (size_t index = 0u; index < promptClasses.size(); ++index)
+    {
+        const size_t classStart = source.find(promptClasses[index]);
+        requireMessage(classStart != std::string::npos, std::string(promptClasses[index]) + " source block is found");
+        const size_t classEnd = index + 1u < promptClasses.size() ? source.find(promptClasses[index + 1u], classStart + 1u) : source.find("} // namespace", classStart);
+        requireMessage(classEnd != std::string::npos && classStart < classEnd, std::string(promptClasses[index]) + " source block end is found");
+        const std::string_view classBlock(source.data() + classStart, classEnd - classStart);
+
+        const size_t closeHelper = classBlock.find("void ClosePromptWindow() noexcept");
+        requireMessage(closeHelper != std::string_view::npos, std::string(promptClasses[index]) + " centralizes modal HWND close");
+        if (closeHelper == std::string_view::npos)
+        {
+            continue;
+        }
+
+        const size_t clearFocus = classBlock.find("_dxHost.SetFocusControl(nullptr)", closeHelper);
+        const size_t resetHwnd  = classBlock.find("_hWnd.reset()", closeHelper);
+        requireMessage(clearFocus != std::string_view::npos && resetHwnd != std::string_view::npos,
+                       std::string(promptClasses[index]) + " close helper clears DxUi focus before destroying the HWND");
+        requireMessage(clearFocus < resetHwnd,
+                       std::string(promptClasses[index]) + " clears DxUi focus before DestroyWindow begins");
+        requireMessage(countOccurrences(classBlock, "_hWnd.reset()") == 1u,
+                       std::string(promptClasses[index]) + " avoids direct modal HWND reset outside the native-text-input close helper");
+    }
+}
