+                                              hwnd,
+                                              active ? 1 : 0,
+                                              threadMgr,
+                                              documentMgr,
+                                              context,
+                                              textStore,
+                                              static_cast<unsigned>(hr));
+    if (FAILED(formatHr))
+    {
+        return;
+    }
+
+    DWORD bytesWritten = 0u;
+    static_cast<void>(WriteFile(file.get(), line, static_cast<DWORD>(wcslen(line) * sizeof(wchar_t)), &bytesWritten, nullptr));
