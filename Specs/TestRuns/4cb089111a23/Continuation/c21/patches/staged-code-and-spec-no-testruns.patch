+void SendFolderViewQuickSearchCharForPerf(HWND folderView, wchar_t character) noexcept
+{
+    ClearSyntheticTextInputModifiersForFolderViewPerf();
+    SendMessageW(folderView, WM_CHAR, static_cast<WPARAM>(character), 0);
+    PumpPendingMessages();
+}
