+[[nodiscard]] bool TryReadRawProviderBoolProperty(IRawElementProviderSimple& provider, PROPERTYID propertyId, bool& outValue) noexcept
+{
+    outValue = false;
+
+    VARIANT value{};
+    VariantInit(&value);
