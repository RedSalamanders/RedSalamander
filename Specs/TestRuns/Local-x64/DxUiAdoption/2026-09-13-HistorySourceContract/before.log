                   popupResult.failedCapture = guiInfo.hwndCapture;
               }
               PostMessageW(popup, WM_KEYDOWN, VK_ESCAPE, 0);
               PostMessageW(popup, WM_KEYUP, VK_ESCAPE, 0);
               popupResult.popupClosed = WaitForWindowClosed(popup, SelfTest::Scale(2000ms));
               return;
