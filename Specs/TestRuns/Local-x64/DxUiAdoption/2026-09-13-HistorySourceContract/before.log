                       popupResult.lastItemCount,
                       popupResult.failedPopupValid,
                       popupResult.failedPopupVisible,
                       popupResult.failedForegroundProcess,
                       GetCurrentProcessId(),
                       reinterpret_cast<uintptr_t>(popupResult.failedFocus),
                       reinterpret_cast<uintptr_t>(popupResult.failedCapture),
                       popupResult.cursorBeforeActivation.x,
                       popupResult.cursorBeforeActivation.y,
                       popupResult.cursorAtFailure.x,
                       popupResult.cursorAtFailure.y,
                       popupResult.failedPopupRect.left,
