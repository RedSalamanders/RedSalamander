// ThemeDefinition (JSON5) for RedSalamander SettingsStore
// Copy this object into your settings file under: theme.themes[]
// Then select it by setting: theme.currentThemeId = "user/neon-tokyo"
{
  "formatVersion": 2,
  "id": "user/neon-tokyo",
  "name": "Neon Tokyo",
  "baseThemeId": "builtin/dark",
  "palette": {
    "accent": "#FF3AF2",
    "background": "#0B1020",
    "text": "#E6F1FF",
    "disabledText": "#607B9E",
    "separator": "#1C2A4A",
    "background2": "#101A33",
    "backgroundHover": "#18264A",
    "backgroundPressed": "#22335F",
    "separator2": "#2A3B66",
    "accent2": "#3AF2FF",
    "progressWarn": "#FF4D4D",
    "graphBackground": "#401C2A4A",
    "graphLimit": "#CC607B9E",
    "scrollbarTrack": "#191C2A4A",
    "scrollbarThumb": "#661C2A4A",
    "itemBackgroundNormal": "#00000000",
    "itemBackgroundHovered": "#33243B73",
    "itemBackgroundSelectedInactive": "#A6FF3AF2",
    "itemBackgroundFocused": "#3340A0FF",
    "textNormal": "#D6DEFF",
    "errorBackground": "#33FF3355",
    "warningBackground": "#33FFB86C",
    "warningText": "#FFB86C",
    "infoBackground": "#333AF2FF",
    "bg": "#050A14",
    "searchHighlight": "#33FFD500",
    "metaText": "#9FB3C8",
    "metaDebug": "#7C7CFF",
    "addedBackground": "#333AF26E",
    "removedBackground": "#33FF5B7A",
    "contextBackground": "#123AF2FF",
    "headerBackground": "#1A3AF2FF",
    "bannerBackground": "#263AF2FF",
    "placeholderBackground": "#22FF3AF2",
    "divider": "#B82A3B66",
  },

  "colors": {
    // App-level
    "app.accent": "ref(palette.accent)", // neon magenta
    "window.background": "ref(palette.background)", // deep night blue

    // Menu
    "menu.background": "ref(palette.background)",
    "menu.text": "ref(palette.text)",
    "menu.disabledText": "ref(palette.disabledText)",
    "menu.selectionBg": "ref(palette.accent)",
    "menu.selectionText": "ref(palette.background)",
    "menu.separator": "ref(palette.separator)",
    "menu.border": "ref(palette.separator)",

    // Navigation
    "navigation.background": "ref(palette.background2)",
    "navigation.backgroundHover": "ref(palette.backgroundHover)",
    "navigation.backgroundPressed": "ref(palette.backgroundPressed)",
    "navigation.text": "ref(palette.text)",
    "navigation.separator": "ref(palette.separator2)",
    "navigation.accent": "ref(palette.accent2)", // neon cyan
    "navigation.progressOk": "ref(palette.accent)", // magenta
    "navigation.progressWarn": "ref(palette.progressWarn)",
    "navigation.progressBackground": "ref(palette.separator)",

    // File Operations popup
    "fileOps.progressBackground": "ref(palette.separator)",
    "fileOps.progressTotal": "ref(palette.accent)",
    "fileOps.progressItem": "ref(palette.accent2)",
    "fileOps.graphBackground": "ref(palette.graphBackground)",
    "fileOps.graphGrid": "ref(palette.graphBackground)",
    "fileOps.graphLimit": "ref(palette.graphLimit)",
    "fileOps.graphLine": "ref(palette.accent2)",
    "fileOps.scrollbarTrack": "ref(palette.scrollbarTrack)",
    "fileOps.scrollbarThumb": "ref(palette.scrollbarThumb)",

    // FolderView
    "folderView.background": "ref(palette.background)",
    "folderView.itemBackgroundNormal": "ref(palette.itemBackgroundNormal)",
    "folderView.itemBackgroundHovered": "ref(palette.itemBackgroundHovered)", // translucent indigo
    "folderView.itemBackgroundSelected": "ref(palette.accent)",
    "folderView.itemBackgroundSelectedInactive": "ref(palette.itemBackgroundSelectedInactive)",
    "folderView.itemBackgroundFocused": "ref(palette.itemBackgroundFocused)",
    "folderView.textNormal": "ref(palette.textNormal)",
    "folderView.textSelected": "ref(palette.background)",
    "folderView.textSelectedInactive": "ref(palette.background)",
    "folderView.textDisabled": "ref(palette.disabledText)",
    "folderView.focusBorder": "ref(palette.accent2)",
    "folderView.gridLines": "ref(palette.separator)",
    "folderView.errorBackground": "ref(palette.errorBackground)",
    "folderView.errorText": "ref(palette.progressWarn)",
    "folderView.warningBackground": "ref(palette.warningBackground)",
    "folderView.warningText": "ref(palette.warningText)",
    "folderView.infoBackground": "ref(palette.infoBackground)",
    "folderView.infoText": "ref(palette.accent2)",

    // Monitor (ColorTextView)
    "monitor.textView.bg": "ref(palette.bg)",
    "monitor.textView.fg": "ref(palette.text)",
    "monitor.textView.caret": "ref(palette.accent)",
    "monitor.textView.selection": "ref(palette.itemBackgroundFocused)",
    "monitor.textView.searchHighlight": "ref(palette.searchHighlight)",
    "monitor.textView.gutterBg": "ref(palette.background)",
    "monitor.textView.gutterFg": "ref(palette.disabledText)",
    "monitor.textView.metaText": "ref(palette.metaText)",
    "monitor.textView.metaError": "ref(palette.progressWarn)",
    "monitor.textView.metaWarning": "ref(palette.warningText)",
    "monitor.textView.metaInfo": "ref(palette.accent2)",
    "monitor.textView.metaDebug": "ref(palette.metaDebug)",

    // Viewer diff
    "viewer.diff.addedBackground": "ref(palette.addedBackground)",
    "viewer.diff.removedBackground": "ref(palette.removedBackground)",
    "viewer.diff.contextBackground": "ref(palette.contextBackground)",
    "viewer.diff.headerBackground": "ref(palette.headerBackground)",
    "viewer.diff.bannerBackground": "ref(palette.bannerBackground)",
    "viewer.diff.placeholderBackground": "ref(palette.placeholderBackground)",
    "viewer.diff.divider": "ref(palette.divider)",
  },
}
