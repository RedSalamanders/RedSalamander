{
  "formatVersion": 2,
  "id": "user/catppuccin-latte",
  "name": "Catppuccin Latte",
  "baseThemeId": "builtin/light",
  "palette": {
    "rosewater": "#DC8A78", "flamingo": "#DD7878", "pink": "#EA76CB", "mauve": "#8839EF",
    "red": "#D20F39", "maroon": "#E64553", "peach": "#FE640B", "yellow": "#DF8E1D",
    "green": "#40A02B", "teal": "#179299", "sky": "#04A5E5", "sapphire": "#209FB5",
    "blue": "#1E66F5", "lavender": "#7287FD", "text": "#4C4F69", "subtext1": "#5C5F77",
    "subtext0": "#6C6F85", "overlay2": "#7C7F93", "overlay1": "#8C8FA1", "overlay0": "#9CA0B0",
    "surface2": "#ACB0BE", "surface1": "#BCC0CC", "surface0": "#CCD0DA", "base": "#EFF1F5",
    "mantle": "#E6E9EF", "crust": "#DCE0E8",
    "transparent": "#00000000",
    "selection": "blend(palette.base,palette.overlay2,26%)",
    "selectionInactive": "alpha(palette.selection,65%)",
    "accentHover": "alpha(palette.lavender,20%)",
    "errorFill": "alpha(palette.red,20%)",
    "warningFill": "alpha(palette.yellow,20%)",
    "infoFill": "alpha(palette.blue,20%)"
  },
  "colors": {
    "app.accent": "ref(palette.lavender)",
    "window.background": "ref(palette.base)",
    "menu.background": "ref(palette.mantle)",
    "menu.text": "ref(palette.text)",
    "menu.disabledText": "ref(palette.subtext0)",
    "menu.selectionBg": "ref(palette.selection)",
    "menu.selectionText": "ref(palette.text)",
    "menu.separator": "ref(palette.surface1)",
    "menu.border": "ref(palette.surface2)",
    "navigation.background": "ref(palette.mantle)",
    "navigation.backgroundHover": "ref(palette.surface0)",
    "navigation.backgroundPressed": "ref(palette.surface1)",
    "navigation.text": "ref(palette.text)",
    "navigation.separator": "ref(palette.surface2)",
    "navigation.accent": "ref(palette.blue)",
    "navigation.progressOk": "ref(palette.green)",
    "navigation.progressWarn": "ref(palette.red)",
    "navigation.progressBackground": "ref(palette.surface0)",
    "fileOps.progressBackground": "ref(palette.surface0)",
    "fileOps.progressTotal": "ref(palette.green)",
    "fileOps.progressItem": "ref(palette.blue)",
    "fileOps.graphBackground": "alpha(palette.surface1,25%)",
    "fileOps.graphGrid": "alpha(palette.surface2,25%)",
    "fileOps.graphLimit": "alpha(palette.overlay1,80%)",
    "fileOps.graphLine": "ref(palette.blue)",
    "fileOps.scrollbarTrack": "alpha(palette.surface1,10%)",
    "fileOps.scrollbarThumb": "alpha(palette.surface2,40%)",
    "folderView.background": "ref(palette.base)",
    "folderView.itemBackgroundNormal": "ref(palette.transparent)",
    "folderView.itemBackgroundHovered": "ref(palette.accentHover)",
    "folderView.itemBackgroundSelected": "ref(palette.selection)",
    "folderView.itemBackgroundSelectedInactive": "ref(palette.selectionInactive)",
    "folderView.itemBackgroundFocused": "ref(palette.accentHover)",
    "folderView.textNormal": "ref(palette.text)",
    "folderView.textSelected": "ref(palette.text)",
    "folderView.textSelectedInactive": "ref(palette.subtext1)",
    "folderView.textDisabled": "ref(palette.overlay1)",
    "folderView.focusBorder": "ref(palette.lavender)",
    "folderView.gridLines": "ref(palette.surface1)",
    "folderView.errorBackground": "ref(palette.errorFill)",
    "folderView.errorText": "ref(palette.red)",
    "folderView.warningBackground": "ref(palette.warningFill)",
    "folderView.warningText": "ref(palette.yellow)",
    "folderView.infoBackground": "ref(palette.infoFill)",
    "folderView.infoText": "ref(palette.blue)",
    "monitor.textView.bg": "ref(palette.base)",
    "monitor.textView.fg": "ref(palette.text)",
    "monitor.textView.caret": "ref(palette.lavender)",
    "monitor.textView.selection": "ref(palette.selection)",
    "monitor.textView.searchHighlight": "ref(palette.warningFill)",
    "monitor.textView.gutterBg": "ref(palette.mantle)",
    "monitor.textView.gutterFg": "ref(palette.subtext0)",
    "monitor.textView.metaText": "ref(palette.subtext1)",
    "monitor.textView.metaError": "ref(palette.red)",
    "monitor.textView.metaWarning": "ref(palette.yellow)",
    "monitor.textView.metaInfo": "ref(palette.blue)",
    "monitor.textView.metaDebug": "ref(palette.mauve)",
    "viewer.diff.addedBackground": "alpha(palette.green,20%)",
    "viewer.diff.removedBackground": "ref(palette.errorFill)",
    "viewer.diff.contextBackground": "alpha(palette.surface0,25%)",
    "viewer.diff.headerBackground": "alpha(palette.lavender,14%)",
    "viewer.diff.bannerBackground": "alpha(palette.lavender,20%)",
    "viewer.diff.placeholderBackground": "alpha(palette.overlay0,18%)",
    "viewer.diff.divider": "alpha(palette.overlay2,70%)"
  }
}
