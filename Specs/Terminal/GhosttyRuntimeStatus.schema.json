{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://red-salamander.local/schemas/ghostty-runtime-status-v1.json",
  "title": "RedSalamander Ghostty runtime observation status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedUtc",
    "mode",
    "result",
    "reasonCodes",
    "sourceBinding",
    "canonicalLock",
    "observation",
    "advisories",
    "networkAttempts",
    "nextAction"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedUtc": { "type": "string", "format": "date-time", "maxLength": 40 },
    "mode": { "enum": ["Locked", "Online", "Candidate"] },
    "result": { "enum": ["current", "update-observed", "security-review", "required-manual", "unreachable"] },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80 }
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryCommit"],
      "properties": {
        "repositoryCommit": { "$ref": "#/$defs/sha1" }
      }
    },
    "canonicalLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "commit", "tree", "version", "zigVersion"],
      "properties": {
        "path": { "const": "External/TerminalEngine/GhosttyRuntimeLock.v1.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "commit": { "$ref": "#/$defs/sha1" },
        "tree": { "$ref": "#/$defs/sha1" },
        "version": { "type": "string", "minLength": 1, "maxLength": 80 },
        "zigVersion": { "type": "string", "minLength": 1, "maxLength": 40 }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "commit", "tree", "version", "aheadCount", "behindCount", "observedUtc", "candidateRequestedCommit"],
      "properties": {
        "source": { "enum": ["canonical-lock", "github-default-branch", "github-explicit-commit"] },
        "commit": { "$ref": "#/$defs/nullableSha1" },
        "tree": { "$ref": "#/$defs/nullableSha1" },
        "version": { "type": ["string", "null"], "maxLength": 80 },
        "aheadCount": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000000 },
        "behindCount": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000000 },
        "observedUtc": { "type": "string", "format": "date-time", "maxLength": 40 },
        "candidateRequestedCommit": { "$ref": "#/$defs/nullableSha1" }
      }
    },
    "advisories": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "identifier", "url", "disposition", "retrievedUtc"],
        "properties": {
          "source": { "enum": ["osv"] },
          "identifier": { "type": "string", "minLength": 1, "maxLength": 120 },
          "url": { "type": "string", "pattern": "^https://", "maxLength": 2048 },
          "disposition": { "enum": ["affected", "not-affected", "unknown"] },
          "retrievedUtc": { "type": "string", "format": "date-time", "maxLength": 40 }
        }
      }
    },
    "networkAttempts": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "outcome", "statusCode", "attemptedUtc"],
        "properties": {
          "source": { "enum": ["github", "osv", "fixture"] },
          "outcome": { "enum": ["success", "fixture", "malformed", "rate-limit", "timeout", "refused"] },
          "statusCode": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
          "attemptedUtc": { "type": "string", "format": "date-time", "maxLength": 40 }
        }
      }
    },
    "nextAction": { "enum": ["none", "review-update", "review-security", "freeze-candidate", "retry-observation", "manual-admission"] }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullableSha1": {
      "oneOf": [
        { "$ref": "#/$defs/sha1" },
        { "type": "null" }
      ]
    }
  }
}
