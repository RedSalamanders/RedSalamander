        "sha256": {"const": "2ee109d55be1e3635d9a41e8c793a2273f70d8eb2609492fc03c648df9a9c321"}
      }
    },
    "exactInput": {
      "type": "object",
      "required": ["relativePath", "sha256"]
    },
    "conformanceCorrection": {
      "oneOf": [
        {"$ref": "#/$defs/correctionC7"},
        {"$ref": "#/$defs/correctionPng"},
        {"$ref": "#/$defs/correctionPackage"}
      ]
    },
    "correctionC7": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correctionId",
        "requirement",
        "priorState",
        "currentState",
        "scoringImpact"
      ],
      "properties": {
        "correctionId": {
          "const": "c7-proof-origin-closure"
        },
        "requirement": {
          "const": "C7 rating 5 requires provider-origin authentication, real adapter session/action/state execution in every lane, replay and boundary rejection, and a content-free proof bound to the actual adapter identity."
        },
        "priorState": {
          "const": "The invalid round-1 path had zero dedicated provider-origin C7 adapter schedules and no score.c7-proof contract or reusable proof identity."
        },
        "currentState": {
          "const": "The correction runs 3 independent adapter schedules, the existing ordering row, 31 authentication/composition cases, and 3 boundary cases. Frozen identities are contract raw 7d1ab5a6c1c2510ae6ded86c37d26ef0b051b3e92f460784fe49e1e7264bbab1, contract JCS 586cdfdaa591ef4a37dcd35fffc7aaedb998089b7a867168bdf2666fb488494f, schema raw a7de70e6ce6f45a1f6995af5643f32b16080714bb0b5121e6a5a1f44a9b83f9d, proof module raw 141f4a3a45f18ee9b177a22e6b2d0b82a396795e7343f14b27d1cc7cc3447ea8, contract documentation raw 9d18fdae4d8e68b023ae8fb69eb590220e76d7284f346275b678feee2aabb56e, and focused test raw 2ee109d55be1e3635d9a41e8c793a2273f70d8eb2609492fc03c648df9a9c321."
        },
        "scoringImpact": {
          "const": "Enforces an existing frozen requirement without changing a score anchor, weight, threshold, or candidate-specific expectation; all earlier result evidence is non-reusable."
        }
      }
    },
    "correctionPng": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correctionId",
        "requirement",
        "priorState",
        "currentState",
        "scoringImpact"
      ],
      "properties": {
        "correctionId": {
          "const": "positive-kitty-png-execution"
        },
        "requirement": {
          "const": "Existing G7 requires the positive kitty-direct-png fixture under every declared split schedule, a real bounded decoder callback, exact RGBA bytes, and an immutable owned snapshot after live deletion."
        },
        "priorState": {
          "const": "The invalid round-1 runner executed 28 fixtures and 41 rows and omitted the positive PNG fixture/action. Prior identities were fixture manifest 7ad1e12c16d518e6825260183dfb76da9942110eabe3f5329a8fc82e56a1d349, corpus raw 6d980b6b8ce9098a19dbdb616815786dfa14c1586f3b8449812fc92ce2b7bda1, generator raw d62fb30943a69d88ce416827bdb015d3b184d061182efbc8ce8ac73960015974, generated header raw 62c0123326163a53f57613ad8beda598c47c4cbaedd82f747a9a7af767674db9, and result raw a3e1a9b9be50bb3f8dd083ef3ff51bd72443db18f6e162bef181adf51130aa11; none is reusable."
        },
        "currentState": {
          "const": "The correction executes 29 fixtures and 43 rows. Current identities are fixture manifest af7277b42f6e74d147bb5df5781b4e4df03bddfcd28738330dd2403da22b9b44, corpus raw afb197f83966016cb3733d9aa4407dd74042a7f31178dac1aa5b3b02e1372109, generator raw ede50e5c8fdd1bc3f076c6fa401676932bacdf948dc0c89c58a0085eb8136d1d, generated header raw cd113174f188eef71acbaaebf38a178d76d3662e802136223ecef77404d5e141, and 43-row proof raw 697c1fe381eecb7873d20eeca603d12a41223cc8a97270ba4d0bb1abc3ba0be0. The added 116-byte input has SHA-256 a90a604995b9f736500e5354d9ced001674c4a26aad8b1353ceba3792986cf39 and expected-state SHA-256 64a4f66c4337d318dc879bda36c59a7f5db30d0f103d8f370444eae9407171d9."
        },
        "scoringImpact": {
          "const": "Enforces an existing frozen requirement without changing a score anchor, weight, threshold, or candidate-specific expectation; all earlier result evidence is non-reusable."
        }
      }
    },
    "correctionPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "correctionId",
        "requirement",
        "priorState",
        "currentState",
        "scoringImpact"
      ],
      "properties": {
        "correctionId": {
          "const": "portable-package-measurement"
        },
        "requirement": {
          "const": "C9 package contribution and the package-size tie-break use one provider-owned deterministic normalized ZIP recipe with fixed entry order, timestamp, attributes, compression, byte-identical double construction, and empty-ZIP overhead subtraction."
        },
        "priorState": {
          "const": "The post-provisional snapshot before this correction had measurement-protocol raw SHA-256 e45dc29c837b7d5608013a4f0b39b522e4e99d0c24834342274f775dbe436206 and did not close the portablePackageRecipe; no earlier raw DLL-plus-notice size, package metric, performance result, or score is reusable."
        },
        "currentState": {
          "const": "The corrected measurement protocol has raw SHA-256 cad0d34dd20fe466e3d04be16aa5ff0b033de6207f1a0575dee4a9ced3a56627 and freezes recipe terminal-engine-contribution-zip-v1."
        },
        "scoringImpact": {
          "const": "Enforces an existing frozen requirement without changing a score anchor, weight, threshold, or candidate-specific expectation; all earlier result evidence is non-reusable."
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalId",
        "reviewerId",
        "reviewerRole",
        "proposalSha256",
        "decision",
        "reviewedUtc"
      ],
      "properties": {
        "approvalId": {
          "$ref": "#/$defs/identifier"
        },
        "reviewerId": {
          "$ref": "#/$defs/identifier"
        },
        "reviewerRole": {
          "const": "independent-universe-reviewer"
        },
        "proposalSha256": {
          "$ref": "#/$defs/nonzeroSha256"
        },
        "decision": {
          "const": "approved"
        },
        "reviewedUtc": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
