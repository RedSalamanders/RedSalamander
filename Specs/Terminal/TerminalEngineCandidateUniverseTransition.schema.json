{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:red-salamander:schema:terminal-engine-candidate-universe-transition:v2",
  "title": "RedSalamander TerminalEngine candidate-universe round transition v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatId",
    "version",
    "frozenUtc",
    "authorId",
    "baseUniverse",
    "roundCloseout",
    "policy",
    "governanceSchemas",
    "conformanceCorrections",
    "frozenInputs",
    "proposalSha256",
    "approvals"
  ],
  "properties": {
    "formatId": {
      "const": "red-salamander-terminal-engine-candidate-universe-transition"
    },
    "version": {
      "const": 2
    },
    "frozenUtc": {
      "type": "string",
      "format": "date-time"
    },
    "authorId": {
      "$ref": "#/$defs/identifier"
    },
    "baseUniverse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "sha256", "version"],
      "properties": {
        "relativePath": {
          "const": "Specs/Terminal/TerminalEngineCandidateUniverse.v1.json"
        },
        "sha256": {
          "const": "eef3e91e61694e30a123d9f53d1aee124112f6af3177db1c315c50ac3d22b3af"
        },
        "version": {
          "const": 1
        }
      }
    },
    "roundCloseout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priorRound",
        "status",
        "failureCodes",
        "reuseAllowed",
        "reuseForbidden"
      ],
      "properties": {
        "priorRound": {
          "const": 1
        },
        "status": {
          "const": "invalid-no-selection"
        },
        "failureCodes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "candidate-set-not-frozen",
              "performance-before-nomination-close"
            ]
          }
        },
        "reuseAllowed": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "prefixItems": [
            {
              "const": "Byte-identical frozen protocols, controls, pins, source archives, source-review facts, and generated fixtures may be reused only after their recorded SHA-256 values are reverified."
            },
            {
              "const": "Exact prior patch bytes may be used as starting inputs, but every round-2 result tree, metric ledger, owner estimate, and approval is regenerated."
            }
          ],
          "items": false
        },
        "reuseForbidden": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "prefixItems": [
            {
              "const": "No round-1 functional, security, performance, package, native-lane, score, approval, or decision record is round-2 evidence."
            },
            {
              "const": "No provisional result may change a cap, score anchor, gate, weight, threshold, pin, source decision, control, fixture expectation, or normalization rule."
            }
          ],
          "items": false
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyChange",
        "hardCaps",
        "nominationOverrides",
        "preMeasurementRules"
      ],
      "properties": {
        "policyChange": {
          "const": "No adaptation cap, score anchor, weight, threshold, pin, source decision, or control changes. Round 2 changes nomination identities, restarts the invalid ordering, and binds candidate-neutral positive-PNG, C7 proof, and normalized-package measurement corrections that enforce existing G7, C7, and C9 requirements."
        },
        "hardCaps": {
          "$ref": "#/$defs/hardCaps"
        },
        "nominationOverrides": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nominationOverride"
          }
        },
        "preMeasurementRules": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "prefixItems": [
            {
              "const": "Freeze and independently approve every allowed seed outcome, exact patch, result tree, concern map, owner ledger, candidate assessment, and candidate set before any round-2 native or performance collection."
            },
            {
              "const": "Candidate-specific adapter, provider, driver, build, generated, test, documentation, and packaging code counts in that candidate regardless of repository location; moving code cannot improve a rating or evade a cap."
            },
            {
              "const": "A changed candidate result tree, provider semantics, frozen protocol, or scoring input after collection starts requires a new universe version and a complete rerun; round 2 has no repair-after-result exception."
            },
            {
              "const": "Logical concerns remain independently regressible behaviors and may not be merged, renamed, or omitted to gain admission or a score."
            },
            {
              "const": "A candidate must pass every fixture and native lane; no assertion-count inflation, fixture exception, expected-state lookup, unsupported action, normalized-artifact substitute, or candidate-supplied evidence claim is accepted."
            },
            {
              "const": "The explicit no-winner outcome remains valid; no cap or rating is raised merely to force a selection."
            }
          ],
          "items": false
        }
      }
    },
    "governanceSchemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUniverse", "transition"],
      "properties": {
        "baseUniverse": {
          "type": "object",
          "additionalProperties": false,
          "required": ["relativePath", "sha256"],
          "properties": {
            "relativePath": {
              "const": "Specs/Terminal/TerminalEngineCandidateUniverse.schema.json"
            },
            "sha256": {
              "$ref": "#/$defs/nonzeroSha256"
            }
          }
        },
        "transition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["relativePath", "sha256"],
          "properties": {
            "relativePath": {
              "const": "Specs/Terminal/TerminalEngineCandidateUniverseTransition.schema.json"
            },
            "sha256": {
              "$ref": "#/$defs/nonzeroSha256"
            }
          }
        }
      }
    },
    "conformanceCorrections": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/conformanceCorrection"
      }
    },
    "frozenInputs": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/frozenInput"
      }
    },
    "proposalSha256": {
      "$ref": "#/$defs/nonzeroSha256"
    },
    "approvals": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/approval"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonzeroSha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "nonemptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "hardCaps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerDays",
        "changedMaintainedLines",
        "changedMaintainedFiles",
        "logicalConcerns",
        "newToolchainFamilies",
        "newNonSystemRuntimeLeaves",
        "binaryPatchAllowed"
      ],
      "properties": {
        "ownerDays": {
          "const": 60
        },
        "changedMaintainedLines": {
          "const": 2500
        },
        "changedMaintainedFiles": {
          "const": 24
        },
        "logicalConcerns": {
          "const": 5
        },
        "newToolchainFamilies": {
          "const": 1
        },
        "newNonSystemRuntimeLeaves": {
          "const": 0
        },
        "binaryPatchAllowed": {
          "const": false
        }
      }
    },
    "nominationOverride": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["seedCandidateId", "priorNominationId", "nominationId"],
          "properties": {
            "seedCandidateId": {"const": "contour"},
            "priorNominationId": {"const": "contour-rs"},
            "nominationId": {"const": "contour-rs-v2"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["seedCandidateId", "priorNominationId", "nominationId"],
          "properties": {
            "seedCandidateId": {"const": "ghostty-upstream"},
            "priorNominationId": {"const": "ghostty-rs-v2"},
            "nominationId": {"const": "ghostty-rs-v3"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["seedCandidateId", "priorNominationId", "nominationId"],
          "properties": {
            "seedCandidateId": {"const": "wezterm"},
            "priorNominationId": {"const": "wezterm-rs"},
            "nominationId": {"const": "wezterm-rs-v2"}
          }
        }
      ]
    },
    "frozenInput": {
      "oneOf": [
        {"$ref": "#/$defs/inputBaseUniverse"},
        {"$ref": "#/$defs/inputFixtureCorpus"},
        {"$ref": "#/$defs/inputMeasurementProtocol"},
        {"$ref": "#/$defs/inputRequirements"},
        {"$ref": "#/$defs/inputScoreAnchors"},
        {"$ref": "#/$defs/inputGeneratedFixtures"},
        {"$ref": "#/$defs/inputFixtureGenerator"},
        {"$ref": "#/$defs/inputAdapterHeader"},
        {"$ref": "#/$defs/inputLayoutHeader"},
        {"$ref": "#/$defs/inputC7Contract"},
        {"$ref": "#/$defs/inputC7Schema"},
        {"$ref": "#/$defs/inputC7Module"},
        {"$ref": "#/$defs/inputC7Documentation"},
        {"$ref": "#/$defs/inputC7Test"}
      ]
    },
    "inputBaseUniverse": {
      "$ref": "#/$defs/exactInput",
      "unevaluatedProperties": false,
      "properties": {
        "relativePath": {"const": "Specs/Terminal/TerminalEngineCandidateUniverse.v1.json"},
        "sha256": {"const": "eef3e91e61694e30a123d9f53d1aee124112f6af3177db1c315c50ac3d22b3af"}
      }
    },
    "inputFixtureCorpus": {
      "$ref": "#/$defs/exactInput",
      "unevaluatedProperties": false,
      "properties": {
        "relativePath": {"const": "Specs/Terminal/TerminalEngineFixtureCorpus.v1.json"},
        "sha256": {"const": "afb197f83966016cb3733d9aa4407dd74042a7f31178dac1aa5b3b02e1372109"}
      }
    },
    "inputMeasurementProtocol": {
      "$ref": "#/$defs/exactInput",
      "unevaluatedProperties": false,
      "properties": {
        "relativePath": {"const": "Specs/Terminal/TerminalEngineMeasurementProtocol.v1.json"},
        "sha256": {"const": "cad0d34dd20fe466e3d04be16aa5ff0b033de6207f1a0575dee4a9ced3a56627"}
      }
    },
    "inputRequirements": {
      "$ref": "#/$defs/exactInput",
      "unevaluatedProperties": false,
      "properties": {
        "relativePath": {"const": "Specs/Terminal/TerminalEngineRequirements.v1.json"},
        "sha256": {"const": "8c4119c6d4429af73d12178f58440609b6e5379ccc2c6bfaa5d9b18788e66366"}
      }
    },
    "inputScoreAnchors": {
      "$ref": "#/$defs/exactInput",
      "unevaluatedProperties": false,
      "properties": {
        "relativePath": {"const": "Specs/Terminal/TerminalEngineScoreAnchors.v1.json"},
        "sha256": {"const": "5dd79066be00e5de4106625263c9ba6c5588a08c169b7693aff230ac512e3007"}
      }
    },
    "inputGeneratedFixtures": {
      "$ref": "#/$defs/exactInput",
      "unevaluatedProperties": false,
      "properties": {
        "relativePath": {"const": "Tools/TerminalEngine/Generated/TerminalEngineFixtures.v1.h"},
        "sha256": {"const": "cd113174f188eef71acbaaebf38a178d76d3662e802136223ecef77404d5e141"}
      }
    },
    "inputFixtureGenerator": {
      "$ref": "#/$defs/exactInput",
      "unevaluatedProperties": false,
      "properties": {
        "relativePath": {"const": "Tools/TerminalEngine/Generate-TerminalEngineFixtures.ps1"},
        "sha256": {"const": "ede50e5c8fdd1bc3f076c6fa401676932bacdf948dc0c89c58a0085eb8136d1d"}
      }
    },
    "inputAdapterHeader": {
      "$ref": "#/$defs/exactInput",
      "unevaluatedProperties": false,
      "properties": {
        "relativePath": {"const": "Tools/TerminalEngine/TerminalEngineGate0Adapter.h"},
        "sha256": {"const": "5aed4f300a5a4aea090f50bbed743bd34824f18a9d2acc64d698a9b8561981bc"}
      }
    },
    "inputLayoutHeader": {
      "$ref": "#/$defs/exactInput",
      "unevaluatedProperties": false,
      "properties": {
        "relativePath": {"const": "Tools/TerminalEngine/TerminalEngineGate0Layout.h"},
        "sha256": {"const": "63cf4fb35db3ca55870b2e5604a9c4b9cb672a3212d132e35465976ce5d1aff6"}
      }
    },
    "inputC7Contract": {
      "$ref": "#/$defs/exactInput",
      "unevaluatedProperties": false,
      "properties": {
        "relativePath": {"const": "Specs/Terminal/TerminalEngineC7ProofContract.v1.json"},
        "sha256": {"const": "7d1ab5a6c1c2510ae6ded86c37d26ef0b051b3e92f460784fe49e1e7264bbab1"}
      }
    },
    "inputC7Schema": {
      "$ref": "#/$defs/exactInput",
      "unevaluatedProperties": false,
      "properties": {
        "relativePath": {"const": "Specs/Terminal/TerminalEngineC7Proof.schema.json"},
        "sha256": {"const": "a7de70e6ce6f45a1f6995af5643f32b16080714bb0b5121e6a5a1f44a9b83f9d"}
      }
    },
    "inputC7Module": {
      "$ref": "#/$defs/exactInput",
      "unevaluatedProperties": false,
      "properties": {
        "relativePath": {"const": "Tools/TerminalEngine/TerminalEngineC7Proof.psm1"},
        "sha256": {"const": "141f4a3a45f18ee9b177a22e6b2d0b82a396795e7343f14b27d1cc7cc3447ea8"}
      }
    },
    "inputC7Documentation": {
      "$ref": "#/$defs/exactInput",
      "unevaluatedProperties": false,
      "properties": {
        "relativePath": {"const": "Tools/TerminalEngine/TerminalEngineC7ProofContract.md"},
        "sha256": {"const": "9d18fdae4d8e68b023ae8fb69eb590220e76d7284f346275b678feee2aabb56e"}
      }
    },
    "inputC7Test": {
      "$ref": "#/$defs/exactInput",
      "unevaluatedProperties": false,
      "properties": {
