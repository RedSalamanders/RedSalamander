{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://red-salamander.local/schemas/ghostty-runtime-candidate-descriptor-v1.json",
  "title": "RedSalamander Ghostty runtime candidate descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedUtc", "sourceBinding", "canonicalLock", "candidate", "ancestry", "observation", "review", "toolchain", "dependency", "overlay", "inputDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedUtc": { "type": "string", "format": "date-time", "maxLength": 40 },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryCommit"],
      "properties": { "repositoryCommit": { "$ref": "#/$defs/sha1" } }
    },
    "canonicalLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "commit", "tree"],
      "properties": {
        "path": { "const": "External/TerminalEngine/GhosttyRuntimeLock.v1.json" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "commit": { "$ref": "#/$defs/sha1" },
        "tree": { "$ref": "#/$defs/sha1" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tree", "version", "archivePath", "archiveUrl", "archiveSha256"],
      "properties": {
        "repository": { "const": "https://github.com/ghostty-org/ghostty.git" },
        "commit": { "$ref": "#/$defs/sha1" },
        "tree": { "$ref": "#/$defs/sha1" },
        "version": { "type": "string", "minLength": 1, "maxLength": 80 },
        "archivePath": { "$ref": "#/$defs/relativePath" },
        "archiveUrl": { "type": "string", "pattern": "^https://github\\.com/ghostty-org/ghostty/archive/[0-9a-f]{40}\\.tar\\.gz$", "maxLength": 256 },
        "archiveSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "ancestry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aheadCount", "behindCount"],
      "properties": {
        "aheadCount": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "behindCount": { "const": 0 }
      }
    },
    "observation": { "$ref": "#/$defs/fileBinding" },
    "review": { "$ref": "#/$defs/fileBinding" },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zigVersion", "archives"],
      "properties": {
        "zigVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
        "archives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hostPlatform", "fileName", "sha256", "executableSha256"],
            "properties": {
              "hostPlatform": { "type": "string", "minLength": 1, "maxLength": 40 },
              "fileName": { "type": "string", "minLength": 1, "maxLength": 255 },
              "sha256": { "$ref": "#/$defs/sha256" },
              "executableSha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceArchiveSha256", "contentArchiveSha256", "licenseSha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80 },
        "sourceArchiveSha256": { "$ref": "#/$defs/sha256" },
        "contentArchiveSha256": { "$ref": "#/$defs/sha256" },
        "licenseSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "normalizedTextSha256", "concernIds"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "normalizedTextSha256": { "$ref": "#/$defs/sha256" },
        "concernIds": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "maxLength": 120 } }
      }
    },
    "inputDigest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\r\\n]+$", "maxLength": 1024 },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
