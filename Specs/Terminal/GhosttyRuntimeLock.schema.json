{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://red-salamander.invalid/schemas/ghostty-runtime-lock-v1.json",
  "title": "Red Salamander Ghostty product runtime lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatId",
    "schemaVersion",
    "upstream",
    "toolchain",
    "dependencies",
    "overlay",
    "build",
    "abi",
    "notices",
    "runtimeIdentity"
  ],
  "properties": {
    "formatId": { "const": "red-salamander-ghostty-runtime-lock" },
    "schemaVersion": { "const": 1 },
    "upstream": { "$ref": "#/$defs/upstream" },
    "toolchain": { "$ref": "#/$defs/toolchain" },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/dependency" }
    },
    "overlay": { "$ref": "#/$defs/overlay" },
    "build": { "$ref": "#/$defs/build" },
    "abi": { "$ref": "#/$defs/abi" },
    "notices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/notice" }
    },
    "runtimeIdentity": { "$ref": "#/$defs/runtimeIdentity" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,63}$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "not": {
        "anyOf": [
          { "pattern": "^[A-Za-z]:" },
          { "pattern": "^[/\\\\]" },
          { "pattern": "(^|[/\\\\])\\.\\.($|[/\\\\])" }
        ]
      }
    },
    "httpsUrl": {
      "type": "string",
      "minLength": 12,
      "maxLength": 1024,
      "pattern": "^https://[^/?#]+/[^?#]+$"
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "fileName", "url", "sha256" ],
      "properties": {
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "repository", "commit", "tree", "version", "archive" ],
      "properties": {
        "repository": { "$ref": "#/$defs/httpsUrl" },
        "commit": { "$ref": "#/$defs/sha1" },
        "tree": { "$ref": "#/$defs/sha1" },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]*$"
        },
        "archive": { "$ref": "#/$defs/archive" }
      }
    },
    "toolchainArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostPlatform",
        "fileName",
        "url",
        "sha256",
        "executableRelativePath",
        "executableSha256"
      ],
      "properties": {
        "hostPlatform": { "enum": [ "x64", "ARM64" ] },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "executableRelativePath": { "$ref": "#/$defs/relativePath" },
        "executableSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "zigVersion", "archives" ],
      "properties": {
        "zigVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "archives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/toolchainArchive" }
        }
      }
    },
    "dependencyArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "fileName", "sha256", "internalRoot" ],
      "properties": {
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "internalRoot": { "$ref": "#/$defs/relativePath" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "packageName",
        "sourceArchive",
        "contentArchive",
        "licenseArchiveRelativePath",
        "licenseSha256"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "packageName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "sourceArchive": {
          "allOf": [
            { "$ref": "#/$defs/dependencyArchive" },
            { "required": [ "url" ] }
          ]
        },
        "contentArchive": { "$ref": "#/$defs/dependencyArchive" },
        "licenseArchiveRelativePath": { "$ref": "#/$defs/relativePath" },
        "licenseSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "path", "normalizedTextSha256", "concernIds" ],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "normalizedTextSha256": { "$ref": "#/$defs/sha256" },
        "concernIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "target",
        "machine",
        "minimumDllSizeBytes",
        "maximumDllSizeBytes"
      ],
      "properties": {
        "platform": { "enum": [ "x64", "ARM64" ] },
        "target": {
          "enum": [ "x86_64-windows-msvc", "aarch64-windows-msvc" ]
        },
        "machine": { "enum": [ "AMD64", "ARM64" ] },
        "minimumDllSizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "maximumDllSizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arguments",
        "environmentAllowlist",
        "canonicalDrive",
        "contentHashNormalization",
        "platforms"
      ],
      "properties": {
        "arguments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "environmentAllowlist": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }
        },
        "canonicalDrive": { "type": "string", "pattern": "^[A-Z]:$" },
        "contentHashNormalization": {
          "const": "pe-coff-debug-rsds-v1"
        },
        "platforms": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/platform" }
        }
      }
    },
    "abi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "importModules",
        "exports",
        "exportCount",
        "exportSetSha256",
        "loaderRequiredExports"
      ],
      "properties": {
        "importModules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_.+-]+\\.dll$"
          }
        },
        "exports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2048,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
        },
        "exportCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "exportSetSha256": { "$ref": "#/$defs/sha256" },
        "loaderRequiredExports": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2048,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
        }
      }
    },
    "noticeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "kind", "path" ],
      "properties": {
        "kind": { "enum": [ "repository", "upstream", "toolchain", "dependency" ] },
        "path": { "$ref": "#/$defs/relativePath" },
        "dependencyId": { "$ref": "#/$defs/id" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "dependency" } } },
          "then": { "required": [ "dependencyId" ] },
          "else": { "not": { "required": [ "dependencyId" ] } }
        }
      ]
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "id", "source", "normalizedTextSha256", "outputRelativePath" ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source": { "$ref": "#/$defs/noticeSource" },
        "normalizedTextSha256": { "$ref": "#/$defs/sha256" },
        "outputRelativePath": { "$ref": "#/$defs/relativePath" }
      }
    },
    "runtimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatId",
        "schemaVersion",
        "pairingContract",
        "generatedIdentityHeader"
      ],
      "properties": {
        "formatId": { "const": "red-salamander-ghostty-runtime" },
        "schemaVersion": { "const": 5 },
        "pairingContract": { "const": "generated-raw-sha256-v1" },
        "generatedIdentityHeader": { "$ref": "#/$defs/relativePath" }
      }
    }
  }
}
