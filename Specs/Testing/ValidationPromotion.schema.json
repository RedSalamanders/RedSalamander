{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://red-salamander.invalid/schemas/validation-promotion-v1.json",
  "title": "RedSalamander validation promotion certificate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "canonicalization", "promotion_digest", "origin_run_id", "entry_id", "evidence_digest", "entry_fingerprint", "fingerprint_component_version", "fingerprint_components", "plan_digest", "coverage_plan_digest", "terminal_result_digest", "pre_snapshot_id", "post_snapshot_id", "build_receipt_id", "artifact_epoch", "artifact_digests", "coverage_digest", "outcome_digest", "result_artifacts", "origin_terminalization_policy", "promoted_utc"],
  "properties": {
    "schema": { "const": "red-salamander.validation-promotion.v1" },
    "canonicalization": { "const": "rs-canonical-json-v1" },
    "promotion_digest": { "$ref": "#/definitions/digest" },
    "origin_run_id": { "$ref": "#/definitions/runId" },
    "entry_id": { "$ref": "#/definitions/id" },
    "evidence_digest": { "$ref": "#/definitions/digest" },
    "entry_fingerprint": { "$ref": "#/definitions/digest" },
    "fingerprint_component_version": { "const": "validation-entry-components.v1" },
    "fingerprint_components": { "$ref": "#/definitions/componentDigests" },
    "plan_digest": { "$ref": "#/definitions/digest" },
    "coverage_plan_digest": { "$ref": "#/definitions/digest" },
    "terminal_result_digest": { "$ref": "#/definitions/digest" },
    "pre_snapshot_id": { "$ref": "#/definitions/digest" },
    "post_snapshot_id": { "$ref": "#/definitions/digest" },
    "build_receipt_id": { "$ref": "#/definitions/digest" },
    "artifact_epoch": { "type": "integer", "minimum": 0 },
    "artifact_digests": { "type": "object", "maxProperties": 4096, "additionalProperties": { "$ref": "#/definitions/digest" }, "propertyNames": { "$ref": "#/definitions/id" } },
    "coverage_digest": { "$ref": "#/definitions/digest" },
    "outcome_digest": { "$ref": "#/definitions/digest" },
    "result_artifacts": { "type": "array", "maxItems": 4096, "uniqueItems": true, "items": { "$ref": "#/definitions/resultArtifact" } },
    "origin_terminalization_policy": { "enum": ["entry-barrier-complete", "run-terminal-required"] },
    "promoted_utc": { "type": "string", "format": "date-time", "maxLength": 64 }
  },
  "definitions": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$" },
    "runId": { "type": "string", "maxLength": 128, "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9]+-[0-9a-f]{32}$" },
    "relativePath": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*\\\\)[^\\u0000-\\u001f]+$" },
    "resultArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/definitions/relativePath" },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 67108864 },
        "sha256": { "$ref": "#/definitions/digest" }
      }
    },
    "componentDigests": {
      "type": "object",
      "minProperties": 11,
      "maxProperties": 64,
      "additionalProperties": { "$ref": "#/definitions/digest" },
      "propertyNames": { "$ref": "#/definitions/id" }
    }
  }
}
