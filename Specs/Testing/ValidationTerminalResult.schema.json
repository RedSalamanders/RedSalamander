{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://red-salamander.invalid/schemas/validation-terminal-result-v1.json",
  "title": "RedSalamander normalized validation terminal result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "canonicalization", "terminal_result_digest", "entry_id", "kind", "status", "reason_codes", "counts"],
  "properties": {
    "schema": { "const": "red-salamander.validation-terminal-result.v1" },
    "canonicalization": { "const": "rs-canonical-json-v1" },
    "terminal_result_digest": { "$ref": "#/definitions/digest" },
    "entry_id": { "$ref": "#/definitions/id" },
    "kind": { "enum": ["SelfTest", "Executable", "CppUnitTest", "Pester", "PowerShellScript"] },
    "status": { "enum": ["PASSED", "FAILED"] },
    "reason_codes": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/reasonCode" }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "skipped", "total"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "definitions": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$" },
    "reasonCode": { "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Z0-9_]+$" }
  }
}
