{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://red-salamander.invalid/schemas/validation-impact-v1.json",
  "title": "RedSalamander validation impact graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "canonicalization", "rules"],
  "properties": {
    "schema": { "const": "red-salamander.validation-impact.v1" },
    "canonicalization": { "const": "rs-canonical-json-v1" },
    "rules": { "type": "array", "minItems": 1, "maxItems": 10000, "items": { "$ref": "#/definitions/rule" } }
  },
  "definitions": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$" },
    "relativePattern": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*\\\\)[^\\u0000-\\u001f]+$" },
    "idSet": { "type": "array", "maxItems": 4096, "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pattern", "classification", "impact_tags", "build_requirement", "broad_fallback", "reason", "owner_spec", "derived_closure_source"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "pattern": { "$ref": "#/definitions/relativePattern" },
        "classification": { "enum": ["product", "suite-test-only", "shared-test", "runner", "build", "workflow", "machine-contract", "runtime-data", "performance-data", "test-corpus", "governance-map", "spec-documentation", "evidence", "generated", "reviewed-no-validation"] },
        "impact_tags": { "$ref": "#/definitions/idSet" },
        "build_requirement": { "enum": ["none", "targeted", "full"] },
        "broad_fallback": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "owner_spec": { "$ref": "#/definitions/relativePattern" },
        "derived_closure_source": { "anyOf": [{ "$ref": "#/definitions/relativePattern" }, { "type": "null" }] }
      }
    }
  }
}
