+        DWORD processId      = 0u;
+        const DWORD threadId = GetWindowThreadProcessId(target, &processId);
+        if (! warning || ! IsWindowVisible(warning) || ! target || processId != GetCurrentProcessId() || threadId != GetCurrentThreadId())
