Language: Cpp
BasedOnStyle: Microsoft
# Basic indentation settings from VS: TabSize=4, IndentSize=4, InsertTabs=true
IndentWidth: 4
TabWidth: 4
UseTab: Never
LineEnding: CRLF

# C++ Standard
Standard: Latest

# Column limit
ColumnLimit: 160

# Access modifiers (VS: IndentAccessSpecifiers=false)
AccessModifierOffset: -4

# Alignment settings
AlignAfterOpenBracket: Align
AlignArrayOfStructures: None
# Enable `=` alignment for consecutive assignments, but NOT across empty lines.
# Insert a blank line between unrelated assignment groups to prevent extreme padding.
AlignConsecutiveAssignments:
  Enabled: true
  AcrossEmptyLines: false
  AcrossComments: false
  AlignCompound: false
  AlignFunctionDeclarations: false
  AlignFunctionPointers: false
  PadOperators: true
AlignConsecutiveBitFields:
  Enabled: false
AlignConsecutiveDeclarations:
  Enabled: false
AlignConsecutiveMacros:
  Enabled: false
AlignEscapedNewlines: Right
AlignOperands: Align
AlignTrailingComments: true

# Allow settings
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: true
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLambdasOnASingleLine: All
AllowShortLoopsOnASingleLine: false

# Break settings
BreakAfterReturnType: None
AlwaysBreakBeforeMultilineStrings: false
BreakTemplateDeclarations: MultiLine

# Binary packing
BinPackArguments: false
BinPackParameters: false

# Break before settings
BreakBeforeBinaryOperators: None
# VS: Allman brace style
BreakBeforeBraces: Allman
BreakBeforeConceptDeclarations: Always
BreakBeforeTemplateCloser: false
BreakBeforeTernaryOperators: true
# VS: SpaceBeforeConstructorColon=true
BreakConstructorInitializers: BeforeColon
# VS: SpaceBeforeInheritanceColon=true
BreakInheritanceList: BeforeColon
BreakStringLiterals: true

# Compact settings
CompactNamespaces: false

# Constructor settings
PackConstructorInitializers: CurrentLine
ConstructorInitializerIndentWidth: 4
ContinuationIndentWidth: 4

# C++11 style
Cpp11BracedListStyle: true

# Derive settings
DerivePointerAlignment: false

# Enum settings (v21)
EnumTrailingComma: Leave

# Fix settings
FixNamespaceComments: true

# Include settings
IncludeBlocks: Preserve
SortIncludes:
  Enabled: true
  IgnoreCase: false
SortUsingDeclarations: true

# Indentation settings based on VS preferences
IndentCaseBlocks: false
IndentCaseLabels: true
IndentExternBlock: AfterExternBlock
IndentGotoLabels: true
IndentPPDirectives: None
IndentRequiresClause: false
IndentWrappedFunctionNames: false

# Lambda settings
LambdaBodyIndentation: OuterScope

# Keep settings (v21 struct replaces KeepEmptyLinesAtTheStartOfBlocks)
KeepEmptyLines:
  AtEndOfFile: false
  AtStartOfBlock: false
  AtStartOfFile: true
MaxEmptyLinesToKeep: 1

# Insert settings
InsertNewlineAtEOF: true

# Namespace settings
NamespaceIndentation: None

# Pointer alignment
# VS: PointerAlignment=1 (left)
PointerAlignment: Left

# Qualifier alignment
QualifierAlignment: Leave

# C++20 concepts/requires
RequiresClausePosition: OwnLine

# Other settings
ReflowComments: true
SeparateDefinitionBlocks: Leave

# Spacing settings
SpaceAfterCStyleCast: false
SpaceAfterLogicalNot: true
SpaceAfterOperatorKeyword: false
SpaceAfterTemplateKeyword: true
SpaceBeforeAssignmentOperators: true
SpaceBeforeCaseColon: false
SpaceBeforeCpp11BracedList: false
SpaceBeforeCtorInitializerColon: true
SpaceBeforeInheritanceColon: true
SpaceBeforeParens: ControlStatements
SpaceBeforeRangeBasedForLoopColon: true
SpaceBeforeSquareBrackets: false
SpaceInEmptyBlock: false
SpacesBeforeTrailingComments: 1
SpacesInAngles: false
SpacesInContainerLiterals: true
SpacesInParens: Never
SpacesInSquareBrackets: false
