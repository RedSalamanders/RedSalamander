IDI_REDCONFIGURE_APP ICON "res\\RedConfigure.ico"

IDR_REDCONFIGURE_MAINMENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit", IDM_REDCONFIGURE_EXIT
    END
END

