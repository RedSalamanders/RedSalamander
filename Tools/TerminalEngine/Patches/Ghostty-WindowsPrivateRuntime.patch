+test "storage: placement admission bounds count allocated bytes and rejection state" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const io = testing.io;
+    var t = try terminal.Terminal.init(io, alloc, .{ .cols = 4, .rows = 4 });
+    defer t.deinit(alloc);
+
+    var s: ImageStorage = .{};
+    defer s.deinit(alloc, t.screens.active);
+    try s.addImage(io, alloc, t.screens.active, .{ .id = 1, .width = 1, .height = 1 });
+
+    const first_allocation = ImageStorage.placementAllocatedBytesForCapacity(
+        ImageStorage.placementCapacityForSize(1),
+    );
+    s.setPlacementLimits(ImageStorage.maximum_placement_count, first_allocation - 1);
+    const generation_before_rejection = s.generation;
+    const next_id_before_rejection = s.next_internal_placement_id;
+    const tracked_before_rejection = t.screens.active.pages.countTrackedPins();
+    const rejected: ImageStorage.Placement = .{
+        .location = .{ .pin = try trackPin(&t, .{ .x = 0, .y = 0 }) },
+    };
+    try testing.expectError(
+        error.OutOfMemory,
+        s.addPlacement(io, alloc, t.screens.active, 1, 0, rejected),
+    );
+    try testing.expectEqual(@as(usize, 0), s.placementCount());
+    try testing.expectEqual(@as(usize, 0), s.placementAllocatedBytes());
+    try testing.expectEqual(generation_before_rejection, s.generation);
+    try testing.expectEqual(next_id_before_rejection, s.next_internal_placement_id);
+    try testing.expectEqual(
+        tracked_before_rejection + 1,
+        t.screens.active.pages.countTrackedPins(),
+    );
+    rejected.deinit(t.screens.active);
+    try testing.expectEqual(
+        tracked_before_rejection,
+        t.screens.active.pages.countTrackedPins(),
+    );
+
+    s.setPlacementLimits(
+        ImageStorage.maximum_placement_count,
+        ImageStorage.maximum_placement_bytes,
+    );
+    for (1..ImageStorage.maximum_placement_count + 1) |placement_id| {
+        try s.addPlacement(
+            io,
