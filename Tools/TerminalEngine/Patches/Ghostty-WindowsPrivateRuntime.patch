+            @intCast(placement_id),
+            .{ .location = .{ .virtual = {} } },
+        );
+    }
+    try testing.expectEqual(ImageStorage.maximum_placement_count, s.placementCount());
+    const retained_bytes = s.placementAllocatedBytes();
+    const retained_generation = s.generation;
+    const retained_next_id = s.next_internal_placement_id;
+    try testing.expect(retained_bytes > 0);
+    try testing.expect(retained_bytes <= ImageStorage.maximum_placement_bytes);
