<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Single source of truth for app-local vcpkg runtime DLLs copied by plugin builds
    and validated by portable packaging. Flavor Debug also applies to ASan Debug.
  -->
  <ItemGroup>
    <RSRuntimeDependency Include="7zip">
      <Projects>FileSystem7z</Projects><Flavor>Any</Flavor><Platform>Any</Platform>
      <Source>bin\7zip.dll</Source><OutputName>7zip.dll</OutputName><Required>true</Required>
    </RSRuntimeDependency>

    <RSRuntimeDependency Include="curl-debug">
      <Projects>FileSystemCurl;FileSystemGoogleDrive</Projects><Flavor>Debug</Flavor><Platform>Any</Platform>
      <Source>debug\bin\libcurl-d.dll</Source><OutputName>libcurl-d.dll</OutputName><Required>true</Required>
    </RSRuntimeDependency>
    <RSRuntimeDependency Include="curl-release">
      <Projects>FileSystemCurl;FileSystemGoogleDrive</Projects><Flavor>Release</Flavor><Platform>Any</Platform>
      <Source>bin\libcurl.dll</Source><OutputName>libcurl.dll</OutputName><Required>true</Required>
    </RSRuntimeDependency>
