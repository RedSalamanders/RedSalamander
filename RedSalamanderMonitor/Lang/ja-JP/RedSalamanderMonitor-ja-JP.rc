    IDS_FILTER_TYPE_WARNING "警告"
    IDS_FILTER_TYPE_INFO "情報"
    IDS_FILTER_TYPE_PERF "パフォーマンス"
    IDS_FILTER_TYPE_DEBUG "デバッグ"
    IDS_STATUS_FILTER_ALL "フィルター: すべて"
    IDS_STATUS_FILTER_NONE "フィルター: なし"
