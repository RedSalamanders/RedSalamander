    IDS_FILE_FILTER_OPEN "テキスト ファイル (*.txt;*.log)\0*.txt;*.log\0すべてのファイル (*.*)\0*.*\0\0"
    IDS_FILE_FILTER_SAVE "テキスト ファイル (*.txt)\0*.txt\0すべてのファイル (*.*)\0*.*\0\0"
    IDS_FILE_DEFAULT_EXT_TXT "テキスト"
    IDS_FILTER_TYPE_TEXT "テキスト"
